<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#0B0B0F;--surface:#14141C;--border:rgba(255,255,255,0.08);--accent:#9D4EDD;--accent2:#6A0DAD;--text:#fff;--muted:#B3B3B3;--success:#00FF88;--error:#FF4444;--warn:#f5c842;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;}
    .layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh;}
    .main{padding:2rem;position:relative;z-index:1;overflow-x:hidden;}
    .page-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:0.4rem;}
    .page-title{font-family:'Poppins',sans-serif;font-size:2rem;letter-spacing:2px;}
    .page-sub{font-size:0.78rem;color:var(--muted);margin-bottom:1.8rem;}
    .btn-add{display:inline-flex;align-items:center;gap:0.5rem;padding:0.65rem 1.3rem;background:linear-gradient(135deg,var(--accent2),var(--accent));border:none;border-radius:8px;color:#fff;font-family:'Outfit',sans-serif;font-weight:600;font-size:0.88rem;cursor:pointer;transition:all 0.18s;}
    .btn-add:hover{box-shadow:0 0 24px rgba(157,78,221,0.35);transform:translateY(-1px);}

    /* Tier tabs */
    .tier-tabs{display:flex;gap:0.5rem;margin-bottom:1.5rem;flex-wrap:wrap;}
    .tier-tab{padding:0.45rem 1rem;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:20px;font-size:0.75rem;font-family:'Space Mono',monospace;letter-spacing:1px;color:var(--muted);cursor:pointer;transition:all 0.15s;text-transform:uppercase;}
    .tier-tab.active{background:rgba(157,78,221,0.12);border-color:rgba(157,78,221,0.4);color:#fff;}
    .tier-tab .cnt{background:rgba(157,78,221,0.3);border-radius:10px;padding:0.05rem 0.4rem;font-size:0.65rem;margin-left:0.3rem;}

    /* Grid */
    .sponsors-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1.2rem;}
    .sponsor-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden;transition:border-color 0.15s;}
    .sponsor-card:hover{border-color:rgba(157,78,221,0.3);}
    .sponsor-card.inactive{opacity:0.45;}

    /* ✅ FIX: checkerboard pattern shows transparency in logo preview on card */
    .sc-logo{
      height:110px;display:flex;align-items:center;justify-content:center;padding:0.75rem;position:relative;
      background-color:#fff;
      background-image:
        linear-gradient(45deg,#e0e0e0 25%,transparent 25%),
        linear-gradient(-45deg,#e0e0e0 25%,transparent 25%),
        linear-gradient(45deg,transparent 75%,#e0e0e0 75%),
        linear-gradient(-45deg,transparent 75%,#e0e0e0 75%);
      background-size:12px 12px;
      background-position:0 0,0 6px,6px -6px,-6px 0px;
    }
    .sc-logo img{max-width:100%;max-height:100%;object-fit:contain;}
    .sc-tier{position:absolute;top:0.5rem;right:0.5rem;font-family:'Space Mono',monospace;font-size:0.5rem;letter-spacing:1px;padding:0.15rem 0.5rem;border-radius:3px;text-transform:uppercase;font-weight:700;}
    .t-title{background:#f5c842;color:#000;}
    .t-gold{background:#E9B84A;color:#000;}
    .t-silver{background:#A8B5C8;color:#000;}
    .t-partner{background:rgba(157,78,221,0.2);border:1px solid rgba(157,78,221,0.4);color:#d8b4fe;}
    .sc-body{padding:0.9rem 1rem;}
    .sc-name{font-weight:700;font-size:0.95rem;margin-bottom:0.2rem;}
    .sc-website{font-size:0.7rem;color:var(--muted);margin-bottom:0.55rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
    .sc-badges{display:flex;gap:0.35rem;flex-wrap:wrap;margin-bottom:0.7rem;}
    .sc-badge{font-family:'Space Mono',monospace;font-size:0.5rem;letter-spacing:1px;padding:0.12rem 0.45rem;border-radius:10px;text-transform:uppercase;}
    .b-tk{background:rgba(0,255,136,0.08);border:1px solid rgba(0,255,136,0.2);color:var(--success);}
    .b-site{background:rgba(157,78,221,0.08);border:1px solid rgba(157,78,221,0.2);color:var(--accent);}
    .b-ev{background:rgba(245,200,66,0.08);border:1px solid rgba(245,200,66,0.2);color:var(--warn);}
    .sc-actions{display:flex;gap:0.45rem;}
    .sc-btn{flex:1;padding:0.5rem 0;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:6px;color:var(--muted);font-size:0.76rem;cursor:pointer;transition:all 0.15s;display:flex;align-items:center;justify-content:center;gap:0.3rem;}
    .sc-btn:hover{background:rgba(255,255,255,0.08);color:#fff;}
    .sc-btn.danger:hover{background:rgba(255,68,68,0.1);border-color:rgba(255,68,68,0.3);color:var(--error);}
    .empty{text-align:center;padding:4rem 2rem;color:var(--muted);}
    .empty i{font-size:3rem;opacity:0.2;display:block;margin-bottom:1rem;}

    /* Modal */
    .modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.78);z-index:999;align-items:center;justify-content:center;padding:1rem;}
    .modal-bg.show{display:flex;}
    .modal{background:var(--surface);border:1px solid rgba(157,78,221,0.25);border-radius:14px;width:100%;max-width:600px;max-height:93vh;overflow-y:auto;}
    .modal-hd{display:flex;align-items:center;justify-content:space-between;padding:1.2rem 1.5rem;border-bottom:1px solid var(--border);}
    .modal-title{font-weight:700;font-size:1rem;}
    .modal-close{background:none;border:none;color:var(--muted);font-size:1.2rem;cursor:pointer;}
    .modal-close:hover{color:#fff;}
    .modal-body{padding:1.4rem 1.5rem;}
    .fg{margin-bottom:1rem;}
    label{display:block;font-size:0.73rem;color:var(--muted);margin-bottom:0.38rem;}
    label .req{color:var(--error);margin-left:2px;}
    input,select{width:100%;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:8px;color:#fff;padding:0.62rem 0.82rem;font-family:'Outfit',sans-serif;font-size:0.87rem;outline:none;transition:border 0.15s;}
    input:focus,select:focus{border-color:var(--accent);}
    select option{background:#1a1a2e;}
    .row2{display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;}
    .cb-row{display:flex;align-items:center;gap:0.6rem;padding:0.45rem 0;}
    .cb-row input[type=checkbox]{width:auto;accent-color:var(--accent);cursor:pointer;}
    .cb-row label{margin:0;font-size:0.85rem;color:#fff;cursor:pointer;}
    .hint{font-size:0.68rem;color:var(--muted);margin-top:0.28rem;}

    /* ── LOGO EDITOR ── */
    .logo-section{border:1px solid var(--border);border-radius:10px;overflow:hidden;}
    .logo-upload-bar{display:flex;align-items:center;gap:0.8rem;padding:0.75rem 1rem;background:rgba(255,255,255,0.025);border-bottom:1px solid var(--border);}
    .logo-upload-btn{display:inline-flex;align-items:center;gap:0.4rem;padding:0.45rem 1rem;background:rgba(157,78,221,0.12);border:1px solid rgba(157,78,221,0.3);border-radius:6px;color:var(--accent);font-size:0.8rem;cursor:pointer;transition:all 0.15s;flex-shrink:0;}
    .logo-upload-btn:hover{background:rgba(157,78,221,0.22);}
    .logo-upload-btn input{display:none;}
    .logo-upload-info{font-size:0.72rem;color:var(--muted);}

    /* ✅ FIX: checkerboard background in crop area to visualise transparency */
    .crop-area{
      position:relative;height:200px;overflow:hidden;cursor:grab;user-select:none;
      background-color:#888;
      background-image:
        linear-gradient(45deg,#555 25%,transparent 25%),
        linear-gradient(-45deg,#555 25%,transparent 25%),
        linear-gradient(45deg,transparent 75%,#555 75%),
        linear-gradient(-45deg,transparent 75%,#555 75%);
      background-size:16px 16px;
      background-position:0 0,0 8px,8px -8px,-8px 0px;
    }
    .crop-area:active{cursor:grabbing;}
    .crop-canvas-wrap{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;}
    #cropImg{position:absolute;transform-origin:center;cursor:grab;}
    #cropImg:active{cursor:grabbing;}
    .crop-overlay{position:absolute;inset:0;pointer-events:none;}
    .crop-grid{position:absolute;inset:0;pointer-events:none;opacity:0.2;}
    .crop-grid::before,.crop-grid::after{content:'';position:absolute;background:rgba(255,255,255,0.4);}
    .crop-grid::before{left:33.33%;top:0;width:1px;height:100%;box-shadow:33.33px 0 0 rgba(255,255,255,0.4);}
    .crop-grid::after{top:33.33%;left:0;height:1px;width:100%;box-shadow:0 33.33px 0 rgba(255,255,255,0.4);}

    .crop-controls{display:flex;align-items:center;justify-content:space-between;padding:0.7rem 1rem;background:rgba(255,255,255,0.025);gap:0.75rem;flex-wrap:wrap;}
    .crop-ctrl-group{display:flex;align-items:center;gap:0.5rem;}
    .crop-ctrl-label{font-size:0.65rem;color:var(--muted);font-family:'Space Mono',monospace;letter-spacing:1px;white-space:nowrap;}
    .crop-slider{width:90px;accent-color:var(--accent);}
    .crop-btn{padding:0.35rem 0.75rem;background:rgba(255,255,255,0.06);border:1px solid var(--border);border-radius:5px;color:var(--muted);font-size:0.75rem;cursor:pointer;transition:all 0.15s;display:flex;align-items:center;gap:0.3rem;}
    .crop-btn:hover{background:rgba(255,255,255,0.12);color:#fff;}

    /* ✅ FIX: logo preview card also uses checkerboard to show true transparency */
    .logo-preview-card{
      padding:0.6rem;display:flex;align-items:center;justify-content:center;height:60px;border-bottom:1px solid var(--border);
      background-color:#fff;
      background-image:
        linear-gradient(45deg,#e0e0e0 25%,transparent 25%),
        linear-gradient(-45deg,#e0e0e0 25%,transparent 25%),
        linear-gradient(45deg,transparent 75%,#e0e0e0 75%),
        linear-gradient(-45deg,transparent 75%,#e0e0e0 75%);
      background-size:10px 10px;
      background-position:0 0,0 5px,5px -5px,-5px 0px;
    }
    .logo-preview-card img{max-height:100%;max-width:100%;object-fit:contain;}
    .logo-preview-card .no-logo{font-size:0.7rem;color:#999;background:none;}

    /* bg toggle strip */
    .bg-toggle-strip{display:flex;align-items:center;gap:0.6rem;padding:0.5rem 1rem;background:rgba(255,255,255,0.02);border-bottom:1px solid var(--border);font-size:0.7rem;color:var(--muted);}
    .bg-swatch{width:18px;height:18px;border-radius:3px;cursor:pointer;border:2px solid transparent;transition:border-color 0.15s;flex-shrink:0;}
    .bg-swatch.active{border-color:#fff;}
    .bg-swatch.checker{
      background-color:#888;
      background-image:linear-gradient(45deg,#555 25%,transparent 25%),linear-gradient(-45deg,#555 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#555 75%),linear-gradient(-45deg,transparent 75%,#555 75%);
      background-size:8px 8px;background-position:0 0,0 4px,4px -4px,-4px 0px;
    }
    .bg-swatch.white{background:#fff;}
    .bg-swatch.black{background:#111;}
    .bg-swatch.dark{background:#1a1a2e;}

    .btn-submit{width:100%;padding:0.85rem;background:linear-gradient(135deg,var(--accent2),var(--accent));border:none;border-radius:8px;color:#fff;font-family:'Outfit',sans-serif;font-size:0.97rem;font-weight:700;cursor:pointer;margin-top:0.5rem;transition:all 0.18s;}
    .btn-submit:hover{box-shadow:0 0 24px rgba(157,78,221,0.35);}
    .btn-submit:disabled{opacity:0.5;cursor:not-allowed;}
    .form-err{color:var(--error);font-size:0.78rem;display:none;margin-bottom:0.5rem;}

    #toast{display:none;position:fixed;bottom:1.5rem;right:1.5rem;background:var(--surface);border:1px solid rgba(0,255,136,0.3);border-radius:8px;padding:0.75rem 1.2rem;font-size:0.83rem;color:var(--success);z-index:9999;box-shadow:0 8px 30px rgba(0,0,0,0.5);}

    @media(max-width:900px){.layout{grid-template-columns:1fr;}.sponsors-grid{grid-template-columns:1fr 1fr;}}
    @media(max-width:560px){.sponsors-grid{grid-template-columns:1fr;}.row2{grid-template-columns:1fr;}}
  </style>
</head>
<body>
<div class="layout">
  <%- include('../partials/admin-sidebar', { activePage:'sponsors', currentAdmin, isSuperAdmin }) %>
  <main class="main">
    <div class="page-hd">
      <div class="page-title">SPONSORS</div>
      <button class="btn-add" onclick="openModal()"><i class="bi bi-plus-circle-fill"></i> Add Sponsor</button>
    </div>
    <p class="page-sub">Sponsor logos appear on tickets &amp; PDFs. Logos are saved with transparent backgrounds.</p>

    <%
      const tiers = ['all','title','gold','silver','partner'];
      const tl    = {all:'All',title:'Title',gold:'Gold',silver:'Silver',partner:'Partner'};
      const tc    = {all:sponsors.length};
      ['title','gold','silver','partner'].forEach(t=>{ tc[t]=sponsors.filter(s=>s.tier===t).length; });
    %>
    <div class="tier-tabs">
      <% tiers.forEach(function(t){ %>
      <button class="tier-tab <%= t==='all'?'active':'' %>" onclick="filterTier('<%= t %>',this)">
        <%= tl[t] %><span class="cnt"><%= tc[t] %></span>
      </button>
      <% }); %>
    </div>

    <% if(sponsors.length===0){ %>
    <div class="empty"><i class="bi bi-building"></i><p>No sponsors yet. Add your first sponsor!</p></div>
    <% } else { %>
    <div class="sponsors-grid" id="sGrid">
      <% sponsors.forEach(function(s){ %>
      <div class="sponsor-card <%= s.isActive?'':'inactive' %>" data-tier="<%= s.tier %>">
        <div class="sc-logo">
          <% if(s.logo){ %><img src="<%= s.logo %>" alt="<%= s.name %>"/><% }else{ %><div style="color:#999;font-size:0.8rem;">No logo</div><% } %>
          <span class="sc-tier t-<%= s.tier %>"><%= s.tier %></span>
        </div>
        <div class="sc-body">
          <div class="sc-name"><%= s.name %></div>
          <% if(s.website){ %><div class="sc-website"><i class="bi bi-link-45deg"></i> <%= s.website %></div><% } %>
          <div class="sc-badges">
            <% if(s.showOnTicket){ %><span class="sc-badge b-tk"><i class="bi bi-ticket-perforated"></i> Ticket</span><% } %>
            <% if(s.showOnSite){ %><span class="sc-badge b-site"><i class="bi bi-globe"></i> Site</span><% } %>
            <% if(s.events&&s.events.length>0){ %>
              <span class="sc-badge b-ev"><i class="bi bi-calendar-event"></i> <%= s.events.length %> event<%= s.events.length>1?'s':'' %></span>
            <% }else{ %>
              <span class="sc-badge b-ev"><i class="bi bi-calendar-event"></i> All events</span>
            <% } %>
          </div>
          <div class="sc-actions">
            <button class="sc-btn" onclick="editSponsor('<%= s._id %>')"><i class="bi bi-pencil-fill"></i> Edit</button>
            <button class="sc-btn" onclick="toggleSponsor('<%= s._id %>',this)"><i class="bi bi-<%= s.isActive?'eye-slash':'eye' %>-fill"></i> <%= s.isActive?'Hide':'Show' %></button>
            <button class="sc-btn danger" onclick="deleteSponsor('<%= s._id %>',this)"><i class="bi bi-trash-fill"></i></button>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>
  </main>
</div>

<!-- Add/Edit Modal -->
<div class="modal-bg" id="modalBg" onclick="if(event.target===this)closeModal()">
  <div class="modal">
    <div class="modal-hd">
      <div class="modal-title" id="modalTitle">Add Sponsor</div>
      <button class="modal-close" onclick="closeModal()"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="editId"/>

      <div class="row2">
        <div class="fg">
          <label>Sponsor Name <span class="req">*</span></label>
          <input type="text" id="fName" placeholder="e.g. Acme Corp"/>
        </div>
        <div class="fg">
          <label>Tier</label>
          <select id="fTier">
            <option value="partner">Partner</option>
            <option value="silver">Silver</option>
            <option value="gold">Gold</option>
            <option value="title">Title Sponsor</option>
          </select>
        </div>
      </div>
      <div class="fg">
        <label>Website / Social</label>
        <input type="text" id="fWebsite" placeholder="https://..."/>
      </div>

      <!-- ── LOGO EDITOR ── -->
      <div class="fg">
        <label>Logo <span class="req">*</span> &nbsp;<span style="font-size:0.65rem;color:var(--muted);">Upload → drag to reposition → pinch/scroll to zoom</span></label>
        <div class="logo-section">
          <!-- Upload bar -->
          <div class="logo-upload-bar">
            <label class="logo-upload-btn">
              <i class="bi bi-upload"></i> Upload Logo
              <input type="file" accept="image/*" onchange="onLogoFile(this.files[0])"/>
            </label>
            <div class="logo-upload-info" id="uploadInfo">PNG, JPG, SVG · Max 3MB · PNG recommended for transparency</div>
          </div>

          <!-- ✅ Background toggle — lets admin preview logo on different backgrounds -->
          <div class="bg-toggle-strip">
            <span>Preview bg:</span>
            <div class="bg-swatch checker active" id="bgChecker" onclick="setCropBg('checker',this)" title="Transparent (checkerboard)"></div>
            <div class="bg-swatch white" id="bgWhite" onclick="setCropBg('white',this)" title="White"></div>
            <div class="bg-swatch black" id="bgBlack" onclick="setCropBg('black',this)" title="Black"></div>
            <div class="bg-swatch dark" id="bgDark" onclick="setCropBg('dark',this)" title="Dark"></div>
            <span style="font-size:0.63rem;color:var(--muted);margin-left:0.3rem;">Logo always saved with transparent background</span>
          </div>

          <!-- Crop/move/zoom area -->
          <div class="crop-area" id="cropArea"
               onmousedown="startDrag(event)" onmousemove="doDrag(event)" onmouseup="endDrag()" onmouseleave="endDrag()"
               ontouchstart="startDragT(event)" ontouchmove="doDragT(event)" ontouchend="endDrag()"
               onwheel="onWheel(event)">
            <div class="crop-grid"></div>
            <img id="cropImg" src="" alt="" style="display:none;position:absolute;"/>
            <div id="cropPlaceholder" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#ccc;font-size:0.8rem;text-align:center;padding:1rem;">
              <div><i class="bi bi-image" style="font-size:2rem;display:block;margin-bottom:0.5rem;opacity:0.5;"></i>Upload a logo to start editing</div>
            </div>
          </div>
          <!-- Controls -->
          <div class="crop-controls">
            <div class="crop-ctrl-group">
              <span class="crop-ctrl-label">ZOOM</span>
              <input type="range" class="crop-slider" id="zoomSlider" min="0.2" max="4" step="0.05" value="1" oninput="onZoomSlider(this.value)"/>
              <span id="zoomVal" style="font-size:0.65rem;color:var(--muted);min-width:30px;">100%</span>
            </div>
            <div class="crop-ctrl-group">
              <button class="crop-btn" onclick="fitLogo()"><i class="bi bi-arrows-fullscreen"></i> Fit</button>
              <button class="crop-btn" onclick="centerLogo()"><i class="bi bi-align-center"></i> Center</button>
              <button class="crop-btn" onclick="resetLogo()"><i class="bi bi-arrow-counterclockwise"></i> Reset</button>
            </div>
          </div>
          <!-- Preview -->
          <div class="logo-preview-card" id="logoPreviewCard">
            <div class="no-logo">Preview will appear here</div>
          </div>
        </div>
        <div class="hint">Drag to reposition, scroll/pinch to zoom. Logo is saved with a <strong>transparent background</strong> — the checkerboard shows where transparency is.</div>
        <input type="hidden" id="fLogo"/>
      </div>

      <div class="fg">
        <label>Display Options</label>
        <div class="cb-row"><input type="checkbox" id="fTicket" checked/><label for="fTicket">Show on tickets &amp; PDF</label></div>
        <div class="cb-row"><input type="checkbox" id="fSite" checked/><label for="fSite">Show on website homepage</label></div>
      </div>
      <div class="fg">
        <label>Events (leave empty = all events)</label>
        <select id="fEvents" multiple style="height:110px;">
          <% events.forEach(function(ev){ %>
          <option value="<%= ev._id %>"><%= ev.name %> · <%= new Date(ev.date).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %></option>
          <% }); %>
        </select>
        <div class="hint">Ctrl/Cmd+click to select multiple. Leave unselected = all events.</div>
      </div>

      <div class="form-err" id="formErr"></div>
      <button class="btn-submit" id="submitBtn" onclick="submitForm()">
        <i class="bi bi-check-circle-fill"></i> Save Sponsor
      </button>
    </div>
  </div>
</div>

<div id="toast"></div>

<script>
const SPONSORS_DATA = <%- JSON.stringify(sponsors.map(s=>({
  _id: s._id, name: s.name, tier: s.tier, website: s.website||'',
  logo: s.logo||'', showOnTicket: s.showOnTicket, showOnSite: s.showOnSite,
  events: (s.events||[]).map(e=>e._id?e._id.toString():e.toString()),
}))) %>;

// ─── Crop/Move/Zoom state ───
let imgSrc   = '';
let posX     = 0;
let posY     = 0;
let scale    = 1;
let isDragging = false;
let lastX    = 0, lastY = 0;
let naturalW = 0, naturalH = 0;

const cropArea  = document.getElementById('cropArea');
const cropImg   = document.getElementById('cropImg');
const zoomSl    = document.getElementById('zoomSlider');
const zoomVal   = document.getElementById('zoomVal');
const prevCard  = document.getElementById('logoPreviewCard');

function applyTransform() {
  const aW = cropArea.offsetWidth;
  const aH = cropArea.offsetHeight;
  const dispW = naturalW * scale;
  const dispH = naturalH * scale;
  cropImg.style.width  = dispW + 'px';
  cropImg.style.height = dispH + 'px';
  cropImg.style.left   = (aW/2 - dispW/2 + posX) + 'px';
  cropImg.style.top    = (aH/2 - dispH/2 + posY) + 'px';
  zoomSl.value = scale;
  zoomVal.textContent = Math.round(scale * 100) + '%';
}

// ✅ KEY FIX: renderPreview() — NO fillRect with white.
// Canvas default is transparent (all zeros). We draw only the image,
// preserving alpha. Saved as PNG which supports full transparency.
function renderPreview() {
  if (!imgSrc) return;
  const aW = cropArea.offsetWidth;
  const aH = cropArea.offsetHeight;
  const canvas = document.createElement('canvas');
  canvas.width  = aW;
  canvas.height = aH;
  const ctx = canvas.getContext('2d');

  // ✅ DO NOT fill background — canvas starts fully transparent
  // ctx.fillStyle = '#ffffff';   ← THIS WAS THE BUG — REMOVED
  // ctx.fillRect(0, 0, aW, aH); ← THIS TOO — REMOVED

  const img = new Image();
  img.onload = () => {
    const dispW = naturalW * scale;
    const dispH = naturalH * scale;
    const drawX = aW/2 - dispW/2 + posX;
    const drawY = aH/2 - dispH/2 + posY;
    ctx.drawImage(img, drawX, drawY, dispW, dispH);

    // ✅ Save as PNG (not JPEG) — JPEG doesn't support transparency
    const dataUrl = canvas.toDataURL('image/png');
    document.getElementById('fLogo').value = dataUrl;

    // Preview card shows the transparent PNG over its checkerboard bg
    prevCard.innerHTML = `<img src="${dataUrl}" style="max-height:52px;max-width:100%;object-fit:contain;"/>`;
  };
  img.src = imgSrc;
}

// ✅ Background toggle for crop area — purely visual, doesn't affect saved output
const CHECKER_BG = `background-color:#888;background-image:linear-gradient(45deg,#555 25%,transparent 25%),linear-gradient(-45deg,#555 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#555 75%),linear-gradient(-45deg,transparent 75%,#555 75%);background-size:16px 16px;background-position:0 0,0 8px,8px -8px,-8px 0px;`;
function setCropBg(type, btn) {
  document.querySelectorAll('.bg-swatch').forEach(s => s.classList.remove('active'));
  btn.classList.add('active');
  const area = document.getElementById('cropArea');
  if (type === 'checker') {
    area.style.cssText = area.style.cssText.replace(/background[^;]+;/g,'');
    area.style.background = '';
    area.setAttribute('style', CHECKER_BG + (area.style.cssText||''));
  } else if (type === 'white') {
    area.style.background = '#fff';
  } else if (type === 'black') {
    area.style.background = '#000';
  } else if (type === 'dark') {
    area.style.background = '#0B0B0F';
  }
}

function onLogoFile(file) {
  if (!file) return;
  if (file.size > 3 * 1024 * 1024) { showToast('Image too large (max 3MB)', true); return; }
  const reader = new FileReader();
  reader.onload = e => {
    imgSrc = e.target.result;
    const img = new Image();
    img.onload = () => {
      naturalW = img.width;
      naturalH = img.height;
      cropImg.src = imgSrc;
      cropImg.style.display = 'block';
      document.getElementById('cropPlaceholder').style.display = 'none';
      document.getElementById('uploadInfo').textContent = `${file.name} · ${Math.round(file.size/1024)}KB · ${file.type}`;
      fitLogo();
    };
    img.src = imgSrc;
  };
  reader.readAsDataURL(file);
}

function fitLogo() {
  if (!naturalW) return;
  const aW = cropArea.offsetWidth;
  const aH = cropArea.offsetHeight;
  const fitScale = Math.min(aW / naturalW, aH / naturalH) * 0.85;
  scale = fitScale;
  posX = 0; posY = 0;
  applyTransform();
  setTimeout(renderPreview, 50);
}

function centerLogo() {
  posX = 0; posY = 0;
  applyTransform();
  setTimeout(renderPreview, 50);
}

function resetLogo() {
  scale = 1; posX = 0; posY = 0;
  applyTransform();
  setTimeout(renderPreview, 50);
}

function onZoomSlider(v) {
  scale = parseFloat(v);
  applyTransform();
  clearTimeout(window._rzTimer);
  window._rzTimer = setTimeout(renderPreview, 120);
}

function onWheel(e) {
  if (!imgSrc) return;
  e.preventDefault();
  const delta = e.deltaY > 0 ? -0.07 : 0.07;
  scale = Math.max(0.1, Math.min(6, scale + delta));
  applyTransform();
  clearTimeout(window._wzTimer);
  window._wzTimer = setTimeout(renderPreview, 120);
}

function startDrag(e) {
  if (!imgSrc) return;
  isDragging = true; lastX = e.clientX; lastY = e.clientY;
}
function doDrag(e) {
  if (!isDragging) return;
  posX += e.clientX - lastX; posY += e.clientY - lastY;
  lastX = e.clientX; lastY = e.clientY;
  applyTransform();
  clearTimeout(window._dmTimer);
  window._dmTimer = setTimeout(renderPreview, 120);
}
function endDrag() { if(isDragging){ isDragging=false; renderPreview(); } }

// Touch drag
let lastTX=0,lastTY=0,lastTDist=0;
function startDragT(e) {
  if (!imgSrc) return;
  if (e.touches.length===1){ isDragging=true; lastTX=e.touches[0].clientX; lastTY=e.touches[0].clientY; }
  if (e.touches.length===2){
    lastTDist=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);
  }
}
function doDragT(e) {
  e.preventDefault();
  if (e.touches.length===1 && isDragging){
    posX+=e.touches[0].clientX-lastTX; posY+=e.touches[0].clientY-lastTY;
    lastTX=e.touches[0].clientX; lastTY=e.touches[0].clientY;
    applyTransform();
    clearTimeout(window._tdTimer); window._tdTimer=setTimeout(renderPreview,120);
  }
  if (e.touches.length===2){
    const d=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);
    if (lastTDist){ scale=Math.max(0.1,Math.min(6,scale*(d/lastTDist))); applyTransform(); }
    lastTDist=d;
    clearTimeout(window._tpTimer); window._tpTimer=setTimeout(renderPreview,120);
  }
}

// ─── Modal open/close ───
function openModal() {
  document.getElementById('editId').value = '';
  document.getElementById('modalTitle').textContent = 'Add Sponsor';
  document.getElementById('fName').value = '';
  document.getElementById('fTier').value = 'partner';
  document.getElementById('fWebsite').value = '';
  document.getElementById('fLogo').value = '';
  document.getElementById('fTicket').checked = true;
  document.getElementById('fSite').checked   = true;
  document.getElementById('formErr').style.display = 'none';
  Array.from(document.getElementById('fEvents').options).forEach(o=>o.selected=false);
  // Reset crop
  imgSrc=''; naturalW=0; naturalH=0; scale=1; posX=0; posY=0;
  cropImg.src=''; cropImg.style.display='none';
  document.getElementById('cropPlaceholder').style.display='flex';
  document.getElementById('uploadInfo').textContent='PNG, JPG, SVG · Max 3MB · PNG recommended for transparency';
  prevCard.innerHTML='<div class="no-logo">Preview will appear here</div>';
  document.getElementById('modalBg').classList.add('show');
}

function closeModal() { document.getElementById('modalBg').classList.remove('show'); }

function editSponsor(id) {
  const s = SPONSORS_DATA.find(x=>x._id.toString()===id.toString());
  if (!s) return;
  document.getElementById('editId').value = s._id;
  document.getElementById('modalTitle').textContent = 'Edit Sponsor';
  document.getElementById('fName').value    = s.name;
  document.getElementById('fTier').value    = s.tier;
  document.getElementById('fWebsite').value = s.website;
  document.getElementById('fLogo').value    = s.logo;
  document.getElementById('fTicket').checked = s.showOnTicket;
  document.getElementById('fSite').checked   = s.showOnSite;
  document.getElementById('formErr').style.display = 'none';
  Array.from(document.getElementById('fEvents').options).forEach(o=>{ o.selected=s.events.includes(o.value); });

  // Load existing logo into crop editor
  if (s.logo) {
    imgSrc = s.logo;
    const img = new Image();
    img.onload = () => {
      naturalW = img.width; naturalH = img.height;
      cropImg.src = imgSrc; cropImg.style.display = 'block';
      document.getElementById('cropPlaceholder').style.display = 'none';
      document.getElementById('uploadInfo').textContent = 'Existing logo loaded — drag to reposition';
      fitLogo();
    };
    // ✅ Handle CORS for existing logos so canvas can read them
    img.crossOrigin = 'anonymous';
    img.src = imgSrc;
    prevCard.innerHTML = `<img src="${s.logo}" style="max-height:52px;max-width:100%;object-fit:contain;"/>`;
  } else {
    imgSrc=''; naturalW=0; naturalH=0;
    cropImg.src=''; cropImg.style.display='none';
    document.getElementById('cropPlaceholder').style.display='flex';
  }
  document.getElementById('modalBg').classList.add('show');
}

async function submitForm() {
  const id      = document.getElementById('editId').value;
  const name    = document.getElementById('fName').value.trim();
  const logo    = document.getElementById('fLogo').value;
  const tier    = document.getElementById('fTier').value;
  const website = document.getElementById('fWebsite').value.trim();
  const showOnTicket = document.getElementById('fTicket').checked;
  const showOnSite   = document.getElementById('fSite').checked;
  const evIds   = Array.from(document.getElementById('fEvents').selectedOptions).map(o=>o.value);
  const errEl   = document.getElementById('formErr');
  errEl.style.display = 'none';

  if (!name) { errEl.textContent='Sponsor name is required.'; errEl.style.display='block'; return; }
  if (!logo)  { errEl.textContent='Please upload and crop a logo.'; errEl.style.display='block'; return; }

  const btn = document.getElementById('submitBtn');
  btn.disabled=true; btn.innerHTML='<i class="bi bi-hourglass-split"></i> Saving...';

  const url  = id ? `/admin/sponsors/${id}/edit` : '/admin/sponsors';
  const body = JSON.stringify({ name, logo, tier, website, showOnTicket, showOnSite, events: evIds });

  try {
    const r    = await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body});
    const data = await r.json();
    if (data.success) { showToast(id?'Sponsor updated!':'Sponsor added!'); setTimeout(()=>location.reload(),700); }
    else { errEl.textContent=data.message||'Error.'; errEl.style.display='block'; btn.disabled=false; btn.innerHTML='<i class="bi bi-check-circle-fill"></i> Save Sponsor'; }
  } catch(e) {
    errEl.textContent='Network error.'; errEl.style.display='block';
    btn.disabled=false; btn.innerHTML='<i class="bi bi-check-circle-fill"></i> Save Sponsor';
  }
}

async function toggleSponsor(id) {
  const r = await fetch(`/admin/sponsors/${id}/toggle`,{method:'POST'});
  const d = await r.json();
  if (d.success) { showToast('Updated!'); setTimeout(()=>location.reload(),500); }
}

async function deleteSponsor(id, btn) {
  if (!confirm('Delete this sponsor?')) return;
  const r = await fetch(`/admin/sponsors/${id}/delete`,{method:'POST'});
  const d = await r.json();
  if (d.success) { showToast('Deleted.'); btn.closest('.sponsor-card').remove(); }
}

function filterTier(tier, btn) {
  document.querySelectorAll('.tier-tab').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.sponsor-card').forEach(c=>{
    c.style.display=(tier==='all'||c.dataset.tier===tier)?'':'none';
  });
}

function showToast(msg,isErr=false) {
  const el=document.getElementById('toast');
  el.textContent=msg;
  el.style.borderColor=isErr?'rgba(255,68,68,0.4)':'rgba(0,255,136,0.3)';
  el.style.color=isErr?'var(--error)':'var(--success)';
  el.style.display='block';
  setTimeout(()=>el.style.display='none',2500);
}
</script>
</body>
