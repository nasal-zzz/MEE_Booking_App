<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#0B0B0F;--surface:#14141C;--border:rgba(255,255,255,0.08);--accent:#6A0DAD;--text:#fff;--muted:#B3B3B3;--success:#00FF88;--error:#FF4444;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;}
    .admin-layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh;}
    .sidebar{background:var(--surface);border-right:1px solid var(--border);padding:1.5rem 1rem;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:0.3rem;z-index:10;overflow-y:auto;}
    .s-logo{display:block;padding:0 0.5rem 1.2rem;border-bottom:1px solid var(--border);margin-bottom:0.8rem;}
    .s-section{font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:2px;color:var(--muted);padding:0.5rem;margin-top:0.5rem;}
    .s-link{display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--muted);text-decoration:none;border-radius:6px;font-size:0.85rem;transition:all 0.15s;border:1px solid transparent;}
    .s-link:hover,.s-link.active{background:rgba(106,13,173,0.07);border-color:rgba(106,13,173,0.15);color:#fff;}
    .s-link i{color:var(--accent);width:18px;}
    .s-logout{margin-top:auto;display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--error);text-decoration:none;border-radius:6px;font-size:0.85rem;border:1px solid transparent;}
    .s-logout:hover{background:rgba(255,92,92,0.08);}
    .main{padding:2rem;position:relative;z-index:1;overflow-x:hidden;}
    .page-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:1.5rem;}
    .page-title{font-family:'Poppins',sans-serif;font-size:2rem;letter-spacing:2px;}
    /* Buttons */
    .reminder-btn{display:inline-flex;align-items:center;gap:0.5rem;padding:0.6rem 1.2rem;background:rgba(245,200,66,0.1);border:1px solid rgba(245,200,66,0.35);border-radius:7px;color:#f5c842;font-size:0.82rem;font-weight:700;cursor:pointer;font-family:inherit;transition:all 0.15s;}
    .reminder-btn:hover{background:rgba(245,200,66,0.2);}
    /* Stats bar */
    .stats-bar{display:flex;gap:0.7rem;flex-wrap:wrap;margin-bottom:1.5rem;}
    .stat-pill{display:flex;align-items:center;gap:0.5rem;padding:0.45rem 0.9rem;border-radius:20px;font-size:0.78rem;font-weight:700;cursor:pointer;border:1px solid transparent;transition:all 0.15s;}
    .sp-all{background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:#fff;}
    .sp-all.active,.sp-all:hover{background:rgba(255,255,255,0.1);border-color:rgba(255,255,255,0.2);}
    .sp-paid{background:rgba(0,255,136,0.06);border-color:rgba(0,255,136,0.2);color:#00FF88;}
    .sp-paid.active,.sp-paid:hover{background:rgba(0,255,136,0.12);}
    .sp-pending{background:rgba(245,200,66,0.06);border-color:rgba(245,200,66,0.25);color:#f5c842;}
    .sp-pending.active,.sp-pending:hover{background:rgba(245,200,66,0.14);}
    .sp-failed{background:rgba(255,68,68,0.06);border-color:rgba(255,68,68,0.25);color:#FF4444;}
    .sp-failed.active,.sp-failed:hover{background:rgba(255,68,68,0.12);}
    /* Table */
    .table-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden;}
    .search-row{display:flex;gap:0.8rem;padding:1rem 1.5rem;border-bottom:1px solid var(--border);}
    .search-input{flex:1;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:6px;color:var(--text);padding:0.6rem 0.9rem;font-family:'Outfit',sans-serif;font-size:0.88rem;outline:none;}
    .search-input:focus{border-color:var(--accent);}
    table{width:100%;border-collapse:collapse;}
    th{font-family:'Space Mono',monospace;font-size:0.54rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;padding:0.8rem 1rem;text-align:left;border-bottom:1px solid var(--border);}
    td{padding:0.8rem 1rem;border-bottom:1px solid rgba(255,255,255,0.04);font-size:0.82rem;vertical-align:middle;}
    tr:last-child td{border-bottom:none;}
    tr:hover td{background:rgba(255,255,255,0.015);}
    .ref{font-family:'Space Mono',monospace;font-size:0.68rem;color:var(--accent);}
    /* Badges */
    .badge{font-family:'Space Mono',monospace;font-size:0.54rem;letter-spacing:1px;padding:0.2rem 0.6rem;border-radius:10px;}
    .b-paid{background:rgba(0,255,136,0.08);border:1px solid rgba(0,255,136,0.25);color:#00FF88;}
    .b-pending{background:rgba(245,200,66,0.08);border:1px solid rgba(245,200,66,0.3);color:#f5c842;}
    .b-failed{background:rgba(255,68,68,0.08);border:1px solid rgba(255,68,68,0.3);color:#FF4444;}
    /* Notified badge */
    .notified-badge{display:inline-flex;align-items:center;gap:0.25rem;font-family:'Space Mono',monospace;font-size:0.56rem;letter-spacing:0.5px;padding:0.18rem 0.5rem;border-radius:8px;background:rgba(0,200,255,0.08);border:1px solid rgba(0,200,255,0.22);color:#00c8ff;margin-top:4px;}
    .empty-row{text-align:center;padding:2.5rem;color:#444;}
    @media(max-width:900px){.admin-layout{grid-template-columns:1fr;}.sidebar{display:none;}}
    @keyframes spin{to{transform:rotate(360deg)}}
    /* Export */
    .export-btn{display:inline-flex;align-items:center;gap:0.5rem;padding:0.6rem 1.2rem;background:rgba(0,255,136,0.07);border:1px solid rgba(0,255,136,0.28);border-radius:7px;color:#00FF88;font-family:'Space Mono',monospace;font-size:0.72rem;font-weight:700;cursor:pointer;transition:all 0.2s;letter-spacing:0.5px;white-space:nowrap;}
    .export-btn:hover{background:rgba(0,255,136,0.15);border-color:rgba(0,255,136,0.5);}
    .ex-sub{font-size:0.72rem;color:#555;font-family:'Space Mono',monospace;margin-bottom:1rem;}
    .ex-sec{margin-bottom:1rem;}
    .ex-sec-title{font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:2px;color:#555;margin-bottom:0.5rem;text-transform:uppercase;}
    .fields-grid{display:grid;grid-template-columns:1fr 1fr;gap:0.4rem;}
    .field-check{display:flex;align-items:center;gap:0.45rem;padding:0.42rem 0.65rem;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:6px;cursor:pointer;transition:all 0.15s;user-select:none;}
    .field-check:hover{border-color:rgba(157,78,221,0.3);background:rgba(157,78,221,0.05);}
    .field-check.selected{border-color:rgba(157,78,221,0.4);background:rgba(157,78,221,0.09);}
    .field-check input[type=checkbox]{accent-color:#9D4EDD;width:13px;height:13px;cursor:pointer;flex-shrink:0;}
    .field-check span{font-size:0.76rem;color:#ccc;}
    .opt-pills{display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.8rem;}
    .opt-pill{display:inline-flex;align-items:center;gap:0.3rem;padding:0.38rem 0.8rem;border-radius:20px;font-size:0.7rem;font-weight:700;cursor:pointer;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04);color:#B3B3B3;font-family:'Space Mono',monospace;transition:all 0.15s;}
    .opt-pill.active{border-color:rgba(157,78,221,0.45);background:rgba(157,78,221,0.12);color:#c084fc;}
    .sel-links{display:flex;gap:0.5rem;margin-bottom:0.55rem;}
    .lnk{background:none;border:none;color:#9D4EDD;font-size:0.7rem;font-family:'Space Mono',monospace;cursor:pointer;text-decoration:underline;padding:0;}
    .ex-footer{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;margin-top:1rem;}
    .ex-count{font-size:0.7rem;color:#555;font-family:'Space Mono',monospace;}
    .btn-do-ex{display:inline-flex;align-items:center;gap:0.45rem;padding:0.55rem 1.3rem;background:rgba(0,255,136,0.09);border:1px solid rgba(0,255,136,0.38);border-radius:7px;color:#00FF88;font-family:'Space Mono',monospace;font-size:0.76rem;font-weight:700;cursor:pointer;transition:all 0.2s;}
    .btn-do-ex:hover{background:rgba(0,255,136,0.17);}
    .btn-do-ex:disabled{opacity:0.4;cursor:not-allowed;}

    /* ── Reminder Modal ── */
    .rmodal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.82);backdrop-filter:blur(4px);z-index:2000;align-items:center;justify-content:center;padding:1rem;}
    .rmodal-bg.open{display:flex;}
    .rmodal{background:#14141C;border:1px solid rgba(255,255,255,0.08);border-radius:14px;width:100%;max-width:640px;max-height:88vh;display:flex;flex-direction:column;position:relative;overflow:hidden;}
    .rmodal-head{padding:1.4rem 1.6rem 1rem;border-bottom:1px solid rgba(255,255,255,0.07);flex-shrink:0;}
    .rmodal-head h3{font-family:'Poppins',sans-serif;font-size:1rem;letter-spacing:1px;margin-bottom:0.2rem;}
    .rmodal-head p{font-size:0.72rem;color:#666;font-family:'Space Mono',monospace;}
    .rmodal-close{position:absolute;top:1rem;right:1rem;background:none;border:none;color:#666;cursor:pointer;font-size:1rem;}
    .rmodal-close:hover{color:#fff;}
    .rmodal-toolbar{display:flex;align-items:center;gap:0.7rem;padding:0.8rem 1.6rem;border-bottom:1px solid rgba(255,255,255,0.05);flex-shrink:0;flex-wrap:wrap;}
    .rmodal-search{flex:1;min-width:140px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:6px;color:#fff;padding:0.45rem 0.8rem;font-family:'Outfit',sans-serif;font-size:0.82rem;outline:none;}
    .rmodal-search:focus{border-color:#9D4EDD;}
    .rm-sel-lnk{background:none;border:none;color:#9D4EDD;font-size:0.68rem;font-family:'Space Mono',monospace;cursor:pointer;text-decoration:underline;padding:0;white-space:nowrap;}
    .rmodal-body{overflow-y:auto;flex:1;padding:0.5rem 0;}
    .ru-row{display:flex;align-items:center;gap:0.8rem;padding:0.7rem 1.6rem;border-bottom:1px solid rgba(255,255,255,0.03);cursor:pointer;transition:background 0.12s;}
    .ru-row:hover{background:rgba(255,255,255,0.02);}
    .ru-row:last-child{border-bottom:none;}
    .ru-check{width:16px;height:16px;accent-color:#9D4EDD;cursor:pointer;flex-shrink:0;}
    .ru-info{flex:1;min-width:0;}
    .ru-name{font-size:0.85rem;font-weight:600;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .ru-phone{font-family:'Space Mono',monospace;font-size:0.68rem;color:#777;margin-top:1px;}
    .ru-meta{display:flex;gap:0.5rem;align-items:center;flex-shrink:0;flex-wrap:wrap;}
    .ru-pill{font-family:'Space Mono',monospace;font-size:0.58rem;padding:0.15rem 0.5rem;border-radius:8px;white-space:nowrap;}
    .ru-bcount{background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.25);color:#c084fc;}
    .ru-notified{background:rgba(0,200,255,0.08);border:1px solid rgba(0,200,255,0.22);color:#00c8ff;}
    .ru-unsent{background:rgba(255,200,0,0.07);border:1px solid rgba(255,200,0,0.2);color:#f5c842;}
    .rmodal-foot{padding:1rem 1.6rem;border-top:1px solid rgba(255,255,255,0.07);display:flex;align-items:center;justify-content:space-between;gap:0.8rem;flex-shrink:0;flex-wrap:wrap;}
    .rfoot-info{font-family:'Space Mono',monospace;font-size:0.68rem;color:#555;}
    .rm-loading{text-align:center;padding:2.5rem;color:#444;font-size:0.82rem;}
    .rm-loading i{font-size:1.8rem;display:block;margin-bottom:0.7rem;opacity:0.3;}
    .btn-send-rm{display:inline-flex;align-items:center;gap:0.45rem;padding:0.55rem 1.3rem;background:rgba(245,200,66,0.1);border:1px solid rgba(245,200,66,0.38);border-radius:7px;color:#f5c842;font-family:'Space Mono',monospace;font-size:0.75rem;font-weight:700;cursor:pointer;transition:all 0.2s;}
    .btn-send-rm:hover{background:rgba(245,200,66,0.2);}
    .btn-send-rm:disabled{opacity:0.4;cursor:not-allowed;}
  
    /* Resend button */
.resend-btn{display:inline-flex;align-items:center;gap:0.5rem;padding:0.6rem 1.2rem;background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.35);border-radius:7px;color:#c084fc;font-size:0.82rem;font-weight:700;cursor:pointer;font-family:inherit;transition:all 0.15s;}
.resend-btn:hover{background:rgba(157,78,221,0.2);}

/* Resend Modal — reuses rmodal pattern */
.rsmodal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.82);backdrop-filter:blur(4px);z-index:2100;align-items:center;justify-content:center;padding:1rem;}
.rsmodal-bg.open{display:flex;}
.rsmodal{background:#14141C;border:1px solid rgba(255,255,255,0.08);border-radius:14px;width:100%;max-width:700px;max-height:88vh;display:flex;flex-direction:column;position:relative;overflow:hidden;}
.rsmodal-head{padding:1.4rem 1.6rem 1rem;border-bottom:1px solid rgba(255,255,255,0.07);flex-shrink:0;}
.rsmodal-head h3{font-family:'Poppins',sans-serif;font-size:1rem;letter-spacing:1px;margin-bottom:0.2rem;}
.rsmodal-head p{font-size:0.72rem;color:#666;font-family:'Space Mono',monospace;}
.rsmodal-close{position:absolute;top:1rem;right:1rem;background:none;border:none;color:#666;cursor:pointer;font-size:1rem;}
.rsmodal-close:hover{color:#fff;}
.rsmodal-toolbar{display:flex;align-items:center;gap:0.7rem;padding:0.8rem 1.6rem;border-bottom:1px solid rgba(255,255,255,0.05);flex-shrink:0;flex-wrap:wrap;}
.rsmodal-search{flex:1;min-width:140px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:6px;color:#fff;padding:0.45rem 0.8rem;font-family:'Outfit',sans-serif;font-size:0.82rem;outline:none;}
.rsmodal-search:focus{border-color:#9D4EDD;}
.rsmodal-body{overflow-y:auto;flex:1;padding:0.5rem 0;}
.rs-row{display:flex;align-items:center;gap:0.8rem;padding:0.7rem 1.6rem;border-bottom:1px solid rgba(255,255,255,0.03);cursor:pointer;transition:background 0.12s;}
.rs-row:hover{background:rgba(255,255,255,0.02);}
.rs-row:last-child{border-bottom:none;}
.rs-check{width:16px;height:16px;accent-color:#9D4EDD;cursor:pointer;flex-shrink:0;}
.rs-info{flex:1;min-width:0;}
.rs-name{font-size:0.85rem;font-weight:600;color:#fff;}
.rs-sub{font-family:'Space Mono',monospace;font-size:0.65rem;color:#777;margin-top:2px;}
.rs-meta{display:flex;gap:0.4rem;align-items:center;flex-shrink:0;flex-wrap:wrap;}
.rs-pill{font-family:'Space Mono',monospace;font-size:0.56rem;padding:0.15rem 0.5rem;border-radius:8px;white-space:nowrap;}
.rs-pill-ref{background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.25);color:#c084fc;}
.rs-pill-sent{background:rgba(0,200,255,0.08);border:1px solid rgba(0,200,255,0.22);color:#00c8ff;}
.rsmodal-foot{padding:1rem 1.6rem;border-top:1px solid rgba(255,255,255,0.07);display:flex;align-items:center;justify-content:space-between;gap:0.8rem;flex-shrink:0;flex-wrap:wrap;}
.rsfoot-info{font-family:'Space Mono',monospace;font-size:0.68rem;color:#555;}
.btn-send-rs{display:inline-flex;align-items:center;gap:0.45rem;padding:0.55rem 1.3rem;background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.38);border-radius:7px;color:#c084fc;font-family:'Space Mono',monospace;font-size:0.75rem;font-weight:700;cursor:pointer;transition:all 0.2s;}
.btn-send-rs:hover{background:rgba(157,78,221,0.2);}
.btn-send-rs:disabled{opacity:0.4;cursor:not-allowed;}
.rs-warn{background:rgba(255,68,68,0.06);border:1px solid rgba(255,68,68,0.2);border-radius:8px;padding:0.6rem 1rem;margin:0.5rem 1.6rem;font-size:0.72rem;color:#FF6B6B;font-family:'Space Mono',monospace;display:none;}
.rs-warn.show{display:block;}
  
  </style>
</head>
<body>
<div class="admin-layout">
    <%- include('../partials/admin-sidebar', { activePage: 'bookings' }) %>

  <main class="main">
    <div class="page-header">
      <div class="page-title">ALL BOOKINGS (<%= bookings.length %>)</div>
      <div style="display:flex;gap:0.6rem;align-items:center;flex-wrap:wrap;">
        <button class="export-btn" onclick="openExportModal()">
          <i class="bi bi-file-earmark-spreadsheet-fill"></i> Export Excel
        </button>
        <button class="reminder-btn" onclick="openReminderModal()">
          <i class="bi bi-whatsapp"></i> Send Event Reminders
        </button>
        <button class="resend-btn" onclick="openResendModal()">
  <i class="bi bi-arrow-repeat"></i> Resend Confirmation
</button>
      </div>
    </div>

    <!-- Status filter pills -->
    <div class="stats-bar">
      <div class="stat-pill sp-all active" onclick="filterStatus('all',this)">
        <i class="bi bi-list-ul"></i> All <span style="opacity:0.6;font-size:0.7rem;margin-left:2px;" id="cnt-all">(<%= bookings.length %>)</span>
      </div>
      <div class="stat-pill sp-paid" onclick="filterStatus('paid',this)">
        <i class="bi bi-check-circle-fill"></i> Paid <span style="opacity:0.6;font-size:0.7rem;margin-left:2px;" id="cnt-paid">(<%= bookings.filter(b=>b.paymentStatus==='paid').length %>)</span>
      </div>
      <div class="stat-pill sp-pending" onclick="filterStatus('pending',this)">
        <i class="bi bi-clock-fill"></i> Pending <span style="opacity:0.6;font-size:0.7rem;margin-left:2px;" id="cnt-pending">(<%= bookings.filter(b=>b.paymentStatus==='pending').length %>)</span>
      </div>
      <div class="stat-pill sp-failed" onclick="filterStatus('failed',this)">
        <i class="bi bi-x-circle-fill"></i> Failed <span style="opacity:0.6;font-size:0.7rem;margin-left:2px;" id="cnt-failed">(<%= bookings.filter(b=>b.paymentStatus==='failed').length %>)</span>
      </div>
    </div>

    <div class="table-card">
      <div class="search-row">
        <input class="search-input" id="searchInput" placeholder="Search by name, phone, ref, event…" oninput="applyFilters()"/>
      </div>
      <div style="overflow-x:auto;">
      <table id="bookingsTable">
        <thead><tr>
          <th>Ref</th><th>User</th><th>Event</th><th>Tier</th><th>Qty</th><th>Subtotal</th><th>Discount</th><th>Fee</th><th>Total</th><th>Date</th><th>Status</th><th>Reminder</th>
        </tr></thead>
        <tbody>
          <% bookings.forEach(function(b) { %>
          <tr data-status="<%= b.paymentStatus %>">
            <td><div class="ref"><%= b.bookingRef %></div></td>
            <td>
              <div style="font-weight:600;color:#fff;"><%= b.user ? b.user.firstName+' '+(b.user.lastName||'') : 'Unknown' %></div>
              <div style="font-size:0.7rem;color:var(--muted);font-family:'Space Mono',monospace;"><%= b.user ? b.user.phone : '' %></div>
            </td>
            <td>
              <div style="font-weight:500;"><%= b.event ? b.event.name : 'N/A' %></div>
              <div style="font-size:0.7rem;color:var(--muted);"><%= b.event ? new Date(b.event.date).toLocaleDateString('en-IN') : '' %></div>
            </td>
            <td style="font-size:0.78rem;"><%= b.ticketType %></td>
            <td style="text-align:center;"><%= b.quantity %></td>
            <td style="color:var(--muted);">₹<%= (b.subtotal||0).toLocaleString('en-IN') %></td>
            <td>
              <% if(b.discount>0){ %><span style="color:#00FF88;font-size:0.78rem;">-₹<%= b.discount.toLocaleString('en-IN') %></span><% if(b.couponCode){ %><div style="font-family:'Space Mono',monospace;font-size:0.58rem;color:#555;margin-top:1px;"><%= b.couponCode %></div><% } %>
              <% }else{ %><span style="color:#333;">—</span><% } %>
            </td>
            <td style="color:var(--muted);font-size:0.78rem;">₹<%= (b.convenienceFee||0).toLocaleString('en-IN') %></td>
            <td style="color:var(--accent);font-weight:700;">₹<%= (b.totalAmount||0).toLocaleString('en-IN') %></td>
            <td style="color:var(--muted);font-size:0.72rem;white-space:nowrap;"><%= new Date(b.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %></td>
            <td>
              <span class="badge b-<%= b.paymentStatus %>"><%= b.paymentStatus.toUpperCase() %></span>
              <% if(b.paymentMethod === 'cash'){ %>
              <span style="display:inline-block;margin-top:3px;font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:1px;background:rgba(0,200,80,0.1);border:1px solid rgba(0,200,80,0.3);color:#00c850;padding:0.1rem 0.4rem;border-radius:4px;">CASH</span>
              <% if(b.soldBy){ %><div style="font-size:0.6rem;color:#555;margin-top:2px;">by <%= b.soldBy %></div><% } %>
              <% } %>
            </td>
            <td>
              <% if(b.paymentStatus === 'paid'){ %>
                <% if(b.reminder24SentAt){ %>
                  <div class="notified-badge"><i class="bi bi-check2-circle"></i> Reminded</div>
                  <div style="font-size:0.58rem;color:#444;margin-top:3px;font-family:'Space Mono',monospace;"><%= new Date(b.reminder24SentAt).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %></div>
                <% } else { %>
                  <span style="font-size:0.68rem;color:#444;font-family:'Space Mono',monospace;">—</span>
                <% } %>
              <% } %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
      <div id="emptyMsg" style="display:none;" class="empty-row">
        <i class="bi bi-inbox" style="font-size:2rem;display:block;margin-bottom:0.5rem;"></i>No bookings match this filter.
      </div>
    </div>
  </main>
</div>

<!-- Export Modal -->
<div class="modal-bg" id="exportModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.78);z-index:1000;align-items:center;justify-content:center;padding:1rem;">
  <div style="background:#14141C;border:1px solid rgba(255,255,255,0.08);border-radius:12px;width:100%;max-width:520px;padding:1.5rem;position:relative;max-height:90vh;overflow-y:auto;">
    <button onclick="closeExportModal()" style="position:absolute;top:1rem;right:1rem;background:none;border:none;color:#B3B3B3;cursor:pointer;font-size:1rem;"><i class="bi bi-x-lg"></i></button>
    <h3 style="font-family:'Poppins',sans-serif;font-size:1rem;margin-bottom:0.3rem;letter-spacing:1px;"><i class="bi bi-file-earmark-spreadsheet-fill" style="color:#00FF88;margin-right:6px;"></i>EXPORT BOOKINGS</h3>
    <div class="ex-sub">Choose scope and fields for your Excel download</div>
    <div class="ex-sec">
      <div class="ex-sec-title">Which bookings to export</div>
      <div class="opt-pills">
        <div class="opt-pill active" id="ex-scope-filtered" onclick="setExScope('filtered',this)"><i class="bi bi-funnel-fill"></i> Current Filter</div>
        <div class="opt-pill" id="ex-scope-all" onclick="setExScope('all',this)"><i class="bi bi-ticket-perforated-fill"></i> All Bookings</div>
      </div>
    </div>
    <div class="ex-sec">
      <div class="ex-sec-title">Fields to include</div>
      <div class="sel-links"><button class="lnk" onclick="exSelAll(true)">Select all</button><span style="color:#333;">·</span><button class="lnk" onclick="exSelAll(false)">Clear all</button></div>
      <div class="fields-grid" id="exFieldsGrid"></div>
    </div>
    <div class="ex-footer">
      <span class="ex-count" id="exCount">—</span>
      <button class="btn-do-ex" id="exDoBtn" onclick="doExport()"><i class="bi bi-download"></i> Download Excel</button>
    </div>
  </div>
</div>

<!-- Reminder Modal -->
<div class="rmodal-bg" id="reminderModal">
  <div class="rmodal">
    <div class="rmodal-head">
      <h3><i class="bi bi-whatsapp" style="color:#25D366;margin-right:6px;"></i>SEND EVENT REMINDERS</h3>
      <p>Paid bookings grouped by phone — one WhatsApp reminder per number</p>
      <button class="rmodal-close" onclick="closeReminderModal()"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="rmodal-toolbar">
      <input class="rmodal-search" id="rmSearch" placeholder="Search name or phone…" oninput="rmFilter()"/>
      <button class="rm-sel-lnk" onclick="rmSelAll(true)">Select all</button>
      <span style="color:#333;font-size:0.7rem;">·</span>
      <button class="rm-sel-lnk" onclick="rmSelAll(false)">Clear all</button>
      <button class="rm-sel-lnk" onclick="rmSelUnnotified()" style="color:#f5c842;">Unreminded only</button>
    </div>
    <div class="rmodal-body" id="rmBody">
      <div class="rm-loading"><i class="bi bi-arrow-repeat" style="animation:spin 1s linear infinite;"></i>Loading paid bookings…</div>
    </div>
    <div class="rmodal-foot">
      <span class="rfoot-info" id="rmFootInfo">—</span>
      <button class="btn-send-rm" id="rmSendBtn" onclick="doSendReminders()" disabled>
        <i class="bi bi-send-fill"></i> Send Reminders
      </button>
    </div>
  </div>
</div>

<!-- Resend Confirmation Modal -->
<div class="rsmodal-bg" id="resendModal">
  <div class="rsmodal">
    <div class="rsmodal-head">
      <h3><i class="bi bi-arrow-repeat" style="color:#c084fc;margin-right:6px;"></i>RESEND BOOKING CONFIRMATION</h3>
      <p>Select paid bookings to resend WhatsApp confirmation with ticket PDF</p>
      <button class="rsmodal-close" onclick="closeResendModal()"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="rsmodal-toolbar">
      <input class="rsmodal-search" id="rsSearch" placeholder="Search name, ref, event, phone…" oninput="rsFilter()"/>
    </div>
    <div class="rs-warn" id="rsWarn">
      <i class="bi bi-exclamation-triangle-fill"></i> You have selected more than 5 bookings. Please confirm you want to resend to all of them.
    </div>
    <div class="rsmodal-body" id="rsBody">
      <div class="rm-loading"><i class="bi bi-arrow-repeat" style="animation:spin 1s linear infinite;"></i>Loading paid bookings…</div>
    </div>
    <div class="rsmodal-foot">
      <span class="rsfoot-info" id="rsFootInfo">—</span>
      <button class="btn-send-rs" id="rsSendBtn" onclick="doResendConfirmations()" disabled>
        <i class="bi bi-send-fill"></i> Resend Confirmation
      </button>
    </div>
  </div>
</div>

<script>
  // ── Export ──
  var EX_FIELDS = [
    { key:'ref',      label:'Booking Ref',    get:function(r){ var el=r.querySelector('.ref'); return el?el.textContent.trim():''; } },
    { key:'customer', label:'Customer Name',  get:function(r){ var el=r.querySelector('td:nth-child(2) div:first-child'); return el?el.textContent.trim():''; } },
    { key:'phone',    label:'Phone',          get:function(r){ var el=r.querySelector('td:nth-child(2) div:nth-child(2)'); return el?el.textContent.trim():''; } },
    { key:'event',    label:'Event',          get:function(r){ var el=r.querySelector('td:nth-child(3) div:first-child'); return el?el.textContent.trim():''; } },
    { key:'edate',    label:'Event Date',     get:function(r){ var el=r.querySelector('td:nth-child(3) div:nth-child(2)'); return el?el.textContent.trim():''; } },
    { key:'ticket',   label:'Ticket Type',    get:function(r){ var el=r.querySelector('td:nth-child(4)'); return el?el.textContent.trim():''; } },
    { key:'qty',      label:'Quantity',       get:function(r){ var el=r.querySelector('td:nth-child(5)'); return el?el.textContent.trim():''; } },
    { key:'subtotal', label:'Subtotal (₹)',   get:function(r){ var el=r.querySelector('td:nth-child(6)'); return el?el.textContent.replace('₹','').trim():''; } },
    { key:'discount', label:'Discount (₹)',   get:function(r){ var el=r.querySelector('td:nth-child(7) span'); return el?el.textContent.replace(/[₹\-]/g,'').trim():''; } },
    { key:'fee',      label:'Conv. Fee (₹)',  get:function(r){ var el=r.querySelector('td:nth-child(8)'); return el?el.textContent.replace('₹','').trim():''; } },
    { key:'total',    label:'Total (₹)',      get:function(r){ var el=r.querySelector('td:nth-child(9)'); return el?el.textContent.replace('₹','').trim():''; } },
    { key:'date',     label:'Booking Date',   get:function(r){ var el=r.querySelector('td:nth-child(10)'); return el?el.textContent.trim():''; } },
    { key:'status',   label:'Payment Status', get:function(r){ return r.dataset.status||''; } },
  ];
  var exDefaultOn = ['ref','customer','phone','event','ticket','qty','total','date','status'];
  var exScope = 'filtered';

  function openExportModal(){
    var grid = document.getElementById('exFieldsGrid');
    grid.innerHTML = '';
    EX_FIELDS.forEach(function(f){
      var on = exDefaultOn.indexOf(f.key) !== -1;
      var lbl = document.createElement('label');
      lbl.className = 'field-check' + (on ? ' selected' : '');
      lbl.innerHTML = '<input type="checkbox" value="'+f.key+'"'+(on ? ' checked' : '')+'> <span>'+f.label+'</span>';
      lbl.querySelector('input').addEventListener('change', function(e){
        lbl.classList.toggle('selected', e.target.checked);
        updateExCount();
      });
      grid.appendChild(lbl);
    });
    exScope = 'filtered';
    document.getElementById('ex-scope-filtered').classList.add('active');
    document.getElementById('ex-scope-all').classList.remove('active');
    updateExCount();
    document.getElementById('exportModal').style.display = 'flex';
  }
  function closeExportModal(){ document.getElementById('exportModal').style.display = 'none'; }
  function setExScope(scope, el){
    exScope = scope;
    document.querySelectorAll('.opt-pill').forEach(function(p){ p.classList.remove('active'); });
    el.classList.add('active');
    updateExCount();
  }
  function exSelAll(val){
    document.querySelectorAll('#exFieldsGrid .field-check').forEach(function(el){
      el.classList.toggle('selected', val);
      el.querySelector('input').checked = val;
    });
    updateExCount();
  }
  function getExRows(){
    var all = Array.from(document.querySelectorAll('#bookingsTable tbody tr'));
    if(exScope === 'all') return all;
    return all.filter(function(r){ return r.style.display !== 'none'; });
  }
  function updateExCount(){
    var rows = getExRows();
    var checked = document.querySelectorAll('#exFieldsGrid input:checked').length;
    document.getElementById('exCount').textContent = rows.length + ' bookings · ' + checked + ' fields';
    document.getElementById('exDoBtn').disabled = (checked === 0 || rows.length === 0);
  }
  function doExport(){
    var rows = getExRows();
    var keys = Array.from(document.querySelectorAll('#exFieldsGrid input:checked')).map(function(i){ return i.value; });
    var fields = EX_FIELDS.filter(function(f){ return keys.indexOf(f.key) !== -1; });
    if(!fields.length || !rows.length) return;
    var data = [fields.map(function(f){ return f.label; })];
    rows.forEach(function(r){ data.push(fields.map(function(f){ return f.get(r) || ''; })); });
    function write(){
      var wb = XLSX.utils.book_new();
      var ws = XLSX.utils.aoa_to_sheet(data);
      ws['!cols'] = data[0].map(function(_,i){ return { wch: Math.max(14, Math.max.apply(null, data.map(function(r){ return String(r[i]||'').length; }))) }; });
      XLSX.utils.book_append_sheet(wb, ws, 'Bookings');
      XLSX.writeFile(wb, 'bookings-export-' + new Date().toISOString().slice(0,10) + '.xlsx');
      closeExportModal();
    }
    if(typeof XLSX === 'undefined'){
      var s = document.createElement('script');
      s.src = 'https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js';
      s.onload = write;
      document.head.appendChild(s);
    } else { write(); }
  }
  document.getElementById('exportModal').addEventListener('click', function(e){ if(e.target === this) closeExportModal(); });

  // ── Filters ──
  var currentStatus = 'all';
  function filterStatus(status, el){
    currentStatus = status;
    document.querySelectorAll('.stat-pill').forEach(function(p){ p.classList.remove('active'); });
    el.classList.add('active');
    applyFilters();
  }
  function applyFilters(){
    var q = document.getElementById('searchInput').value.toLowerCase();
    var visible = 0;
    document.querySelectorAll('#bookingsTable tbody tr').forEach(function(row){
      var matchStatus = currentStatus === 'all' || row.dataset.status === currentStatus;
      var matchSearch = !q || row.textContent.toLowerCase().includes(q);
      var show = matchStatus && matchSearch;
      row.style.display = show ? '' : 'none';
      if(show) visible++;
    });
    document.getElementById('emptyMsg').style.display = visible === 0 ? 'block' : 'none';
  }

  // ── Reminder Modal ──
  var rmEntries = [];   // full list from API
  var rmFiltered = [];  // after search

  async function openReminderModal(){
    document.getElementById('reminderModal').classList.add('open');
    document.getElementById('rmBody').innerHTML = '<div class="rm-loading"><i class="bi bi-arrow-repeat" style="animation:spin 1s linear infinite;"></i>Loading paid bookings…</div>';
    document.getElementById('rmSendBtn').disabled = true;
    document.getElementById('rmFootInfo').textContent = '—';
    document.getElementById('rmSearch').value = '';

    try {
      var r = await fetch('/mee-admin/bookings/reminder-stats', { credentials: 'include' });
      var d = await r.json();
      if(d.success){
        rmEntries = d.entries || [];
        rmFiltered = rmEntries.slice();
        renderRmList();
      } else {
        document.getElementById('rmBody').innerHTML = '<div class="rm-loading"><i class="bi bi-exclamation-circle"></i>Failed to load: ' + (d.message||'Unknown error') + '</div>';
      }
    } catch(e){
      document.getElementById('rmBody').innerHTML = '<div class="rm-loading"><i class="bi bi-exclamation-circle"></i>Network error.</div>';
    }
  }

  function closeReminderModal(){
    document.getElementById('reminderModal').classList.remove('open');
  }

  function renderRmList(){
    if(!rmFiltered.length){
      document.getElementById('rmBody').innerHTML = '<div class="rm-loading"><i class="bi bi-inbox"></i>No paid bookings found.</div>';
      updateRmFoot();
      return;
    }
    var html = '';
    rmFiltered.forEach(function(e){
      var notifiedHtml = e.notifiedAt
        ? '<span class="ru-pill ru-notified"><i class="bi bi-check2"></i> Reminded ' + new Date(e.notifiedAt).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) + '</span>'
        : '<span class="ru-pill ru-unsent"><i class="bi bi-clock"></i> Not reminded</span>';
      html += '<div class="ru-row" onclick="rmToggle(\''+e.phone+'\',this)">'
        + '<input type="checkbox" class="ru-check rm-cb" data-phone="'+e.phone+'" onclick="event.stopPropagation();rmToggle(\''+e.phone+'\',this.closest(\'.ru-row\'))">'
        + '<div class="ru-info"><div class="ru-name">'+escHtml(e.name)+'</div><div class="ru-phone">+91 '+e.phone+'</div></div>'
        + '<div class="ru-meta">'
        + '<span class="ru-pill ru-bcount"><i class="bi bi-ticket-perforated"></i> '+e.bookingCount+' booking'+(e.bookingCount>1?'s':'')+'</span>'
        + notifiedHtml
        + '</div>'
        + '</div>';
    });
    document.getElementById('rmBody').innerHTML = html;
    updateRmFoot();
  }

  function rmToggle(phone, row){
    var cb = row.querySelector('.rm-cb') || row;
    if(cb.tagName === 'INPUT'){
      // toggled via row click, manually flip
      cb.checked = !cb.checked;
    }
    row.style.background = cb.checked ? 'rgba(157,78,221,0.05)' : '';
    updateRmFoot();
  }

  function rmSelAll(val){
    document.querySelectorAll('.rm-cb').forEach(function(cb){
      cb.checked = val;
      cb.closest('.ru-row').style.background = val ? 'rgba(157,78,221,0.05)' : '';
    });
    updateRmFoot();
  }

  function rmSelUnnotified(){
    document.querySelectorAll('.rm-cb').forEach(function(cb){
      var phone = cb.dataset.phone;
      var entry = rmEntries.find(function(e){ return e.phone === phone; });
      var sel = entry && !entry.notifiedAt;
      cb.checked = sel;
      cb.closest('.ru-row').style.background = sel ? 'rgba(157,78,221,0.05)' : '';
    });
    updateRmFoot();
  }

  function rmFilter(){
    var q = document.getElementById('rmSearch').value.toLowerCase().trim();
    rmFiltered = !q ? rmEntries.slice() : rmEntries.filter(function(e){
      return e.name.toLowerCase().includes(q) || e.phone.includes(q);
    });
    renderRmList();
  }

  function updateRmFoot(){
    var checked = document.querySelectorAll('.rm-cb:checked').length;
    var total   = document.querySelectorAll('.rm-cb').length;
    document.getElementById('rmFootInfo').textContent = checked + ' of ' + total + ' selected';
    document.getElementById('rmSendBtn').disabled = checked === 0;
  }

  async function doSendReminders(){
    var phones = Array.from(document.querySelectorAll('.rm-cb:checked')).map(function(cb){ return cb.dataset.phone; });
    if(!phones.length) return;

    var btn = document.getElementById('rmSendBtn');
    btn.disabled = true;
    btn.innerHTML = '<span style="width:12px;height:12px;border:2px solid rgba(245,200,66,0.3);border-top-color:#f5c842;border-radius:50%;animation:spin .7s linear infinite;display:inline-block;vertical-align:middle;margin-right:6px;"></span> Sending…';

    try {
      var r = await fetch('/mee-admin/bookings/send-bulk-reminder', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phones: phones }),
      });
      var d = await r.json();
      if(d.success){
        btn.innerHTML = '<i class="bi bi-check-circle-fill"></i> Sent ' + d.sent + ' · Skipped ' + d.skipped;
        btn.style.color = '#00FF88';
        btn.style.borderColor = 'rgba(0,255,136,0.35)';
        btn.style.background = 'rgba(0,255,136,0.08)';
        // Refresh list to update notified status
        setTimeout(function(){
          btn.innerHTML = '<i class="bi bi-send-fill"></i> Send Reminders';
          btn.style.cssText = '';
          openReminderModal();
        }, 2500);
      } else {
        btn.innerHTML = '<i class="bi bi-x-circle-fill"></i> Error';
        btn.style.color = '#FF4444';
        setTimeout(function(){ btn.innerHTML = '<i class="bi bi-send-fill"></i> Send Reminders'; btn.style.cssText = ''; btn.disabled = false; }, 3000);
      }
    } catch(e){
      btn.innerHTML = '<i class="bi bi-exclamation-circle-fill"></i> Network Error';
      btn.style.color = '#FF4444';
      setTimeout(function(){ btn.innerHTML = '<i class="bi bi-send-fill"></i> Send Reminders'; btn.style.cssText = ''; btn.disabled = false; }, 3000);
    }
  }

  document.getElementById('reminderModal').addEventListener('click', function(e){ if(e.target === this) closeReminderModal(); });

  // ── Resend Confirmation Modal ──
var rsEntries   = [];
var rsFiltered  = [];
// Change the prefix below for superadmin: '/superadmin'
var RS_PREFIX = '/mee-admin';  // ← '/superadmin' in superadmin page

async function openResendModal() {
  document.getElementById('resendModal').classList.add('open');
  document.getElementById('rsBody').innerHTML = '<div class="rm-loading"><i class="bi bi-arrow-repeat" style="animation:spin 1s linear infinite;"></i>Loading paid bookings…</div>';
  document.getElementById('rsSendBtn').disabled = true;
  document.getElementById('rsFootInfo').textContent = '—';
  document.getElementById('rsSearch').value = '';
  document.getElementById('rsWarn').classList.remove('show');

  try {
    var r = await fetch(RS_PREFIX + '/bookings/resend-stats', { credentials: 'include' });
    var d = await r.json();
    if (d.success) {
      rsEntries  = d.entries || [];
      rsFiltered = rsEntries.slice();
      renderRsList();
    } else {
      document.getElementById('rsBody').innerHTML = '<div class="rm-loading"><i class="bi bi-exclamation-circle"></i>Failed: ' + (d.message || 'Unknown error') + '</div>';
    }
  } catch (e) {
    document.getElementById('rsBody').innerHTML = '<div class="rm-loading"><i class="bi bi-exclamation-circle"></i>Network error.</div>';
  }
}

function closeResendModal() {
  document.getElementById('resendModal').classList.remove('open');
}

function renderRsList() {
  if (!rsFiltered.length) {
    document.getElementById('rsBody').innerHTML = '<div class="rm-loading"><i class="bi bi-inbox"></i>No paid bookings found.</div>';
    updateRsFoot();
    return;
  }
  var html = '';
  rsFiltered.forEach(function(e) {
    var resentHtml = e.resentAt
      ? '<span class="rs-pill rs-pill-sent"><i class="bi bi-check2"></i> Resent ' + new Date(e.resentAt).toLocaleDateString('en-IN', { day:'numeric', month:'short' }) + '</span>'
      : '';
    html += '<div class="rs-row" onclick="rsToggle(\'' + e.bookingId + '\', this)">'
      + '<input type="checkbox" class="rs-check rs-cb" data-id="' + e.bookingId + '" onclick="event.stopPropagation();rsToggle(\'' + e.bookingId + '\',this.closest(\'.rs-row\'))">'
      + '<div class="rs-info">'
      + '<div class="rs-name">' + escHtml(e.name) + '</div>'
      + '<div class="rs-sub">'
      + escHtml(e.eventName) + ' · ' + escHtml(e.ticketType) + ' × ' + e.quantity
      + (e.phone ? ' · +91 ' + e.phone : '')
      + '</div>'
      + '</div>'
      + '<div class="rs-meta">'
      + '<span class="rs-pill rs-pill-ref">' + escHtml(e.bookingRef) + '</span>'
      + resentHtml
      + '</div>'
      + '</div>';
  });
  document.getElementById('rsBody').innerHTML = html;
  updateRsFoot();
}

function rsToggle(id, row) {
  var cb = row.querySelector('.rs-cb');
  cb.checked = !cb.checked;
  row.style.background = cb.checked ? 'rgba(157,78,221,0.06)' : '';
  updateRsFoot();
}

function rsFilter() {
  var q = document.getElementById('rsSearch').value.toLowerCase().trim();
  rsFiltered = !q ? rsEntries.slice() : rsEntries.filter(function(e) {
    return (e.name + ' ' + e.bookingRef + ' ' + e.eventName + ' ' + e.phone).toLowerCase().includes(q);
  });
  renderRsList();
}

function updateRsFoot() {
  var checked = document.querySelectorAll('.rs-cb:checked').length;
  var total   = document.querySelectorAll('.rs-cb').length;
  document.getElementById('rsFootInfo').textContent = checked + ' of ' + total + ' selected';
  document.getElementById('rsSendBtn').disabled = checked === 0;
  // Warn if more than 5 selected
  document.getElementById('rsWarn').classList.toggle('show', checked > 5);
}

async function doResendConfirmations() {
  var ids = Array.from(document.querySelectorAll('.rs-cb:checked')).map(function(cb) { return cb.dataset.id; });
  if (!ids.length) return;

  var btn = document.getElementById('rsSendBtn');
  btn.disabled = true;
  btn.innerHTML = '<span style="width:12px;height:12px;border:2px solid rgba(192,132,252,0.3);border-top-color:#c084fc;border-radius:50%;animation:spin .7s linear infinite;display:inline-block;vertical-align:middle;margin-right:6px;"></span> Sending…';

  try {
    var r = await fetch(RS_PREFIX + '/bookings/resend-confirmation', {
      method: 'POST',
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ bookingIds: ids }),
    });
    var d = await r.json();
    if (d.success) {
      btn.innerHTML = '<i class="bi bi-check-circle-fill"></i> Sent ' + d.sent + (d.failed ? ' · Failed ' + d.failed : '');
      btn.style.color = '#00FF88';
      btn.style.borderColor = 'rgba(0,255,136,0.35)';
      btn.style.background = 'rgba(0,255,136,0.08)';
      setTimeout(function() {
        btn.innerHTML = '<i class="bi bi-send-fill"></i> Resend Confirmation';
        btn.style.cssText = '';
        openResendModal(); // refresh list to show new resentAt timestamps
      }, 2500);
    } else {
      btn.innerHTML = '<i class="bi bi-x-circle-fill"></i> Error';
      btn.style.color = '#FF4444';
      setTimeout(function() { btn.innerHTML = '<i class="bi bi-send-fill"></i> Resend Confirmation'; btn.style.cssText = ''; btn.disabled = false; }, 3000);
    }
  } catch (e) {
    btn.innerHTML = '<i class="bi bi-exclamation-circle-fill"></i> Network Error';
    btn.style.color = '#FF4444';
    setTimeout(function() { btn.innerHTML = '<i class="bi bi-send-fill"></i> Resend Confirmation'; btn.style.cssText = ''; btn.disabled = false; }, 3000);
  }
}

document.getElementById('resendModal').addEventListener('click', function(e) { if (e.target === this) closeResendModal(); });

  function escHtml(str){ return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
</script>

</body>
</html>
