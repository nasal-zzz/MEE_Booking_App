<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#0B0B0F;--surface:#14141C;--border:rgba(255,255,255,0.08);--accent:#9500ff;--text:#fff;--muted:#B3B3B3;--success:#00FF88;--error:#FF4444;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;}
    .admin-layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh;}
    .main{padding:2rem;position:relative;z-index:1;}
    .page-title{font-family:'Poppins',sans-serif;font-size:2rem;letter-spacing:2px;margin-bottom:0.2rem;}
    .page-sub{font-size:0.78rem;color:var(--muted);margin-bottom:1.5rem;}

    .sidebar{background:var(--surface);border-right:1px solid var(--border);padding:1.5rem 1rem;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:0.3rem;z-index:10;overflow-y:auto;scrollbar-width:none;}
    .sidebar::-webkit-scrollbar{display:none;}
    .s-logo{display:block;padding:0 0.5rem 1rem;border-bottom:1px solid var(--border);margin-bottom:0.5rem;text-decoration:none;}
    .s-section{font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;padding:0.5rem 0.5rem 0.2rem;margin-top:0.3rem;}
    .s-link{display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--muted);text-decoration:none;border-radius:6px;font-size:0.85rem;transition:all 0.15s;border:1px solid transparent;}
    .s-link:hover,.s-link.active{background:rgba(106,13,173,0.08);border-color:rgba(106,13,173,0.2);color:#fff;}
    .s-link i{color:var(--accent);width:18px;}
    .s-logout{margin-top:auto;display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--error);text-decoration:none;border-radius:6px;font-size:0.85rem;border:1px solid transparent;transition:all 0.15s;}
    .s-logout:hover{background:rgba(255,68,68,0.08);}

    /* Event header */
    .event-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem;}
    .event-info{display:flex;align-items:center;gap:0.8rem;}
    .live-badge{background:rgba(0,255,136,0.1);border:1px solid rgba(0,255,136,0.3);color:#00FF88;font-family:'Space Mono',monospace;font-size:0.6rem;padding:0.2rem 0.6rem;border-radius:4px;letter-spacing:1px;}
    .event-name{font-weight:700;font-size:1rem;}
    .event-meta{font-size:0.72rem;color:var(--muted);}

    /* Filter bar */
    .filter-bar{display:flex;gap:0.7rem;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:0.9rem 1rem;}
    .filter-label{font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:2px;color:#555;text-transform:uppercase;white-space:nowrap;}
    .f-sel{background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:7px;color:#fff;font-family:'Outfit',sans-serif;font-size:0.82rem;padding:0.5rem 0.75rem;outline:none;cursor:pointer;}
    .f-sel:focus{border-color:rgba(149,0,255,0.45);}
    .f-sel option{background:#1a1a2e;}
    .search-inp{flex:1;min-width:160px;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:7px;color:#fff;font-family:'Outfit',sans-serif;font-size:0.82rem;padding:0.5rem 0.75rem;outline:none;}
    .search-inp:focus{border-color:rgba(149,0,255,0.45);}
    .btn-reset{background:transparent;border:1px solid var(--border);border-radius:7px;color:var(--muted);font-family:'Outfit',sans-serif;font-size:0.78rem;padding:0.5rem 0.9rem;cursor:pointer;transition:all 0.15s;white-space:nowrap;}
    .btn-reset:hover{border-color:var(--error);color:var(--error);}

    /* Stats strip */
    .stats-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:0.8rem;margin-bottom:1.5rem;}
    .stat-box{background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:0.9rem 1rem;}
    .stat-val{font-family:'Poppins',sans-serif;font-size:1.6rem;font-weight:700;}
    .stat-lbl{font-family:'Space Mono',monospace;font-size:0.5rem;letter-spacing:2px;color:#555;text-transform:uppercase;margin-top:0.1rem;}

    /* Staff cards */
    .staff-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;margin-bottom:1.5rem;}
    .staff-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden;}
    .sc-head{padding:1rem 1.2rem 0.8rem;display:flex;align-items:center;gap:0.8rem;border-bottom:1px solid var(--border);}
    .sc-avatar{width:40px;height:40px;border-radius:50%;background:rgba(106,13,173,0.2);border:2px solid rgba(106,13,173,0.4);display:flex;align-items:center;justify-content:center;font-family:'Poppins',sans-serif;font-size:1.1rem;color:var(--accent);flex-shrink:0;}
    .sc-name{font-weight:700;font-size:0.92rem;}
    .sc-role{font-size:0.65rem;color:var(--muted);font-family:'Space Mono',monospace;}
    .sc-stats{display:grid;grid-template-columns:1fr 1fr 1fr;padding:0.8rem 1.2rem;}
    .sc-stat{text-align:center;}
    .sc-stat-val{font-family:'Poppins',sans-serif;font-size:1.3rem;color:#fff;}
    .sc-stat-lbl{font-size:0.58rem;color:#555;font-family:'Space Mono',monospace;letter-spacing:1px;}
    .sc-last{padding:0 1.2rem 0.8rem;font-size:0.7rem;color:#555;}

    /* Table */
    .section-title{font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:3px;color:#555;text-transform:uppercase;margin-bottom:0.8rem;}
    .table-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden;}
    .table-scroll{overflow-x:auto;}
    table{width:100%;border-collapse:collapse;}
    th{font-family:'Space Mono',monospace;font-size:0.5rem;letter-spacing:2px;color:#555;text-transform:uppercase;padding:0.7rem 1rem;border-bottom:1px solid var(--border);text-align:left;white-space:nowrap;}
    td{padding:0.7rem 1rem;border-bottom:1px solid rgba(255,255,255,0.04);font-size:0.82rem;vertical-align:middle;}
    tr:last-child td{border-bottom:none;}
    tr:hover td{background:rgba(255,255,255,0.015);}
    .b{font-family:'Space Mono',monospace;font-size:0.55rem;padding:0.14rem 0.42rem;border-radius:4px;display:inline-block;}
    .b-staff{background:rgba(106,13,173,0.1);border:1px solid rgba(106,13,173,0.3);color:#bf80ff;}
    .b-cat{background:rgba(245,200,66,0.08);border:1px solid rgba(245,200,66,0.25);color:#f5c842;}
    .b-gate{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:#888;}
    .no-results{text-align:center;padding:2.5rem;color:#555;font-size:0.85rem;display:none;}
    .empty{text-align:center;padding:3rem;color:#555;}
    .empty i{font-size:2.5rem;display:block;margin-bottom:0.8rem;}
    @media(max-width:900px){.admin-layout{grid-template-columns:1fr;}}
  </style>
</head>
<body>
<div class="admin-layout">
  <%- include('../partials/admin-sidebar', { activePage: 'participants' }) %>
  <%- include('../partials/admin-confirm') %>

  <main class="main">
    <div class="page-title">STAFF ACTIVITY</div>
    <p class="page-sub">Scan logs — filter by scanner, gender, or ticket category.</p>

    <% if(selectedEvent){ %>

    <!-- Event header -->
    <div class="event-header">
      <div class="event-info">
        <span class="live-badge">● LIVE</span>
        <div>
          <div class="event-name"><%= selectedEvent.name %></div>
          <div class="event-meta">
            <%= new Date(selectedEvent.date).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'}) %>
            <% if(selectedEvent.venue){ %> · <%= selectedEvent.venue %><% } %>
          </div>
        </div>
      </div>
    </div>

    <% if(logs.length > 0){ %>

    <%
      // Build per-staff summary from ALL logs (unfiltered, for cards)
      var staffMap = {};
      logs.forEach(function(log){
        var key = (log.scannedBy && log.scannedBy.staffName) ? log.scannedBy.staffName : 'Unknown';
        if(!staffMap[key]) staffMap[key] = { name:key,scans:0, male:0, female:0, lastScan:null };
        staffMap[key].scans++;
        if(log.attendeeGender==='male') staffMap[key].male++;
        else if(log.attendeeGender==='female') staffMap[key].female++;
        if(!staffMap[key].lastScan || new Date(log.scannedAt) > new Date(staffMap[key].lastScan))
          staffMap[key].lastScan = log.scannedAt;
      });
      var staffList = Object.values(staffMap).sort(function(a,b){ return b.scans-a.scans; });

      var totalMale   = logs.filter(l => l.attendeeGender==='male').length;
      var totalFemale = logs.filter(l => l.attendeeGender==='female').length;
      var totalOther  = logs.length - totalMale - totalFemale;
    %>

    <!-- Stats strip -->
    <div class="stats-strip">
      <div class="stat-box">
        <div class="stat-val"><%= logs.length %></div>
        <div class="stat-lbl">Total Scans</div>
      </div>
      <div class="stat-box">
        <div class="stat-val" style="color:#64b5f6;"><%= totalMale %></div>
        <div class="stat-lbl">Male</div>
      </div>
      <div class="stat-box">
        <div class="stat-val" style="color:#f48fb1;"><%= totalFemale %></div>
        <div class="stat-lbl">Female</div>
      </div>
      <div class="stat-box">
        <div class="stat-val" style="color:#888;"><%= totalOther %></div>
        <div class="stat-lbl">Other / Unknown</div>
      </div>
      <div class="stat-box">
        <div class="stat-val" style="color:var(--accent);"><%= staffList.length %></div>
        <div class="stat-lbl">Scanners</div>
      </div>
    </div>

    <!-- Staff summary cards -->
    <div class="section-title">Scanner Summary</div>
    <div class="staff-grid" id="staffGrid">
      <% staffList.forEach(function(s){ %>
      <div class="staff-card" data-scanner="<%= s.name %>">
        <div class="sc-head">
          <div class="sc-avatar"><%= s.name.charAt(0).toUpperCase() %></div>
          <div>
            <div class="sc-name"><%= s.name %></div>
            <div class="sc-role">Gate Staff</div>
          </div>
        </div>
        <div class="sc-stats">
          <div class="sc-stat"><div class="sc-stat-val"><%= s.scans %></div><div class="sc-stat-lbl">Total</div></div>
          <div class="sc-stat"><div class="sc-stat-val" style="color:#64b5f6;"><%= s.male %></div><div class="sc-stat-lbl">Male</div></div>
          <div class="sc-stat"><div class="sc-stat-val" style="color:#f48fb1;"><%= s.female %></div><div class="sc-stat-lbl">Female</div></div>
        </div>
        <div class="sc-last">Last scan: <%= s.lastScan ? new Date(s.lastScan).toLocaleString('en-IN',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) : '—' %></div>
      </div>
      <% }); %>
    </div>

    <!-- Filter bar -->
    <div class="filter-bar">
      <span class="filter-label">Filter</span>

      <select class="f-sel" id="fScanner">
        <option value="">All Scanners</option>
        <% scanners.forEach(function(s){ %>
        <option value="<%= s %>"><%= s %></option>
        <% }); %>
      </select>

      <select class="f-sel" id="fGender">
        <option value="">All Genders</option>
        <option value="male">♂ Male</option>
        <option value="female">♀ Female</option>
        <option value="other">Other / Unknown</option>
      </select>

      <select class="f-sel" id="fCategory">
        <option value="">All Categories</option>
        <% categories.forEach(function(c){ %>
        <option value="<%= c %>"><%= c %></option>
        <% }); %>
      </select>

      <input class="search-inp" id="searchInp" placeholder="Search name, ref, gate…"/>

      <button class="btn-reset" onclick="resetFilters()"><i class="bi bi-x-circle"></i> Reset</button>

      <span style="font-family:'Space Mono',monospace;font-size:0.65rem;color:#555;white-space:nowrap;">
        Showing <span id="visCount"><%= logs.length %></span> / <%= logs.length %>
      </span>
    </div>

    <!-- Scan log table -->
    <div class="section-title">Full Scan Log</div>
    <div class="table-card">
      <div class="table-scroll">
        <table id="partTable">
          <thead><tr>
            <th>#</th>
            <th>Attendee</th>
            <th>Gender</th>
            <th>Category</th>
            <th>Gate</th>
            <th>Booking Ref</th>
            <th>Scanned By</th>
            <th>Scanned At</th>
          </tr></thead>
          <tbody>
            <% logs.forEach(function(log, idx){ %>
            <tr
              data-scanner="<%= (log.scannedBy && log.scannedBy.staffName) ? log.scannedBy.staffName : '' %>"
              data-gender="<%= log.attendeeGender || 'other' %>"
              data-category="<%= log.ticketType || '' %>"
              data-search="<%= ((log.attendeeName||'') + ' ' + (log.bookingRef||'') + ' ' + (log.scannedBy&&log.scannedBy.staffName||'') + ' ' + (log.location&&log.location.gate||'')).toLowerCase() %>"
            >
              <td style="color:#555;font-size:0.7rem;" class="row-num"><%= idx+1 %></td>
              <td style="font-weight:600;"><%= log.attendeeName || '—' %></td>
              <td>
                <% if(log.attendeeGender==='male'){ %>
                  <span style="color:#64b5f6;font-size:0.78rem;">♂ Male</span>
                <% }else if(log.attendeeGender==='female'){ %>
                  <span style="color:#f48fb1;font-size:0.78rem;">♀ Female</span>
                <% }else{ %>
                  <span style="color:#444;font-size:0.78rem;">—</span>
                <% } %>
              </td>
              <td><span class="b b-cat"><%= log.ticketType || '—' %></span></td>
              <td><span class="b b-gate"><i class="bi bi-door-open"></i> <%= (log.location && log.location.gate) ? log.location.gate : '—' %></span></td>
              <td style="font-family:'Space Mono',monospace;font-size:0.67rem;color:var(--accent);"><%= log.bookingRef || '—' %></td>
              <td><span class="b b-staff"><%= (log.scannedBy && log.scannedBy.staffName) ? log.scannedBy.staffName : '—' %></span></td>
              <td style="font-family:'Space Mono',monospace;font-size:0.68rem;color:var(--muted);white-space:nowrap;">
                <%= new Date(log.scannedAt).toLocaleString('en-IN',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) %>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
        <div class="no-results" id="noResults">
          <i class="bi bi-funnel" style="font-size:1.8rem;display:block;margin-bottom:0.5rem;color:#333;"></i>
          No records match the selected filters.
        </div>
      </div>
    </div>

    <% }else{ %>
    <div class="empty">
      <i class="bi bi-qr-code-scan" style="color:#333;"></i>
      <div style="font-size:0.88rem;">No scan records for this event yet.</div>
      <div style="font-size:0.72rem;margin-top:0.3rem;color:#444;">Staff scan activity will appear here after QR codes are scanned at the gate.</div>
    </div>
    <% } %>

    <% }else{ %>
    <div style="margin-top:2rem;padding:1rem;background:rgba(255,68,68,0.06);border:1px solid rgba(255,68,68,0.2);border-radius:8px;color:#FF4444;font-size:0.85rem;">
      <i class="bi bi-exclamation-triangle"></i> No active event found. Please activate an event from the Events page.
    </div>
    <% } %>
  </main>
</div>

<script>
var allRows = Array.from(document.querySelectorAll('#partTable tbody tr'));

function applyFilters() {
  var scanner  = document.getElementById('fScanner').value;
  var gender   = document.getElementById('fGender').value;
  var category = document.getElementById('fCategory').value;
  var search   = document.getElementById('searchInp').value.toLowerCase().trim();

  var visible = 0;
  var rowNum  = 1;

  allRows.forEach(function(r) {
    var rScanner  = r.dataset.scanner;
    var rGender   = r.dataset.gender;
    var rCategory = r.dataset.category;
    var rSearch   = r.dataset.search;

    // Gender "other" means not male and not female
    var genderMatch = !gender ||
      (gender === 'other' ? (rGender !== 'male' && rGender !== 'female') : rGender === gender);

    var show =
      (!scanner  || rScanner === scanner) &&
      genderMatch &&
      (!category || rCategory === category) &&
      (!search   || rSearch.includes(search));

    r.style.display = show ? '' : 'none';
    if (show) {
      r.querySelector('.row-num').textContent = rowNum++;
      visible++;
    }
  });

  document.getElementById('visCount').textContent = visible;
  document.getElementById('noResults').style.display = visible === 0 ? 'block' : 'none';

  // Highlight active scanner card
  var sc = scanner;
  document.querySelectorAll('.staff-card').forEach(function(card) {
    card.style.borderColor = (!sc || card.dataset.scanner === sc)
      ? 'rgba(149,0,255,0.4)'
      : 'rgba(255,255,255,0.08)';
    card.style.opacity = (!sc || card.dataset.scanner === sc) ? '1' : '0.4';
  });
}

function resetFilters() {
  document.getElementById('fScanner').value  = '';
  document.getElementById('fGender').value   = '';
  document.getElementById('fCategory').value = '';
  document.getElementById('searchInp').value = '';
  applyFilters();
}

document.getElementById('fScanner').addEventListener('change', applyFilters);
document.getElementById('fGender').addEventListener('change', applyFilters);
document.getElementById('fCategory').addEventListener('change', applyFilters);
document.getElementById('searchInp').addEventListener('input', applyFilters);

// Clicking a staff card filters by that scanner
document.querySelectorAll('.staff-card').forEach(function(card) {
  card.style.cursor = 'pointer';
  card.addEventListener('click', function() {
    var sel = document.getElementById('fScanner');
    var name = card.dataset.scanner;
    sel.value = sel.value === name ? '' : name;  // toggle
    applyFilters();
  });
});
</script>
</body>
</html>