<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
  <style>
    :root{--bg:#0B0B0F;--surface:#14141C;--card:#14141C;--border:rgba(255,255,255,0.08);--accent:#9500ff;--text:#FFFFFF;--muted:#B3B3B3;--success:#00FF88;--error:#FF4444;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;}
    .admin-layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh;}
    .main{padding:2rem;position:relative;z-index:1;overflow-x:hidden;}
    .page-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem;flex-wrap:wrap;gap:1rem;}
    .page-title{font-family:'Poppins',sans-serif;font-size:2rem;letter-spacing:2px;color:#fff;}
    .btn-primary{display:inline-flex;align-items:center;gap:0.5rem;background:var(--accent);color:#fff;padding:0.7rem 1.4rem;border-radius:6px;text-decoration:none;font-weight:700;font-size:0.85rem;letter-spacing:1px;transition:all 0.2s;border:none;cursor:pointer;}
    .btn-primary:hover{box-shadow:0 0 20px rgba(106,13,173,0.4);}
    .btn-sm{display:inline-flex;align-items:center;gap:0.3rem;padding:0.35rem 0.75rem;border-radius:4px;font-size:0.78rem;font-weight:600;cursor:pointer;text-decoration:none;border:1px solid var(--border);background:transparent;color:var(--text);transition:all 0.15s;}
    .btn-sm:hover{border-color:var(--accent);color:var(--accent);}
    .btn-sm.danger{border-color:rgba(255,68,68,0.3);color:var(--error);}
    .btn-sm.danger:hover{background:rgba(255,68,68,0.08);}
    .table-card{background:var(--card);border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-bottom:2rem;}
    .table-header{padding:1.2rem 1.5rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
    .table-title{font-family:'Poppins',sans-serif;font-size:1.1rem;letter-spacing:1px;}
    table{width:100%;border-collapse:collapse;}
    th{font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;padding:0.8rem 1.2rem;text-align:left;border-bottom:1px solid var(--border);}
    td{padding:0.9rem 1.2rem;border-bottom:1px solid rgba(255,255,255,0.04);font-size:0.85rem;vertical-align:middle;}
    tr:last-child td{border-bottom:none;}
    tr:hover td{background:rgba(255,255,255,0.02);}
    .badge-on{background:rgba(0,255,136,0.1);border:1px solid rgba(0,255,136,0.3);color:var(--success);border-radius:10px;padding:0.2rem 0.6rem;font-size:0.7rem;font-family:'Space Mono',monospace;}
    .badge-off{background:rgba(255,68,68,0.1);border:1px solid rgba(255,68,68,0.3);color:var(--error);border-radius:10px;padding:0.2rem 0.6rem;font-size:0.7rem;font-family:'Space Mono',monospace;}
    .stat-chip{display:inline-flex;flex-direction:column;align-items:center;background:#0B0B0F;border:1px solid var(--border);border-radius:6px;padding:0.3rem 0.7rem;min-width:52px;}
    .stat-chip .val{font-family:'Poppins',sans-serif;font-size:1rem;color:var(--accent);}
    .stat-chip .lbl{font-size:0.58rem;color:var(--muted);font-family:'Space Mono',monospace;letter-spacing:1px;}
    /* Create form */
    .form-card{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1.5rem;margin-bottom:2rem;}
    .form-grid{display:grid;grid-template-columns:1fr 2fr 2fr auto;gap:0.8rem;align-items:end;}
    .form-group label{display:block;font-size:0.72rem;color:var(--muted);font-family:'Space Mono',monospace;letter-spacing:1px;margin-bottom:0.4rem;text-transform:uppercase;}
    .form-group input,.form-group textarea{width:100%;background:#0B0B0F;border:1px solid var(--border);border-radius:6px;padding:0.6rem 0.9rem;color:#fff;font-size:0.85rem;font-family:'Outfit',sans-serif;outline:none;transition:border-color 0.15s;}
    .form-group input:focus,.form-group textarea:focus{border-color:var(--accent);}
    /* Modal */
    .modal-overlay{display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.75);backdrop-filter:blur(6px);overflow-y:auto;}
    .modal-box{max-width:600px;margin:3rem auto;background:#14141C;border:1px solid rgba(255,255,255,0.1);border-radius:14px;overflow:hidden;}
    .modal-top{height:3px;background:linear-gradient(90deg,transparent,#9500ff,#9D4EDD,transparent);}
    .modal-head{padding:1.2rem 1.5rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
    .modal-body{padding:1.5rem;}
    .url-box{background:#0B0B0F;border:1px solid var(--border);border-radius:6px;padding:0.7rem 1rem;font-family:'Space Mono',monospace;font-size:0.78rem;color:#9D4EDD;word-break:break-all;cursor:pointer;transition:border-color 0.15s;}
    .url-box:hover{border-color:var(--accent);}
    /* Users drawer */
    .drawer{display:none;background:#0B0B0F;border-top:1px solid var(--border);padding:1.2rem 1.5rem;}
    .drawer.open{display:block;}
    @media(max-width:900px){.admin-layout{grid-template-columns:1fr;}.form-grid{grid-template-columns:1fr 1fr;}}
    @keyframes spin{to{transform:rotate(360deg)}}
  </style>
</head>
<body>
<div class="admin-layout">
  <%- include('../partials/admin-sidebar', { activePage: 'referrals' }) %>
  <main class="main">
    <div class="page-header">
      <div class="page-title">REFERRAL LINKS</div>
    </div>

    <!-- Create form -->
    <div class="form-card">
      <div style="font-family:'Space Mono',monospace;font-size:0.6rem;letter-spacing:2px;color:var(--muted);margin-bottom:1rem;">CREATE NEW REFERRAL LINK</div>
      <div class="form-grid">
        <div class="form-group">
          <label>Code *</label>
          <input type="text" id="newCode" placeholder="LULU01" maxlength="20" style="text-transform:uppercase;">
        </div>
        <div class="form-group">
          <label>Place / Label *</label>
          <input type="text" id="newLabel" placeholder="LuLu Mall Kozhikode">
        </div>
        <div class="form-group">
          <label>Description</label>
          <input type="text" id="newDesc" placeholder="Ground floor entrance QR">
        </div>
        <div class="form-group">
          <label>&nbsp;</label>
          <button class="btn-primary" onclick="createReferral()"><i class="bi bi-plus-lg"></i> Create</button>
        </div>
      </div>
      <div id="createMsg" style="margin-top:0.8rem;font-size:0.82rem;display:none;"></div>
    </div>

    <!-- Referrals table -->
    <div class="table-card">
      <div class="table-header">
        <div class="table-title">ALL REFERRAL LINKS</div>
        <span style="font-size:0.78rem;color:var(--muted);"><%= referrals.length %> total</span>
      </div>
      <% if (referrals.length === 0) { %>
        <div style="padding:3rem;text-align:center;color:var(--muted);">No referral links yet. Create one above.</div>
      <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Code / Place</th>
            <th>Link</th>
            <th>Stats</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% referrals.forEach(r => { %>
          <% const refUrl = appUrl + '/r/' + r.code; %>
          <tr>
            <td>
              <div style="font-weight:700;font-family:'Space Mono',monospace;color:#9D4EDD;"><%= r.code %></div>
              <div style="font-size:0.78rem;color:var(--muted);margin-top:0.2rem;"><%= r.label %></div>
              <% if (r.description) { %><div style="font-size:0.7rem;color:#555;"><%= r.description %></div><% } %>
            </td>
            <td>
              <div class="url-box" onclick="copyUrl('<%= refUrl %>', this)" title="Click to copy"><%= refUrl %></div>
            </td>
            <td>
              <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                <div class="stat-chip"><span class="val"><%= r.visits %></span><span class="lbl">Visits</span></div>
                <div class="stat-chip"><span class="val"><%= r.signups %></span><span class="lbl">Signups</span></div>
                <div class="stat-chip"><span class="val" style="color:#00FF88;"><%= r.bookings %></span><span class="lbl">Bookings</span></div>
              </div>
            </td>
            <td>
              <% if (r.isActive) { %>
                <span class="badge-on">● ACTIVE</span>
              <% } else { %>
                <span class="badge-off">○ PAUSED</span>
              <% } %>
            </td>
            <td>
              <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                <button class="btn-sm" onclick="showQR('<%= r.code %>', '<%= refUrl %>', '<%= r.label %>', '<%= r._id %>')" style="color:#9D4EDD;border-color:rgba(157,78,221,0.3);"><i class="bi bi-qr-code"></i> QR</button>
                <button class="btn-sm" onclick="viewUsers('<%= r.code %>', '<%= r.label %>', this)"><i class="bi bi-people-fill"></i> Users</button>
                <button class="btn-sm" id="tog-<%= r._id %>" onclick="toggleRef('<%= r._id %>', this)"><i class="bi bi-toggle-<%= r.isActive ? 'on' : 'off' %>"></i> <%= r.isActive ? 'Pause' : 'Resume' %></button>
                <form method="POST" action="/mee-admin/referrals/<%= r._id %>/delete" style="display:inline;" onsubmit="return confirm('Delete this referral link?')">
                  <button type="submit" class="btn-sm danger"><i class="bi bi-trash-fill"></i></button>
                </form>
              </div>
            </td>
          </tr>
          <!-- Users drawer row -->
          <tr id="drawer-<%= r._id %>" style="display:none;">
            <td colspan="5" style="padding:0;">
              <div class="drawer open" id="drawerContent-<%= r._id %>">
                <div style="color:var(--muted);font-size:0.82rem;">Loading users...</div>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } %>
    </div>
  </main>
</div>

<!-- QR Modal -->
<div id="qrModal" class="modal-overlay">
  <div class="modal-box">
    <div class="modal-top"></div>
    <div class="modal-head">
      <div id="qrModalTitle" style="font-family:'Poppins',sans-serif;font-size:1.1rem;letter-spacing:2px;"></div>
      <button onclick="closeQR()" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:1.4rem;">&times;</button>
    </div>
    <div class="modal-body" style="text-align:center;">
      <div id="qrContainer" style="display:inline-block;background:#0B0B0F;padding:16px;border-radius:12px;border:1px solid rgba(255,255,255,0.08);"></div>
      <div id="qrUrl" style="margin-top:1rem;font-family:'Space Mono',monospace;font-size:0.72rem;color:#9D4EDD;word-break:break-all;"></div>
      <div style="margin-top:1.2rem;display:flex;gap:0.8rem;justify-content:center;flex-wrap:wrap;">
        <a id="qrDownloadBtn" href="#" class="btn-primary" download><i class="bi bi-download"></i> Download QR (PNG)</a>
        <button class="btn-sm" onclick="copyQrUrl()" style="color:#9D4EDD;border-color:rgba(157,78,221,0.3);"><i class="bi bi-clipboard"></i> Copy Link</button>
      </div>
      <div style="margin-top:1rem;font-size:0.75rem;color:var(--muted);">High-quality PNG — ready to print and place at the location.</div>
    </div>
  </div>
</div>

<%- include('../partials/admin-confirm') %>

<script>
let _currentQrUrl = '';
let _currentQrCode = '';

async function createReferral() {
  const code  = document.getElementById('newCode').value.trim().toUpperCase();
  const label = document.getElementById('newLabel').value.trim();
  const desc  = document.getElementById('newDesc').value.trim();
  const msg   = document.getElementById('createMsg');
  if (!code || !label) { showMsg(msg, 'Code and label are required.', false); return; }
  try {
    const r = await fetch('/mee-admin/referrals', {
      method: 'POST', credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code, label, description: desc })
    });
    const d = await r.json();
    if (d.success) {
      showMsg(msg, '✓ Referral link created! Refreshing...', true);
      setTimeout(() => location.reload(), 1000);
    } else {
      showMsg(msg, d.message || 'Error creating link.', false);
    }
  } catch(e) { showMsg(msg, 'Server error.', false); }
}

function showMsg(el, text, ok) {
  el.textContent = text;
  el.style.color = ok ? 'var(--success)' : 'var(--error)';
  el.style.display = 'block';
}

function copyUrl(url, el) {
  navigator.clipboard.writeText(url).then(() => {
    const orig = el.textContent;
    el.textContent = '✓ Copied!';
    el.style.color = 'var(--success)';
    setTimeout(() => { el.textContent = orig; el.style.color = ''; }, 1500);
  });
}

function showQR(code, url, label, id) {
  _currentQrUrl  = url;
  _currentQrCode = code;
  document.getElementById('qrModalTitle').textContent = code + ' — ' + label;
  document.getElementById('qrUrl').textContent = url;

  // Set server-side download link
  document.getElementById('qrDownloadBtn').href = `/mee-admin/referrals/${id}/qr`;
  document.getElementById('qrDownloadBtn').download = `MEE-QR-${code}.png`;

  // Clear previous QR and render new one
  const container = document.getElementById('qrContainer');
  container.innerHTML = '';
  new QRCode(container, {
    text:           url,
    width:          200,
    height:         200,
    colorDark:      '#ffffff',
    colorLight:     '#0B0B0F',
    correctLevel:   QRCode.CorrectLevel.H,
  });

  document.getElementById('qrModal').style.display = 'block';
  document.body.style.overflow = 'hidden';
}

function closeQR() {
  document.getElementById('qrModal').style.display = 'none';
  document.body.style.overflow = '';
}

function copyQrUrl() {
  navigator.clipboard.writeText(_currentQrUrl).then(() => {
    const btn = event.target.closest('button');
    const orig = btn.innerHTML;
    btn.innerHTML = '<i class="bi bi-check-lg"></i> Copied!';
    setTimeout(() => btn.innerHTML = orig, 1500);
  });
}

document.getElementById('qrModal').addEventListener('click', e => {
  if (e.target === document.getElementById('qrModal')) closeQR();
});

async function toggleRef(id, btn) {
  btn.disabled = true;
  const origHTML = btn.innerHTML;
  btn.innerHTML = '<span style="width:10px;height:10px;border:2px solid rgba(255,255,255,0.2);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;display:inline-block;"></span>';
  try {
    const r = await fetch(`/mee-admin/referrals/${id}/toggle`, {
      method: 'POST',
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
    });
    const d = await r.json();
    if (d.success) {
      // Update button
      btn.innerHTML = d.isActive
        ? '<i class="bi bi-toggle-on"></i> Pause'
        : '<i class="bi bi-toggle-off"></i> Resume';
      // Update the badge in the same row
      const row = btn.closest('tr');
      const badge = row.querySelector('.badge-on, .badge-off');
      if (badge) {
        if (d.isActive) {
          badge.className = 'badge-on';
          badge.textContent = '● ACTIVE';
        } else {
          badge.className = 'badge-off';
          badge.textContent = '○ PAUSED';
        }
      }
    } else {
      btn.innerHTML = origHTML;
    }
  } catch(e) { btn.innerHTML = origHTML; }
  btn.disabled = false;
}

let openDrawer = null;

async function viewUsers(code, label, btn) {
  // Find the drawer for this row
  const rows = document.querySelectorAll('tr');
  let drawerRow = null;
  rows.forEach(row => {
    if (row.id && row.id.startsWith('drawer-')) {
      const contentDiv = row.querySelector('[id^="drawerContent-"]');
      // find by checking if the toggle button is in prev sibling
      const prevRow = row.previousElementSibling;
      if (prevRow && prevRow.contains(btn)) drawerRow = row;
    }
  });
  if (!drawerRow) return;

  if (drawerRow.style.display !== 'none') {
    drawerRow.style.display = 'none';
    return;
  }

  drawerRow.style.display = '';
  const contentDiv = drawerRow.querySelector('.drawer');
  contentDiv.innerHTML = '<div style="color:var(--muted);font-size:0.82rem;">Loading users...</div>';

  try {
    const r = await fetch(`/mee-admin/api/referral-users?code=${encodeURIComponent(code)}`, { credentials: 'include' });
    const d = await r.json();
    if (!d.success || d.users.length === 0) {
      contentDiv.innerHTML = `<div style="color:var(--muted);font-size:0.82rem;">No users from <strong>${label}</strong> yet.</div>`;
      return;
    }
    let html = `
      <div style="font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:var(--muted);margin-bottom:0.8rem;">
        USERS FROM ${label.toUpperCase()} — ${d.users.length} user(s)
      </div>
      <div style="overflow-x:auto;">
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr>
            <th style="font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:2px;color:var(--muted);padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Name</th>
            <th style="font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:2px;color:var(--muted);padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Phone</th>
            <th style="font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:2px;color:var(--muted);padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Email</th>
            <th style="font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:2px;color:var(--muted);padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Signed Up</th>
            <th style="font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:2px;color:var(--muted);padding:0.5rem;text-align:left;border-bottom:1px solid var(--border);">Bookings</th>
          </tr>
        </thead>
        <tbody>`;
    d.users.forEach(u => {
      const date = new Date(u.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' });
      html += `
        <tr>
          <td style="padding:0.5rem;font-size:0.82rem;font-weight:600;">${u.firstName} ${u.lastName || ''}</td>
          <td style="padding:0.5rem;font-size:0.75rem;color:var(--muted);font-family:'Space Mono',monospace;">${u.phone || '—'}</td>
          <td style="padding:0.5rem;font-size:0.75rem;color:var(--muted);">${u.email || '—'}</td>
          <td style="padding:0.5rem;font-size:0.75rem;color:var(--muted);">${date}</td>
          <td style="padding:0.5rem;">
            <span style="background:rgba(0,255,136,0.1);border:1px solid rgba(0,255,136,0.2);color:#00FF88;border-radius:10px;padding:0.15rem 0.5rem;font-size:0.7rem;font-family:'Space Mono',monospace;">${u.bookingCount} booking${u.bookingCount !== 1 ? 's' : ''}</span>
          </td>
        </tr>`;
    });
    html += `</tbody></table></div>`;
    contentDiv.innerHTML = html;
  } catch(e) {
    contentDiv.innerHTML = '<div style="color:var(--error);font-size:0.82rem;">Error loading users.</div>';
  }
}

// Code input auto-uppercase
document.getElementById('newCode').addEventListener('input', function() {
  this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
});
</script>
</body>
</html>
