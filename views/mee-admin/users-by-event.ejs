<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#0B0B0F;--surface:#14141C;--border:rgba(255,255,255,0.08);--accent:#9500ff;--text:#fff;--muted:#B3B3B3;--success:#00FF88;--error:#FF4444;--warn:#f5c842;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    .layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh;}
    .main{padding:2rem;overflow-x:hidden;}
    .page-title{font-family:'Poppins',sans-serif;font-size:1.8rem;letter-spacing:2px;margin-bottom:0.2rem;}
    .page-sub{font-size:0.78rem;color:var(--muted);margin-bottom:1.5rem;}

    /* Stats */
    .stat-row{display:flex;gap:0.8rem;margin-bottom:1.2rem;flex-wrap:wrap;}
    .stat-box{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:0.8rem 1.1rem;display:flex;align-items:center;gap:0.7rem;min-width:120px;}
    .stat-box i{font-size:1.2rem;color:var(--accent);}
    .stat-val{font-family:'Poppins',sans-serif;font-size:1.25rem;letter-spacing:1px;}
    .stat-lbl{font-size:0.65rem;color:var(--muted);}

    /* Filter bar */
    .filter-top{display:flex;gap:0.8rem;align-items:flex-end;margin-bottom:1rem;flex-wrap:wrap;}
    .f-grp{display:flex;flex-direction:column;gap:0.25rem;flex:1;min-width:180px;}
    .f-lbl{font-family:'Space Mono',monospace;font-size:0.5rem;letter-spacing:1.5px;color:#555;text-transform:uppercase;}
    .f-inp,.f-sel{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:7px;color:#fff;font-family:'Outfit',sans-serif;font-size:0.85rem;padding:0.6rem 0.85rem;outline:none;width:100%;transition:border-color 0.15s;}
    .f-inp:focus,.f-sel:focus{border-color:rgba(106,13,173,0.45);}
    .f-sel option{background:#1a1a2e;}
    .age-range{display:flex;gap:0.4rem;align-items:center;}
    .age-range .f-inp{width:70px;min-width:60px;flex:1;}
    .age-sep{color:#555;font-size:0.8rem;white-space:nowrap;}

    /* Filter chips row */
    .filter-chips{display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1.2rem;align-items:center;}
    .chip{padding:0.28rem 0.75rem;border-radius:20px;font-size:0.72rem;cursor:pointer;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.03);color:var(--muted);transition:all 0.15s;font-family:'Space Mono',monospace;}
    .chip.on{background:rgba(106,13,173,0.18);border-color:rgba(106,13,173,0.4);color:#bf80ff;}
    .chip-lbl{font-size:0.62rem;color:#444;font-family:'Space Mono',monospace;letter-spacing:1px;margin-right:0.3rem;}

    /* Table */
    .table-wrap{background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden;}
    .table-scroll{overflow-x:auto;}
    table{width:100%;border-collapse:collapse;}
    th{font-family:'Space Mono',monospace;font-size:0.5rem;letter-spacing:2px;color:#555;text-transform:uppercase;padding:0.7rem 0.9rem;border-bottom:1px solid var(--border);text-align:left;white-space:nowrap;}
    td{padding:0.75rem 0.9rem;border-bottom:1px solid rgba(255,255,255,0.04);font-size:0.82rem;vertical-align:middle;}
    tr:last-child td{border-bottom:none;}
    tr:hover td{background:rgba(255,255,255,0.015);}

    /* Badges */
    .b{font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:0.5px;padding:0.15rem 0.45rem;border-radius:4px;display:inline-block;white-space:nowrap;}
    .b-m{background:rgba(100,181,246,0.1);border:1px solid rgba(100,181,246,0.3);color:#64b5f6;}
    .b-f{background:rgba(244,143,177,0.1);border:1px solid rgba(244,143,177,0.3);color:#f48fb1;}
    .b-o{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:#888;}
    .b-ticket{background:rgba(106,13,173,0.12);border:1px solid rgba(106,13,173,0.3);color:#bf80ff;}
    .b-in{background:rgba(0,255,136,0.09);border:1px solid rgba(0,255,136,0.25);color:#00FF88;}
    .b-out{background:rgba(255,68,68,0.08);border:1px solid rgba(255,68,68,0.2);color:#FF6666;}

    .empty{text-align:center;padding:3rem;color:#555;}
    .empty i{font-size:2.5rem;display:block;margin-bottom:0.8rem;}
    .ev-header{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:1.1rem 1.4rem;margin-bottom:1.2rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.8rem;}
    .ev-name{font-family:'Poppins',sans-serif;font-size:1.1rem;letter-spacing:2px;}
    .ev-meta{font-size:0.75rem;color:var(--muted);margin-top:0.15rem;}
    .results-count{font-family:'Space Mono',monospace;font-size:0.65rem;color:#555;margin-bottom:0.5rem;}

    /* Export */
    .export-btn{display:inline-flex;align-items:center;gap:0.5rem;padding:0.5rem 1.1rem;background:rgba(0,255,136,0.07);border:1px solid rgba(0,255,136,0.28);border-radius:7px;color:#00FF88;font-family:'Space Mono',monospace;font-size:0.72rem;font-weight:700;cursor:pointer;transition:all 0.2s;letter-spacing:0.5px;white-space:nowrap;}
    .export-btn:hover{background:rgba(0,255,136,0.14);border-color:rgba(0,255,136,0.5);}
    .ex-modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.78);z-index:1000;align-items:center;justify-content:center;padding:1rem;}
    .ex-modal-bg.open{display:flex;}
    .ex-modal{background:#14141C;border:1px solid rgba(255,255,255,0.08);border-radius:12px;width:100%;max-width:500px;padding:1.5rem;position:relative;max-height:90vh;overflow-y:auto;}
    .ex-modal h3{font-family:'Poppins',sans-serif;font-size:1rem;margin-bottom:0.3rem;letter-spacing:1px;}
    .ex-modal-close{position:absolute;top:1rem;right:1rem;background:none;border:none;color:#B3B3B3;cursor:pointer;font-size:1rem;}
    .ex-modal-close:hover{color:#fff;}
    .ex-sub{font-size:0.7rem;color:#555;font-family:'Space Mono',monospace;margin-bottom:1rem;}
    .ex-sec{margin-bottom:1rem;}
    .ex-sec-title{font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:2px;color:#555;margin-bottom:0.5rem;text-transform:uppercase;}
    .ex-fields-grid{display:grid;grid-template-columns:1fr 1fr;gap:0.38rem;}
    .ex-field{display:flex;align-items:center;gap:0.42rem;padding:0.4rem 0.62rem;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:5px;cursor:pointer;transition:all 0.15s;user-select:none;}
    .ex-field:hover{border-color:rgba(106,13,173,0.3);background:rgba(106,13,173,0.05);}
    .ex-field.on{border-color:rgba(106,13,173,0.4);background:rgba(106,13,173,0.1);}
    .ex-field input[type=checkbox]{accent-color:#9500ff;width:13px;height:13px;cursor:pointer;flex-shrink:0;}
    .ex-field span{font-size:0.75rem;color:#ccc;}
    .ex-opt-pills{display:flex;gap:0.45rem;flex-wrap:wrap;}
    .ex-opt-pill{display:inline-flex;align-items:center;gap:0.3rem;padding:0.35rem 0.78rem;border-radius:20px;font-size:0.68rem;font-weight:700;cursor:pointer;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04);color:#B3B3B3;font-family:'Space Mono',monospace;transition:all 0.15s;}
    .ex-opt-pill.active{border-color:rgba(106,13,173,0.45);background:rgba(106,13,173,0.12);color:#bf80ff;}
    .ex-sel-links{display:flex;gap:0.45rem;margin-bottom:0.5rem;}
    .ex-lnk{background:none;border:none;color:#9500ff;font-size:0.68rem;font-family:'Space Mono',monospace;cursor:pointer;text-decoration:underline;padding:0;}
    .ex-footer{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;margin-top:1rem;}
    .ex-count-lbl{font-size:0.68rem;color:#555;font-family:'Space Mono',monospace;}
    .ex-dl-btn{display:inline-flex;align-items:center;gap:0.4rem;padding:0.52rem 1.25rem;background:rgba(0,255,136,0.09);border:1px solid rgba(0,255,136,0.35);border-radius:7px;color:#00FF88;font-family:'Space Mono',monospace;font-size:0.74rem;font-weight:700;cursor:pointer;transition:all 0.2s;}
    .ex-dl-btn:hover{background:rgba(0,255,136,0.17);}
    .ex-dl-btn:disabled{opacity:0.4;cursor:not-allowed;}

    /* Toast */
    #toastMsg{position:fixed;bottom:1.5rem;right:1.5rem;background:#1a1a2a;border:1px solid rgba(106,13,173,0.4);color:#fff;padding:0.75rem 1.2rem;border-radius:8px;font-size:0.82rem;z-index:9999;display:none;box-shadow:0 8px 32px rgba(0,0,0,0.5);}
    #toastMsg.show{display:block;}

    @media(max-width:900px){.layout{grid-template-columns:1fr;}}
  </style>
</head>
<body>
<div class="layout">
  <%- include('../partials/admin-sidebar', { activePage: 'users-by-event' }) %>
  <main class="main">
    <div class="page-title">ATTENDEES</div>
    <p class="page-sub">Every individual attendee from all paid bookings — with entry status.</p>

    <% if(selectedEvent && attendees){ %>
    <div class="ev-header">
      <div>
        <div class="ev-name"><%= selectedEvent.name.toUpperCase() %></div>
        <div class="ev-meta"><%= new Date(selectedEvent.date).toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long',year:'numeric'}) %></div>
      </div>
      <div style="font-family:'Space Mono',monospace;font-size:0.68rem;letter-spacing:2px;color:var(--accent);"><%= attendees.length %> TOTAL ATTENDEES</div>
    </div>

    <% if(attendees.length > 0){ %>
    <%
      const totalMale    = attendees.filter(function(a){return a.gender==='male';}).length;
      const totalFemale  = attendees.filter(function(a){return a.gender==='female';}).length;
      const totalEntered = attendees.filter(function(a){return a.entered;}).length;
      const totalPending = attendees.length - totalEntered;

      // Build unique category list for filter chips
      const allCategories = [...new Set(attendees.map(function(a){return (a.ticketType||'').toLowerCase();}).filter(Boolean))];
    %>
    <div class="stat-row">
      <div class="stat-box"><i class="bi bi-people-fill"></i><div><div class="stat-val"><%= attendees.length %></div><div class="stat-lbl">Attendees</div></div></div>
      <div class="stat-box"><i class="bi bi-door-open-fill" style="color:#00FF88;"></i><div><div class="stat-val"><%= totalEntered %></div><div class="stat-lbl">Entered</div></div></div>
      <div class="stat-box"><i class="bi bi-hourglass-split" style="color:#FF4444;"></i><div><div class="stat-val"><%= totalPending %></div><div class="stat-lbl">Not Entered</div></div></div>
      <div class="stat-box"><i class="bi bi-gender-male" style="color:#64b5f6;"></i><div><div class="stat-val"><%= totalMale %></div><div class="stat-lbl">Male</div></div></div>
      <div class="stat-box"><i class="bi bi-gender-female" style="color:#f48fb1;"></i><div><div class="stat-val"><%= totalFemale %></div><div class="stat-lbl">Female</div></div></div>
    </div>

    <!-- Search + Age range -->
    <div class="filter-top" style="margin-bottom:0.6rem;">
      <div class="f-grp" style="flex:2;">
        <label class="f-lbl">Search</label>
        <input class="f-inp" id="searchInp" placeholder="Name, phone, email, booking ref, seat…" oninput="applyFilters()"/>
      </div>
      <div class="f-grp" style="flex:0 0 auto;min-width:180px;">
        <label class="f-lbl">Age Range</label>
        <div class="age-range">
          <input class="f-inp" id="ageMin" type="number" min="0" max="120" placeholder="Min" oninput="applyFilters()"/>
          <span class="age-sep">to</span>
          <input class="f-inp" id="ageMax" type="number" min="0" max="120" placeholder="Max" oninput="applyFilters()"/>
        </div>
      </div>
    </div>

    <!-- Gender + Status chips -->
    <div class="filter-chips">
      <span class="chip-lbl">GENDER</span>
      <button class="chip on" data-filter="gender" data-val="all"    onclick="setChip('gender','all',this)">All</button>
      <button class="chip"    data-filter="gender" data-val="male"   onclick="setChip('gender','male',this)">Male</button>
      <button class="chip"    data-filter="gender" data-val="female" onclick="setChip('gender','female',this)">Female</button>
      <button class="chip"    data-filter="gender" data-val="other"  onclick="setChip('gender','other',this)">Other</button>

      <span class="chip-lbl" style="margin-left:0.8rem;">STATUS</span>
      <button class="chip on" data-filter="entry" data-val="all"     onclick="setChip('entry','all',this)">All</button>
      <button class="chip"    data-filter="entry" data-val="entered" onclick="setChip('entry','entered',this)">✅ Entered</button>
      <button class="chip"    data-filter="entry" data-val="pending" onclick="setChip('entry','pending',this)">⏳ Not Entered</button>

      <% if(allCategories.length > 1){ %>
      <span class="chip-lbl" style="margin-left:0.8rem;">CATEGORY</span>
      <button class="chip on" data-filter="category" data-val="all" onclick="setChip('category','all',this)">All</button>
      <% allCategories.forEach(function(cat){ %>
      <button class="chip" data-filter="category" data-val="<%= cat %>" onclick="setChip('category','<%= cat %>',this)"><%= cat.toUpperCase() %></button>
      <% }); %>
      <% } %>
    </div>

    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.7rem;margin-bottom:1rem;">
      <button class="export-btn" onclick="openAttExport()"><i class="bi bi-file-earmark-spreadsheet-fill"></i> Export Excel</button>
    </div>

    <div class="results-count" id="resultsCount"><%= attendees.length %> of <%= attendees.length %> shown</div>

    <div class="table-wrap">
      <div class="table-scroll">
      <table id="attTable">
        <thead><tr>
          <th>#</th>
          <th>Name</th>
          <th>Age</th>
          <th>Gender</th>
          <th>Ticket</th>
          <th>Seat</th>
          <th>Booking Ref</th>
          <th>Booked On</th>
          <th>Status</th>
        </tr></thead>
        <tbody>
        <% attendees.forEach(function(a, i){ %>
        <tr
          data-gender="<%= a.gender||'other' %>"
          data-age="<%= a.age||0 %>"
          data-entry="<%= a.entered?'entered':'pending' %>"
          data-category="<%= (a.ticketType||'').toLowerCase() %>"
          data-phone="<%= a.user&&a.user.phone?a.user.phone:'' %>"
          data-name="<%= (a.name||'').replace(/'/g,'') %>"
          data-search="<%= ((a.name||'')+(a.user&&a.user.email?a.user.email:'')+(a.user&&a.user.phone?a.user.phone:'')+(a.bookingRef||'')+(a.seatNumber||'')).toLowerCase() %>">
          <td style="color:var(--muted);font-family:'Space Mono',monospace;font-size:0.7rem;" class="row-num"><%= i+1 %></td>
          <td>
            <strong><%= a.name||'—' %></strong>
            <% if(a.user&&a.user.email){ %><div style="font-size:0.7rem;color:#555;"><%= a.user.email %></div><% } %>
          </td>
          <td style="color:var(--muted);text-align:center;"><%= a.age||'—' %></td>
          <td>
            <% if(a.gender==='male'){ %><span class="b b-m">♂ M</span>
            <% }else if(a.gender==='female'){ %><span class="b b-f">♀ F</span>
            <% }else if(a.gender){ %><span class="b b-o"><%= a.gender %></span>
            <% }else{ %><span style="color:#444;">—</span><% } %>
          </td>
          <td><span class="b b-ticket"><%= (a.ticketType||'—').toUpperCase() %></span></td>
          <td style="font-family:'Space Mono',monospace;font-size:0.7rem;color:#555;"><%= a.seatNumber||'—' %></td>
          <td style="font-family:'Space Mono',monospace;font-size:0.68rem;color:var(--accent);"><%= a.bookingRef||'—' %></td>
          <td style="font-size:0.72rem;color:var(--muted);white-space:nowrap;"><%= new Date(a.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %></td>
          <td>
            <% if(a.entered){ %>
              <span class="b b-in"><i class="bi bi-door-open-fill"></i> Entered</span>
              <% if(a.usedAt){ %><div style="font-size:0.6rem;color:#555;margin-top:2px;"><%= new Date(a.usedAt).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %></div><% } %>
            <% }else{ %>
              <span class="b b-out"><i class="bi bi-hourglass-split"></i> Not In</span>
            <% } %>
          </td>
        </tr>
        <% }); %>
        </tbody>
      </table>
      </div>
    </div>

    <% }else{ %>
    <div class="empty"><i class="bi bi-people"></i>No paid bookings for this event yet.</div>
    <% } %>
    <% }else{ %>
    <div class="empty"><i class="bi bi-calendar-event"></i>No active event found. Activate an event to view attendees.</div>
    <% } %>
  </main>
</div>

<!-- Export Modal -->
<div class="ex-modal-bg" id="attExportModal">
  <div class="ex-modal">
    <button class="ex-modal-close" onclick="closeAttExport()"><i class="bi bi-x-lg"></i></button>
    <h3><i class="bi bi-file-earmark-spreadsheet-fill" style="color:#00FF88;margin-right:6px;"></i>EXPORT ATTENDEES</h3>
    <div class="ex-sub">Choose scope and fields for your Excel download</div>
    <div class="ex-sec">
      <div class="ex-sec-title">Which attendees to export</div>
      <div class="ex-opt-pills">
        <div class="ex-opt-pill active" id="att-scope-filtered" onclick="setAttScope('filtered',this)"><i class="bi bi-funnel-fill"></i> Current Filter</div>
        <div class="ex-opt-pill" id="att-scope-all" onclick="setAttScope('all',this)"><i class="bi bi-people-fill"></i> All Attendees</div>
      </div>
    </div>
    <div class="ex-sec">
      <div class="ex-sec-title">Fields to include</div>
      <div class="ex-sel-links">
        <button class="ex-lnk" onclick="attSelAll(true)">Select all</button>
        <span style="color:#333;">·</span>
        <button class="ex-lnk" onclick="attSelAll(false)">Clear all</button>
      </div>
      <div class="ex-fields-grid" id="attFieldsGrid"></div>
    </div>
    <div class="ex-footer">
      <span class="ex-count-lbl" id="attExCount">—</span>
      <button class="ex-dl-btn" id="attExBtn" onclick="doAttExport()"><i class="bi bi-download"></i> Download Excel</button>
    </div>
  </div>
</div>

<div id="toastMsg"></div>

<script>
var ATT_FIELDS = [
  { key:'num',     label:'#',             get:function(r){ var e=r.querySelector('.row-num'); return e?e.textContent.trim():''; } },
  { key:'name',    label:'Name',          get:function(r){ return r.dataset.name||''; } },
  { key:'email',   label:'Email',         get:function(r){ var e=r.querySelector('td:nth-child(2) div'); return e?e.textContent.trim():''; } },
  { key:'phone',   label:'Phone',         get:function(r){ return r.dataset.phone||''; } },
  { key:'age',     label:'Age',           get:function(r){ return r.dataset.age||''; } },
  { key:'gender',  label:'Gender',        get:function(r){ return r.dataset.gender||''; } },
  { key:'ticket',  label:'Ticket Type',   get:function(r){ var e=r.querySelector('.b-ticket'); return e?e.textContent.trim():''; } },
  { key:'seat',    label:'Seat Number',   get:function(r){ var e=r.querySelector('td:nth-child(6)'); return e?e.textContent.trim():''; } },
  { key:'ref',     label:'Booking Ref',   get:function(r){ var e=r.querySelector('td:nth-child(7)'); return e?e.textContent.trim():''; } },
  { key:'booked',  label:'Booked On',     get:function(r){ var e=r.querySelector('td:nth-child(8)'); return e?e.textContent.trim():''; } },
  { key:'entry',   label:'Entry Status',  get:function(r){ return r.dataset.entry==='entered'?'Entered':'Not Entered'; } },
];
var attDefaultOn = ['name','phone','age','gender','ticket','seat','ref','booked','entry'];
var attExScope = 'filtered';

function openAttExport(){
  var grid = document.getElementById('attFieldsGrid');
  grid.innerHTML = '';
  ATT_FIELDS.forEach(function(f){
    var on = attDefaultOn.indexOf(f.key) !== -1;
    var lbl = document.createElement('label');
    lbl.className = 'ex-field' + (on?' on':'');
    lbl.innerHTML = '<input type="checkbox" value="'+f.key+'"'+(on?' checked':'')+'>  <span>'+f.label+'</span>';
    lbl.querySelector('input').addEventListener('change', function(e){
      lbl.classList.toggle('on', e.target.checked); updateAttExCount();
    });
    grid.appendChild(lbl);
  });
  attExScope = 'filtered';
  document.getElementById('att-scope-filtered').classList.add('active');
  document.getElementById('att-scope-all').classList.remove('active');
  updateAttExCount();
  document.getElementById('attExportModal').classList.add('open');
}
function closeAttExport(){ document.getElementById('attExportModal').classList.remove('open'); }
function setAttScope(scope, el){
  attExScope = scope;
  document.querySelectorAll('.ex-opt-pill').forEach(function(p){ p.classList.remove('active'); });
  el.classList.add('active'); updateAttExCount();
}
function attSelAll(val){
  document.querySelectorAll('#attFieldsGrid .ex-field').forEach(function(el){
    el.classList.toggle('on', val); el.querySelector('input').checked = val;
  }); updateAttExCount();
}
function getAttExRows(){
  var all = Array.from(document.querySelectorAll('#attTable tbody tr'));
  if(attExScope === 'all') return all;
  return all.filter(function(r){ return r.style.display !== 'none'; });
}
function updateAttExCount(){
  var rows = getAttExRows();
  var checked = document.querySelectorAll('#attFieldsGrid input:checked').length;
  document.getElementById('attExCount').textContent = rows.length+' attendees · '+checked+' fields';
  document.getElementById('attExBtn').disabled = checked === 0 || rows.length === 0;
}
function doAttExport(){
  var rows = getAttExRows();
  var keys = Array.from(document.querySelectorAll('#attFieldsGrid input:checked')).map(function(i){ return i.value; });
  var fields = ATT_FIELDS.filter(function(f){ return keys.indexOf(f.key) !== -1; });
  if(!fields.length || !rows.length) return;
  var evName = document.querySelector('.ev-name');
  var sheetName = evName ? evName.textContent.trim().slice(0,28).replace(/[^\w\s]/g,'') : 'Attendees';
  var data = [fields.map(function(f){ return f.label; })];
  rows.forEach(function(r){ data.push(fields.map(function(f){ return f.get(r)||''; })); });
  function write(){
    var wb = XLSX.utils.book_new();
    var ws = XLSX.utils.aoa_to_sheet(data);
    ws['!cols'] = data[0].map(function(_,i){ return { wch: Math.max(14, Math.max.apply(null, data.map(function(r){ return String(r[i]||'').length; }))) }; });
    XLSX.utils.book_append_sheet(wb, ws, sheetName||'Attendees');
    XLSX.writeFile(wb, 'attendees-'+new Date().toISOString().slice(0,10)+'.xlsx');
    closeAttExport();
    showToast('Exported '+rows.length+' attendees to Excel.');
  }
  if(typeof XLSX === 'undefined'){
    var s = document.createElement('script'); s.src = 'https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js'; s.onload = write; document.head.appendChild(s);
  } else { write(); }
}
document.getElementById('attExportModal').addEventListener('click', function(e){ if(e.target===this) closeAttExport(); });

// ── Filters ──
var activeFilters = { gender:'all', entry:'all', category:'all' };

function setChip(filter, val, btn){
  activeFilters[filter] = val;
  document.querySelectorAll('[data-filter="'+filter+'"]').forEach(function(c){ c.classList.remove('on'); });
  btn.classList.add('on');
  applyFilters();
}

function applyFilters(){
  var q       = (document.getElementById('searchInp').value||'').toLowerCase();
  var ageMinV = parseInt(document.getElementById('ageMin').value) || 0;
  var ageMaxV = parseInt(document.getElementById('ageMax').value) || 999;

  var rows = document.querySelectorAll('#attTable tbody tr');
  var shown = 0;
  rows.forEach(function(r){
    var gender   = r.dataset.gender  || 'other';
    var age      = parseInt(r.dataset.age) || 0;
    var entry    = r.dataset.entry;
    var category = r.dataset.category || '';
    var search   = r.dataset.search   || '';

    var gOk = activeFilters.gender   === 'all' || gender   === activeFilters.gender;
    var eOk = activeFilters.entry    === 'all' || entry    === activeFilters.entry;
    var cOk = activeFilters.category === 'all' || category === activeFilters.category;
    var aOk = age >= ageMinV && age <= ageMaxV;
    // If age is 0/missing and no range entered, show it
    if(age === 0 && ageMinV === 0 && ageMaxV === 999) aOk = true;
    var sOk = !q || search.includes(q);

    var show = gOk && eOk && cOk && aOk && sOk;
    r.style.display = show ? '' : 'none';
    if(show) shown++;
  });

  var rc = document.getElementById('resultsCount');
  if(rc) rc.textContent = shown + ' of ' + rows.length + ' shown';

  // Renumber
  var num = 1;
  rows.forEach(function(r){
    if(r.style.display !== 'none'){
      var nd = r.querySelector('.row-num');
      if(nd) nd.textContent = num++;
    }
  });
}

function showToast(msg){
  var t = document.getElementById('toastMsg');
  t.textContent = msg; t.classList.add('show');
  setTimeout(function(){ t.classList.remove('show'); }, 3500);
}
</script>
</body>
