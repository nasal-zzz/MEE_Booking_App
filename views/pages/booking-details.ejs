      </div>
      <div class="att-fields">
        <div>
          <label class="form-label">Full Name *</label>
          <input type="text" class="form-inp" id="n-${n}"
            placeholder="Full name" autocomplete="off"/>
          <div class="field-err" id="ne-${n}"><i class="bi bi-exclamation-circle"></i> Name required</div>
        </div>
        <div>
          <label class="form-label">Age *${ageLimitHint}</label>
          <input type="number" class="form-inp" id="a-${n}"
            placeholder="${minAge > 1 ? minAge : '25'}" min="${minAge}" max="120" inputmode="numeric"/>
          <div class="field-err" id="ae-${n}"><i class="bi bi-exclamation-circle"></i>
            <span id="ae-msg-${n}">Valid age required</span></div>
        </div>
        <div>
          <label class="form-label">Gender *</label>
          <select class="form-inp" id="g-${n}" style="cursor:pointer;">
            <option value="">Select gender</option>
            <option value="male">Male</option>
            <option value="female">Female</option>
            <option value="other">Other / Prefer not to say</option>
          </select>
          <div class="field-err" id="ge-${n}"><i class="bi bi-exclamation-circle"></i> Gender required</div>
        </div>
      </div>
      <div class="special-toggle" onclick="document.getElementById('sp-${n}').classList.toggle('show')">
        <i class="bi bi-chat-left-text"></i> Add special request
      </div>
      <textarea class="special-inp" id="sp-${n}" rows="2" placeholder="E.g. wheelchair access..."></textarea>`;
  }

  // ── Real-time validation wiring ──────────────────────────────────
  setTimeout(function(){
    const nf = document.getElementById('n-' + n);
    const af = document.getElementById('a-' + n);
    const gf = document.getElementById('g-' + n);
    const _minAge = (selTicketData && selTicketData.ageLimit > 0) ? selTicketData.ageLimit : 1;

    function clearErr(inp, errId){ inp.classList.remove('err'); document.getElementById(errId).classList.remove('show'); }
    function showErrInp(inp, errId, msg){
      inp.classList.add('err');
      const errEl = document.getElementById(errId);
      errEl.classList.add('show');
      if(msg){ const span = document.getElementById('ae-msg-' + n); if(span && errId === 'ae-' + n) span.textContent = msg; }
    }
    if(nf){
      nf.addEventListener('blur',  () => { if(nf.value.trim().length >= 2) clearErr(nf,'ne-'+n); else showErrInp(nf,'ne-'+n); });
      nf.addEventListener('input', () => { if(nf.classList.contains('err') && nf.value.trim().length >= 2) clearErr(nf,'ne-'+n); });
    }
    if(af){
      function ageOk(v){ return !isNaN(v) && v >= _minAge && v <= 120; }
      function getAgeErrMsg(v){
        if(isNaN(v) || !af.value) return 'Age is required';
        if(_minAge > 1 && v < _minAge) return 'Must be ' + _minAge + '+ years old for this ticket';
        if(v > 120) return 'Please enter a valid age';
        return 'Valid age required';
      }
      af.addEventListener('blur',  () => { const v=parseInt(af.value); if(ageOk(v)) clearErr(af,'ae-'+n); else showErrInp(af,'ae-'+n, getAgeErrMsg(v)); });
      af.addEventListener('input', () => { if(af.classList.contains('err') && ageOk(parseInt(af.value))) clearErr(af,'ae-'+n); });
    }
    if(gf){
      gf.addEventListener('change', () => { if(gf.value) clearErr(gf,'ge-'+n); else showErrInp(gf,'ge-'+n); });
    }
  }, 0);

  return el;
}

// ─── EMAIL VERIFY HELPERS ────────────────────────────────────────
function onBookingEmailInput(inp) {
  const val = inp.value.trim();
  const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
  const btn  = document.getElementById('bk-emailVerifyBtn');
  const wrap = document.getElementById('bk-emailWrap');
  if (!btn) return;

  // If user edits email after already verifying, reset verification state
  if (_bookingEmailVerified && val !== _bookingVerifiedEmail) {
    _bookingEmailVerified = false;
    _bookingVerifiedEmail = '';
    if (wrap) wrap.style.borderColor = '';
    const badge = document.getElementById('bk-emailVerifiedBadge');
    if (badge) badge.style.display = 'none';
    btn.innerHTML = '<i class="bi bi-patch-check-fill"></i> VERIFY';
    btn.style.background = '';
    btn.style.color = '#bf80ff';
    btn.style.borderLeftColor = 'rgba(106,13,173,0.3)';
    btn.style.pointerEvents = '';
  }

btn.style.display = (valid && !_bookingEmailVerified) ? 'flex' : 'none';
const emErr2 = document.getElementById('em-err-1');
  if(emErr2) emErr2.classList.remove('show');
  inp.classList.remove('err');
  const wrap2 = document.getElementById('bk-emailWrap');
  if(wrap2 && !_bookingEmailVerified) wrap2.style.borderColor = '';

}

async function triggerBookingEmailVerify() {
  const inp   = document.getElementById('em-1');
  const email = inp ? inp.value.trim() : '';
  if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return;

  const btn = document.getElementById('bk-emailVerifyBtn');
  btn.innerHTML = '<i class="bi bi-hourglass-split"></i>';
  btn.style.pointerEvents = 'none';

  try {
    const r = await fetch('/auth/send-email-otp', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ email }),
    });
    const d = await r.json();

    btn.style.pointerEvents = '';
    btn.innerHTML = '<i class="bi bi-patch-check-fill"></i> VERIFY';

    if (!d.success) {
      const errEl = document.getElementById('em-err-1');
      if (errEl) { errEl.innerHTML = `<i class="bi bi-exclamation-circle"></i> ${d.message || 'Failed to send OTP.'}`; errEl.classList.add('show'); }
      return;
    }

    EmailOTPModal.open({
      email,
      onVerified(verifiedAddr) {
        _bookingEmailVerified = true;
        _bookingVerifiedEmail = verifiedAddr;
        if (inp) { inp.value = verifiedAddr; inp.setAttribute('readonly', true); inp.style.opacity = '.7'; inp.style.cursor = 'not-allowed'; }
        const wrap = document.getElementById('bk-emailWrap');
        if (wrap) wrap.style.borderColor = 'rgba(0,255,136,0.3)';
        btn.innerHTML = '<i class="bi bi-check-circle-fill"></i> VERIFIED';
        btn.style.background    = 'rgba(0,255,136,0.1)';
        btn.style.color         = '#00FF88';
        btn.style.borderLeftColor = 'rgba(0,255,136,0.3)';
        btn.style.pointerEvents = 'none';
        const badge = document.getElementById('bk-emailVerifiedBadge');
        if (badge) badge.style.display = 'flex';
        const errEl = document.getElementById('em-err-1');
        if (errEl) errEl.classList.remove('show');
      },
    });
  } catch(e) {
    btn.style.pointerEvents = '';
    btn.innerHTML = '<i class="bi bi-patch-check-fill"></i> VERIFY';
    showToast('Network error', 'Could not send verification email. Try again.', 'error');
  }
}

// ─── SUMMARY ─────────────────────────────────────────────────────
function setEl(id, val){ var e=document.getElementById(id); if(e) e.textContent=val; }

function updateSummary(){
  const sub = qty * price;
  let comboDisc = 0, comboNudgeMsg = '';
  const tiers = (selTicketData && Array.isArray(selTicketData.discountTiers) && selTicketData.discountTiers.length > 0)
    ? selTicketData.discountTiers.filter(d=>d.minQty>0&&d.discount>0).sort((a,b)=>a.minQty-b.minQty)
    : (selTicketData && selTicketData.comboOfferMinQty>0
        ? [{minQty:selTicketData.comboOfferMinQty, discount:selTicketData.comboOfferDiscount}]
        : []);

  if(tiers.length > 0){
    const applicable = tiers.filter(d=>qty>=d.minQty).sort((a,b)=>b.minQty-a.minQty);
    if(applicable.length > 0){ const best=applicable[0]; comboDisc=Math.floor(qty/best.minQty)*best.discount; }
    const next = tiers.find(d=>qty<d.minQty);
    if(next){ const need=next.minQty-qty; comboNudgeMsg=`Add ${need} more ticket${need>1?'s':''} → unlock ₹${next.discount.toLocaleString('en-IN')} off!`; }
  }

  const disc  = Math.max(couponApplied ? discAmt : 0, comboDisc);
  const total = Math.max(sub - disc + CONV_FEE, 0);

  setEl('sumType',    selTypeName||'—');
  setEl('sumPrice',   price?'₹'+price.toLocaleString('en-IN'):'—');
  setEl('sumQty',     '× '+qty);
  setEl('sumSub',     price?'₹'+sub.toLocaleString('en-IN'):'—');
  setEl('sumTotal',   price?'₹'+total.toLocaleString('en-IN'):'—');
  setEl('qtyTotalAmt',price?'₹'+sub.toLocaleString('en-IN'):'—');
  setEl('mobTotal',   price?'₹'+total.toLocaleString('en-IN'):'—');

  const discRow    = document.getElementById('discRow');
  const discVal    = document.getElementById('discVal');
  const comboNudge = document.getElementById('comboOfferNudge');

  if(comboDisc > 0){
    if(discRow) discRow.classList.add('show');
    if(discVal){ discVal.textContent='-₹'+disc.toLocaleString('en-IN'); discVal.style.color='#f5c842'; }
    if(comboNudge) comboNudge.style.display = comboNudgeMsg ? 'flex' : 'none';
    if(comboNudgeMsg){ var cnTxt=comboNudge.querySelector('.cn-text'); if(cnTxt) cnTxt.textContent=comboNudgeMsg; }
  } else if(tiers.length > 0 && comboNudgeMsg){
    if(comboNudge){ comboNudge.style.display='flex'; var cnTxt2=comboNudge.querySelector('.cn-text'); if(cnTxt2) cnTxt2.textContent=comboNudgeMsg; }
    if(!couponApplied){ if(discRow) discRow.classList.remove('show'); }
    else { if(discRow) discRow.classList.add('show'); if(discVal){ discVal.textContent='-₹'+discAmt.toLocaleString('en-IN'); discVal.style.color='#00FF88'; } }
  } else {
    if(comboNudge) comboNudge.style.display='none';
    if(couponApplied){ if(discRow) discRow.classList.add('show'); if(discVal){ discVal.textContent='-₹'+discAmt.toLocaleString('en-IN'); discVal.style.color='#00FF88'; } }
    else { if(discRow) discRow.classList.remove('show'); }
  }
  return total;
}

// ─── TERMS & CONDITIONS ───────────────────────────────────────────
var _termsOpen = false;

function renderTerms(){
  var terms = selTicketData && selTicketData.terms ? selTicketData.terms.trim() : '';
  var sec   = document.getElementById('termsSection');
  if(!terms || !sec) return;
  document.getElementById('termsContent').textContent = terms;
  var displayName = (selTicketData.name || selTypeName).toUpperCase();
  document.getElementById('termsCatBadge').textContent   = displayName;
  document.getElementById('termsAgreeLabel').textContent = displayName;
  sec.style.display = 'block';
  setTimeout(function(){ openTerms(); }, 450);
}
function openTerms(){
  _termsOpen = true;
  document.getElementById('termsBody').classList.add('open');
  document.getElementById('termsChevron').classList.add('open');
  document.getElementById('termsHd').classList.add('open');
}
function toggleTerms(){
  _termsOpen = !_termsOpen;
  document.getElementById('termsBody').classList.toggle('open', _termsOpen);
  document.getElementById('termsChevron').classList.toggle('open', _termsOpen);
  document.getElementById('termsHd').classList.toggle('open', _termsOpen);
}
function onTermsChange(){
  if(document.getElementById('termsCheckbox').checked)
    document.getElementById('termsErr').classList.remove('show');
}
function termsAccepted(){
  var sec = document.getElementById('termsSection');
  if(!sec || sec.style.display === 'none') return true;
  var cb = document.getElementById('termsCheckbox');
  if(!cb.checked){
    document.getElementById('termsErr').classList.add('show');
    openTerms();
    cb.scrollIntoView({ behavior:'smooth', block:'center' });
    showToast('Terms & Conditions', 'Please read and accept the terms before paying.', 'warning', 4000);
    return false;
  }
  return true;
}

// ─── COUPON ────────────────────────────────────────────────────────
function applyCoupon(){
  var code = document.getElementById('couponInp').value.trim().toUpperCase();
  if(!code){ showCouponMsg('Enter a coupon code first.', false); return; }
  if(!selTypeName){ showCouponMsg('Select a ticket type first.', false); return; }
  var btn = document.querySelector('.coupon-btn');
  btn.textContent = '...'; btn.disabled = true;
  fetch('/superadmin/api/validate-coupon', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    credentials: 'include',
    body: JSON.stringify({ code, orderAmount: qty * price, quantity: qty })
  })
  .then(r => r.json())
  .then(d => {
    if(d.success){
      couponApplied=true; discAmt=d.discount; couponCode=d.code;
      showCouponMsg(d.code + ' applied — ' + formatRupee(d.discount) + ' off!', true);
      document.getElementById('couponInp').style.borderColor='#00FF88';
      document.getElementById('couponInp').disabled=true;
      btn.textContent='REMOVE'; btn.disabled=false; btn.onclick=removeCoupon;
    } else {
      couponApplied=false; discAmt=0; couponCode=null;
      showCouponMsg(d.message||'Invalid coupon code.', false);
      document.getElementById('couponInp').style.borderColor='#FF4444';
      setTimeout(()=>{ document.getElementById('couponInp').style.borderColor=''; }, 3000);
    }
    updateSummary();
  })
  .catch(()=>{ showCouponMsg('Network error. Please try again.', false); })
  .finally(()=>{ btn.textContent='APPLY'; btn.disabled=false; });
}
function removeCoupon(){
  couponApplied=false; discAmt=0; couponCode=null;
  var inp=document.getElementById('couponInp');
  inp.value=''; inp.disabled=false; inp.style.borderColor='';
  var btn=document.querySelector('.coupon-btn');
  btn.textContent='APPLY'; btn.onclick=applyCoupon;
  document.getElementById('couponMsg').classList.remove('show');
  updateSummary();
}
function showCouponMsg(text, isSuccess){
  var msgEl=document.getElementById('couponMsg');
  var icon=isSuccess
    ? '<i class="bi bi-check-circle-fill" style="color:#00FF88;"></i><span style="color:#00FF88;">'
    : '<i class="bi bi-x-circle-fill" style="color:#FF4444;"></i><span style="color:#FF4444;">';
  msgEl.innerHTML=icon+text+'</span>';
  msgEl.classList.add('show');
  if(!isSuccess) setTimeout(()=>{ msgEl.classList.remove('show'); }, 4000);
}
function formatRupee(n){ return '\u20b9' + n.toLocaleString('en-IN'); }

document.getElementById('couponInp').addEventListener('keydown', function(e){
  if(e.key==='Enter') applyCoupon();
});

// ─── VALIDATE ─────────────────────────────────────────────────────
function validate(){
  let ok = true;
  const total = isMultiEntry ? multiCount : qty;
  const _minAge = (selTicketData && selTicketData.ageLimit > 0) ? selTicketData.ageLimit : 1;
  let firstErrScrolled = false;

  for(let i = 1; i <= total; i++){
    const n = document.getElementById('n-' + i);
    const a = document.getElementById('a-' + i);
    const g = document.getElementById('g-' + i);

    document.getElementById('ne-'+i).classList.remove('show'); n.classList.remove('err');
    document.getElementById('ae-'+i).classList.remove('show'); a.classList.remove('err');
    if(g){ document.getElementById('ge-'+i).classList.remove('show'); g.classList.remove('err'); }

    if(!n.value.trim() || n.value.trim().length < 2){
      n.classList.add('err'); document.getElementById('ne-'+i).classList.add('show');
      if(!firstErrScrolled){ n.scrollIntoView({behavior:'smooth',block:'center'}); firstErrScrolled=true; }
      ok=false;
    }
    const age=parseInt(a.value);
    const ageValid=!isNaN(age) && age>=_minAge && age<=120;
    if(!a.value || !ageValid){
      a.classList.add('err'); document.getElementById('ae-'+i).classList.add('show');
      const ageErrMsg=document.getElementById('ae-msg-'+i);
      if(ageErrMsg){
        if(!a.value||isNaN(age)) ageErrMsg.textContent='Age is required';
        else if(_minAge>1&&age<_minAge) ageErrMsg.textContent='Attendee '+i+' must be '+_minAge+'+ years old for this ticket';
        else if(age>120) ageErrMsg.textContent='Please enter a valid age';
        else ageErrMsg.textContent='Valid age required';
      }
      if(!firstErrScrolled){ a.scrollIntoView({behavior:'smooth',block:'center'}); firstErrScrolled=true; }
      ok=false;
    }
    if(g && !g.value){
      g.classList.add('err'); document.getElementById('ge-'+i).classList.add('show');
      if(!firstErrScrolled){ g.scrollIntoView({behavior:'smooth',block:'center'}); firstErrScrolled=true; }
      ok=false;
    }
  }

  // ── Email entered but not verified ──────────────────────────────
  const emInp = document.getElementById('em-1');
  const emErr = document.getElementById('em-err-1');
  if(emInp && !emInp.readOnly && emErr){
    const emVal = emInp.value.trim();
    const emHasValue = emVal.length > 0;
    const emValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emVal);
    if(emHasValue && emValid && !_bookingEmailVerified){
      emInp.classList.add('err');
      emErr.innerHTML = '<i class="bi bi-exclamation-circle"></i> Please verify your email before proceeding';
      emErr.classList.add('show');
      const wrap = document.getElementById('bk-emailWrap');
      if(wrap) wrap.style.borderColor = 'rgba(255,68,68,0.5)';
      if(!firstErrScrolled){ emInp.scrollIntoView({behavior:'smooth',block:'center'}); firstErrScrolled=true; }
      showToast('Email not verified', 'Please verify your email or leave it empty to skip.', 'warning', 5000);
      ok = false;
    } else if(emHasValue && !emValid){
      // invalid format — also flag it
      emInp.classList.add('err');
      emErr.innerHTML = '<i class="bi bi-exclamation-circle"></i> Enter a valid email address';
      emErr.classList.add('show');
      if(!firstErrScrolled){ emInp.scrollIntoView({behavior:'smooth',block:'center'}); firstErrScrolled=true; }
      ok = false;
  } else {
      emInp.classList.remove('err');
      emErr.classList.remove('show');
      const emWrapClear = document.getElementById('bk-emailWrap');
      if(emWrapClear) emWrapClear.style.borderColor = '';
    }
  }

  if(!USER.whatsapp){
    const waEl=document.getElementById('wa-1');
    const waErr=document.getElementById('wa-err-1');
    if(waEl && waErr){
      waErr.classList.remove('show'); waEl.classList.remove('err');
      if(!waEl.value.trim() || waEl.value.trim().length < 10){
        waEl.classList.add('err'); waErr.classList.add('show');
        if(!firstErrScrolled){ waEl.scrollIntoView({behavior:'smooth',block:'center'}); firstErrScrolled=true; }
        ok=false;
      }
    }
  }

  if(!ok && _minAge > 1){
    const ageViolators=[];
    for(let i=1;i<=total;i++){
      const a=document.getElementById('a-'+i);
      const age=parseInt(a?a.value:'');
      if(!isNaN(age) && age<_minAge) ageViolators.push('Attendee '+i);
    }
    if(ageViolators.length>0){
      showToast('Age restriction',
        ageViolators.join(', ')+(ageViolators.length===1?' does':' do')+' not meet the minimum age of '+_minAge+' for this ticket.',
        'warning', 6000);
    }
  }
  return ok;
}

// ─── TOAST ────────────────────────────────────────────────────────
function showToast(title, msg, type, duration){
  duration = duration || 4000;
  var icons = { success:'bi-check-circle-fill', error:'bi-x-circle-fill', warning:'bi-exclamation-triangle-fill', info:'bi-info-circle-fill' };
  var container = document.getElementById('toast-container');
  var el = document.createElement('div');
  el.className = 'toast-msg ' + (type||'info');
  el.innerHTML = '<i class="bi '+(icons[type]||icons.info)+' toast-icon"></i>' +
    '<div class="toast-body"><div class="toast-title">'+title+'</div>' +
    (msg?'<div class="toast-sub">'+msg+'</div>':'')+
    '</div>';
  container.appendChild(el);
  setTimeout(function(){
    el.style.animation='toastOut 0.3s ease forwards';
    setTimeout(function(){ el.remove(); }, 300);
  }, duration);
}

// ─── PAYMENT FAILED OVERLAY ────────────────────────────────────────
var _lastOrderId = null, _lastPayData = null, _paymentCompleted = false, _paymentFailed = false;

function showPayFailed(errMsg){
  document.getElementById('pfErrorMsg').textContent = errMsg || 'Please try again or use a different payment method.';
  document.getElementById('payFailedOverlay').classList.add('show');
  setLoading(false);
}
function closePayFailed(){
  document.getElementById('payFailedOverlay').classList.remove('show');
  setLoading(false);
}
function retryFromOverlay(){
  document.getElementById('payFailedOverlay').classList.remove('show');
  setLoading(false);
  if(_lastPayData){ _paymentFailed=false; setTimeout(function(){ launchRazorpay(_lastPayData); }, 200); }
}

// ─── PAYMENT ──────────────────────────────────────────────────────
function doPayment(){
  if(!selTypeName){ showToast('Select a ticket type','Please choose a ticket category before proceeding.','warning'); return; }
  if(!validate()) return;
  if(!termsAccepted()) return;

  var attendees = [];
  var total = isMultiEntry ? multiCount : qty;
  for(var i = 1; i <= total; i++){
    var gEl=document.getElementById('g-'+i);
    var spEl=document.getElementById('sp-'+i);
    attendees.push({
      name:    document.getElementById('n-'+i).value.trim(),
      age:     document.getElementById('a-'+i).value,
      gender:  gEl ? gEl.value : '',
      special: spEl ? spEl.value : ''
    });
  }
  var emailVal    = (document.getElementById('em-1')?.value||'').trim() || USER.email    || '';
  var whatsappVal = (document.getElementById('wa-1')?.value||'').trim() || USER.whatsapp || '';
  var submitQty   = isMultiEntry ? 1 : qty;

  setLoading(true);
  fetch('/booking/create-order', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    credentials: 'include',
    body: JSON.stringify({
      eventId: EVENT_DATA._id, ticketType: selTypeName,
      quantity: submitQty, couponCode: couponCode,
      attendees: attendees, zone: selZone,
      comboCount: isMultiEntry ? multiCount : 1,
      email: emailVal, whatsapp: whatsappVal
    })
  })
  .then(r => r.json())
  .then(data => {
    if(!data.success){ showToast('Order failed', data.message||'Please try again.', 'error'); setLoading(false); return; }
    _lastPayData = data;
    launchRazorpay(data);
  })
  .catch(()=>{ showToast('Network error','Please check your connection and try again.','error'); setLoading(false); });
}

function launchRazorpay(data){
  _paymentFailed=false; _paymentCompleted=false;
  var rzp = new Razorpay({
    key: data.key, amount: data.amount, currency: data.currency,
    name: 'Melattur Entertainment Events',
    description: selTypeName.toUpperCase() + ' x ' + qty,
    order_id: data.orderId, prefill: data.prefill,
    theme: { color:'#6A0DAD', backdrop_color:'#0B0B0F' },
    modal: {
      ondismiss: function(){
        if(_paymentCompleted||_paymentFailed){ setLoading(false); return; }
        setTimeout(function(){
          if(_paymentCompleted||_paymentFailed) return;
          fetch('/booking/save-pending',{
            method:'POST', headers:{'Content-Type':'application/json'},
            credentials:'include', body:JSON.stringify({orderId:data.orderId})
          }).catch(()=>{});
          setLoading(false);
        }, 900);
      }
    },
    handler: function(response){
      _paymentCompleted=true;
      showToast('Verifying payment','Please wait a moment...','info',9000);
      fetch('/booking/verify-payment',{
        method:'POST', headers:{'Content-Type':'application/json'},
        credentials:'include',
        body:JSON.stringify({
          razorpay_payment_id: response.razorpay_payment_id,
          razorpay_order_id:   response.razorpay_order_id,
          razorpay_signature:  response.razorpay_signature
        })
      })
      .then(r=>r.json())
      .then(vdata=>{
        if(vdata.success){
          sessionStorage.removeItem('np_sel');
          window.location.href='/booking/success/'+vdata.bookingId;
        } else {
          showToast('Confirmation failed','Payment ID: '+response.razorpay_payment_id+'. Contact support.','error',12000);
          setLoading(false);
        }
      })
      .catch(()=>{ showToast('Network error','Could not verify payment. Please contact support.','error',12000); setLoading(false); });
    }
  });
  rzp.on('payment.failed', function(r){
    _paymentFailed=true;
    var errMsg = r.error&&r.error.description ? r.error.description : 'Payment could not be processed.';
    fetch('/booking/save-failed',{
      method:'POST', headers:{'Content-Type':'application/json'},
      credentials:'include', body:JSON.stringify({orderId:data.orderId, error:errMsg})
    }).catch(()=>{});
    showPayFailed(errMsg);
  });
  rzp.open();
}

function setLoading(on){
  document.getElementById('payBtn').disabled=on;
  document.getElementById('payBtnTxt').style.display=on?'none':'flex';
  document.getElementById('paySpinner').style.display=on?'block':'none';
}
</script>
</body>
</html>
