          <label class="form-label">Phone</label>
          <input type="tel" class="form-inp" value="${USER.phone}"
            readonly style="opacity:0.6;cursor:not-allowed;"/>
        </div>
        ${emailFieldHTML}
        <div style="grid-column:1/-1;">
          <label class="form-label">WhatsApp Number ${USER.whatsapp ? '' : '<span style="color:#FF4444;">*</span>'}</label>
          <input type="tel" class="form-inp" id="wa-1"
            placeholder="91XXXXXXXXXX"
            value="${USER.whatsapp || USER.phone || ''}"
            ${USER.whatsapp ? 'readonly style="opacity:0.6;cursor:not-allowed;"' : ''}
            inputmode="numeric" maxlength="15"/>
          <div class="field-err" id="wa-err-1"><i class="bi bi-exclamation-circle"></i> WhatsApp number required</div>
          <div style="font-size:0.68rem;color:#B3B3B3;margin-top:0.25rem;">Your ticket PDF will be sent here via WhatsApp or email.</div>
        </div>
