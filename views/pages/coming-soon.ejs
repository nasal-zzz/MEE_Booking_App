<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Coming Soon — Melattur Events & Entertainments</title>
  <meta name="description" content="Something spectacular is on its way. Stay tuned for the next big event by Melattur Events & Entertainments.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Anek+Malayalam:wght@100..800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="/css/style.css" rel="stylesheet">

  <style>
    /* ── Variables ── */
    :root {
      --primary:   #d103ef;
      --secondary: #5c1aff;
      --bg:        #08080e;
      --surface:   rgba(255,255,255,0.04);
      --border:    rgba(255,255,255,0.08);
      --text-muted: rgba(255,255,255,0.35);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      font-family: 'Outfit', sans-serif;
      color: #fff;
      min-height: 100dvh;
      overflow-x: hidden;
    }

    /* ── Animated Gradient Orbs ── */
    .orb-wrap {
      position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden;
    }
    .orb {
      position: absolute;
      border-radius: 50%;
      mix-blend-mode: screen;
      filter: blur(120px);
      animation: orbFloat 8s ease-in-out infinite;
    }
    .orb-1 { width: 500px; height: 500px; background: var(--primary); opacity: 0.18; top: -10%; left: 15%; animation-delay: 0s; }
    .orb-2 { width: 600px; height: 600px; background: var(--secondary); opacity: 0.14; top: 40%; right: -10%; animation-delay: -3s; }
    .orb-3 { width: 400px; height: 400px; background: var(--primary); opacity: 0.12; bottom: -5%; left: 30%; animation-delay: -6s; }

    @keyframes orbFloat {
      0%, 100% { transform: translateY(0) scale(1); }
      50%       { transform: translateY(-30px) scale(1.05); }
    }

    /* ── Noise Texture ── */
    .noise {
      position: fixed; inset: 0; z-index: 1; pointer-events: none; opacity: 0.03;
      background-image: url('data:image/svg+xml,%3Csvg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"%3E%3Cfilter id="n"%3E%3CfeTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/%3E%3C/filter%3E%3Crect width="100%25" height="100%25" filter="url(%23n)"/%3E%3C/svg%3E');
    }

    /* ── Grid Lines ── */
    .grid-lines {
      position: fixed; inset: 0; z-index: 1; pointer-events: none; opacity: 0.04;
      background-image:
        linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px);
      background-size: 60px 60px;
    }

    /* ── Main layout ── */
    .cs-wrap {
      position: relative; z-index: 10;
      min-height: 100dvh;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      padding: 6rem 1.5rem 3rem;
      text-align: center;
    }

    /* ── Logo mark ── */
    .cs-logo-mark {
      width: 72px; height: 72px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 2rem;
      position: relative;
      animation: logoPulse 3s ease-in-out infinite;
      box-shadow: 0 0 40px rgba(209, 3, 239, 0.4);
    }
    .cs-logo-mark::before {
      content: '';
      position: absolute; inset: -6px;
      border-radius: 50%;
      border: 1px solid rgba(209,3,239,0.3);
      animation: ringExpand 3s ease-in-out infinite;
    }
    .cs-logo-mark::after {
      content: '';
      position: absolute; inset: -14px;
      border-radius: 50%;
      border: 1px solid rgba(209,3,239,0.12);
      animation: ringExpand 3s ease-in-out infinite 0.4s;
    }
    .cs-logo-mark i { font-size: 2rem; color: #fff; }

    @keyframes logoPulse {
      0%, 100% { box-shadow: 0 0 40px rgba(209,3,239,0.4); }
      50%       { box-shadow: 0 0 80px rgba(209,3,239,0.7), 0 0 120px rgba(92,26,255,0.3); }
    }
    @keyframes ringExpand {
      0%, 100% { transform: scale(1); opacity: 1; }
      50%       { transform: scale(1.08); opacity: 0.4; }
    }

    /* ── Status pill ── */
    .cs-pill {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 100px;
      padding: 0.4rem 1.1rem;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 1.8rem;
      backdrop-filter: blur(10px);
      animation: fadeSlideUp 0.6s ease both;
    }
    .cs-pill-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--primary);
      animation: dotBlink 2s ease-in-out infinite;
    }
    @keyframes dotBlink {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.2; }
    }

    /* ── Headline ── */
    .cs-headline {
      font-size: clamp(2.4rem, 8vw, 5.5rem);
      font-weight: 800;
      line-height: 1.05;
      letter-spacing: -0.02em;
      margin-bottom: 1.2rem;
      animation: fadeSlideUp 0.7s 0.1s ease both;
    }
    .cs-headline-gradient {
      background: linear-gradient(135deg, var(--primary) 0%, #a855f7 40%, var(--secondary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      display: block;
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-size: 1.1em;
    }

    /* ── Malayalam sub ── */
    .cs-malayalam {
      font-family: 'Anek Malayalam', sans-serif;
      font-size: clamp(1rem, 3vw, 1.4rem);
      color: rgba(255,255,255,0.5);
      font-weight: 300;
      margin-bottom: 1.4rem;
      animation: fadeSlideUp 0.7s 0.15s ease both;
    }

    /* ── Description ── */
    .cs-desc {
      font-size: clamp(0.9rem, 2.5vw, 1.05rem);
      color: rgba(255,255,255,0.45);
      font-weight: 300;
      max-width: 480px;
      line-height: 1.7;
      margin: 0 auto 2.8rem;
      animation: fadeSlideUp 0.7s 0.2s ease both;
    }

    /* ── Divider ornament ── */
    .cs-ornament {
      display: flex; align-items: center; gap: 1rem;
      margin: 0 auto 2.8rem;
      max-width: 320px;
      animation: fadeSlideUp 0.7s 0.25s ease both;
    }
    .cs-ornament-line {
      flex: 1; height: 1px;
      background: linear-gradient(90deg, transparent, rgba(209,3,239,0.4), transparent);
    }
    .cs-ornament-icon { color: rgba(209,3,239,0.5); font-size: 1.1rem; }

    /* ── Notify form ── */
    .cs-notify {
      display: flex; gap: 0.6rem;
      max-width: 420px; width: 100%;
      margin: 0 auto 3.5rem;
      animation: fadeSlideUp 0.7s 0.3s ease both;
    }
    .cs-notify input {
      flex: 1;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 100px;
      padding: 0.75rem 1.2rem;
      color: #fff;
      font-family: 'Outfit', sans-serif;
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
      backdrop-filter: blur(10px);
    }
    .cs-notify input::placeholder { color: var(--text-muted); }
    .cs-notify input:focus {
      border-color: rgba(209,3,239,0.5);
      box-shadow: 0 0 0 3px rgba(209,3,239,0.12);
    }
    .cs-notify-btn {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: #fff;
      border: none;
      border-radius: 100px;
      padding: 0.75rem 1.5rem;
      font-family: 'Outfit', sans-serif;
      font-weight: 600;
      font-size: 0.88rem;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s, opacity 0.2s;
      white-space: nowrap;
      box-shadow: 0 4px 20px rgba(209,3,239,0.35);
    }
    .cs-notify-btn:hover  { transform: scale(1.04); box-shadow: 0 6px 30px rgba(209,3,239,0.55); }
    .cs-notify-btn:active { transform: scale(0.97); }

    .cs-notify-success {
      display: none;
      color: rgba(255,255,255,0.5);
      font-size: 0.85rem;
      margin-top: 0.6rem;
      text-align: center;
    }

    /* ── Social links ── */
    .cs-socials {
      display: flex; gap: 1rem; justify-content: center;
      margin-bottom: 3rem;
      animation: fadeSlideUp 0.7s 0.35s ease both;
    }
    .cs-social-link {
      width: 42px; height: 42px;
      border-radius: 50%;
      background: var(--surface);
      border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      color: var(--text-muted);
      font-size: 1rem;
      text-decoration: none;
      transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.2s;
      backdrop-filter: blur(10px);
    }
    .cs-social-link:hover {
      color: #fff;
      border-color: rgba(209,3,239,0.5);
      background: rgba(209,3,239,0.1);
      transform: translateY(-3px);
    }

    /* ── Brand footer ── */
    .cs-brand {
      animation: fadeSlideUp 0.7s 0.4s ease both;
    }
    .cs-brand-name {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--text-muted);
    }
    .cs-brand-name span {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* ── Floating music notes ── */
    .notes-wrap {
      position: fixed; inset: 0; z-index: 2; pointer-events: none; overflow: hidden;
    }
    .note {
      position: absolute;
      font-size: 1.2rem;
      color: rgba(209,3,239,0.15);
      animation: noteDrift linear infinite;
    }

    @keyframes noteDrift {
      0%   { transform: translateY(100vh) rotate(0deg); opacity: 0; }
      10%  { opacity: 1; }
      90%  { opacity: 0.5; }
      100% { transform: translateY(-120px) rotate(360deg); opacity: 0; }
    }

    /* ── Shared fade animation ── */
    @keyframes fadeSlideUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Responsive ── */
    @media (max-width: 480px) {
      .cs-notify { flex-direction: column; }
      .cs-notify-btn { border-radius: 100px; }
    }
  </style>
</head>

<body>
  <!-- Background layers -->
  <div class="orb-wrap">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
  </div>
  <div class="noise"></div>
  <div class="grid-lines"></div>

  <!-- Floating music notes -->
  <div class="notes-wrap" id="notes-wrap"></div>

  <%- include('../partials/navbar_home') %>

  <main class="cs-wrap">

    <!-- Logo mark -->
    <div class="cs-logo-mark">
      <i class="bi bi-music-note-beamed"></i>
    </div>

    <!-- Status pill — changes based on reason -->
    <div class="cs-pill">
      <div class="cs-pill-dot"></div>
      <% if (reason === 'no-event') { %>
        Something Magical is Brewing
      <% } else if (reason === 'expired') { %>
        Event Has Concluded
      <% } else { %>
        Temporarily Unavailable
      <% } %>
    </div>

    <!-- Headline -->
    <h1 class="cs-headline">
      <% if (reason === 'expired') { %>
        Thank You,
        <span class="cs-headline-gradient">Melattur!</span>
      <% } else { %>
        Coming
        <span class="cs-headline-gradient">Soon</span>
      <% } %>
    </h1>

    <!-- Malayalam line -->
  

    <!-- Description -->
    <p class="cs-desc">
      <% if (reason === 'no-event') { %>
        We're working on something spectacular for you. The next big musical night is being crafted with the same passion and energy you love. Stay tuned.
      <% } else if (reason === 'expired') { %>
        What an incredible night it was! The energy, the music, the memories — thank you for being part of it. Our next show is already in the works.
      <% } else { %>
        This event is currently paused. Our team is putting the final touches in place. Check back soon for updates or follow us on social media.
      <% } %>
    </p>

    <!-- Ornament -->
    <div class="cs-ornament">
      <div class="cs-ornament-line"></div>
      <i class="bi bi-music-note cs-ornament-icon"></i>
      <div class="cs-ornament-line"></div>
    </div>


    <!-- Brand -->
    <div class="cs-brand">
      <p class="cs-brand-name">
        <span>Melattur</span> Events &amp; Entertainments
      </p>
    </div>

  </main>

  <script>
    // ── Floating music notes ──
    const noteIcons = ['♪', '♫', '♬', '♩', '𝅘𝅥𝅮'];
    const wrap = document.getElementById('notes-wrap');

    function spawnNote() {
      const el = document.createElement('div');
      el.className = 'note';
      el.textContent = noteIcons[Math.floor(Math.random() * noteIcons.length)];
      el.style.left = Math.random() * 100 + 'vw';
      const dur = 8 + Math.random() * 10;
      el.style.animationDuration = dur + 's';
      el.style.animationDelay = Math.random() * 4 + 's';
      el.style.fontSize = (0.8 + Math.random() * 1.2) + 'rem';
      wrap.appendChild(el);
      setTimeout(() => el.remove(), (dur + 4) * 1000);
    }

    // Spawn initial batch
    for (let i = 0; i < 12; i++) {
      setTimeout(() => spawnNote(), i * 600);
    }
    setInterval(spawnNote, 1800);

    // ── Notify me ──
    function handleNotify() {
      const input = document.getElementById('notify-phone');
      const btn   = document.getElementById('notify-btn');
      const succ  = document.getElementById('notify-success');
      const phone = input.value.trim();

      if (!/^[6-9]\d{9}$/.test(phone)) {
        input.style.borderColor = 'rgba(239,68,68,0.6)';
        input.style.boxShadow   = '0 0 0 3px rgba(239,68,68,0.12)';
        input.placeholder = 'Enter valid 10-digit number';
        setTimeout(() => {
          input.style.borderColor = '';
          input.style.boxShadow   = '';
          input.placeholder = 'Your WhatsApp number';
        }, 2000);
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Saving...';

      // POST to your notify endpoint (create one if needed)
      fetch('/notify-me', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ phone: '+91' + phone }),
      })
      .then(r => r.json())
      .catch(() => ({ success: true })) // graceful fallback
      .then(() => {
        document.getElementById('notify-form-wrap').style.display = 'none';
        succ.style.display = 'block';
      });
    }

    // Allow Enter key on input
    document.getElementById('notify-phone')?.addEventListener('keydown', e => {
      if (e.key === 'Enter') handleNotify();
    });
  </script>
</body>
</html>
