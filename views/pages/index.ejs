<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Melattur Events & Entertainments | Premium Musical Experience</title>
    <meta name="description"
        content="Book tickets for the most anticipated musical events by Melattur Events & Entertainments. Premium experience, dynamic performances.">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
        rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Anek+Malayalam:wght@100..800&display=swap" rel="stylesheet">
    <!-- Global Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">
</head>

<body
    class="font-sans antialiased text-white relative min-h-screen flex flex-col selection:bg-primary selection:text-white">

    <!-- Gradient Orbs Background -->
    <div class="fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
        <div
            class="absolute top-[10%] left-[20%] w-96 h-96 bg-primary rounded-full mix-blend-screen filter blur-[120px] opacity-30 animate-float">
        </div>
        <div class="absolute top-[40%] right-[10%] w-[500px] h-[500px] bg-secondary rounded-full mix-blend-screen filter blur-[150px] opacity-20 animate-float"
            style="animation-delay: -2s;"></div>
        <div class="absolute bottom-[-10%] left-[30%] w-[600px] h-[600px] bg-primary rounded-full mix-blend-screen filter blur-[150px] opacity-20 animate-float"
            style="animation-delay: -4s;"></div>
    </div>

    <!-- Background Noise/Texture -->
    <div class="fixed inset-0 opacity-[0.03] z-[-5] pointer-events-none"
        style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');">
    </div>

    <!-- Page Loader Overlay -->
    <div id="page-loader" style="
    position: fixed; inset: 0; z-index: 9999;
    background: #000;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 16px;
    transition: opacity 0.6s ease;
">
        <div
            style="width: 48px; height: 48px; border: 2px solid rgba(255,255,255,0.1); border-top-color: #d103ef; border-radius: 50%; animation: spin 0.8s linear infinite;">
        </div>
        <p
            style="color: rgba(255,255,255,0.4); font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; font-family: 'Outfit', sans-serif;">
            Loading experience...</p>
    </div>
    <style>
        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
    </style>

    <!-- Navbar -->
    <%- include('../partials/navbar_home') %>

        <main class="flex-grow">
            <% const evTickets=event ? (event.ticketTypes || []) : []; const evSoldOut=evTickets.length> 0 &&
                evTickets.every(t => t.bookedSeats >= t.totalSeats);
                %>
                <!-- Pinned Scroll Sequence Hero -->
                <section id="hero-sequence" class="relative h-[100dvh] w-full overflow-hidden bg-black">
                    <!-- Canvas for Image Sequence -->
                    <canvas id="hero-canvas"
                        class="absolute top-0 left-0 w-full h-full object-cover opacity-80"></canvas>

                    <!-- Initial Hero Text -->
                    <div id="initial-hero-scroll"
                        class="absolute top-[28%] left-0 w-full flex flex-col items-center z-10">
                        <div id="initial-hero-text"
                            class="opacity-0 translate-y-10 text-center flex flex-col items-center w-[90%] max-w-4xl">
                            <h1
                                class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 leading-tight bg-gradient-to-b from-white via-white/80 to-white/20 text-transparent bg-clip-text drop-shadow-lg">
                                Experience the<br>
                                <span
                                    class="font-serif italic tracking-normal drop-shadow-none bg-gradient-premium bg-clip-text text-transparent">Magic
                                    of Music</span><br>
                                Live & Unforgettable
                            </h1>
                            <p class="text-base md:text-lg text-gray-400 font-light max-w-lg leading-relaxed">
                                Kerala's premier musical event. Book your seats to spectacular live concerts, and
                                electrifying shows.
                            </p>

                            <!-- Scroll down indicator -->
                            <div class="mt-8 flex flex-col items-center gap-3">
                                <span class="text-[10px] tracking-[0.3em] uppercase text-gray-500 font-semibold">Scroll
                                    to
                                    explore</span>
                                <div class="w-[2px] h-12 bg-white/10 relative overflow-hidden rounded-full">
                                    <div
                                        class="absolute top-0 left-0 w-full h-[50%] bg-gradient-premium animate-[scroll-down_1.5s_ease-in-out_infinite]">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Featured Artist Boxes (Minimalist Technical style) -->
                    <div id="singer-cta-left" class="artist-callout left">
                        <div class="artist-info-minimal" style="align-items: flex-end; margin-right: -2px;">
                            <h3 class="artist-name-minimal">Hanan Sha</h3>
                            <div class="artist-subtitle-badge">Singer</div>
                        </div>
                        <div class="callout-svg-container" style="margin-right:0; margin-left: -10px;">
                            <svg class="callout-svg" width="100" height="60" viewBox="0 0 100 60" fill="none"
                                xmlns="http://www.w3.org/2000/svg">
                                <path d="M0 20H60L90 50" stroke="white" stroke-width="2" stroke-linecap="round" />
                            </svg>
                        </div>
                    </div>

                    <div id="singer-cta-right" class="artist-callout right">
                        <div class="artist-info-minimal" style="align-items: flex-start; margin-left: -2px;">
                            <h3 class="artist-name-minimal">Shafi Kollam</h3>
                            <div class="artist-subtitle-badge">Singer</div>
                        </div>
                        <div class="callout-svg-container" style="margin-left:0; margin-right: -10px;">
                            <svg class="callout-svg" width="100" height="60" viewBox="0 0 100 60" fill="none"
                                xmlns="http://www.w3.org/2000/svg">
                                <path d="M100 20H40L10 50" stroke="white" stroke-width="2" stroke-linecap="round" />
                            </svg>
                        </div>
                    </div>

                    <div id="malayalam-hero-text"
                        style="position: absolute; bottom: 8vh; left: 0; width: 100%; z-index: 20; opacity: 0; display: flex; flex-direction: column; align-items: center;">
                        <div class="text-center w-[90%] max-w-4xl flex flex-col items-center">
                            <h2 class="font-bold tracking-tight mb-4 leading-[1.1] drop-shadow-2xl"
                                style="font-family: 'Anek Malayalam', sans-serif;">
                                <span
                                    class="text-gray-300 text-lg md:text-xl lg:text-2xl block mb-1 font-light">പാട്ടുകൾ
                                    ഇഷ്ടപ്പെടുന്നവർക്കായി</span>
                                <span class="text-white text-2xl md:text-3xl lg:text-4xl block mb-1">മേലാറ്റൂരിന്റെ
                                    സ്വന്തം</span>
                                <span
                                    class="bg-gradient-premium bg-clip-text text-transparent text-4xl md:text-5xl lg:text-6xl block mt-2 pb-1">മേലാറ്റൂർ
                                    പാട്ട്</span>
                            </h2>

                            <div
                                style="display: flex; flex-direction: row; gap: 1.5rem; margin-top: 1.5rem; align-items: center; justify-content: center;">

                                <% if (evSoldOut) { %>
                                    <span
                                        class="bg-gradient-premium text-white font-bold py-3 px-8 rounded-full text-base opacity-50 cursor-not-allowed">
                                        Sold Out
                                    </span>
                                    <% } else if (locals.user && user) { %>
                                        <a href="/booking/seatmap/<%= event._id %>"
                                            class="bg-gradient-premium text-white font-bold py-3 px-8 rounded-full text-base shadow-[0_0_30px_-10px_#d103ef] transition-transform duration-300 hover:scale-105 active:scale-95">
                                            Book Now
                                        </a>
                                        <% } else { %>
                                            <a href="/auth/login?next=/booking/seatmap/<%= event._id %>"
                                                class="bg-gradient-premium text-white font-bold py-3 px-8 rounded-full text-base shadow-[0_0_30px_-10px_#d103ef] transition-transform duration-300 hover:scale-105 active:scale-95">
                                                Book Now
                                            </a>
                                            <% } %>
                                                <a href="/event/<%= event._id %>" class="view-details-btn">
                                                    View Details
                                                </a>

                            </div>
                        </div>
                    </div>

                    <!-- Bottom Gradient Fade -->
                    <div
                        class="absolute bottom-0 w-full h-80 bg-gradient-to-t from-[#000000] via-[#000000]/50 to-transparent z-10 pointer-events-none">
                    </div>
                </section>

                <!-- Sponsors Section -->
                <section class="sponsors-section">
                    <div class="container-custom">
                        <h4 class="sponsors-title">SPONSORS</h4>
                        <div class="sponsors-wrapper">
                            <div class="sponsors-track">
                                <!-- Two sets of items for seamless looping -->
                                <div class="sponsor-card"><img src="/images/sponsors/s1.png" alt="Sponsor"></div>
                                <div class="sponsor-card"><img src="/images/sponsors/s2.png" alt="Sponsor"></div>
                                <div class="sponsor-card"><img src="/images/sponsors/s3.png" alt="Sponsor"></div>
                                <div class="sponsor-card"><img src="/images/sponsors/s4.png" alt="Sponsor"></div>
                                <div class="sponsor-card"><img src="/images/sponsors/s5.png" alt="Sponsor"></div>
                                <!-- Second set -->
                                <div class="sponsor-card"><img src="/images/sponsors/s1.png" alt="Sponsor"></div>
                                <div class="sponsor-card"><img src="/images/sponsors/s2.png" alt="Sponsor"></div>
                                <div class="sponsor-card"><img src="/images/sponsors/s3.png" alt="Sponsor"></div>
                                <div class="sponsor-card"><img src="/images/sponsors/s4.png" alt="Sponsor"></div>
                                <div class="sponsor-card"><img src="/images/sponsors/s5.png" alt="Sponsor"></div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- About The Musical Night Section -->
                <section id="about" class="about-section">

                    <!-- Ambient background glow -->
                    <div class="about-glow"></div>

                    <div class="about-container">

                        <!-- Section eyebrow label -->
                        <div class="about-eyebrow gs-fade-up">
                            <div class="about-eyebrow-line"></div>
                            <span class="about-eyebrow-text">Melattur Pattu</span>
                        </div>

                        <!-- Full-width headline -->
                        <div class="about-headline-wrap gs-fade-up">
                            <h2 class="about-headline">
                                Evening of
                                <span class="about-headline-gradient">Soulful Music</span>
                            </h2>
                        </div>

                        <!-- Two-column body -->
                        <div class="about-body">

                            <!-- LEFT: Description -->
                            <div class="about-left gs-fade-right">
                                <p class="about-desc">
                                    Get ready for an unforgettable evening of music and entertainment at
                                    <strong class="about-strong">Melattur Pattu</strong>,
                                    featuring the sensational voices of
                                    <strong class="about-strong">Hanan Sha</strong>
                                    and
                                    <strong class="about-strong">Kollam Shafi</strong>.
                                </p>
                                <p class="about-desc">
                                    Organised by <strong class="about-strong">Melattur Events &amp;
                                        Entertainments</strong>,
                                    this spectacular show promises a vibrant blend of soulful melodies, energetic
                                    performances,
                                    and a world-class stage experience set in the lively atmosphere of Melattur Stadium.
                                </p>

                                <!-- Pull quote -->
                                <blockquote class="about-quote">
                                    "From heart-touching songs to crowd-thrilling performances — a musical night
                                    designed
                                    to captivate audiences of all ages."
                                </blockquote>
                            </div>

                            <!-- RIGHT: Event detail cards -->
                            <div class="about-right gs-fade-left">

                                <div class="about-detail-stack">

                                    <!-- Date row -->
                                    <div class="about-detail-row">
                                        <div class="about-detail-icon about-detail-icon--primary">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d103ef"
                                                stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="3" y="4" width="18" height="18" rx="2" />
                                                <line x1="16" y1="2" x2="16" y2="6" />
                                                <line x1="8" y1="2" x2="8" y2="6" />
                                                <line x1="3" y1="10" x2="21" y2="10" />
                                            </svg>
                                        </div>
                                        <div class="about-detail-body">
                                            <p class="about-detail-label">Date</p>
                                            <p class="about-detail-value">9th May 2026</p>
                                        </div>
                                        <span class="about-detail-badge about-detail-badge--primary">Saturday</span>
                                    </div>

                                    <div class="about-detail-divider"></div>

                                    <!-- Time row -->
                                    <div class="about-detail-row">
                                        <div class="about-detail-icon about-detail-icon--secondary">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5c1aff"
                                                stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10" />
                                                <polyline points="12 6 12 12 16 14" />
                                            </svg>
                                        </div>
                                        <div class="about-detail-body">
                                            <p class="about-detail-label">Doors Open</p>
                                            <p class="about-detail-value">04:00 PM</p>
                                        </div>
                                        <span class="about-detail-badge about-detail-badge--muted">Onwards</span>
                                    </div>

                                    <div class="about-detail-divider"></div>

                                    <!-- Venue row -->
                                    <div class="about-detail-row">
                                        <div class="about-detail-icon about-detail-icon--primary">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d103ef"
                                                stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                                                <circle cx="12" cy="10" r="3" />
                                            </svg>
                                        </div>
                                        <div class="about-detail-body">
                                            <p class="about-detail-label">Venue</p>
                                            <p class="about-detail-value">Melattur Stadium</p>
                                            <p class="about-detail-sublabel">Melattur, Kerala</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Social proof + CTA strip -->
                                <div class="about-cta-strip">
                                    <div class="about-cta-left">
                                        <div class="about-avatars">
                                            <div class="about-avatar about-avatar--gradient"></div>
                                            <div class="about-avatar about-avatar--mid"></div>
                                            <div class="about-avatar about-avatar--dark"></div>
                                        </div>
                                        <div class="about-cta-text">
                                            <p class="about-cta-title">Tickets selling fast</p>
                                            <p class="about-cta-sub">Limited seats available</p>
                                        </div>
                                    </div>
                                    <% if (evSoldOut) { %>
                                        <span class="about-cta-btn" style="opacity:0.5;cursor:not-allowed;">Sold
                                            Out</span>
                                        <% } else if (locals.user && user) { %>
                                            <a href="/booking/seatmap/<%= event._id %>" class="about-cta-btn">Book
                                                Now</a>
                                            <% } else { %>
                                                <a href="/auth/login?next=/booking/seatmap/<%= event._id %>"
                                                    class="about-cta-btn">Book Now</a>
                                                <% } %>
                                </div>

                            </div>
                        </div>
                    </div>
                </section>
        </main>

        <!-- Footer -->
        <%- include('../partials/footer_home') %>



            <!-- GSAP for Animations -->
            <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

            <!-- Custom Animations Script -->
            <script src="/js/animations.js"></script>
</body>


</html>