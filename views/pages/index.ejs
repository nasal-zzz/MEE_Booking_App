                                                        alt="Sponsor" loading="lazy"></div>
                                                <div class="sponsor-card"><img src="/images/sponsors/s10.webp"
                                                        alt="Sponsor" loading="lazy"></div>
                                                <div class="sponsor-card"><img src="/images/sponsors/s4.webp"
