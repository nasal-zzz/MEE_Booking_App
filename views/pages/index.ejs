<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home | Melattur Events & Entertainments</title>
    <meta name="description"
        content="Book tickets for the most anticipated musical events by Melattur Events & Entertainments. Premium experience, dynamic performances.">

    <!-- UMAMI TRACKING CODE -->
    <script defer src="https://analytics.meefuture.in/script.js"
        data-website-id="bd996d0c-f978-42ae-aa21-084ac547be39"></script>

    <!-- Preconnect to external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">

    <!-- Preload critical images -->
    <link rel="preload" as="image" href="/images/herosection/Mee_hero_section_00000.webp">
    <link rel="preload" as="image" href="/images/herosection/Mee_hero_section_00001.webp">
    <link rel="preload" as="image" href="/images/herosection/Mee_hero_section_00002.webp">

    <!-- Optimized font loading - swap for instant text display -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
        rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Anek+Malayalam:wght@100..800&display=swap" rel="stylesheet">

    <!-- Global Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <!-- Inline critical loader styles to avoid FOUC -->
    <style>
        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        #page-loader {
            position: fixed;
            inset: 0;
            z-index: 9999;
            background: #000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 16px;
            transition: opacity 0.6s ease;
        }

        #page-loader .spinner {
            width: 48px;
            height: 48px;
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-top-color: #d103ef;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        #page-loader p {
            color: rgba(255, 255, 255, 0.4);
            font-size: 12px;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            font-family: 'Outfit', sans-serif;
        }
    </style>
    <!-- Optimized Hero Slider Styles -->
    <style>
        .hero-slider {
            position: relative;
            height: 75dvh;
            width: 100%;
            overflow: hidden;
            background: #000;
        }

        .slide {
            position: absolute;
            inset: 0;
            opacity: 0;
            transition: opacity 0.8s ease-in-out;
            display: flex;
            align-items: flex-end;
            justify-content: flex-start;
            z-index: 1;
        }

        .slide.active {
            opacity: 1;
            z-index: 2;
        }

        .slide-bg {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        .slide-bg::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom,
                    rgba(0, 0, 0, 0.7) 0%,
                    rgba(0, 0, 0, 0) 30%,
                    rgba(0, 0, 0, 0) 70%,
                    rgba(0, 0, 0, 0.9) 100%);
        }

        .slide-content {
            position: relative;
            z-index: 5;
            text-align: left;
            width: 100%;
            max-width: 900px;
            padding: 4rem 4rem 6rem;
        }

        .slide-date {
            display: inline-block;
            font-size: 0.9rem;
            letter-spacing: 0.3em;
            color: #d103ef;
            margin-bottom: 1rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .slide-name {
            font-size: clamp(2rem, 6vw, 4rem);
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 1.2rem;
            color: #fff;
            text-transform: uppercase;
        }

        .slide-name .accent {
            background: linear-gradient(135deg, #fff 30%, #d103ef 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .slide-venue {
            font-size: 1.1rem;
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 0.5rem;
        }

        .slide-desc {
            max-width: 600px;
            margin: 0 0 2.5rem;
            color: rgba(255, 255, 255, 0.6);
            line-height: 1.6;
        }

        .slide-btns {
            display: flex;
            gap: 1.5rem;
            justify-content: flex-start;
            align-items: center;
        }

        .btn-book-now {
            background: linear-gradient(135deg, #d103ef, #5c1aff);
            color: white;
            padding: 0.8rem 2rem;
            border-radius: 99px;
            font-weight: 700;
            text-decoration: none;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0 10px 30px -10px rgba(209, 3, 239, 0.5);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-book-now:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 40px -10px rgba(209, 3, 239, 0.6);
        }

        .btn-outline {
            border: 2px solid rgba(255, 255, 255, 0.2);
            color: white;
            padding: 0.8rem 2rem;
            border-radius: 99px;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-outline:hover {
            border-color: #d103ef;
            background: rgba(209, 3, 239, 0.05);
            transform: translateY(-2px);
        }

        .btn-view-details {
            color: white;
            text-decoration: none;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: gap 0.3s ease;
        }

        .btn-view-details:hover {
            gap: 0.8rem;
        }

        .slider-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: white;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 10;
            backdrop-filter: blur(10px);
            transition: background 0.3s ease;
        }

        .slider-arrow:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        .slider-arrow.prev {
            left: 2rem;
        }

        .slider-arrow.next {
            right: 2rem;
        }

        .slider-dots {
            position: absolute;
            bottom: 3rem;
            right: 4rem;
            display: flex;
            gap: 0.8rem;
            z-index: 10;
        }

        .slider-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .slider-dot.active {
            background: #d103ef;
            width: 30px;
            border-radius: 5px;
        }

        @media (max-width: 768px) {
            .slider-arrow {
                display: none;
            }

            .slide-content {
                padding: 2rem 1.5rem 4rem;
                text-align: center;
            }

            .slide-name {
                font-size: 2.5rem;
            }

            .slide-venue {
                justify-content: center;
            }

            .slide-btns {
                flex-direction: row;
                gap: 1rem;
                align-items: stretch;
            }

            .btn-book-now,
            .btn-outline {
                width: 100%;
                text-align: center;
                padding: 0.6rem 1.5rem;
                font-size: 0.9rem;
            }

            .btn-view-details {
                justify-content: center;
            }

            .slider-dots {
                right: 0;
                left: 0;
                justify-content: center;
                bottom: 2rem;
            }
        }
    </style>
</head>

<body
    class="font-sans antialiased text-white relative min-h-screen flex flex-col selection:bg-primary selection:text-white">

    <!-- Gradient Orbs Background -->
    <div class="fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
        <div
            class="absolute top-[10%] left-[20%] w-96 h-96 bg-primary rounded-full mix-blend-screen filter blur-[120px] opacity-30 animate-float">
        </div>
        <div class="absolute top-[40%] right-[10%] w-[500px] h-[500px] bg-secondary rounded-full mix-blend-screen filter blur-[150px] opacity-20 animate-float"
            style="animation-delay: -2s;"></div>
        <div class="absolute bottom-[-10%] left-[30%] w-[600px] h-[600px] bg-primary rounded-full mix-blend-screen filter blur-[150px] opacity-20 animate-float"
            style="animation-delay: -4s;"></div>
    </div>

    <!-- Background Noise/Texture -->
    <div class="fixed inset-0 opacity-[0.03] z-[-5] pointer-events-none"
        style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');">
    </div>

    <!-- Page Loader Overlay -->
    <div id="page-loader">
        <div class="spinner"></div>
        <p>Loading ...</p>
    </div>

    <!-- Navbar -->
    <%- include('../partials/navbar_home') %>

        <main class="flex-grow">
            <% const featuredEvTickets=event ? (event.ticketTypes || []) : []; const
                featuredEvSoldOut=featuredEvTickets.length> 0 && featuredEvTickets.every(t => t.bookedSeats >=
                t.totalSeats);
                %>

                <!-- ═══════════════ HERO SLIDER ═══════════════ -->
                <% const tierColors={ standard:'#a0a0a0', silver:'#c0c8d8', gold:'#f5c842', platinum:'#9500ff',
                    vip:'#bf80ff', general:'#a0a0a0' }; let rawEvents=events && events.length ? events : []; let
                    sliderEvents=rawEvents; let singleEventDualSlide=false; if (rawEvents.length===1) { const
                    ev=rawEvents[0]; const slide2Desktop=ev.slideDesktop || ev.bannerDesktop || '' ; const
                    slide2Mobile=ev.slideMobile || ev.bannerMobile || '' ; if (slide2Desktop || slide2Mobile) {
                    singleEventDualSlide=true; const evPlain=typeof ev.toObject==='function' ? ev.toObject() :
                    JSON.parse(JSON.stringify(ev)); sliderEvents=[ Object.assign({}, evPlain, { _slideType: 'desktop' ,
                    _slideBanner: evPlain.bannerDesktop || '' , _slideMobileBanner: evPlain.bannerMobile || '' }),
                    Object.assign({}, evPlain, { _slideType: 'slide2' , _slideBanner: slide2Desktop, _slideMobileBanner:
                    slide2Mobile }), ]; } } %>

                    <% if (sliderEvents.length> 0) { %>
                        <div class="hero-slider" id="heroSlider">
                            <% sliderEvents.forEach(function(ev, idx) { const evTickets=ev.ticketTypes || []; const
                                evSoldOut=evTickets.length> 0 && evTickets.every(t => t.bookedSeats >= t.totalSeats);
                                const hasBanner = !!(ev._slideBanner || ev.bannerDesktop || ev.bannerMobile);
                                const bgDesktop = ev._slideBanner || ev.bannerDesktop || '';
                                const bgMobile = ev._slideMobileBanner || ev._slideBanner || ev.bannerMobile ||
                                ev.bannerDesktop || '';

                                const nameParts = ev.name.trim().split(' ');
                                const firstName = nameParts[0] || '';
                                const restName = nameParts.slice(1).join(' ') || '';
                                %>
                                <div class="slide <%= idx === 0 ? 'active' : '' %>" data-index="<%= idx %>">
                                    <div class="slide-bg" id="slideBg<%= idx %>"
                                        style="<%= hasBanner ? '' : 'background:linear-gradient(135deg,#0a0014 0%,#1a0030 40%,#2a0050 70%,#600020 100%);' %>">

                                        <!-- Inline Style for Responsive Bg -->
                                        <style>
                                            #slideBg<%=idx %> {
                                                background-image: url('<%= bgDesktop %>');
                                            }

                                            @media (max-width: 768px) {
                                                #slideBg<%=idx %> {
                                                    background-image: url('<%= bgMobile || bgDesktop %>');
                                                }
                                            }
                                        </style>
                                    </div>

                                    <div class="slide-content">
                                        <span class="slide-date">
                                            <%= new Date(ev.date).toLocaleDateString('en-IN', { day: 'numeric' ,
                                                month: 'long' , year: 'numeric' }).toUpperCase() %>
                                        </span>

                                        <h1 class="slide-name">
                                            <%= firstName %>
                                                <% if (restName) { %><br /><span>
                                                        <%= restName %>
                                                    </span>
                                                    <% } %>
                                        </h1>


                                        <% if (ev.description) { %>
                                            <p class="slide-desc">
                                                <%= ev.description.substring(0, 120) %>
                                                    <%= ev.description.length> 120 ? ' …' : '' %>
                                            </p>
                                            <% } %>

                                                <div class="slide-btns">
                                                    <% if (evSoldOut) { %>
                                                        <span class="btn-book-now"
                                                            style="opacity:0.5;cursor:not-allowed;">Sold Out</span>
                                                        <% } else if (locals.user && user) { %>
                                                            <a href="/booking/seatmap/<%= ev._id %>"
                                                                class="btn-book-now">Book Now</a>
                                                            <% } else { %>
                                                                <a href="/auth/login?next=/booking/seatmap/<%= ev._id %>"
                                                                    class="btn-book-now">Book Now</a>
                                                                <% } %>

                                                                    <a href="/event/<%= ev._id %>" class="btn-outline">
                                                                        View Details
                                                                    </a>
                                                </div>
                                    </div>
                                </div>
                                <% }); %>

                                    <% if(sliderEvents.length> 1){ %>
                                        <button class="slider-arrow prev" onclick="moveSlider(-1)"
                                            aria-label="Previous">
                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <polyline points="15 18 9 12 15 6"></polyline>
                                            </svg>
                                        </button>
                                        <button class="slider-arrow next" onclick="moveSlider(1)" aria-label="Next">
                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <polyline points="9 18 15 12 9 6"></polyline>
                                            </svg>
                                        </button>
                                        <% } %>

                                            <div class="slider-dots">
                                                <% sliderEvents.forEach(function(ev, idx){ %>
                                                    <div class="slider-dot <%= idx===0?'active':'' %>"
                                                        onclick="goToSlide(<%= idx %>)"></div>
                                                    <% }); %>
                                            </div>
                        </div>

                        <script>
                            let currentHeroSlide = 0;
                            const heroSlides = document.querySelectorAll('.hero-slider .slide');
                            const heroDots = document.querySelectorAll('.hero-slider .slider-dot');

                            function showHeroSlide(n) {
                                if (!heroSlides.length) return;
                                heroSlides[currentHeroSlide].classList.remove('active');
                                heroDots[currentHeroSlide].classList.remove('active');
                                currentHeroSlide = (n + heroSlides.length) % heroSlides.length;
                                heroSlides[currentHeroSlide].classList.add('active');
                                heroDots[currentHeroSlide].classList.add('active');
                            }

                            function moveSlider(n) { showHeroSlide(currentHeroSlide + n); }
                            function goToSlide(n) { showHeroSlide(n); }

                            // Auto play
                            if (heroSlides.length > 1) {
                                setInterval(() => moveSlider(1), 6000);
                            }
                        </script>
                        <% } else { %>
                            <div class="hero-slider"
                                style="display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1.5rem;background:linear-gradient(135deg,#0a0014,#1a0030);">
                                <h1
                                    style="font-size:clamp(2rem, 10vw, 4rem); text-align:center; font-weight:800; color: #fff;">
                                    MELATTUR<br /><span style="color:#d103ef;">ENTERTAINMENT EVENTS</span></h1>
                                <p style="color:rgba(255,255,255,0.5); text-align:center;">Melattur's most electrifying
                                    musical experiences.</p>
                                <a href="/auth/signup" class="btn-book-now">Create Account</a>
                            </div>
                            <% } %>



                                <!-- Sponsors Section -->
                                <section class="sponsors-section">
                                    <div class="container-custom">
                                        <h4 class="sponsors-title">SPONSORS</h4>
                                        <div class="sponsors-wrapper">
                                            <div class="sponsors-track">
                                                <!-- Two sets of items for seamless looping -->
                                                <div class="sponsor-card"><img src="/images/sponsors/title_sponsor.webp"
                                                        alt="Sponsor" loading="lazy"></div>
                                                <div class="sponsor-card"><img src="/images/sponsors/s1.webp"
