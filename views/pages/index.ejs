                                                <div class="sponsor-card"><img src="/images/sponsors/s12.webp"
                                                        alt="Sponsor" loading="lazy"></div>
                                            </div>
                                        </div>
                                    </div>
                                </section>

                                <!-- About The Musical Night Section -->
                                <section id="about" class="about-section">

                                    <!-- Ambient background glow -->
                                    <div class="about-glow"></div>

                                    <div class="about-container">

                                        <!-- Section eyebrow label -->
                                        <div class="about-eyebrow gs-fade-up">
                                            <div class="about-eyebrow-line"></div>
                                            <span class="about-eyebrow-text">Melattur Pattu</span>
                                        </div>

                                        <!-- Full-width headline -->
                                        <div class="about-headline-wrap gs-fade-up">
                                            <h2 class="about-headline">
                                                Evening of
                                                <span class="about-headline-gradient">Soulful Music</span>
                                            </h2>
                                        </div>

                                        <!-- Two-column body -->
                                        <div class="about-body">

                                            <!-- LEFT: Description -->
                                            <div class="about-left gs-fade-right">
                                                <p class="about-desc">
                                                    Get ready for an unforgettable evening of music and entertainment at
                                                    <strong class="about-strong">Melattur Pattu</strong>,
                                                    featuring the sensational voices of
                                                    <strong class="about-strong">Hanan Sha</strong>
                                                    and
                                                    <strong class="about-strong">Kollam Shafi</strong>.
                                                </p>
                                                <p class="about-desc">
                                                    Organised by <strong class="about-strong">Melattur Events &amp;
                                                        Entertainments</strong>,
                                                    this spectacular show promises a vibrant blend of soulful melodies,
                                                    energetic
                                                    performances,
                                                    and a world-class stage experience set in the lively atmosphere of
                                                    Melattur Stadium.
                                                </p>

                                                <!-- Pull quote -->
                                                <blockquote class="about-quote">
                                                    "From heart-touching songs to crowd-thrilling performances — a
                                                    musical night
                                                    designed
                                                    to captivate audiences of all ages."
                                                </blockquote>
                                            </div>

                                            <!-- RIGHT: Event detail cards -->
                                            <div class="about-right gs-fade-left">

                                                <div class="about-detail-stack">

                                                    <!-- Date row -->
                                                    <div class="about-detail-row">
                                                        <div class="about-detail-icon about-detail-icon--primary">
                                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                                stroke="#d103ef" stroke-width="1.5"
                                                                stroke-linecap="round" stroke-linejoin="round">
                                                                <rect x="3" y="4" width="18" height="18" rx="2" />
                                                                <line x1="16" y1="2" x2="16" y2="6" />
                                                                <line x1="8" y1="2" x2="8" y2="6" />
                                                                <line x1="3" y1="10" x2="21" y2="10" />
                                                            </svg>
                                                        </div>
                                                        <div class="about-detail-body">
                                                            <p class="about-detail-label">Date</p>
                                                            <p class="about-detail-value">
                                                                <%= new
                                                                    Date(event.date).toLocaleDateString('en-IN',{weekday:'short',day:'numeric',month:'long',year:'numeric'})
                                                                    %>
                                                            </p>
                                                        </div>

                                                    </div>

                                                    <div class="about-detail-divider"></div>

                                                    <!-- Time row -->
                                                    <div class="about-detail-row">
                                                        <div class="about-detail-icon about-detail-icon--secondary">
                                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                                stroke="#5c1aff" stroke-width="1.5"
                                                                stroke-linecap="round" stroke-linejoin="round">
                                                                <circle cx="12" cy="12" r="10" />
                                                                <polyline points="12 6 12 12 16 14" />
                                                            </svg>
                                                        </div>
                                                        <div class="about-detail-body">
                                                            <p class="about-detail-label">Doors Open</p>
                                                            <p class="about-detail-value">
                                                                <%= event.doorsOpen %>
                                                            </p>
                                                        </div>
                                                        <span
                                                            class="about-detail-badge about-detail-badge--muted">Onwards</span>
                                                    </div>

                                                    <div class="about-detail-divider"></div>

                                                    <!-- Venue row -->
                                                    <div class="about-detail-row">
                                                        <div class="about-detail-icon about-detail-icon--primary">
                                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                                stroke="#d103ef" stroke-width="1.5"
                                                                stroke-linecap="round" stroke-linejoin="round">
                                                                <path
                                                                    d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                                                                <circle cx="12" cy="10" r="3" />
                                                            </svg>
                                                        </div>
                                                        <div class="about-detail-body">
                                                            <p class="about-detail-label">Venue</p>
                                                            <p class="about-detail-value">
                                                                <%= event.venue %>
                                                            </p>
                                                            <p class="about-detail-sublabel">
                                                                <%= event.venueAddress %>
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Social proof + CTA strip -->
                                                <div class="about-cta-strip">
                                                    <div class="about-cta-left">
                                                        <div class="about-avatars">
                                                            <div class="about-avatar about-avatar--gradient"></div>
                                                            <div class="about-avatar about-avatar--mid"></div>
                                                            <div class="about-avatar about-avatar--dark"></div>
                                                        </div>
                                                        <div class="about-cta-text">
                                                            <p class="about-cta-title">Tickets selling fast</p>
                                                            <p class="about-cta-sub">Limited seats available</p>
                                                        </div>
                                                    </div>
                                                    <% if (featuredEvSoldOut) { %>
                                                        <span class="about-cta-btn"
                                                            style="opacity:0.5;cursor:not-allowed;">Sold
                                                            Out</span>
                                                        <% } else if (locals.user && user) { %>
                                                            <a href="/booking/seatmap/<%= event._id %>"
                                                                class="about-cta-btn">Book
                                                                Now</a>
                                                            <% } else { %>
                                                                <a href="/auth/login?next=/booking/seatmap/<%= event._id %>"
                                                                    class="about-cta-btn">Book Now</a>
                                                                <% } %>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </section>
        </main>

        <!-- Footer -->
        <%- include('../partials/footer_home') %>

            <!-- GSAP for Animations - Deferred loading -->
            <script defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
            <script defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

            <!-- Custom Animations Script - Deferred loading -->
            <script defer src="/js/animations.js"></script>
</body>

</html>