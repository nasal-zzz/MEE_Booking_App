        <div style="font-family:'Courier New',Courier,monospace;font-size:0.4rem;letter-spacing:1px;color:rgba(255,255,255,0.3);text-transform:uppercase;margin-bottom:0.1rem;">Gate No.</div>
        <div style="font-family:'Outfit',sans-serif;font-size:0.65rem;font-weight:600;color:rgba(255,255,255,0.85);line-height:1.2;">${gateDisplay}</div>
      </div>

