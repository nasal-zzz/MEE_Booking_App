  <script>
  // ── Avatar Crop System ──
  let cropImg = null, cropScale = 1, cropOffX = 0, cropOffY = 0;
  let isDragging = false, lastX = 0, lastY = 0;
  let initPinchDist = 0, initPinchScale = 1;

  function openAvatarCrop(e) {
    const file = e.target.files[0];
    if (!file) return;
    if (file.size > 5 * 1024 * 1024) { alert('Image too large. Max 5MB.'); return; }

    const reader = new FileReader();
    reader.onload = function(ev) {
      const img = new Image();
      img.onload = function() {
        cropImg = img; cropScale = 1; cropOffX = 0; cropOffY = 0;
        document.getElementById('zoomSlider').value = 1;
        document.getElementById('cropModal').style.display = 'flex';
        setTimeout(drawCrop, 50);
      };
      img.src = ev.target.result;
    };
    reader.readAsDataURL(file);
    e.target.value = '';
  }

  function closeCropModal() {
    document.getElementById('cropModal').style.display = 'none';
    cropImg = null;
  }

  function drawCrop() {
    const canvas = document.getElementById('cropCanvas');
    const container = document.getElementById('cropContainer');
    const size = container.offsetWidth;
    canvas.width = size; canvas.height = size;
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, size, size);
    ctx.fillStyle = '#0a0a12';
    ctx.fillRect(0, 0, size, size);
    if (!cropImg) return;

    const aspect = cropImg.width / cropImg.height;
    let baseW, baseH;
    if (aspect > 1) { baseH = size; baseW = baseH * aspect; }
    else            { baseW = size; baseH = baseW / aspect; }
    const w = baseW * cropScale, h = baseH * cropScale;
    const x = (size - w) / 2 + cropOffX;
    const y = (size - h) / 2 + cropOffY;
    ctx.drawImage(cropImg, x, y, w, h);
  }

  function updateZoom(v) {
    cropScale = parseFloat(v);
    drawCrop();
  }

  // Mouse drag
  const cc = document.getElementById('cropContainer');
  cc.addEventListener('mousedown', e => { isDragging = true; lastX = e.clientX; lastY = e.clientY; e.preventDefault(); });
  window.addEventListener('mousemove', e => {
    if (!isDragging) return;
    cropOffX += e.clientX - lastX; cropOffY += e.clientY - lastY;
    lastX = e.clientX; lastY = e.clientY;
    drawCrop();
  });
  window.addEventListener('mouseup', () => { isDragging = false; });

  // Touch drag + pinch
  cc.addEventListener('touchstart', e => {
    if (e.touches.length === 1) {
      isDragging = true;
      lastX = e.touches[0].clientX; lastY = e.touches[0].clientY;
    } else if (e.touches.length === 2) {
      isDragging = false;
      initPinchDist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
      initPinchScale = cropScale;
    }
    e.preventDefault();
  }, { passive: false });
  cc.addEventListener('touchmove', e => {
    if (e.touches.length === 1 && isDragging) {
      cropOffX += e.touches[0].clientX - lastX; cropOffY += e.touches[0].clientY - lastY;
      lastX = e.touches[0].clientX; lastY = e.touches[0].clientY;
      drawCrop();
    } else if (e.touches.length === 2) {
      const dist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
      cropScale = Math.min(3, Math.max(0.5, initPinchScale * (dist / initPinchDist)));
      document.getElementById('zoomSlider').value = cropScale;
      drawCrop();
    }
    e.preventDefault();
  }, { passive: false });
  cc.addEventListener('touchend', () => { isDragging = false; });

  async function saveCroppedAvatar() {
    const canvas = document.getElementById('cropCanvas');
    const container = document.getElementById('cropContainer');
    const size = container.offsetWidth;

    const outCanvas = document.createElement('canvas');
    outCanvas.width = 200; outCanvas.height = 200;
    const ctx = outCanvas.getContext('2d');
    ctx.beginPath(); ctx.arc(100, 100, 100, 0, Math.PI * 2); ctx.clip();
    ctx.drawImage(canvas, 0, 0, size, size, 0, 0, 200, 200);
    const dataUrl = outCanvas.toDataURL('image/jpeg', 0.88);

    const btn = document.getElementById('cropSaveBtn');
    btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Saving…';

    try {
      const res = await fetch('/user/avatar', {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ avatar: dataUrl }),
      });
      const d = await res.json();
      if (d.success) {
        let imgEl = document.getElementById('avatarImg');
        const initials = document.getElementById('avatarInitials');
        if (!imgEl) {
          imgEl = document.createElement('img');
          imgEl.id = 'avatarImg';
          imgEl.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius:50%;position:absolute;inset:0;';
          imgEl.alt = 'Avatar';
          document.getElementById('avatarCircle').prepend(imgEl);
          if (initials) initials.style.display = 'none';
        }
        imgEl.src = dataUrl;
        closeCropModal();
      } else {
        alert(d.message || 'Failed to save avatar.');
      }
    } catch(e) { alert('Network error.'); }
    btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg"></i> Save Photo';
  }


  // ── Profile Email Modal ───────────────────────────────────────────────────────
let _peTimerInterval = null;
let _peTimerSecs = 60;
let _pePendingEmail = '';

function openProfileEmailModal() {
  // Reset state
  _pePendingEmail = '';
  document.getElementById('profileNewEmail').value = '';
  document.getElementById('profileEmailStep1').style.display = 'block';
  document.getElementById('profileEmailStep2').style.display = 'none';
  document.getElementById('profileEmailSuccess').style.display = 'none';
  document.getElementById('profileEmailInputErr').style.display = 'none';
  document.getElementById('profileSendOtpBtn').style.display = 'none';
  _clearPEDigits();
  document.getElementById('profileOTPErr').textContent = '';
  document.getElementById('profileEmailModal').style.display = 'flex';
  setTimeout(() => document.getElementById('profileNewEmail').focus(), 150);
}

function closeProfileEmailModal() {
  document.getElementById('profileEmailModal').style.display = 'none';
  clearInterval(_peTimerInterval);
}

function onProfileEmailInput(inp) {
  const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(inp.value.trim());
  document.getElementById('profileSendOtpBtn').style.display = valid ? 'flex' : 'none';
  document.getElementById('profileEmailInputErr').style.display = 'none';
  const wrap = document.getElementById('profileEmailInputWrap');
  wrap.style.borderColor = valid ? 'rgba(106,13,173,0.5)' : '';
}

async function sendProfileEmailOTP(isResend) {
  const email = (isResend ? _pePendingEmail : document.getElementById('profileNewEmail').value.trim());
  if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return;

  const btn = document.getElementById(isResend ? 'profileResendBtn' : 'profileSendOtpBtn');
  const origHTML = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = isResend ? 'Sending…' : '<i class="bi bi-hourglass-split"></i>';

  const r = await fetch('/auth/send-email-otp', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    credentials: 'include',
    body: JSON.stringify({ email }),
  });
  const d = await r.json();

  btn.innerHTML = origHTML;
  if (!isResend) btn.disabled = false;

  if (!d.success) {
    const errEl = document.getElementById('profileEmailInputErr');
    document.getElementById('profileEmailInputErrTxt').textContent = d.message || 'Failed to send OTP.';
    errEl.style.display = 'flex';
    return;
  }

  _pePendingEmail = email;

  // Switch to step 2
  document.getElementById('profileEmailStep1').style.display = 'none';
  document.getElementById('profileEmailStep2').style.display = 'block';
  document.getElementById('profileOTPEmailDisplay').textContent = email;
  _clearPEDigits();
  document.getElementById('profileOTPErr').textContent = '';
  _startPETimer();

  setTimeout(() => {
    const firstDigit = document.querySelector('#profileOTPDigits ._peDigit');
    if (firstDigit) firstDigit.focus();
  }, 100);
}

function _startPETimer() {
  _peTimerSecs = 60;
  const resendBtn = document.getElementById('profileResendBtn');
  const timerEl = document.getElementById('profileOTPTimer');
  resendBtn.disabled = true;
  clearInterval(_peTimerInterval);
  _peTimerInterval = setInterval(() => {
    _peTimerSecs--;
    if (_peTimerSecs <= 0) {
      clearInterval(_peTimerInterval);
      resendBtn.disabled = false;
      timerEl.textContent = '';
    } else {
      timerEl.textContent = `(${_peTimerSecs}s)`;
    }
  }, 1000);
}

function _clearPEDigits() {
  document.querySelectorAll('#profileOTPDigits ._peDigit').forEach(d => {
    d.value = '';
    d.style.borderColor = 'rgba(255,255,255,0.1)';
  });
}

// Wire up profile OTP digit inputs
(function() {
  function wireProfileDigits() {
    const digits = document.querySelectorAll('#profileOTPDigits ._peDigit');
    if (!digits.length) { setTimeout(wireProfileDigits, 100); return; }
    digits.forEach((inp, idx) => {
      inp.addEventListener('input', () => {
        inp.value = inp.value.replace(/\D/g, '').slice(-1);
        if (inp.value && idx < digits.length - 1) digits[idx + 1].focus();
        inp.style.borderColor = inp.value ? 'rgba(106,13,173,0.55)' : 'rgba(255,255,255,0.1)';
        document.getElementById('profileOTPErr').textContent = '';
        if (idx === digits.length - 1 && inp.value) {
          const all = Array.from(digits).map(d => d.value).join('');
          if (all.length === 6) verifyProfileEmailOTP();
        }
      });
      inp.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !inp.value && idx > 0) {
          digits[idx - 1].focus(); digits[idx - 1].value = '';
          digits[idx - 1].style.borderColor = 'rgba(255,255,255,0.1)';
        }
        if (e.key === 'Enter') verifyProfileEmailOTP();
      });
      inp.addEventListener('paste', (e) => {
        e.preventDefault();
        const text = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
        digits.forEach((d, i) => { d.value = text[i] || ''; d.style.borderColor = d.value ? 'rgba(106,13,173,0.55)' : 'rgba(255,255,255,0.1)'; });
        (digits[Math.min(text.length, 5)] || digits[5]).focus();
        if (text.length >= 6) setTimeout(() => verifyProfileEmailOTP(), 80);
      });
    });
  }
  wireProfileDigits();
})();

async function verifyProfileEmailOTP() {
  const digits = document.querySelectorAll('#profileOTPDigits ._peDigit');
  const otp = Array.from(digits).map(d => d.value).join('');
  if (otp.length < 6) {
    document.getElementById('profileOTPErr').textContent = 'Enter the complete 6-digit code.';
    return;
  }

  const btn = document.getElementById('profileVerifyOTPBtn');
  btn.disabled = true;
  document.getElementById('profileVerifyIcon').style.display = 'none';
  document.getElementById('profileVerifySpin').style.display = 'block';
  document.getElementById('profileVerifyTxt').textContent = 'Verifying…';

  try {
    const r = await fetch('/auth/verify-email-otp', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ email: _pePendingEmail, otp }),
    });
    const d = await r.json();

    if (d.success) {
      clearInterval(_peTimerInterval);
      // Show success
      document.getElementById('profileEmailStep2').style.display = 'none';
      document.getElementById('profileEmailSuccess').style.display = 'flex';

      // Update the display field and badge on the profile card
      const display = document.getElementById('profileEmailDisplay');
      if (display) display.value = _pePendingEmail;

      // Close after 1.5s and refresh page so the EJS re-renders correctly
      setTimeout(() => {
        closeProfileEmailModal();
        window.location.reload();
      }, 1500);
    } else {
      document.getElementById('profileOTPErr').textContent = d.message || 'Incorrect OTP. Please try again.';
      digits.forEach(d => { d.style.borderColor = '#FF4444'; });
      setTimeout(() => digits.forEach(d => { if (d.style.borderColor === 'rgb(255, 68, 68)') d.style.borderColor = 'rgba(255,255,255,0.1)'; }), 700);
    }
  } catch (e) {
    document.getElementById('profileOTPErr').textContent = 'Network error. Please try again.';
  }

  btn.disabled = false;
  document.getElementById('profileVerifyIcon').style.display = 'inline';
  document.getElementById('profileVerifySpin').style.display = 'none';
  document.getElementById('profileVerifyTxt').textContent = 'Confirm & Save Email';
}


  </script>
</body>
</html>
