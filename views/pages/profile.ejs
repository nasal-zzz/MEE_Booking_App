        <div style="font-family:'Courier New',Courier,monospace;font-size:0.4rem;letter-spacing:1px;color:rgba(255,255,255,0.3);text-transform:uppercase;margin-bottom:0.1rem;">Amount</div>
        <div style="font-family:'Outfit',sans-serif;font-size:0.65rem;font-weight:600;color:rgba(255,255,255,0.85);line-height:1.2;">&#8377; ${Number(bookingData.price || 0).toLocaleString('en-IN')}/-</div>
      </div>

    </div>

    <!-- Valid badge -->
    <div style="
      width:100%;
      background:rgba(76,220,128,0.09);
      border:1px solid rgba(76,220,128,0.28);
      color:#4cdc80;
      font-family:'Courier New',Courier,monospace;
      font-size:0.38rem;letter-spacing:0.5px;
      padding:0.8% 1%;border-radius:3px;text-align:center;
    ">&#10003;&nbsp; VALID &nbsp;·&nbsp; ONE TIME ENTRY</div>

  </div><!-- end right panel -->
</div>`;

        // ── Inject into hidden render zone ──
        const zone = document.getElementById('ticketRenderZone');
        zone.innerHTML = ticketHTML;
        const ticketEl = zone.firstElementChild;

        // ── Wait for all images (BG + QR) to fully load ──
        const images = Array.from(ticketEl.querySelectorAll('img'));
        await Promise.all(images.map(img => {
          if (img.complete && img.naturalWidth > 0) return Promise.resolve();
          return new Promise(resolve => {
            img.onload  = resolve;
            img.onerror = resolve; // don't block if image fails
          });
        }));

        // Small extra delay to ensure layout is painted
        await new Promise(r => setTimeout(r, 120));

        // ── Capture with html2canvas ──
        const canvas = await html2canvas(ticketEl, {
          scale:           3,
          useCORS:         true,
          allowTaint:      false,
          backgroundColor: null,
          logging:         false,
          width:           1000,
          height:          ticketEl.offsetHeight,
        });

        // ── Generate landscape A4 PDF ──
        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
        const imgData = canvas.toDataURL('image/jpeg', 0.92);
        pdf.addImage(imgData, 'JPEG', 0, 0, 297, 210);
        pdf.save(`MEE_${bookingData.ref}_${ticketData.ticketId}.pdf`);

        // ── Cleanup ──
        zone.innerHTML = '';

      } catch(e) {
        console.error('PDF generation error:', e);
        alert('PDF generation failed: ' + e.message);
      }

      btnEl.disabled = false;
      btnEl.innerHTML = '<i class="bi bi-file-earmark-pdf-fill"></i> Download PDF';
    }
  </script>

