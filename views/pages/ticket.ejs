  async function captureTicket(idx) {
  const el = document.getElementById('ticket-' + idx);
  const wasHidden = el.style.display === 'none' || 
    window.getComputedStyle(el).display === 'none';
  if (wasHidden) {
    el.style.cssText = 'display:block!important;position:fixed;left:-9999px;top:0;width:900px;';
  }
  const canvas = await html2canvas(el, {
    scale: 3, useCORS: true, allowTaint: false,
    backgroundColor: null, logging: false,
    width: 900,
  });
  if (wasHidden) { el.style.cssText = ''; }
  return canvas;
}

 async function sendToWhatsApp() {
  const btn = document.getElementById('waBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Preparing PDF…';

  try {
    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
    const tickets = document.querySelectorAll('.ticket');

    for (let i = 0; i < tickets.length; i++) {
      if (i > 0) pdf.addPage();
      const canvas = await captureTicket(i);
      const imgData = canvas.toDataURL('image/jpeg', 0.92);
      pdf.addImage(imgData, 'JPEG', 0, 0, 297, 210);
    }

    const pdfBlob = pdf.output('blob');
    const pdfFile = new File([pdfBlob], `MEE_${BOOKING_REF}_Tickets.pdf`, { type: 'application/pdf' });

    // Web Share API — works on mobile browsers (Chrome Android, Safari iOS)
    if (navigator.canShare && navigator.canShare({ files: [pdfFile] })) {
      await navigator.share({
        files: [pdfFile],
        title: `MEE Tickets — ${BOOKING_REF}`,
        text: `🎟️ Your MEE event tickets. Booking Ref: ${BOOKING_REF}`,
      });
    } else {
      // Desktop fallback: download PDF + open WhatsApp Web with message
      pdf.save(`MEE_${BOOKING_REF}_Tickets.pdf`);
      setTimeout(() => {
        const msg = encodeURIComponent(
          `🎟️ *MEE Event Tickets*\nBooking Ref: *${BOOKING_REF}*\n\nYour ticket PDF has been downloaded. Please attach it here.`
        );
        window.open(`https://web.whatsapp.com/send?text=${msg}`, '_blank');
      }, 800);
    }

  } catch (e) {
    if (e.name !== 'AbortError') {
      alert('Failed: ' + e.message);
    }
  }

  btn.disabled = false;
  btn.innerHTML = '<i class="bi bi-whatsapp"></i> Send to WhatsApp';
}

  async function downloadSingle(idx, ref) {
    const btn = document.getElementById('dl-' + idx);
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Generating…';
    try {
      const canvas = await captureTicket(idx);
      const { jsPDF } = window.jspdf;
      const pdf = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
      const imgData = canvas.toDataURL('image/jpeg', 0.92);
      pdf.addImage(imgData, 'JPEG', 0, 0, 297, 210);
      pdf.save(`MEE_Ticket_${idx + 1}_${ref}.pdf`);
    } catch(e) {
      alert('Download failed: ' + e.message);
    }
    btn.disabled = false;
    btn.innerHTML = `<i class="bi bi-file-earmark-pdf-fill"></i> Download Ticket ${idx + 1} as PDF`;
  }

  async function downloadAll() {
    const btn = document.getElementById('dlAllBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Generating PDF…';
    try {
      const { jsPDF } = window.jspdf;
      const pdf = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
      const tickets = document.querySelectorAll('.ticket');
      for (let i = 0; i < tickets.length; i++) {
        if (i > 0) pdf.addPage();
        const canvas = await captureTicket(i);
        const imgData = canvas.toDataURL('image/jpeg', 0.92);
        pdf.addImage(imgData, 'JPEG', 0, 0, 297, 210);
      }
      pdf.save(`MEE_${BOOKING_REF}_AllTickets.pdf`);
    } catch(e) {
      alert('Download failed: ' + e.message);
    }
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-download"></i> Download All Tickets (PDF)';
  }

  if (window.history && window.history.replaceState) {
    window.history.replaceState(null, '', window.location.href);
    window.history.pushState(null, '', '/');
    window.history.pushState(null, '', window.location.href);
    window.addEventListener('popstate', function() { window.location.replace('/'); });
  }
  </script>
