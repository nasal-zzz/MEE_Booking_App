<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Booking Confirmed — MEE</title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Condensed:wght@400;600;700;800&family=Space+Mono:wght@400;700&family=Outfit:wght@400;500;600;700&family=Poppins:wght@400;600;700&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/index.css"/>
  <script src="/js/ui.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <style>
    :root{
      --bg:#0B0B0F;--surface:#14141C;--border:rgba(255,255,255,0.08);
      --accent:#6A0DAD;--accent2:#9D4EDD;--text:#fff;--muted:#B3B3B3;
      --success:#00FF88;--neon:#c8ff00;
    }
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.011) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.011) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;z-index:0;}

    nav{padding:0.9rem 2rem;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);background:rgba(8,8,14,0.92);backdrop-filter:blur(20px);position:sticky;top:0;z-index:100;}
    .nav-btn{display:flex;align-items:center;gap:0.4rem;padding:0.5rem 1rem;border-radius:6px;text-decoration:none;font-size:0.8rem;font-weight:600;transition:all 0.18s;cursor:pointer;border:none;}
    .nav-btn.home{background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:var(--muted);}
    .nav-btn.home:hover{color:#fff;}
    .nav-btn.tickets{background:rgba(106,13,173,0.15);border:1px solid rgba(106,13,173,0.3);color:var(--accent2);}
    .nav-btn.tickets:hover{background:rgba(106,13,173,0.28);}

    .hero{text-align:center;padding:3rem 1rem 0.5rem;position:relative;z-index:1;}
    .success-badge{display:inline-flex;align-items:center;gap:0.55rem;background:rgba(0,255,136,0.08);border:1px solid rgba(0,255,136,0.25);border-radius:20px;padding:0.45rem 1.2rem;font-family:'Space Mono',monospace;font-size:0.65rem;letter-spacing:2px;color:var(--success);margin-bottom:1.4rem;}
    .success-ring{width:88px;height:88px;border-radius:50%;background:rgba(106,13,173,0.14);border:2px solid rgba(157,78,221,0.4);display:flex;align-items:center;justify-content:center;font-size:2.2rem;margin:0 auto 1.4rem;box-shadow:0 0 40px rgba(157,78,221,0.18);animation:popIn 0.5s ease both;}
    @keyframes popIn{0%{transform:scale(0.5);opacity:0}70%{transform:scale(1.08)}100%{transform:scale(1);opacity:1}}
    .success-title{font-family:'Anton',sans-serif;font-size:clamp(2.5rem,7vw,4.5rem);letter-spacing:3px;color:#fff;line-height:1;margin-bottom:0.7rem;}
    .success-title .grn{color:var(--success);}
    .success-sub{font-size:0.92rem;color:var(--muted);max-width:440px;margin:0 auto 0.8rem;line-height:1.7;}
    .ref-chip{display:inline-flex;align-items:center;gap:0.45rem;background:var(--surface);border:1px solid var(--border);border-radius:4px;padding:0.38rem 0.9rem;font-family:'Space Mono',monospace;font-size:0.68rem;letter-spacing:2px;color:var(--muted);}

    .cta-row{display:flex;justify-content:center;gap:0.8rem;flex-wrap:wrap;padding:1.5rem 1rem 0;position:relative;z-index:1;}
    .cta-btn{display:flex;align-items:center;gap:0.5rem;padding:0.75rem 1.4rem;border-radius:7px;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.85rem;cursor:pointer;border:none;text-decoration:none;transition:all 0.18s;}
    .cta-dl-all{background:var(--accent);color:#fff;box-shadow:0 0 22px rgba(106,13,173,0.25);}
    .cta-dl-all:hover{box-shadow:0 0 42px rgba(106,13,173,0.5);transform:translateY(-1px);color:#fff;}
    .cta-dl-all:disabled{opacity:0.6;cursor:not-allowed;transform:none;}
    .cta-wa{background:rgba(37,211,102,0.1);border:1px solid rgba(37,211,102,0.3);color:#25d366;}
    .cta-wa:hover{background:rgba(37,211,102,0.2);}
    .cta-home{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:var(--muted);}
    .cta-home:hover{color:#fff;}
    .cta-mytickets{background:rgba(106,13,173,0.12);border:1px solid rgba(106,13,173,0.28);color:var(--accent2);}
    .cta-mytickets:hover{background:rgba(106,13,173,0.24);}

    /* ── TICKETS AREA ── */
    .tickets-area{max-width:1000px;margin:2.5rem auto 1rem;padding:0 1.5rem;position:relative;z-index:1;}
    .area-label{font-family:'Space Mono',monospace;font-size:0.65rem;letter-spacing:3px;color:var(--accent2);margin-bottom:1.4rem;}
    .tickets-list{display:flex;flex-direction:column;gap:2.5rem;}

    /* ── TICKET WRAPPER ── */
    .ticket-wrap{display:flex;flex-direction:column;gap:0.7rem;}

    /* ── THE TICKET ITSELF (matches bg image proportions 2000×1416 = ~1.41 ratio, top 70%) ── */
    /* We show just the ticket portion (top 70% of bg = concert+right panel) */
.ticket{
  width:100%;
  aspect-ratio:2000/1430; /* full image height */
  position:relative;
  overflow:hidden;
  border-radius:12px;
  box-shadow:0 20px 60px rgba(0,0,0,0.7);
  background:#0d0d18;
}

    /* BG image — show only top 70% */
.ticket-bg{
  position:absolute;inset:0;
  width:100%;height:100%; /* full image */
  object-fit:cover;object-position:top left;
  top:0;left:0;
}

    /* ── QR TOP-LEFT ── */
    .t-qr-left{
      position:absolute;left:1.5%;top:2.2%;
      width:10.5%;z-index:2;
    }
    .t-qr-left img{width:100%;aspect-ratio:1;display:block;border:2px solid rgba(255,255,255,0.3);border-radius:3px;background:#fff;}

    /* ── EVENT NAME + PRICE ── */
    /* .t-ev-info{
      position:absolute;left:33%;right:29.5%;top:3%;
      text-align:right;z-index:2;
    } */
     .t-ev-info{
  position:absolute;
  left:33%;
  right:29.5%;
  top:5%;           /* slightly lower */
  text-align:right;
  z-index:2;
}

    .t-ev-name{
      font-family:'Anton',Impact,sans-serif;
      font-size:clamp(1.2rem,2.8vw,2.2rem);
      letter-spacing:3px;color:#fff;line-height:1;
      text-shadow:0 2px 14px rgba(0,0,0,0.9);
    }
    .t-ev-price{
      font-family:'Anton',Impact,sans-serif;
      font-size:clamp(1.1rem,2.5vw,2rem);
      color:#ff2d78;letter-spacing:1px;margin-top:0.3rem;
      text-shadow:0 2px 10px rgba(255,45,120,0.6);
    }

    /* ── DATE / TIME / VENUE ── */
   /* ── DATE / TIME / VENUE ── */
.t-ev-meta{
  position:absolute;
  left:30%;
  right:29.5%;
  top:40%;
  z-index:2;
  display:flex;
  flex-direction:column;
  gap:0;
}
.t-em-row{
  display:flex;
  flex-direction:row;
  gap:8%;
  margin-bottom:2%;
  align-items:flex-start;
}
.t-em-col{
  display:flex;
  flex-direction:column;
}
.t-em-lbl{
  font-family:'Space Mono',monospace;
  font-size:clamp(0.35rem,0.55vw,0.5rem);
  letter-spacing:2px;
  color:rgba(255,255,255,0.45);
  text-transform:uppercase;
  margin-bottom:0.3rem;
}
.t-em-val{
  font-family:'Barlow Condensed',sans-serif;
  font-size:clamp(0.65rem,1.15vw,1.05rem);
  font-weight:700;
  color:#fff;
  letter-spacing:0.5px;
  line-height:1.2;
}
.t-em-divider{
  width:100%;
  height:1px;
  background:rgba(255,255,255,0.2);
  margin:2% 0;
}
.t-em-venue-name{
  font-family:'Barlow Condensed',sans-serif;
  font-size:clamp(0.8rem,1.5vw,1.25rem);
  font-weight:700;
  color:#fff;
  letter-spacing:0.5px;
  line-height:1.15;
}
.t-em-venue-addr{
  font-family:'Barlow Condensed',sans-serif;
  font-size:clamp(0.4rem,0.65vw,0.6rem);
  color:rgba(255,255,255,0.5);
  text-transform:uppercase;
  letter-spacing:1px;
  margin-top:0.3rem;
}

    /* ── RIGHT PANEL ── */
    .t-rp{
      position:absolute;left:71.5%;right:0;top:11%;bottom:0;
      z-index:2;display:flex;flex-direction:column;
      align-items:center;padding:0 2.5%;gap:1.5%;
    }
    .t-rp-qr{width:46%;flex-shrink:0;}
    .t-rp-qr img{width:100%;aspect-ratio:1;display:block;border:2px solid rgba(255,255,255,0.15);border-radius:3px;background:#fff;}
    .t-rp-qr-ph{width:100%;aspect-ratio:1;background:rgba(255,255,255,0.04);border-radius:3px;display:flex;align-items:center;justify-content:center;font-size:0.5rem;color:#555;}

    .t-bid-lbl{font-family:'Space Mono',monospace;font-size:clamp(0.3rem,0.5vw,0.45rem);letter-spacing:2px;color:rgba(255,255,255,0.3);text-transform:uppercase;text-align:center;}
    .t-bid-val{font-family:'Barlow Condensed',sans-serif;font-size:clamp(0.65rem,1.2vw,1rem);font-weight:800;color:#fff;letter-spacing:2px;text-align:center;line-height:1.1;}

    .t-rp-hr{width:90%;height:1px;background:rgba(255,255,255,0.08);}

    .t-att-name{font-family:'Anton',Impact,sans-serif;font-size:clamp(0.65rem,1.1vw,0.95rem);letter-spacing:1px;color:#fff;width:100%;text-align:left;line-height:1;}
    .t-att-meta{font-family:'Space Mono',monospace;font-size:clamp(0.28rem,0.45vw,0.42rem);color:rgba(255,255,255,0.32);width:100%;text-align:left;letter-spacing:0.8px;margin-top:0.2rem;}

    .t-grid{display:grid;grid-template-columns:1fr 1fr;gap:1% 2%;width:100%;}
    .t-gc{display:flex;flex-direction:column;}
    .t-gl{font-family:'Space Mono',monospace;font-size:clamp(0.28rem,0.42vw,0.4rem);letter-spacing:1px;color:rgba(255,255,255,0.3);text-transform:uppercase;margin-bottom:0.1rem;}
    .t-gv{font-family:'Outfit',sans-serif;font-size:clamp(0.45rem,0.72vw,0.65rem);font-weight:600;color:rgba(255,255,255,0.85);line-height:1.2;}
    .t-gv.acc{color:#c8ff00;}
    .t-gv.mono{font-family:'Space Mono',monospace;font-size:clamp(0.32rem,0.5vw,0.46rem);}

    .t-valid{width:100%;background:rgba(76,220,128,0.09);border:1px solid rgba(76,220,128,0.28);color:#4cdc80;font-family:'Space Mono',monospace;font-size:clamp(0.28rem,0.42vw,0.38rem);letter-spacing:0.5px;padding:0.8% 1%;border-radius:3px;text-align:center;}

    /* ── DOWNLOAD STRIP below ticket ── */
    .ticket-dl-bar{
      display:flex;gap:0.6rem;
    }
    .btn-dl{
      flex:1;display:flex;align-items:center;justify-content:center;gap:0.45rem;
      padding:0.75rem;background:rgba(106,13,173,0.15);
      border:1px solid rgba(106,13,173,0.3);color:var(--accent2);
      border-radius:8px;cursor:pointer;font-family:'Outfit',sans-serif;
      font-weight:600;font-size:0.82rem;transition:all 0.18s;
    }
    .btn-dl:hover{background:rgba(106,13,173,0.3);}
    .btn-dl:disabled{opacity:0.5;cursor:not-allowed;}

    .btn-dlM{
      flex:1;display:flex;align-items:center;justify-content:center;gap:8.45rem;
      padding:0.75rem;background:rgba(106,13,173,0.15);
      border:1px solid rgba(106,13,173,0.3);color:var(--accent2);
      border-radius:8px;cursor:pointer;font-family:'Outfit',sans-serif;
      font-weight:600;font-size:0.82rem;transition:all 0.18s;
    }
    .btn-dlM:hover{background:rgba(106,13,173,0.3);}
    .btn-dlM:disabled{opacity:0.5;cursor:not-allowed;}

    /* WHATS NEXT */
    .whats-next{max-width:900px;margin:0 auto 2rem;padding:0 1.5rem;position:relative;z-index:1;}
    .next-title{font-family:'Poppins',sans-serif;font-size:1.4rem;letter-spacing:2px;color:#fff;margin-bottom:1rem;}
    .next-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0.9rem;}
    .next-card{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:1.2rem;}
    .next-num{font-family:'Poppins',sans-serif;font-size:2.2rem;color:rgba(255,255,255,0.03);line-height:1;margin-bottom:-0.25rem;}
    .next-icon{font-size:1.4rem;margin-bottom:0.5rem;}
    .next-card-title{font-weight:700;font-size:0.88rem;color:#fff;margin-bottom:0.28rem;}
    .next-card-desc{font-size:0.78rem;color:var(--muted);line-height:1.6;}

    .notice{max-width:900px;margin:0 auto 4rem;padding:0 1.5rem;position:relative;z-index:1;}
    .notice-inner{background:rgba(106,13,173,0.04);border:1px solid rgba(106,13,173,0.14);border-radius:8px;padding:1.1rem 1.4rem;display:flex;gap:0.9rem;align-items:flex-start;}
    .notice-inner i{color:var(--accent);font-size:1rem;flex-shrink:0;margin-top:2px;}
    .notice-text{font-size:0.8rem;color:var(--muted);line-height:1.7;}

    @media(max-width:640px){
      .next-grid{grid-template-columns:1fr;}
      .cta-row{flex-direction:column;align-items:center;}
      .cta-btn{width:100%;max-width:320px;justify-content:center;}
    }

    /* ── MOBILE TICKET CARD ── */
.mobile-ticket-card {
  display: none;
  background: linear-gradient(135deg, #1a0a2e 0%, #14141C 60%, #0d0d18 100%);
  border: 1px solid rgba(157,78,221,0.35);
  border-radius: 14px;
  overflow: hidden;
  position: relative;
}
.mtc-top-bar {
  background: rgba(106,13,173,0.55);
  padding: 0.55rem 1rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.mtc-event-name {
  font-family: 'Anton', sans-serif;
  font-size: 1.15rem;
  letter-spacing: 2px;
  color: #fff;
}
.mtc-price {
  font-family: 'Anton', sans-serif;
  font-size: 1.1rem;
  color: #ff2d78;
  text-shadow: 0 0 10px rgba(255,45,120,0.5);
}
.mtc-body {
  padding: 1rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem 1rem;
}
.mtc-qr-row {
  grid-column: 1 / -1;
  display: flex;
  justify-content: center;
  margin-bottom: 0.25rem;
}
.mtc-qr-row img {
  width: 110px;
  height: 110px;
  border: 2px solid rgba(255,255,255,0.2);
  border-radius: 6px;
  background: #fff;
}
.mtc-field label {
  font-family: 'Space Mono', monospace;
  font-size: 0.52rem;
  letter-spacing: 2px;
  color: rgba(255,255,255,0.4);
  text-transform: uppercase;
  display: block;
  margin-bottom: 0.18rem;
}
.mtc-field span {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.88rem;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.5px;
}
.mtc-field span.acc { color: #c8ff00; }
.mtc-field span.pink { color: #ff2d78; }
.mtc-field span.mono {
  font-family: 'Space Mono', monospace;
  font-size: 0.68rem;
}
.mtc-divider {
  grid-column: 1 / -1;
  height: 1px;
  background: rgba(255,255,255,0.1);
}
.mtc-attendee-row {
  grid-column: 1 / -1;
}
.mtc-attendee-name {
  font-family: 'Anton', sans-serif;
  font-size: 1.05rem;
  letter-spacing: 1px;
  color: #fff;
}
.mtc-attendee-meta {
  font-family: 'Space Mono', monospace;
  font-size: 0.58rem;
  color: rgba(255,255,255,0.4);
  margin-top: 0.2rem;
  letter-spacing: 0.5px;
}
.mtc-valid-badge {
  grid-column: 1 / -1;
  background: rgba(76,220,128,0.08);
  border: 1px solid rgba(76,220,128,0.3);
  color: #4cdc80;
  font-family: 'Space Mono', monospace;
  font-size: 0.6rem;
  letter-spacing: 1px;
  padding: 0.5rem;
  border-radius: 4px;
  text-align: center;
}
.mtc-booking-id {
  grid-column: 1 / -1;
  text-align: center;
}
.mtc-booking-id label {
  font-family: 'Space Mono', monospace;
  font-size: 0.5rem;
  letter-spacing: 2px;
  color: rgba(255,255,255,0.35);
  text-transform: uppercase;
  display: block;
  margin-bottom: 0.15rem;
}
.mtc-booking-id span {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 1.1rem;
  font-weight: 800;
  color: #fff;
  letter-spacing: 3px;
}

@media (max-width: 640px) {
  .ticket-wrap .ticket,
  .ticket-wrap .ticket-dl-bar { display: none; }
  .mobile-ticket-card { display: block; }
}
@media (min-width: 641px) {
  .mobile-ticket-card { display: none; }
}

  
  </style>
</head>
<body>
  <nav>
    <a href="/" class="np-logo">
      <img src="/img/mee-logo.png" alt="MEE Logo" style="height:38px;width:auto;object-fit:contain;"/>
    </a>
    <div style="display:flex;align-items:center;gap:0.7rem;">
      
    </div>
  </nav>

  <div class="hero">
    <div class="success-badge"><i class="bi bi-check-circle-fill"></i> PAYMENT SUCCESSFUL</div>
    <div class="success-ring">🎉</div>
    <h1 class="success-title">YOU'RE<br/><span class="grn">IN!</span></h1>
    <p class="success-sub">Your entry passes are confirmed. Download your QR tickets and show them at the door.</p>
    <div class="ref-chip"><i class="bi bi-receipt"></i> Booking Ref: <strong><%= booking.bookingRef %></strong></div>
  </div>

  <div class="cta-row">
    <button class="cta-btn cta-dl-all" id="dlAllBtn" onclick="downloadAll()">
      <i class="bi bi-download"></i> Download All Tickets (PDF)
    </button>
    <button class="cta-btn cta-wa" id="waBtn" onclick="sendToWhatsApp()">
  <i class="bi bi-whatsapp"></i> Send to WhatsApp
</button>
    <a href="/" class="cta-btn cta-home"><i class="bi bi-house-fill"></i> Home</a>
    <a href="/user/profile/#myBookings" class="cta-btn cta-mytickets"><i class="bi bi-ticket-perforated-fill"></i> My Tickets</a>
  </div>

  <div class="tickets-area">
    <div class="area-label">// your tickets (<%= booking.tickets.length %> pass<%= booking.tickets.length>1?'es':'' %>)</div>
    <div class="tickets-list">

      <% booking.tickets.forEach(function(ticket, idx){ %>
      <%
      var rawSeat    = (ticket.seatNumber || '').trim();
        // Find the matching ticket type from the event to get seatType
        var matchedType = event.ticketTypes && event.ticketTypes.find(function(tt){
          return tt.category === booking.ticketType || tt._id.toString() === (booking.ticketTypeId||'').toString();
        });
        var seatType   = (matchedType && matchedType.seatType) || 'standing';
        var isSitting  = seatType === 'sitting';
        var attendee   = ticket.attendee || {};
        var genderStr  = attendee.gender ? (attendee.gender.charAt(0).toUpperCase() + attendee.gender.slice(1)) : '';
        var pricePerTicket = Math.round((booking.subtotal || booking.totalAmount || 0) / (booking.quantity || 1));
        var gateDisplay = (booking.gateNumber || '').trim().toUpperCase();
      %>

      <div class="ticket-wrap">

        <!-- THE TICKET (captured by html2canvas) -->
        <div class="ticket" id="ticket-<%= idx %>">
          <!-- Background image -->
          <img class="ticket-bg" src="data:image/jpeg;base64," alt="" crossorigin="anonymous"/>

          <!-- QR top-left -->
          <div class="t-qr-left">
            <% if(ticket.qrCode){ %>
            <img src="<%= ticket.qrCode %>" alt="QR" crossorigin="anonymous"/>
            <% } else { %>
            <div style="width:100%;aspect-ratio:1;background:#fff;border-radius:3px;"></div>
            <% } %>
          </div>

          <!-- Event name + price -->
          <div class="t-ev-info">
            <div class="t-ev-name"><%= (booking.ticketType||event.name).toUpperCase() %></div>
            <div class="t-ev-price">&#8377; <%= pricePerTicket.toLocaleString('en-IN') %></div>
          </div>

          <!-- Date / Time / Venue -->
          <div class="t-ev-meta">
            <div class="t-em-row">
              <div class="t-em-col">
                <div class="t-em-lbl">DATE</div>
                <div class="t-em-val"><%= new Date(event.date).toLocaleDateString('en-IN',{day:'2-digit',month:'long',year:'numeric'}).toUpperCase() %></div>
              </div>
              <div class="t-em-col">
                <div class="t-em-lbl">TIME</div>
                <div class="t-em-val"><%= event.doorsOpen || '' %></div>
              </div>
            </div>
