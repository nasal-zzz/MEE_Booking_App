<!-- ================================================================
     NAVBAR — Full-page shared partial
     Includes: desktop nav, mobile toggle, mobile sidebar, scroll JS
     ================================================================ -->

<!-- Full-width Navbar that becomes Glassmorphic on Scroll -->
<nav
  class="fixed top-0 left-0 w-full z-50 border-b border-white/5 bg-transparent transition-all duration-500"
  id="navbar">
  <div class="px-5 sm:px-12 w-full transition-all duration-500" id="navbar-inner">
    <div class="flex items-center justify-between h-auto sm:h-20">

      <!-- Logo -->
      <div class="flex-shrink-0 cursor-pointer" onclick="window.location.href='/'">
        <img src="/images/brandings/logo.webp" alt="Melattur Events" class="h-12 md:h-14 w-auto object-contain">
      </div>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center space-x-6">
        <div class="flex items-center space-x-6 mr-4">
          <a href="/"         class="text-gray-300 hover:text-white transition-colors duration-200 text-sm font-medium">Home</a>
          <a href="/#about"   class="text-gray-300 hover:text-white transition-colors duration-200 text-sm font-medium">About Show</a>
          <a href="/support"  class="text-gray-300 hover:text-white transition-colors duration-200 text-sm font-medium">Contact Us</a>

          <% if (locals.user && user) { %>
            <!-- My Tickets (logged in) -->
            <a href="/user/profile/#myBookings" class="text-gray-300 hover:text-white transition-colors duration-200 text-sm font-medium">My Tickets</a>

          <!-- Profile Pill + Dropdown -->
<div class="relative" id="npProfileWrap">
  <!-- ✅ icon + first name -->
<div
  class="flex items-center gap-2.5 cursor-pointer bg-primary/10 border border-white/30 hover:border-primary/55 hover:bg-primary/20 rounded-full px-3 py-1.5 transition-all duration-200 self-center"
  onclick="npToggleProfile()">
  <i class="bi bi-person-circle text-white text-base" style="line-height:1;display:flex;align-items:center;"></i>
  <span class="text-white text-sm font-semibold max-w-[90px] truncate leading-none"><%= user.firstName %></span>
</div>

              <!-- Dropdown -->
              <div id="npProfileDd" class="hidden absolute top-[calc(100%+10px)] right-0 bg-[#13131b] border border-white/10 rounded-xl min-w-[210px] shadow-2xl z-[400] overflow-hidden">
                <!-- Head -->
                <div class="flex items-center gap-3 px-4 py-3 bg-primary/5 border-b border-white/7">
                  <div class="w-9 h-9 rounded-full bg-gradient-to-br from-[#3a0870] to-[#9500ff] border border-primary/50 flex items-center justify-center text-white text-sm font-bold flex-shrink-0">
                    <%= user.firstName.charAt(0).toUpperCase() %><% if(user.lastName){ %><%= user.lastName.charAt(0).toUpperCase() %><% } %>
                  </div>
                  <div>
                    <div class="text-white text-sm font-bold"><%= (user.firstName + ' ' + (user.lastName||'')).trim() %></div>
                    <div class="text-[#777] text-xs font-mono mt-0.5"><%= user.phone && !user.phone.startsWith('GOOGLE_') ? user.phone : (user.email||'') %></div>
                  </div>
                </div>
                <!-- Links -->
                <a href="/user/profile"             class="flex items-center gap-2.5 px-4 py-2.5 text-[#ccc] hover:bg-white/5 hover:text-white text-sm transition-colors"><i class="bi bi-person-fill text-primary w-4"></i> View Profile</a>
                <!-- ✅ ADDED: name + contact shown only on mobile (md:hidden) -->
                <div class="md:hidden flex flex-col gap-0.5 px-4 py-2 bg-primary/[0.03] border-b border-white/5" style="padding-left:2.65rem;">
                  <span class="text-[#ddd] text-sm font-semibold font-['Poppins',sans-serif]"><%= (user.firstName + ' ' + (user.lastName||'')).trim() %></span>
                  <span class="text-[#777] text-xs font-mono"><%= user.phone && !user.phone.startsWith('GOOGLE_') ? user.phone : (user.email||'') %></span>
                </div>
               <div class="h-px bg-white/10"></div>
                <a href="/auth/logout"              class="flex items-center gap-2.5 px-4 py-2.5 text-[#FF4444] hover:bg-red-500/6 text-sm transition-colors"><i class="bi bi-box-arrow-right w-4"></i> Log Out</a>
              </div>
            </div>

          <% } else { %>
            <!-- My Tickets (guest) -->
            <a href="/auth/login?next=/user/profile/#myBookings" class="text-gray-300 hover:text-white transition-colors duration-200 text-sm font-medium">My Tickets</a>

            <!-- Login Button -->
            <a href="/auth/login"
              class="text-white hover:text-primary transition-colors duration-300 text-sm font-medium border border-white/30 hover:border-primary rounded-full px-5 py-2 hover:bg-white/5">
              Login / Signup
            </a>
          <% } %>

          <div class="h-6 w-[1px] bg-white/20"></div>
        </div>
        <% if (locals.event && event) { %>
  <a href="<% if(locals.user && user){ %>/booking/seatmap/<%= event._id %><% } else { %>/auth/login?next=/booking/seatmap/<%= event._id %><% } %>"
    class="bg-gradient-premium relative group overflow-hidden text-white font-bold py-2.5 px-6 rounded-full text-sm inline-block shadow-lg shadow-primary/30 transition-transform hover:scale-105 active:scale-95 text-center">
    <span class="relative z-10">Book Now</span>
    <div class="absolute inset-0 h-full w-full bg-white/20 transform -skew-x-12 -translate-x-full group-hover:animate-[shimmer_1.5s_infinite]"></div>
  </a>
<% } %>

      </div>

      <!-- Mobile: Book Now + Hamburger -->
      <div class="flex md:hidden items-center gap-3">
        <% if (locals.event && event) { %>
  <a href="<% if(locals.user && user){ %>/booking/seatmap/<%= event._id %><% } else { %>/auth/login?next=/booking/seatmap/<%= event._id %><% } %>"
    class="bg-gradient-premium text-white font-bold py-1.5 px-4 rounded-full text-xs shadow-lg shadow-primary/20 whitespace-nowrap">
    Book Now
  </a>
<% } %>

        <button
          id="mobile-menu-btn"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="p-2 -mr-1 text-gray-300 hover:text-white hover:bg-white/10 rounded-md transition-colors focus:outline-none focus:text-white">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>
</nav>

<!-- ── Mobile Sidebar Overlay ── -->
<div id="mobile-sidebar-overlay"></div>

<!-- ── Mobile Sidebar ── -->
<div id="mobile-menu" role="dialog" aria-modal="true" aria-label="Navigation menu">

  <!-- Header -->
  <div class="sidebar-header">
    <h3>Menu</h3>
    <button id="mobile-menu-close" aria-label="Close navigation menu">
      <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Links -->
  <div class="sidebar-body">
    <a href="/"         class="sidebar-link">Home</a>
    <a href="/#about"   class="sidebar-link">About Show</a>
    <a href="/support"  class="sidebar-link">Contact Us</a>

    <% if (locals.user && user) { %>
      <a href="/user/profile/#myBookings" class="sidebar-link">My Tickets</a>
      <a href="/user/profile"             class="sidebar-link">View Profile</a>
      <!-- ✅ ADDED: name + contact in mobile sidebar below View Profile -->
      <div style="padding: 0.3rem 1.2rem 0.7rem 0.1rem; margin-top: -0.4rem; border-bottom: 1px solid rgba(255,255,255,0.06);">
  <div style="font-family:'Poppins',sans-serif; font-size:0.78rem; font-weight:600; color:#ddd;">
    <%= (user.firstName + ' ' + (user.lastName||'')).trim() %>
  </div>
  <div style="font-family:'Space Mono',monospace; font-size:0.62rem; color:#777; margin-top:2px;">
    <%= user.phone && !user.phone.startsWith('GOOGLE_') ? user.phone : (user.email||'') %>
  </div>
</div>
    <% } else { %>
      <a href="/auth/login?next=/user/profile/#myBookings" class="sidebar-link">My Tickets</a>
      <a href="/auth/login" class="sidebar-link sidebar-link--highlight">Login / Signup</a>
    <% } %>

    <!-- Social Icons -->
    <div class="flex justify-center gap-3 py-4 border-t border-white/10 mt-2">
      <a href="#" aria-label="Facebook"  class="w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-[#aaa] hover:bg-primary/20 hover:text-white hover:border-primary/40 transition-all"><i class="bi bi-facebook"></i></a>
      <a href="#" aria-label="Instagram" class="w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-[#aaa] hover:bg-primary/20 hover:text-white hover:border-primary/40 transition-all"><i class="bi bi-instagram"></i></a>
      <a href="#" aria-label="YouTube"   class="w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-[#aaa] hover:bg-primary/20 hover:text-white hover:border-primary/40 transition-all"><i class="bi bi-youtube"></i></a>
    </div>

    <div class="sidebar-cta">
      <% if (locals.user && user) { %>
        <a href="/auth/logout" class="sidebar-book-btn" style="background:rgba(255,68,68,0.12);border:1px solid rgba(255,68,68,0.3);color:#FF5555;">
          <i class="bi bi-box-arrow-right"></i> Sign Out
        </a>
      <% } else { %>
<% if (locals.event && event) { %>
  <a href="<% if(locals.user && user){ %>/booking/seatmap/<%= event._id %><% } else { %>/auth/login?next=/booking/seatmap/<%= event._id %><% } %>" class="sidebar-book-btn">Book Now</a>
<% } %>      <% } %>
    </div>
  </div>

</div>

<!-- ================================================================
     NAVBAR SCRIPT — Scroll glass effect + Mobile sidebar + Profile dropdown
     ================================================================ -->
<script>
(function () {
  'use strict';

  /* ── Scroll: glassmorphic navbar ── */
  var navbar = document.getElementById('navbar');

  function onScroll() {
    if (!navbar) return;
    if (window.scrollY > 40) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }
  }

  if (navbar) {
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  /* ── Mobile sidebar ── */
  var overlay  = document.getElementById('mobile-sidebar-overlay');
  var sidebar  = document.getElementById('mobile-menu');
  var openBtn  = document.getElementById('mobile-menu-btn');
  var closeBtn = document.getElementById('mobile-menu-close');

  if (!overlay || !sidebar || !openBtn) return;

  var sideLinks = sidebar.querySelectorAll('.sidebar-link, .sidebar-book-btn');

  function openMenu() {
    overlay.style.display = 'block';
    requestAnimationFrame(function () { overlay.classList.add('visible'); });
    sidebar.classList.add('open');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    setTimeout(function () {
      var firstLink = sidebar.querySelector('.sidebar-link');
      if (firstLink) firstLink.focus();
    }, 420);
  }

  function closeMenu() {
    overlay.classList.remove('visible');
    sidebar.classList.remove('open');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setTimeout(function () { overlay.style.display = 'none'; }, 320);
  }

  openBtn.addEventListener('click', openMenu);
  if (closeBtn) closeBtn.addEventListener('click', closeMenu);
  overlay.addEventListener('click', closeMenu);
  sideLinks.forEach(function (link) { link.addEventListener('click', closeMenu); });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && sidebar.classList.contains('open')) {
      closeMenu();
      openBtn.focus();
    }
  });

  sidebar.addEventListener('keydown', function (e) {
    if (e.key !== 'Tab' || !sidebar.classList.contains('open')) return;
    var focusable = sidebar.querySelectorAll('a[href], button:not([disabled])');
    var first = focusable[0];
    var last  = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault(); last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault(); first.focus();
    }
  });

})();

/* ── Profile dropdown (desktop) ── */
function npToggleProfile() {
  var dd = document.getElementById('npProfileDd');
  if (!dd) return;
  var isOpen = dd.classList.toggle('hidden');
  if (!isOpen) {
    setTimeout(function () {
      document.addEventListener('click', _npCloseProfile, { once: true });
    }, 10);
  }
}

function _npCloseProfile(e) {
  var wrap = document.getElementById('npProfileWrap');
  if (wrap && !wrap.contains(e.target)) {
    var dd = document.getElementById('npProfileDd');
    if (dd) dd.classList.add('hidden');
  }
}
</script>