<%
var _active = locals.activePage || '';
function _isActive(page) { return _active === page ? ' active' : ''; }
%>
<style>
  /* ── Sidebar base ── */
  .sidebar{
    background:var(--surface);
    border-right:1px solid var(--border);
    padding:1.5rem 1rem;
    position:sticky;top:0;
    height:100vh;
    display:flex;flex-direction:column;gap:0.3rem;
    z-index:100;
    overflow-y:auto;
    scrollbar-width:none;-ms-overflow-style:none;
    transition:transform 0.28s cubic-bezier(0.4,0,0.2,1);
  }
  .sidebar::-webkit-scrollbar{display:none;}
  .s-logo{display:block;padding:0 0.5rem 1rem;border-bottom:1px solid var(--border);margin-bottom:0.5rem;text-decoration:none;flex-shrink:0;}
  .s-badge{
    font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:2px;
    color:#9D4EDD;text-transform:uppercase;
    padding:0.3rem 0.5rem;margin-bottom:0.3rem;
    border:1px solid rgba(157,78,221,0.2);border-radius:4px;
    background:rgba(157,78,221,0.06);text-align:center;flex-shrink:0;
  }
  .s-section{
    font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:2px;
    color:var(--muted);text-transform:uppercase;
    padding:0.5rem 0.5rem 0.2rem;margin-top:0.3rem;flex-shrink:0;
  }
  .s-link{
    display:flex;align-items:center;gap:0.7rem;
    padding:0.7rem 0.8rem;color:var(--muted);
    text-decoration:none;border-radius:6px;font-size:0.85rem;
    transition:all 0.15s;border:1px solid transparent;flex-shrink:0;
  }
  .s-link:hover,.s-link.active{background:rgba(106,13,173,0.08);border-color:rgba(106,13,173,0.2);color:#fff;}
  .s-link i{color:var(--accent,#9500ff);width:18px;flex-shrink:0;}
  .s-logout{
    margin-top:auto;display:flex;align-items:center;gap:0.7rem;
    padding:0.7rem 0.8rem;color:var(--error,#FF4444);
    text-decoration:none;border-radius:6px;font-size:0.85rem;
    border:1px solid transparent;transition:all 0.15s;flex-shrink:0;
  }
  .s-logout:hover{background:rgba(255,68,68,0.08);}

  /* ── Mobile top bar ── */
  .mobile-topbar{
    display:none;
    position:fixed;top:0;left:0;right:0;height:54px;z-index:99;
    background:var(--surface,#14141C);border-bottom:1px solid var(--border,rgba(255,255,255,0.08));
    align-items:center;justify-content:space-between;
    padding:0 1rem;gap:0.75rem;
  }
  .mobile-topbar img{height:24px;width:auto;object-fit:contain;}
  .mobile-topbar-title{
    font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;
    color:#9D4EDD;text-transform:uppercase;flex:1;text-align:center;
  }
  .hamburger{
    background:rgba(157,78,221,0.07);border:1px solid rgba(157,78,221,0.25);
    border-radius:6px;width:36px;height:36px;cursor:pointer;
    display:flex;align-items:center;justify-content:center;
    color:#9D4EDD;font-size:1.1rem;flex-shrink:0;
    transition:background 0.15s;
  }
  .hamburger:hover{background:rgba(157,78,221,0.15);}

  /* ── Overlay ── */
  .sidebar-overlay{
    display:none;position:fixed;inset:0;background:rgba(0,0,0,0.65);
    z-index:99;backdrop-filter:blur(2px);
  }
  .sidebar-overlay.open{display:block;}

  /* ── Mobile drawer ── */
  @media(max-width:900px){
    .admin-layout{grid-template-columns:1fr !important;}
    .main{padding-top:calc(54px + 1.5rem) !important;}

    .mobile-topbar{display:flex;}

    .sidebar{
      position:fixed;top:0;left:0;bottom:0;
      width:260px;
      transform:translateX(-100%);
      box-shadow:6px 0 32px rgba(0,0,0,0.5);
    }
    .sidebar.open{transform:translateX(0);}
    .s-logo{padding:0.75rem 0.5rem;}
  }
</style>

<!-- Mobile top bar -->
<div class="mobile-topbar" id="mobileTopbar">
  <img src="/images/brandings/logo.webp" alt="MEE"/>
  <span class="mobile-topbar-title">⬡ Super Admin</span>
  <button class="hamburger" onclick="toggleSidebar()" aria-label="Menu">
    <i class="bi bi-list" id="hamburgerIcon"></i>
  </button>
</div>

<!-- Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<!-- Sidebar -->
<aside class="sidebar" id="superSidebar">
  <a href="/superadmin" class="s-logo">
    <img src="/images/brandings/logo.webp" alt="MEE" style="height:28px;width:auto;object-fit:contain;"/>
  </a>
  <span class="s-badge">&#11041; SUPER ADMIN</span>

  <div class="s-section">Overview</div>
  <a href="/superadmin"                 class="s-link<%- _isActive('dashboard') %>"       onclick="closeSidebar()"><i class="bi bi-speedometer2"></i>           Dashboard</a>
  <a href="/superadmin/bookings"        class="s-link<%- _isActive('bookings') %>"        onclick="closeSidebar()"><i class="bi bi-ticket-perforated-fill"></i>  Bookings</a>
  <a href="/superadmin/users"           class="s-link<%- _isActive('users') %>"           onclick="closeSidebar()"><i class="bi bi-person-lines-fill"></i>       Users</a>
  <a href="/superadmin/payments"        class="s-link<%- _isActive('payments') %>"        onclick="closeSidebar()"><i class="bi bi-cash-stack"></i>              Payments</a>
    <a href="/superadmin/transactions"        class="s-link<%- _isActive('transactions') %>"        onclick="closeSidebar()"><i class="bi bi-ticket-perforated-fill"></i>  Transactions</a>


  <div class="s-section">Events</div>
  <a href="/superadmin/entered-tickets" class="s-link<%- _isActive('entered-tickets') %>" onclick="closeSidebar()"><i class="bi bi-door-open-fill"></i>          Entered Tickets</a>
  <a href="/superadmin/users-by-event"  class="s-link<%- _isActive('users-by-event') %>"  onclick="closeSidebar()"><i class="bi bi-people-fill"></i>             Attendees</a>

  <div class="s-section">Promotions</div>
  <a href="/superadmin/coupons"         class="s-link<%- _isActive('coupons') %>"         onclick="closeSidebar()"><i class="bi bi-tag-fill"></i>               Coupons</a>
  <a href="/superadmin/referrals"       class="s-link<%- _isActive('referrals') %>"       onclick="closeSidebar()"><i class="bi bi-qr-code"></i>                Referral Links</a>
  <a href="/superadmin/sponsors"        class="s-link<%- _isActive('sponsors') %>"        onclick="closeSidebar()"><i class="bi bi-building-fill"></i>          Sponsors</a>

  <div class="s-section">Team</div>
  <a href="/superadmin/staff"           class="s-link<%- _isActive('staff') %>"           onclick="closeSidebar()"><i class="bi bi-person-badge-fill"></i>       Staff &amp; Admins</a>
  <a href="/superadmin/seller-activity" class="s-link<%- _isActive('seller-activity') %>" onclick="closeSidebar()"><i class="bi bi-graph-up-arrow"></i>          Seller Activity</a>

  <div class="s-section">Switch</div>
  <a href="/mee-admin" class="s-link" onclick="closeSidebar()"><i class="bi bi-grid-fill"></i> Admin Panel</a>
  <a href="/" class="s-link" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> View Site</a>

      <a href="/superadmin/bulk-events"
       class="s-link <%= activePage === 'bulk-events' ? 'active' : '' %>">
      <i class="bi bi-ticket-perforated-fill"></i> Bulk Tickets
    </a>

  <a href="/superadmin/logout" class="s-logout">
    <i class="bi bi-box-arrow-right"></i> Logout
  </a>
</aside>

<script>
  function toggleSidebar() {
    const sb  = document.getElementById('superSidebar');
    const ov  = document.getElementById('sidebarOverlay');
    const ico = document.getElementById('hamburgerIcon');
    const open = sb.classList.toggle('open');
    ov.classList.toggle('open', open);
    ico.className = open ? 'bi bi-x-lg' : 'bi bi-list';
    document.body.style.overflow = open ? 'hidden' : '';
  }
  function closeSidebar() {
    const sb  = document.getElementById('superSidebar');
    const ov  = document.getElementById('sidebarOverlay');
    const ico = document.getElementById('hamburgerIcon');
    sb.classList.remove('open');
    ov.classList.remove('open');
    ico.className = 'bi bi-list';
    document.body.style.overflow = '';
  }
</script>
