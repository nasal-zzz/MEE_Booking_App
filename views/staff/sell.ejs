<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"/>
  <meta name="theme-color" content="#0B0B0F"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Condensed:wght@400;600;700;800&family=Space+Mono:wght@400;700&family=Outfit:wght@400;500;600;700&family=Poppins:wght@400;600;700;900&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <!-- <style>
    :root{
      --bg:#0B0B0F;--surf:#14141C;--surf2:#1a1a28;
      --border:rgba(255,255,255,0.08);--accent:#9D4EDD;--accent2:#6A0DAD;
      --text:#fff;--muted:#888;--muted2:#B3B3B3;
      --success:#00FF88;--error:#FF4444;--warn:#f5c842;--cash:#00c850;
    }
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}

    /* ── TOPBAR ── */
    .topbar{background:var(--surf);border-bottom:1px solid var(--border);padding:0 1rem;height:52px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:200;}
    .tb-left{display:flex;align-items:center;gap:0.6rem;min-width:0;}
    .tb-logo{height:26px;width:auto;object-fit:contain;flex-shrink:0;}
    .tb-title{font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:2px;color:var(--muted2);text-transform:uppercase;white-space:nowrap;}
    .tb-right{display:flex;align-items:center;gap:0.5rem;flex-shrink:0;}
    .tb-user{font-size:0.72rem;color:var(--muted2);white-space:nowrap;}
    .tb-user strong{color:#fff;}
    .role-dot{width:7px;height:7px;border-radius:50%;background:var(--cash);flex-shrink:0;}
    .logout-link{display:flex;align-items:center;gap:0.3rem;font-size:0.7rem;color:var(--error);text-decoration:none;padding:0.28rem 0.55rem;border-radius:5px;border:1px solid rgba(255,68,68,0.2);white-space:nowrap;}
    .logout-link:hover{background:rgba(255,68,68,0.08);}
    @media(max-width:400px){.tb-user{display:none;}}

    /* ── PAGE ── */
    .page{padding:1.2rem;max-width:1200px;margin:0 auto;}
    .page-hd{margin-bottom:1.2rem;}
    .page-title{font-family:'Poppins',sans-serif;font-size:1.3rem;font-weight:700;letter-spacing:2px;}
    .page-sub{font-size:0.74rem;color:var(--muted2);margin-top:0.15rem;}

    /* ── GRID ── */
    .grid{display:grid;grid-template-columns:420px 1fr;gap:1.2rem;align-items:start;}
    @media(max-width:900px){.grid{grid-template-columns:1fr;}}

    /* ── CARDS ── */
    .card{background:var(--surf);border:1px solid var(--border);border-radius:12px;padding:1.2rem;}
    .card-hd{display:flex;align-items:center;gap:0.5rem;font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:var(--muted2);text-transform:uppercase;margin-bottom:1.1rem;}
    .card-hd i{font-size:0.8rem;color:var(--accent);}

    /* ── FORM ── */
    .fg{margin-bottom:0.85rem;}
    label{display:block;font-size:0.72rem;color:var(--muted2);margin-bottom:0.35rem;letter-spacing:0.3px;}
    label .req{color:var(--error);margin-left:2px;}
    input,select{width:100%;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:8px;color:#fff;padding:0.65rem 0.85rem;font-family:'Outfit',sans-serif;font-size:0.87rem;outline:none;transition:border 0.15s;-webkit-appearance:none;}
    input:focus,select:focus{border-color:var(--accent);}
    select option{background:#1a1a2e;}
    .row2{display:grid;grid-template-columns:1fr 1fr;gap:0.65rem;}
    .hint{font-size:0.67rem;color:var(--muted);margin-top:0.25rem;}

    /* ── EVENT PICKER ── */
    .evt-section{margin-bottom:1rem;}
    .evt-section-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:0.6rem;}
    .evt-section-lbl{font-size:0.72rem;color:var(--muted2);letter-spacing:0.3px;}
    .evt-section-lbl .req{color:var(--error);margin-left:2px;}
    .evt-cards{display:flex;flex-direction:column;gap:0.45rem;}
    .evt-card{
      display:flex;align-items:center;gap:0.75rem;
      background:rgba(255,255,255,0.03);
      border:1.5px solid var(--border);
      border-radius:10px;padding:0.7rem 0.85rem;
      cursor:pointer;transition:all 0.15s;
      -webkit-tap-highlight-color:transparent;
      position:relative;overflow:hidden;
    }
    .evt-card:active{transform:scale(0.985);}
    .evt-card.selected{border-color:var(--accent);background:rgba(157,78,221,0.08);}
    .evt-card.selected::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--accent);border-radius:3px 0 0 3px;}
    .evt-card-icon{width:36px;height:36px;border-radius:8px;background:rgba(157,78,221,0.15);border:1px solid rgba(157,78,221,0.25);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.9rem;color:var(--accent);}
    .evt-card-info{flex:1;min-width:0;}
    .evt-card-name{font-weight:700;font-size:0.85rem;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.2;}
    .evt-card-meta{font-size:0.65rem;color:var(--muted2);margin-top:0.18rem;display:flex;flex-wrap:wrap;gap:0.3rem 0.6rem;}
    .evt-card-meta span{display:flex;align-items:center;gap:0.2rem;}
    .evt-card-meta i{font-size:0.6rem;}
    .evt-card-sel{width:18px;height:18px;border-radius:50%;border:1.5px solid var(--border);flex-shrink:0;display:flex;align-items:center;justify-content:center;transition:all 0.15s;}
    .evt-card.selected .evt-card-sel{background:var(--accent);border-color:var(--accent);}
    .evt-card.selected .evt-card-sel::after{content:'✓';font-size:0.6rem;color:#fff;font-weight:700;}

    /* ── TICKET TYPE CARDS ── */
    .ttype-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:0.5rem;}
    .ttype-card{background:rgba(255,255,255,0.03);border:1.5px solid var(--border);border-radius:10px;padding:0.75rem 0.85rem;cursor:pointer;transition:all 0.15s;position:relative;overflow:hidden;-webkit-tap-highlight-color:transparent;}
    .ttype-card:active{transform:scale(0.97);}
    .ttype-card.selected{border-color:var(--accent);background:rgba(157,78,221,0.08);}
    .ttype-card.soldout{opacity:0.35;pointer-events:none;}
    .tt-color{width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:5px;flex-shrink:0;}
    .tt-top{display:flex;align-items:center;margin-bottom:0.25rem;}
    .tt-name{font-weight:700;font-size:0.83rem;flex:1;}
    .tt-avail{font-size:0.61rem;color:var(--muted2);}
    .tt-avail.low{color:var(--warn);}
    .tt-avail.none{color:var(--error);}
    .tt-price{font-family:'Space Mono',monospace;font-size:0.88rem;color:var(--accent);font-weight:700;}
    .tt-combo{display:inline-flex;align-items:center;gap:0.2rem;margin-top:0.25rem;font-size:0.6rem;background:rgba(245,200,66,0.1);border:1px solid rgba(245,200,66,0.25);color:var(--warn);padding:0.1rem 0.4rem;border-radius:10px;}

    /* ── SEAT MAP ── */
    .seatmap-outer{background:#0a0a12;border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-bottom:0.7rem;}
    .seatmap-title{font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:1.5px;color:var(--muted);padding:0.48rem 0.7rem;border-bottom:1px solid var(--border);text-transform:uppercase;}
    .seatmap-canvas-wrap{position:relative;width:100%;overflow:hidden;touch-action:pan-y;}
    .seatmap-img{display:block;width:100%;height:auto;max-height:300px;object-fit:contain;}
    #mapSvg{display:none;width:100%;height:auto;max-height:300px;}
    .zone-hit{position:absolute;cursor:pointer;pointer-events:all;border-radius:5px;border:2px solid rgba(255,255,255,0.25);transition:border-color 0.15s,box-shadow 0.15s;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;line-height:1.25;padding:3px 4px;-webkit-tap-highlight-color:transparent;}
    .zone-hit:active,.zone-hit:hover{border-color:#fff;}
    .zone-hit.active{border-color:#fff;border-width:2.5px;box-shadow:0 0 0 2px var(--accent),inset 0 0 0 100px rgba(255,255,255,0.12);}
    .zone-hit.full{opacity:0.3;pointer-events:none;cursor:default;}
    .zone-label{color:#fff;font-weight:700;font-size:clamp(7px,1.5vw,11px);text-shadow:0 1px 3px rgba(0,0,0,0.8);white-space:nowrap;}
    .zone-cnt{color:rgba(255,255,255,0.85);font-size:clamp(6px,1.2vw,9px);text-shadow:0 1px 3px rgba(0,0,0,0.8);}
    .seatmap-legend{display:flex;flex-wrap:wrap;gap:0.4rem;padding:0.5rem 0.7rem;background:rgba(255,255,255,0.02);border-top:1px solid var(--border);}
    .leg-item{display:flex;align-items:center;gap:0.28rem;font-size:0.65rem;color:var(--muted2);}
    .leg-dot{width:8px;height:8px;border-radius:2px;flex-shrink:0;}
    .zone-selected-bar{display:none;align-items:center;gap:0.5rem;background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.25);border-radius:7px;padding:0.5rem 0.75rem;margin-bottom:0.7rem;font-size:0.78rem;font-weight:600;color:var(--accent);}
    .zone-selected-bar.show{display:flex;}
    .zone-selected-bar i{font-size:0.9rem;}
    .zone-clear{margin-left:auto;background:none;border:none;color:var(--muted);cursor:pointer;font-size:0.75rem;padding:0.15rem 0.4rem;border-radius:4px;}
    .zone-clear:hover{color:var(--error);}

    /* ── QTY ── */
    .qty-row{display:flex;gap:0.6rem;align-items:center;}
    .qty-btn{width:42px;height:42px;border-radius:7px;background:rgba(255,255,255,0.06);border:1px solid var(--border);color:#fff;font-size:1.15rem;cursor:pointer;flex-shrink:0;display:flex;align-items:center;justify-content:center;transition:background 0.12s;-webkit-tap-highlight-color:transparent;}
    .qty-btn:active{background:rgba(255,255,255,0.14);}
    #qtyInp{text-align:center;font-family:'Space Mono',monospace;font-size:1rem;}

    /* ── SUMMARY BAR ── */
    .summary-bar{background:rgba(157,78,221,0.07);border:1px solid rgba(157,78,221,0.18);border-radius:8px;padding:0.75rem 0.9rem;margin:0.6rem 0;display:flex;justify-content:space-between;align-items:center;overflow-x:auto;}
    .sum-item{text-align:center;flex:1;padding:0 0.3rem;}
    .sum-item+.sum-item{border-left:1px solid rgba(157,78,221,0.2);}
    .sum-val{font-family:'Space Mono',monospace;font-size:0.88rem;font-weight:700;color:var(--accent);}
    .sum-val.big{font-size:1.05rem;color:#fff;}
    .sum-lbl{font-size:0.6rem;color:var(--muted);margin-top:1px;white-space:nowrap;}
    .combo-bar{background:rgba(245,200,66,0.07);border:1px solid rgba(245,200,66,0.2);border-radius:8px;padding:0.5rem 0.85rem;margin-bottom:0.6rem;display:flex;align-items:center;gap:0.5rem;font-size:0.75rem;color:var(--warn);}

    /* ── ATTENDEE ROWS ── */
    .att-list{display:flex;flex-direction:column;gap:0.5rem;margin-bottom:0.85rem;}
    .att-row{background:rgba(255,255,255,0.025);border:1px solid var(--border);border-radius:8px;padding:0.7rem;}
    .att-num{font-family:'Space Mono',monospace;font-size:0.56rem;letter-spacing:1px;color:var(--accent);margin-bottom:0.45rem;text-transform:uppercase;}

    /* ── CONTACT ── */
    .contact-section{border-top:1px solid var(--border);padding-top:0.85rem;margin-top:0.5rem;}

    /* ── STICKY SELL BUTTON ── */
    .sell-sticky{position:sticky;bottom:0;background:linear-gradient(to top,#0B0B0F 70%,transparent);padding:0.7rem 0 0.2rem;margin-top:0.4rem;z-index:50;}
    .btn-sell{width:100%;padding:0.9rem;background:linear-gradient(135deg,#6A0DAD,#9D4EDD);border:none;border-radius:8px;color:#fff;font-family:'Outfit',sans-serif;font-size:0.97rem;font-weight:700;cursor:pointer;letter-spacing:0.5px;transition:all 0.18s;display:flex;align-items:center;justify-content:center;gap:0.5rem;-webkit-tap-highlight-color:transparent;}
    .btn-sell:active:not(:disabled){transform:scale(0.98);}
    .btn-sell:disabled{opacity:0.4;cursor:not-allowed;}

    /* ── HISTORY TABLE ── */
    .tab-bar{display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:1rem;}
    .tb{background:none;border:none;color:var(--muted2);padding:0.6rem 1rem;font-family:'Space Mono',monospace;font-size:0.56rem;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;border-bottom:2px solid transparent;transition:all 0.15s;white-space:nowrap;}
    .tb.active{color:#fff;border-bottom-color:var(--accent);}
    .sales-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;}
    .sales-tbl{width:100%;border-collapse:collapse;min-width:520px;}
    .sales-tbl th{font-family:'Space Mono',monospace;font-size:0.48rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;padding:0.6rem 0.7rem;text-align:left;border-bottom:1px solid var(--border);}
    .sales-tbl td{padding:0.7rem 0.7rem;border-bottom:1px solid rgba(255,255,255,0.035);font-size:0.79rem;vertical-align:middle;}
    .sales-tbl tr:last-child td{border-bottom:none;}
    .ref-pill{font-family:'Space Mono',monospace;font-size:0.64rem;background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.2);padding:0.12rem 0.42rem;border-radius:4px;color:#d8b4fe;cursor:pointer;white-space:nowrap;}
    .reprint-btn{display:inline-flex;align-items:center;gap:0.3rem;background:rgba(157,78,221,0.06);border:1px solid rgba(157,78,221,0.18);color:#b48ef0;border-radius:5px;padding:0.2rem 0.55rem;font-size:0.6rem;cursor:pointer;margin-top:5px;transition:all 0.15s;white-space:nowrap;font-family:'Space Mono',monospace;letter-spacing:0.5px;width:100%;justify-content:center;}
    .reprint-btn:hover{background:rgba(157,78,221,0.18);border-color:rgba(157,78,221,0.5);color:#fff;box-shadow:0 0 8px rgba(157,78,221,0.2);}
    .reprint-btn:active{transform:scale(0.97);}
    .reprint-btn:disabled{opacity:0.5;cursor:not-allowed;}
    .reprint-btn i{font-size:0.7rem;}
    .no-sales{text-align:center;color:var(--muted);padding:2.5rem 1rem;font-size:0.82rem;}
    .no-sales i{display:block;font-size:2rem;opacity:0.25;margin-bottom:0.5rem;}
    .stats-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:0.6rem;margin-top:1rem;padding-top:1rem;border-top:1px solid var(--border);}
    .sstat{background:rgba(255,255,255,0.025);border:1px solid var(--border);border-radius:8px;padding:0.7rem;text-align:center;}
    .sstat-val{font-family:'Space Mono',monospace;font-size:0.92rem;font-weight:700;color:var(--cash);}
    .sstat-lbl{font-size:0.6rem;color:var(--muted);margin-top:2px;}

    /* ── SUCCESS MODAL ── */
    .modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.88);z-index:999;align-items:flex-end;justify-content:center;padding:0;}
    .modal-bg.show{display:flex;}
    @media(min-width:600px){.modal-bg{align-items:center;padding:1rem;}}
    .modal{background:var(--surf);border:1px solid rgba(157,78,221,0.25);border-radius:16px 16px 0 0;width:100%;max-width:680px;max-height:92vh;overflow-y:auto;padding:0;}
    @media(min-width:600px){.modal{border-radius:16px;max-height:88vh;}}
    .modal-handle{width:36px;height:4px;background:rgba(255,255,255,0.15);border-radius:2px;margin:10px auto 0;}
    .modal-top{padding:1.2rem 1.3rem 0.9rem;border-bottom:1px solid var(--border);}
    .modal-ok{display:flex;align-items:center;gap:0.55rem;font-size:1.02rem;font-weight:700;color:var(--success);margin-bottom:0.15rem;}
    .modal-ok i{font-size:1.15rem;}
    .modal-ref{font-family:'Space Mono',monospace;font-size:0.62rem;color:var(--muted2);letter-spacing:1px;}
    .modal-tickets{padding:0.9rem 1rem;}

    /* ══════════════════════════════════════════════
       TICKET DESIGN
    ══════════════════════════════════════════════ */
    .ticket-wrap-modal{margin-bottom:1.5rem;}

    /* Container that enforces the correct aspect ratio */
    .ticket{
      width:100%;
      aspect-ratio:2000/1430;
      position:relative;
      overflow:hidden;
      border-radius:10px;
      box-shadow:0 16px 50px rgba(0,0,0,0.7);
      background:#0d0d18;
      /* Ensure children use % positioning relative to THIS box */
      contain:layout;
    }
    .ticket-bg{
      position:absolute;inset:0;
      width:100%;height:100%;
      object-fit:cover;object-position:top left;
    }
    /* QR top-left */
    .t-qr-left{position:absolute;left:1.5%;top:2.2%;width:10.5%;z-index:2;}
    .t-qr-left img{width:100%;aspect-ratio:1;display:block;border:2px solid rgba(255,255,255,0.3);border-radius:3px;background:#fff;}

    /* Event name + price */
    .t-ev-info{position:absolute;left:33%;right:29.5%;top:5%;text-align:right;z-index:2;}
    .t-ev-name{font-family:'Anton',Impact,sans-serif;font-size:clamp(0.65rem,1.8vw,1.5rem);letter-spacing:3px;color:#fff;line-height:1;text-shadow:0 2px 14px rgba(0,0,0,0.9);}
    .t-ev-price{font-family:'Anton',Impact,sans-serif;font-size:clamp(0.6rem,1.6vw,1.35rem);color:#ff2d78;letter-spacing:1px;margin-top:0.3rem;text-shadow:0 2px 10px rgba(255,45,120,0.6);}

    /* Date / Time / Venue */
    .t-ev-meta{position:absolute;left:30%;right:29.5%;top:40%;z-index:2;display:flex;flex-direction:column;gap:0;}
    .t-em-row{display:flex;flex-direction:row;gap:8%;margin-bottom:2%;align-items:flex-start;}
    .t-em-col{display:flex;flex-direction:column;}
    .t-em-lbl{font-family:'Space Mono',monospace;font-size:clamp(0.28rem,0.5vw,0.45rem);letter-spacing:2px;color:rgba(255,255,255,0.45);text-transform:uppercase;margin-bottom:0.3rem;}
    .t-em-val{font-family:'Barlow Condensed',sans-serif;font-size:clamp(0.5rem,1vw,0.95rem);font-weight:700;color:#fff;letter-spacing:0.5px;line-height:1.2;}
    .t-em-divider{width:100%;height:1px;background:rgba(255,255,255,0.2);margin:2% 0;}
    .t-em-venue-name{font-family:'Barlow Condensed',sans-serif;font-size:clamp(0.6rem,1.3vw,1.1rem);font-weight:700;color:#fff;letter-spacing:0.5px;line-height:1.15;}
    .t-em-venue-addr{font-family:'Barlow Condensed',sans-serif;font-size:clamp(0.32rem,0.6vw,0.55rem);color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:1px;margin-top:0.3rem;}

    /* Right panel */
    .t-rp{position:absolute;left:71.5%;right:0;top:11%;bottom:0;z-index:2;display:flex;flex-direction:column;align-items:center;padding:0 2.5%;gap:1.5%;}
    .t-rp-qr{width:46%;flex-shrink:0;}
    .t-rp-qr img{width:100%;aspect-ratio:1;display:block;border:2px solid rgba(255,255,255,0.15);border-radius:3px;background:#fff;}
    .t-rp-qr-ph{width:100%;aspect-ratio:1;background:rgba(255,255,255,0.04);border-radius:3px;display:flex;align-items:center;justify-content:center;font-size:0.5rem;color:#555;}

    .t-bid-lbl{font-family:'Space Mono',monospace;font-size:clamp(0.26rem,0.45vw,0.42rem);letter-spacing:2px;color:rgba(255,255,255,0.3);text-transform:uppercase;text-align:center;}
    .t-bid-val{font-family:'Barlow Condensed',sans-serif;font-size:clamp(0.5rem,1.1vw,0.9rem);font-weight:800;color:#fff;letter-spacing:2px;text-align:center;line-height:1.1;}
    .t-rp-hr{width:90%;height:1px;background:rgba(255,255,255,0.08);}
    .t-att-name{font-family:'Anton',Impact,sans-serif;font-size:clamp(0.5rem,0.95vw,0.85rem);letter-spacing:1px;color:#fff;width:100%;text-align:left;line-height:1;}
    .t-att-meta{font-family:'Space Mono',monospace;font-size:clamp(0.22rem,0.4vw,0.38rem);color:rgba(255,255,255,0.32);width:100%;text-align:left;letter-spacing:0.8px;margin-top:0.2rem;}

    .t-grid{display:grid;grid-template-columns:1fr 1fr;gap:1% 2%;width:100%;}
    .t-gc{display:flex;flex-direction:column;}
    .t-gl{font-family:'Space Mono',monospace;font-size:clamp(0.22rem,0.38vw,0.36rem);letter-spacing:1px;color:rgba(255,255,255,0.3);text-transform:uppercase;margin-bottom:0.1rem;}
    .t-gv{font-family:'Outfit',sans-serif;font-size:clamp(0.35rem,0.65vw,0.58rem);font-weight:600;color:rgba(255,255,255,0.85);line-height:1.2;}
    .t-gv.acc{color:#c8ff00;}
    .t-gv.mono{font-family:'Space Mono',monospace;font-size:clamp(0.25rem,0.45vw,0.42rem);}
    .t-valid{width:100%;background:rgba(76,220,128,0.09);border:1px solid rgba(76,220,128,0.28);color:#4cdc80;font-family:'Space Mono',monospace;font-size:clamp(0.22rem,0.38vw,0.34rem);letter-spacing:0.5px;padding:0.8% 1%;border-radius:3px;text-align:center;}

    /* Modal actions */
    .modal-actions{padding:0 1rem 1.2rem;display:flex;flex-direction:column;gap:0.55rem;}
    .btn-print{padding:0.7rem;background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.25);border-radius:8px;color:var(--accent);font-family:'Outfit',sans-serif;font-size:0.87rem;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:0.42rem;transition:background 0.15s;}
    .btn-print:hover{background:rgba(157,78,221,0.2);}
    .btn-print:disabled{opacity:0.5;cursor:not-allowed;}
    .btn-close-modal{padding:0.7rem;background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:8px;color:var(--muted2);font-family:'Outfit',sans-serif;font-size:0.87rem;cursor:pointer;}

    /* ── TOAST ── */
    #toast{display:none;position:fixed;bottom:1.2rem;left:50%;transform:translateX(-50%);background:var(--surf);border:1px solid var(--border);border-radius:8px;padding:0.6rem 1.1rem;font-size:0.82rem;z-index:9999;box-shadow:0 6px 24px rgba(0,0,0,0.5);white-space:nowrap;max-width:90vw;text-align:center;}

    /* ── MOBILE ── */
    @media(max-width:480px){
      .page{padding:0.7rem 0.6rem;}
      .card{padding:0.9rem 0.8rem;}
      .page-title{font-size:1.1rem;letter-spacing:1px;}
      .row2{grid-template-columns:1fr;}
      .summary-bar{padding:0.5rem 0.4rem;}
      .sum-item{padding:0 0.1rem;}
      .sum-val{font-size:0.72rem;}
      .sum-val.big{font-size:0.85rem;}
      .sum-lbl{font-size:0.52rem;}
      .ttype-grid{grid-template-columns:1fr 1fr;gap:0.4rem;}
      .tt-name{font-size:0.78rem;}
      .tt-price{font-size:0.78rem;}
      .seatmap-canvas-wrap{max-height:200px;}
      #mapSvg,.seatmap-img{max-height:200px;}
      .stats-strip{grid-template-columns:1fr 1fr;}
      .modal{max-height:95vh;}
      .tb-title{display:none;}
      /* Modal ticket on phone: give it full modal width */
      .modal-tickets{padding:0.6rem 0.5rem;}
      .ticket{width:100%;}
    }
    @media(max-width:360px){
      .ttype-grid{grid-template-columns:1fr;}
      .summary-bar{flex-wrap:wrap;gap:0.4rem;}
      .sum-item{flex:none;width:45%;border-left:none!important;border-top:1px solid rgba(157,78,221,0.2);}
      .sum-item:nth-child(-n+2){border-top:none;}
    }

    /* ── PRINT STYLES ── */
    @media print {
      body > *:not(#printOverlay) { display: none !important; }
      #printOverlay {
        display: block !important;
        position: absolute !important;
        top: 0; left: 0;
        width: 100% !important;
        background: #000 !important;
        z-index: 99999 !important;
      }
      .ticket-scale-wrap {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: 100vw !important;
        height: 100vh !important;
        padding: 4mm !important;
        box-sizing: border-box !important;
        background: #000 !important;
        page-break-after: always !important;
        break-after: page !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
      }
      .ticket-scale-wrap .ticket {
        width: 277mm !important;
        height: calc(277mm * (1430 / 2000)) !important;
        aspect-ratio: unset !important;
        border-radius: 8px !important;
        flex-shrink: 0 !important;
      }
      .ticket-scale-wrap .t-ev-name        { font-size: 1.55rem !important; }
      .ticket-scale-wrap .t-ev-price       { font-size: 1.35rem !important; }
      .ticket-scale-wrap .t-em-lbl         { font-size: 0.46rem !important; }
      .ticket-scale-wrap .t-em-val         { font-size: 0.92rem !important; }
      .ticket-scale-wrap .t-em-venue-name  { font-size: 1.05rem !important; }
      .ticket-scale-wrap .t-em-venue-addr  { font-size: 0.52rem !important; }
      .ticket-scale-wrap .t-bid-lbl        { font-size: 0.46rem !important; }
      .ticket-scale-wrap .t-bid-val        { font-size: 0.92rem !important; }
      .ticket-scale-wrap .t-att-name       { font-size: 0.88rem !important; }
      .ticket-scale-wrap .t-att-meta       { font-size: 0.4rem !important; }
      .ticket-scale-wrap .t-gl             { font-size: 0.38rem !important; }
      .ticket-scale-wrap .t-gv             { font-size: 0.6rem !important; }
      .ticket-scale-wrap .t-gv.mono        { font-size: 0.44rem !important; }
      .ticket-scale-wrap .t-valid          { font-size: 0.36rem !important; padding: 1% 2% !important; }
      .ticket-scale-wrap .t-rp             { gap: 2% !important; }
      .ticket-scale-wrap .t-rp-qr          { width: 48% !important; }
      .ticket-scale-wrap .t-grid           { gap: 2% 3% !important; }
      @page { size: A4 landscape; margin: 0; }
    }
  </style> -->

<style>
  :root{
    --bg:#0B0B0F;--surf:#14141C;--surf2:#1a1a28;
    --border:rgba(255,255,255,0.08);--accent:#9D4EDD;--accent2:#6A0DAD;
    --text:#fff;--muted:#888;--muted2:#B3B3B3;
    --success:#00FF88;--error:#FF4444;--warn:#f5c842;--cash:#00c850;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}

  /* ── TOPBAR ── */
  .topbar{background:var(--surf);border-bottom:1px solid var(--border);padding:0 0.75rem;height:52px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:200;gap:0.5rem;}
  .tb-left{display:flex;align-items:center;gap:0.6rem;min-width:0;flex:1;}
  .tb-logo{height:26px;width:auto;object-fit:contain;flex-shrink:0;}
  .tb-title{font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:2px;color:var(--muted2);text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .tb-right{display:flex;align-items:center;gap:0.4rem;flex-shrink:0;}
  .tb-user{font-size:0.72rem;color:var(--muted2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:120px;}
  .tb-user strong{color:#fff;}
  .role-dot{width:7px;height:7px;border-radius:50%;background:var(--cash);flex-shrink:0;}
  .logout-link{display:flex;align-items:center;gap:0.3rem;font-size:0.7rem;color:var(--error);text-decoration:none;padding:0.28rem 0.5rem;border-radius:5px;border:1px solid rgba(255,68,68,0.2);white-space:nowrap;flex-shrink:0;}
  .logout-link:hover{background:rgba(255,68,68,0.08);}
  /* hide label on small screens, keep icon */
  .logout-txt{display:inline;}

  /* ── PAGE ── */
  .page{padding:1rem;max-width:1200px;margin:0 auto;}
  .page-hd{margin-bottom:1rem;}
  .page-title{font-family:'Poppins',sans-serif;font-size:1.2rem;font-weight:700;letter-spacing:2px;}
  .page-sub{font-size:0.74rem;color:var(--muted2);margin-top:0.15rem;}

  /* ── GRID ── */
  /* Single column by default, two-col only on wide screens */
  .grid{display:grid;grid-template-columns:1fr;gap:1rem;}

  /* ── CARDS ── */
  .card{background:var(--surf);border:1px solid var(--border);border-radius:12px;padding:1rem;}
  .card-hd{display:flex;align-items:center;gap:0.5rem;font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:var(--muted2);text-transform:uppercase;margin-bottom:1rem;}
  .card-hd i{font-size:0.8rem;color:var(--accent);}

  /* ── FORM ── */
  .fg{margin-bottom:0.85rem;}
  label{display:block;font-size:0.72rem;color:var(--muted2);margin-bottom:0.35rem;letter-spacing:0.3px;}
  label .req{color:var(--error);margin-left:2px;}
  input,select{width:100%;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:8px;color:#fff;padding:0.7rem 0.85rem;font-family:'Outfit',sans-serif;font-size:0.9rem;outline:none;transition:border 0.15s;-webkit-appearance:none;}
  input:focus,select:focus{border-color:var(--accent);}
  select option{background:#1a1a2e;}
  /* row2: 2-col on 400px+, single col on tiny */
  .row2{display:grid;grid-template-columns:1fr;gap:0.65rem;}
  .hint{font-size:0.67rem;color:var(--muted);margin-top:0.25rem;}

  /* ── EVENT PICKER ── */
  .evt-section{margin-bottom:1rem;}
  .evt-section-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:0.6rem;}
  .evt-section-lbl{font-size:0.72rem;color:var(--muted2);letter-spacing:0.3px;}
  .evt-section-lbl .req{color:var(--error);margin-left:2px;}
  .evt-cards{display:flex;flex-direction:column;gap:0.45rem;}
  .evt-card{display:flex;align-items:center;gap:0.75rem;background:rgba(255,255,255,0.03);border:1.5px solid var(--border);border-radius:10px;padding:0.7rem 0.85rem;cursor:pointer;transition:all 0.15s;-webkit-tap-highlight-color:transparent;position:relative;overflow:hidden;}
  .evt-card:active{transform:scale(0.985);}
  .evt-card.selected{border-color:var(--accent);background:rgba(157,78,221,0.08);}
  .evt-card.selected::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--accent);border-radius:3px 0 0 3px;}
  .evt-card-icon{width:36px;height:36px;border-radius:8px;background:rgba(157,78,221,0.15);border:1px solid rgba(157,78,221,0.25);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.9rem;color:var(--accent);}
  .evt-card-info{flex:1;min-width:0;}
  .evt-card-name{font-weight:700;font-size:0.85rem;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.2;}
  .evt-card-meta{font-size:0.65rem;color:var(--muted2);margin-top:0.18rem;display:flex;flex-wrap:wrap;gap:0.3rem 0.6rem;}
  .evt-card-meta span{display:flex;align-items:center;gap:0.2rem;}
  .evt-card-meta i{font-size:0.6rem;}
  .evt-card-sel{width:18px;height:18px;border-radius:50%;border:1.5px solid var(--border);flex-shrink:0;display:flex;align-items:center;justify-content:center;transition:all 0.15s;}
  .evt-card.selected .evt-card-sel{background:var(--accent);border-color:var(--accent);}
  .evt-card.selected .evt-card-sel::after{content:'✓';font-size:0.6rem;color:#fff;font-weight:700;}

  /* ── TICKET TYPE CARDS ── */
  /* Always 2-col — but min width so they never collapse below readable */
  .ttype-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0.5rem;}
  .ttype-card{background:rgba(255,255,255,0.03);border:1.5px solid var(--border);border-radius:10px;padding:0.75rem 0.75rem;cursor:pointer;transition:all 0.15s;position:relative;overflow:hidden;-webkit-tap-highlight-color:transparent;}
  .ttype-card:active{transform:scale(0.97);}
  .ttype-card.selected{border-color:var(--accent);background:rgba(157,78,221,0.08);}
  .ttype-card.soldout{opacity:0.35;pointer-events:none;}
  .tt-color{width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:5px;flex-shrink:0;}
  .tt-top{display:flex;align-items:center;margin-bottom:0.25rem;}
  .tt-name{font-weight:700;font-size:0.8rem;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .tt-avail{font-size:0.61rem;color:var(--muted2);}
  .tt-avail.low{color:var(--warn);}
  .tt-avail.none{color:var(--error);}
  .tt-price{font-family:'Space Mono',monospace;font-size:0.82rem;color:var(--accent);font-weight:700;}
  .tt-combo{display:inline-flex;align-items:center;gap:0.2rem;margin-top:0.25rem;font-size:0.58rem;background:rgba(245,200,66,0.1);border:1px solid rgba(245,200,66,0.25);color:var(--warn);padding:0.1rem 0.35rem;border-radius:10px;word-break:break-word;}

  /* ── SEAT MAP ── */
  .seatmap-outer{background:#0a0a12;border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-bottom:0.7rem;}
  .seatmap-title{font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:1.5px;color:var(--muted);padding:0.48rem 0.7rem;border-bottom:1px solid var(--border);text-transform:uppercase;}
  .seatmap-canvas-wrap{position:relative;width:100%;overflow:hidden;touch-action:pan-y;}
  .seatmap-img{display:block;width:100%;height:auto;max-height:260px;object-fit:contain;}
  #mapSvg{display:none;width:100%;height:auto;max-height:260px;}
  .zone-hit{position:absolute;cursor:pointer;pointer-events:all;border-radius:5px;border:2px solid rgba(255,255,255,0.25);transition:border-color 0.15s,box-shadow 0.15s;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;line-height:1.25;padding:3px 4px;-webkit-tap-highlight-color:transparent;}
  .zone-hit:active,.zone-hit:hover{border-color:#fff;}
  .zone-hit.active{border-color:#fff;border-width:2.5px;box-shadow:0 0 0 2px var(--accent),inset 0 0 0 100px rgba(255,255,255,0.12);}
  .zone-hit.full{opacity:0.3;pointer-events:none;cursor:default;}
  .zone-label{color:#fff;font-weight:700;font-size:clamp(7px,1.5vw,11px);text-shadow:0 1px 3px rgba(0,0,0,0.8);white-space:nowrap;}
  .zone-cnt{color:rgba(255,255,255,0.85);font-size:clamp(6px,1.2vw,9px);text-shadow:0 1px 3px rgba(0,0,0,0.8);}
  .seatmap-legend{display:flex;flex-wrap:wrap;gap:0.4rem;padding:0.5rem 0.7rem;background:rgba(255,255,255,0.02);border-top:1px solid var(--border);}
  .leg-item{display:flex;align-items:center;gap:0.28rem;font-size:0.65rem;color:var(--muted2);}
  .leg-dot{width:8px;height:8px;border-radius:2px;flex-shrink:0;}
  .zone-selected-bar{display:none;align-items:center;gap:0.5rem;background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.25);border-radius:7px;padding:0.5rem 0.75rem;margin-bottom:0.7rem;font-size:0.78rem;font-weight:600;color:var(--accent);}
  .zone-selected-bar.show{display:flex;}
  .zone-selected-bar i{font-size:0.9rem;}
  .zone-clear{margin-left:auto;background:none;border:none;color:var(--muted);cursor:pointer;font-size:0.75rem;padding:0.15rem 0.4rem;border-radius:4px;flex-shrink:0;}
  .zone-clear:hover{color:var(--error);}

  /* ── QTY ── */
  .qty-row{display:flex;gap:0.5rem;align-items:center;}
  .qty-btn{width:44px;height:44px;min-width:44px;border-radius:7px;background:rgba(255,255,255,0.06);border:1px solid var(--border);color:#fff;font-size:1.2rem;cursor:pointer;flex-shrink:0;display:flex;align-items:center;justify-content:center;transition:background 0.12s;-webkit-tap-highlight-color:transparent;}
  .qty-btn:active{background:rgba(255,255,255,0.14);}
  #qtyInp{text-align:center;font-family:'Space Mono',monospace;font-size:1rem;flex:1;min-width:0;}

  /* ── SUMMARY BAR ── */
  /* Scrollable row so 5 items never overflow on small screens */
  .summary-bar{background:rgba(157,78,221,0.07);border:1px solid rgba(157,78,221,0.18);border-radius:8px;padding:0.6rem 0.5rem;margin:0.6rem 0;display:flex;justify-content:space-between;align-items:center;overflow-x:auto;-webkit-overflow-scrolling:touch;gap:0.25rem;}
  .sum-item{text-align:center;flex:1;padding:0 0.25rem;min-width:0;}
  .sum-item+.sum-item{border-left:1px solid rgba(157,78,221,0.2);}
  .sum-val{font-family:'Space Mono',monospace;font-size:0.78rem;font-weight:700;color:var(--accent);white-space:nowrap;}
  .sum-val.big{font-size:0.9rem;color:#fff;}
  .sum-lbl{font-size:0.55rem;color:var(--muted);margin-top:1px;white-space:nowrap;}
  .combo-bar{background:rgba(245,200,66,0.07);border:1px solid rgba(245,200,66,0.2);border-radius:8px;padding:0.5rem 0.85rem;margin-bottom:0.6rem;display:flex;align-items:center;gap:0.5rem;font-size:0.74rem;color:var(--warn);word-break:break-word;}

  /* ── ATTENDEE ROWS ── */
  .att-list{display:flex;flex-direction:column;gap:0.5rem;margin-bottom:0.85rem;}
  .att-row{background:rgba(255,255,255,0.025);border:1px solid var(--border);border-radius:8px;padding:0.7rem;}
  .att-num{font-family:'Space Mono',monospace;font-size:0.56rem;letter-spacing:1px;color:var(--accent);margin-bottom:0.45rem;text-transform:uppercase;}

  /* ── CONTACT ── */
  .contact-section{border-top:1px solid var(--border);padding-top:0.85rem;margin-top:0.5rem;}

  /* ── STICKY SELL BUTTON ── */
  .sell-sticky{position:sticky;bottom:0;background:linear-gradient(to top,#0B0B0F 70%,transparent);padding:0.7rem 0 env(safe-area-inset-bottom,0.4rem);margin-top:0.4rem;z-index:50;}
  .btn-sell{width:100%;padding:0.95rem;background:linear-gradient(135deg,#6A0DAD,#9D4EDD);border:none;border-radius:8px;color:#fff;font-family:'Outfit',sans-serif;font-size:1rem;font-weight:700;cursor:pointer;letter-spacing:0.5px;transition:all 0.18s;display:flex;align-items:center;justify-content:center;gap:0.5rem;-webkit-tap-highlight-color:transparent;}
  .btn-sell:active:not(:disabled){transform:scale(0.98);}
  .btn-sell:disabled{opacity:0.4;cursor:not-allowed;}

  /* ── HISTORY TABLE ── */
  .tab-bar{display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:1rem;}
  .tb{background:none;border:none;color:var(--muted2);padding:0.6rem 1rem;font-family:'Space Mono',monospace;font-size:0.56rem;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;border-bottom:2px solid transparent;transition:all 0.15s;white-space:nowrap;}
  .tb.active{color:#fff;border-bottom-color:var(--accent);}
  .sales-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;}
  .sales-tbl{width:100%;border-collapse:collapse;min-width:500px;}
  .sales-tbl th{font-family:'Space Mono',monospace;font-size:0.48rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;padding:0.6rem 0.6rem;text-align:left;border-bottom:1px solid var(--border);}
  .sales-tbl td{padding:0.65rem 0.6rem;border-bottom:1px solid rgba(255,255,255,0.035);font-size:0.78rem;vertical-align:middle;}
  .sales-tbl tr:last-child td{border-bottom:none;}
  .ref-pill{font-family:'Space Mono',monospace;font-size:0.62rem;background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.2);padding:0.12rem 0.42rem;border-radius:4px;color:#d8b4fe;cursor:pointer;white-space:nowrap;}
  .reprint-btn{display:inline-flex;align-items:center;gap:0.3rem;background:rgba(157,78,221,0.06);border:1px solid rgba(157,78,221,0.18);color:#b48ef0;border-radius:5px;padding:0.22rem 0.55rem;font-size:0.6rem;cursor:pointer;margin-top:5px;transition:all 0.15s;white-space:nowrap;font-family:'Space Mono',monospace;letter-spacing:0.5px;width:100%;justify-content:center;}
  .reprint-btn:hover{background:rgba(157,78,221,0.18);border-color:rgba(157,78,221,0.5);color:#fff;}
  .reprint-btn:active{transform:scale(0.97);}
  .reprint-btn:disabled{opacity:0.5;cursor:not-allowed;}
  .reprint-btn i{font-size:0.7rem;}
  .no-sales{text-align:center;color:var(--muted);padding:2.5rem 1rem;font-size:0.82rem;}
  .no-sales i{display:block;font-size:2rem;opacity:0.25;margin-bottom:0.5rem;}
  .stats-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0.5rem;margin-top:1rem;padding-top:1rem;border-top:1px solid var(--border);}
  .sstat{background:rgba(255,255,255,0.025);border:1px solid var(--border);border-radius:8px;padding:0.65rem 0.5rem;text-align:center;}
  .sstat-val{font-family:'Space Mono',monospace;font-size:0.82rem;font-weight:700;color:var(--cash);word-break:break-all;}
  .sstat-lbl{font-size:0.58rem;color:var(--muted);margin-top:2px;}

  /* ── SUCCESS MODAL ── */
  .modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.88);z-index:999;align-items:flex-end;justify-content:center;padding:0;}
  .modal-bg.show{display:flex;}
  .modal{background:var(--surf);border:1px solid rgba(157,78,221,0.25);border-radius:16px 16px 0 0;width:100%;max-width:680px;max-height:92vh;overflow-y:auto;padding:0;padding-bottom:env(safe-area-inset-bottom,0px);}
  .modal-handle{width:36px;height:4px;background:rgba(255,255,255,0.15);border-radius:2px;margin:10px auto 0;}
  .modal-top{padding:1.2rem 1rem 0.9rem;border-bottom:1px solid var(--border);}
  .modal-ok{display:flex;align-items:center;gap:0.55rem;font-size:1rem;font-weight:700;color:var(--success);margin-bottom:0.15rem;}
  .modal-ok i{font-size:1.1rem;}
  .modal-ref{font-family:'Space Mono',monospace;font-size:0.6rem;color:var(--muted2);letter-spacing:1px;word-break:break-all;}
  .modal-tickets{padding:0.9rem 0.75rem;}

  /* ══════════════════════════════════════════════
     TICKET DESIGN — NOT MODIFIED (as requested)
  ══════════════════════════════════════════════ */
  .ticket-wrap-modal{margin-bottom:1.5rem;}
  .ticket{width:100%;aspect-ratio:2000/1430;position:relative;overflow:hidden;border-radius:10px;box-shadow:0 16px 50px rgba(0,0,0,0.7);background:#0d0d18;contain:layout;}
  .ticket-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top left;}
  .t-qr-left{position:absolute;left:1.5%;top:2.2%;width:10.5%;z-index:2;}
  .t-qr-left img{width:100%;aspect-ratio:1;display:block;border:2px solid rgba(255,255,255,0.3);border-radius:3px;background:#fff;}
  .t-ev-info{position:absolute;left:33%;right:29.5%;top:5%;text-align:right;z-index:2;}
  .t-ev-name{font-family:'Anton',Impact,sans-serif;font-size:clamp(0.65rem,1.8vw,1.5rem);letter-spacing:3px;color:#fff;line-height:1;text-shadow:0 2px 14px rgba(0,0,0,0.9);}
  .t-ev-price{font-family:'Anton',Impact,sans-serif;font-size:clamp(0.6rem,1.6vw,1.35rem);color:#ff2d78;letter-spacing:1px;margin-top:0.3rem;text-shadow:0 2px 10px rgba(255,45,120,0.6);}
  .t-ev-meta{position:absolute;left:30%;right:29.5%;top:40%;z-index:2;display:flex;flex-direction:column;gap:0;}
  .t-em-row{display:flex;flex-direction:row;gap:8%;margin-bottom:2%;align-items:flex-start;}
  .t-em-col{display:flex;flex-direction:column;}
  .t-em-lbl{font-family:'Space Mono',monospace;font-size:clamp(0.28rem,0.5vw,0.45rem);letter-spacing:2px;color:rgba(255,255,255,0.45);text-transform:uppercase;margin-bottom:0.3rem;}
  .t-em-val{font-family:'Barlow Condensed',sans-serif;font-size:clamp(0.5rem,1vw,0.95rem);font-weight:700;color:#fff;letter-spacing:0.5px;line-height:1.2;}
  .t-em-divider{width:100%;height:1px;background:rgba(255,255,255,0.2);margin:2% 0;}
  .t-em-venue-name{font-family:'Barlow Condensed',sans-serif;font-size:clamp(0.6rem,1.3vw,1.1rem);font-weight:700;color:#fff;letter-spacing:0.5px;line-height:1.15;}
  .t-em-venue-addr{font-family:'Barlow Condensed',sans-serif;font-size:clamp(0.32rem,0.6vw,0.55rem);color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:1px;margin-top:0.3rem;}
  .t-rp{position:absolute;left:71.5%;right:0;top:11%;bottom:0;z-index:2;display:flex;flex-direction:column;align-items:center;padding:0 2.5%;gap:1.5%;}
  .t-rp-qr{width:46%;flex-shrink:0;}
  .t-rp-qr img{width:100%;aspect-ratio:1;display:block;border:2px solid rgba(255,255,255,0.15);border-radius:3px;background:#fff;}
  .t-rp-qr-ph{width:100%;aspect-ratio:1;background:rgba(255,255,255,0.04);border-radius:3px;display:flex;align-items:center;justify-content:center;font-size:0.5rem;color:#555;}
  .t-bid-lbl{font-family:'Space Mono',monospace;font-size:clamp(0.26rem,0.45vw,0.42rem);letter-spacing:2px;color:rgba(255,255,255,0.3);text-transform:uppercase;text-align:center;}
  .t-bid-val{font-family:'Barlow Condensed',sans-serif;font-size:clamp(0.5rem,1.1vw,0.9rem);font-weight:800;color:#fff;letter-spacing:2px;text-align:center;line-height:1.1;}
  .t-rp-hr{width:90%;height:1px;background:rgba(255,255,255,0.08);}
  .t-att-name{font-family:'Anton',Impact,sans-serif;font-size:clamp(0.5rem,0.95vw,0.85rem);letter-spacing:1px;color:#fff;width:100%;text-align:left;line-height:1;}
  .t-att-meta{font-family:'Space Mono',monospace;font-size:clamp(0.22rem,0.4vw,0.38rem);color:rgba(255,255,255,0.32);width:100%;text-align:left;letter-spacing:0.8px;margin-top:0.2rem;}
  .t-grid{display:grid;grid-template-columns:1fr 1fr;gap:1% 2%;width:100%;}
  .t-gc{display:flex;flex-direction:column;}
  .t-gl{font-family:'Space Mono',monospace;font-size:clamp(0.22rem,0.38vw,0.36rem);letter-spacing:1px;color:rgba(255,255,255,0.3);text-transform:uppercase;margin-bottom:0.1rem;}
  .t-gv{font-family:'Outfit',sans-serif;font-size:clamp(0.35rem,0.65vw,0.58rem);font-weight:600;color:rgba(255,255,255,0.85);line-height:1.2;}
  .t-gv.acc{color:#c8ff00;}
  .t-gv.mono{font-family:'Space Mono',monospace;font-size:clamp(0.25rem,0.45vw,0.42rem);}
  .t-valid{width:100%;background:rgba(76,220,128,0.09);border:1px solid rgba(76,220,128,0.28);color:#4cdc80;font-family:'Space Mono',monospace;font-size:clamp(0.22rem,0.38vw,0.34rem);letter-spacing:0.5px;padding:0.8% 1%;border-radius:3px;text-align:center;}

  /* Modal actions */
  .modal-actions{padding:0 0.75rem 1.2rem;display:flex;flex-direction:column;gap:0.55rem;}
  .btn-print{padding:0.75rem;background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.25);border-radius:8px;color:var(--accent);font-family:'Outfit',sans-serif;font-size:0.9rem;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:0.42rem;transition:background 0.15s;}
  .btn-print:hover{background:rgba(157,78,221,0.2);}
  .btn-print:disabled{opacity:0.5;cursor:not-allowed;}
  .btn-close-modal{padding:0.75rem;background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:8px;color:var(--muted2);font-family:'Outfit',sans-serif;font-size:0.9rem;cursor:pointer;}

  /* ── TOAST ── */
  #toast{display:none;position:fixed;bottom:max(1.2rem, env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);background:var(--surf);border:1px solid var(--border);border-radius:8px;padding:0.6rem 1.1rem;font-size:0.82rem;z-index:9999;box-shadow:0 6px 24px rgba(0,0,0,0.5);white-space:nowrap;max-width:90vw;text-align:center;}

  /* ── PRINT STYLES (UNCHANGED) ── */
  @media print {
    body > *:not(#printOverlay) { display: none !important; }
    #printOverlay {display:block !important;position:absolute !important;top:0;left:0;width:100% !important;background:#000 !important;z-index:99999 !important;}
    .ticket-scale-wrap{display:flex !important;align-items:center !important;justify-content:center !important;width:100vw !important;height:100vh !important;padding:4mm !important;box-sizing:border-box !important;background:#000 !important;page-break-after:always !important;break-after:page !important;page-break-inside:avoid !important;break-inside:avoid !important;}
    .ticket-scale-wrap .ticket{width:277mm !important;height:calc(277mm * (1430 / 2000)) !important;aspect-ratio:unset !important;border-radius:8px !important;flex-shrink:0 !important;}
    .ticket-scale-wrap .t-ev-name{font-size:1.55rem !important;}
    .ticket-scale-wrap .t-ev-price{font-size:1.35rem !important;}
    .ticket-scale-wrap .t-em-lbl{font-size:0.46rem !important;}
    .ticket-scale-wrap .t-em-val{font-size:0.92rem !important;}
    .ticket-scale-wrap .t-em-venue-name{font-size:1.05rem !important;}
    .ticket-scale-wrap .t-em-venue-addr{font-size:0.52rem !important;}
    .ticket-scale-wrap .t-bid-lbl{font-size:0.46rem !important;}
    .ticket-scale-wrap .t-bid-val{font-size:0.92rem !important;}
    .ticket-scale-wrap .t-att-name{font-size:0.88rem !important;}
    .ticket-scale-wrap .t-att-meta{font-size:0.4rem !important;}
    .ticket-scale-wrap .t-gl{font-size:0.38rem !important;}
    .ticket-scale-wrap .t-gv{font-size:0.6rem !important;}
    .ticket-scale-wrap .t-gv.mono{font-size:0.44rem !important;}
    .ticket-scale-wrap .t-valid{font-size:0.36rem !important;padding:1% 2% !important;}
    .ticket-scale-wrap .t-rp{gap:2% !important;}
    .ticket-scale-wrap .t-rp-qr{width:48% !important;}
    .ticket-scale-wrap .t-grid{gap:2% 3% !important;}
    @page{size:A4 landscape;margin:0;}
  }

  /* ══════════════════════════════════════════════
     RESPONSIVE BREAKPOINTS
  ══════════════════════════════════════════════ */

/* Topbar — prevent overflow on tiny screens */
.topbar { padding: 0 0.75rem; gap: 0.5rem; }
.tb-left { flex: 1; min-width: 0; }
.tb-title { overflow: hidden; text-overflow: ellipsis; }
/* Hide user label and role dot until we have room */
.tb-user  { display: none; }
.role-dot { display: none; }
.logout-txt { display: none; }
/* Always keep the logout button visible but compact */
.logout-link { padding: 0.28rem 0.45rem; }
 
/* Page */
.page { padding: 0.65rem; }
.page-title { font-size: 1rem; letter-spacing: 1px; }
 
/* Grid — single column on mobile */
.grid { grid-template-columns: 1fr; gap: 0.75rem; }
 
/* Card */
.card { padding: 0.8rem 0.7rem; }
.card-hd { margin-bottom: 0.85rem; }
 
/* ── Event cards ── */
.evt-card { padding: 0.6rem 0.7rem; gap: 0.55rem; }
.evt-card-icon { width: 30px; height: 30px; font-size: 0.78rem; }
.evt-card-name { font-size: 0.8rem; }
.evt-card-meta { font-size: 0.6rem; gap: 0.2rem 0.5rem; }
 
/* ── Ticket type grid ──
   ALWAYS 2-col regardless of screen width.
   minmax(0,1fr) prevents cards overflowing their column. */
.ttype-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.4rem;
}
.ttype-card { padding: 0.6rem 0.55rem; }
.tt-name    { font-size: 0.74rem; }
.tt-price   { font-size: 0.76rem; }
.tt-avail   { font-size: 0.58rem; }
.tt-combo   { font-size: 0.53rem; padding: 0.07rem 0.28rem; }
.tt-top     { margin-bottom: 0.2rem; }
 
/* ── Quantity row ── */
.qty-btn { width: 44px; height: 44px; min-width: 44px; font-size: 1.15rem; }
#qtyInp  { font-size: 0.9rem; }
 
/* ── Summary bar — single scrollable row, never wraps ── */
.summary-bar {
  flex-wrap: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  padding: 0.45rem 0.35rem;
  gap: 0;
}
.sum-item  { min-width: 52px; padding: 0 0.18rem; flex-shrink: 0; }
.sum-val   { font-size: 0.68rem; white-space: nowrap; }
.sum-val.big { font-size: 0.78rem; }
.sum-lbl   { font-size: 0.49rem; white-space: nowrap; }
 
/* ── Combo bar ── */
.combo-bar { font-size: 0.7rem; padding: 0.4rem 0.65rem; }
 
/* ── Attendee rows — name/age stacked on tiny phones ── */
.att-row { padding: 0.6rem 0.55rem; }
.att-row .row2 { grid-template-columns: 1fr; }
 
/* ── Contact section row2 — stacked on tiny phones ── */
.contact-section .row2 { grid-template-columns: 1fr; }
 
/* ── Zone selected bar ── */
.zone-selected-bar { font-size: 0.72rem; padding: 0.42rem 0.55rem; }
 
/* ── Seat map ── */
.seatmap-img, #mapSvg { max-height: 200px; }
 
/* ── Stats strip — always 3 cols, but tighter ── */
.stats-strip {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.4rem;
}
.sstat     { padding: 0.5rem 0.35rem; }
.sstat-val { font-size: 0.68rem; word-break: break-all; }
.sstat-lbl { font-size: 0.54rem; }
 
/* ── Sales table ── */
.sales-tbl    { min-width: 460px; }
.sales-tbl th { font-size: 0.44rem; padding: 0.5rem 0.45rem; }
.sales-tbl td { font-size: 0.73rem; padding: 0.55rem 0.45rem; }
.ref-pill     { font-size: 0.6rem; }
.reprint-btn  { font-size: 0.57rem; padding: 0.18rem 0.45rem; }
 
/* ── Sell button ── */
.sell-sticky {
  padding: 0.55rem 0 env(safe-area-inset-bottom, 0.25rem);
}
.btn-sell { font-size: 0.92rem; padding: 0.85rem; }
 
/* ── Modal — bottom sheet on mobile ── */
.modal-bg  { align-items: flex-end; padding: 0; }
.modal     { border-radius: 14px 14px 0 0; max-height: 93vh; padding-bottom: env(safe-area-inset-bottom, 0); }
.modal-top { padding: 0.9rem 0.85rem 0.75rem; }
.modal-ok  { font-size: 0.95rem; }
.modal-ref { font-size: 0.57rem; }
.modal-tickets { padding: 0.7rem 0.55rem; }
.modal-actions { padding: 0 0.55rem 0.95rem; gap: 0.45rem; }
.btn-print, .btn-close-modal { font-size: 0.85rem; padding: 0.68rem; }
 
 
/* ─────────────────────────────────────────────
   380px — wider small phones
───────────────────────────────────────────────*/
@media (min-width: 380px) {
  .page  { padding: 0.75rem; }
  .card  { padding: 0.88rem 0.8rem; }
 
  /* Restore user label now there's room */
  .tb-user  { display: flex; max-width: 120px; font-size: 0.68rem; }
  .role-dot { display: block; }
  .logout-txt { display: inline; }
 
  .ttype-card { padding: 0.65rem 0.6rem; }
  .tt-name  { font-size: 0.77rem; }
  .tt-price { font-size: 0.79rem; }
 
  .sum-val   { font-size: 0.72rem; }
  .sum-val.big { font-size: 0.82rem; }
 
  .seatmap-img, #mapSvg { max-height: 215px; }
}
 
 
/* ─────────────────────────────────────────────
   420px — iPhone 14 / standard Android
───────────────────────────────────────────────*/
@media (min-width: 420px) {
  .page  { padding: 0.85rem; }
  .card  { padding: 0.95rem; }
  .page-title { font-size: 1.1rem; letter-spacing: 1.5px; }
 
  /* Two-col for attendee name/age */
  .att-row .row2 { grid-template-columns: 1fr 1fr; }
  /* Two-col for buyer contact */
  .contact-section .row2 { grid-template-columns: 1fr 1fr; }
 
  .ttype-grid { gap: 0.45rem; }
  .ttype-card { padding: 0.7rem 0.65rem; }
  .tt-name    { font-size: 0.8rem; }
  .tt-price   { font-size: 0.82rem; }
  .tt-avail   { font-size: 0.6rem; }
 
  .sum-item    { min-width: 56px; padding: 0 0.22rem; }
  .sum-val     { font-size: 0.75rem; }
  .sum-val.big { font-size: 0.86rem; }
  .sum-lbl     { font-size: 0.52rem; }
 
  .seatmap-img, #mapSvg { max-height: 230px; }
 
  .stats-strip { gap: 0.45rem; }
  .sstat-val   { font-size: 0.74rem; }
  .sstat-lbl   { font-size: 0.56rem; }
}
 
 
/* ─────────────────────────────────────────────
   540px — phablets, small tablets portrait
───────────────────────────────────────────────*/
@media (min-width: 540px) {
  .page  { padding: 1rem 1.05rem; }
  .card  { padding: 1.05rem 1rem; }
  .page-title { font-size: 1.15rem; }
 
  .tb-user { max-width: 160px; font-size: 0.7rem; }
 
  .ttype-grid { gap: 0.5rem; }
  .ttype-card { padding: 0.72rem 0.7rem; }
  .tt-name    { font-size: 0.82rem; }
  .tt-price   { font-size: 0.84rem; }
 
  .summary-bar { padding: 0.55rem 0.45rem; }
  .sum-val     { font-size: 0.78rem; }
  .sum-val.big { font-size: 0.9rem; }
  .sum-lbl     { font-size: 0.54rem; }
 
  .seatmap-img, #mapSvg { max-height: 250px; }
 
  .stats-strip { gap: 0.5rem; }
  .sstat-val   { font-size: 0.8rem; }
  .sstat-lbl   { font-size: 0.58rem; }
 
  .modal-tickets { padding: 0.85rem 0.75rem; }
  .modal-actions { padding: 0 0.75rem 1.05rem; }
}
 
 
/* ─────────────────────────────────────────────
   600px — large phones, small tablets
───────────────────────────────────────────────*/
@media (min-width: 600px) {
  .page  { padding: 1.1rem 1.15rem; }
  .card  { padding: 1.1rem 1.1rem; }
  .page-title { font-size: 1.2rem; letter-spacing: 2px; }
 
  .tb-user    { max-width: none; font-size: 0.72rem; }
  .logout-link { padding: 0.28rem 0.55rem; }
 
  .ttype-grid { gap: 0.5rem; }
  .tt-name    { font-size: 0.83rem; }
  .tt-price   { font-size: 0.88rem; }
  .tt-avail   { font-size: 0.61rem; }
 
  .summary-bar { padding: 0.6rem 0.55rem; }
  .sum-val     { font-size: 0.82rem; }
  .sum-val.big { font-size: 0.95rem; }
  .sum-lbl     { font-size: 0.56rem; }
 
  .seatmap-img, #mapSvg { max-height: 265px; }
 
  .stats-strip { gap: 0.55rem; }
  .sstat-val   { font-size: 0.85rem; }
  .sstat-lbl   { font-size: 0.59rem; }
 
  /* Modal closer to centered on 600+ */
  .modal-bg  { align-items: flex-end; padding: 0; }
  .modal     { border-radius: 16px 16px 0 0; max-height: 92vh; }
  .modal-top { padding: 1.1rem 1.1rem 0.85rem; }
  .modal-tickets { padding: 0.9rem 0.9rem; }
  .modal-actions { padding: 0 0.9rem 1.1rem; }
  .btn-print, .btn-close-modal { font-size: 0.88rem; padding: 0.72rem; }
 
  .sell-sticky { padding: 0.65rem 0 env(safe-area-inset-bottom, 0.3rem); }
  .btn-sell    { font-size: 0.97rem; padding: 0.9rem; }
}
 
 
/* ─────────────────────────────────────────────
   768px — tablets portrait
───────────────────────────────────────────────*/
@media (min-width: 768px) {
  .page  { padding: 1.15rem 1.25rem; }
  .card  { padding: 1.15rem 1.2rem; }
 
  .ttype-grid { gap: 0.55rem; }
  .tt-name    { font-size: 0.84rem; }
  .tt-price   { font-size: 0.9rem; }
 
  .summary-bar { padding: 0.65rem 0.65rem; flex-wrap: nowrap; }
  .sum-val     { font-size: 0.86rem; }
  .sum-val.big { font-size: 1rem; }
  .sum-lbl     { font-size: 0.58rem; }
 
  .seatmap-img, #mapSvg { max-height: 285px; }
 
  .stats-strip { gap: 0.55rem; }
  .sstat-val   { font-size: 0.88rem; }
  .sstat-lbl   { font-size: 0.6rem; }
 
  .sales-tbl th { font-size: 0.47rem; padding: 0.58rem 0.58rem; }
  .sales-tbl td { font-size: 0.77rem; padding: 0.62rem 0.58rem; }
}
 
 
/* ─────────────────────────────────────────────
   900px — two-column desktop layout
───────────────────────────────────────────────*/
@media (min-width: 900px) {
  .page  { padding: 1.2rem; }
  .card  { padding: 1.2rem; }
  .page-title { font-size: 1.3rem; letter-spacing: 2px; }
 
  /* Restore two-column layout */
  .grid { grid-template-columns: 420px 1fr; gap: 1.2rem; }
 
  .tt-name    { font-size: 0.83rem; }
  .tt-price   { font-size: 0.88rem; }
  .ttype-grid { gap: 0.5rem; }
 
  .summary-bar { padding: 0.75rem 0.9rem; }
  .sum-val     { font-size: 0.88rem; }
  .sum-val.big { font-size: 1.05rem; }
  .sum-lbl     { font-size: 0.6rem; }
 
  .seatmap-img, #mapSvg { max-height: 300px; }
 
  .stats-strip { gap: 0.6rem; }
  .sstat-val   { font-size: 0.92rem; }
  .sstat       { padding: 0.65rem 0.5rem; }
 
  .sales-tbl th { font-size: 0.48rem; padding: 0.6rem 0.6rem; }
  .sales-tbl td { font-size: 0.79rem; padding: 0.65rem 0.6rem; }
 
  /* Modal: centered dialog on desktop */
  .modal-bg  { align-items: center; padding: 1rem; }
  .modal     { border-radius: 16px; max-height: 88vh; align-self: center; }
  .modal-top { padding: 1.2rem 1.3rem 0.9rem; }
  .modal-tickets { padding: 0.9rem 1rem; }
  .modal-actions { padding: 0 1rem 1.2rem; }
  .btn-print, .btn-close-modal { font-size: 0.9rem; padding: 0.75rem; }
 
  .sell-sticky { padding: 0.7rem 0 env(safe-area-inset-bottom, 0.2rem); }
  .btn-sell    { font-size: 1rem; padding: 0.95rem; }
}
 
 
/* ─────────────────────────────────────────────
   1100px — wide desktop
───────────────────────────────────────────────*/
@media (min-width: 1100px) {
  .page { max-width: 1200px; margin: 0 auto; padding: 1.4rem 1.2rem; }
  .grid { grid-template-columns: 440px 1fr; gap: 1.4rem; }
}
 
 
/* ─────────────────────────────────────────────
   Landscape phones (short height) — keep UI
   usable without excessive scrolling
───────────────────────────────────────────────*/
@media (max-height: 480px) and (orientation: landscape) {
  .modal     { max-height: 96vh; }
  .sell-sticky { padding: 0.35rem 0 0.15rem; }
  .btn-sell    { padding: 0.65rem; font-size: 0.88rem; }
  .seatmap-img, #mapSvg { max-height: 140px; }
}
 
</style>




</head>
<body>

<!-- ── TOPBAR ── -->
<div class="topbar">
  <div class="tb-left">
    <img src="/img/mee-logo.png" alt="MEE" class="tb-logo" onerror="this.style.display='none'"/>
    <span class="tb-title">Sell Tickets</span>
  </div>
  <div class="tb-right">
    <div class="role-dot"></div>
    <div class="tb-user">Logged in as <strong><%= staffUser.name || staffUser.username %></strong></div>
    <a href="/staff/logout" class="logout-link"><i class="bi bi-box-arrow-right"></i> Logout</a>
  </div>
</div>

<div class="page">
  <div class="page-hd">
    <div class="page-title">SELL TICKETS</div>
    <div class="page-sub">Offline cash sales — generate QR tickets instantly</div>
  </div>

  <div class="grid">

    <!-- ─────────────── LEFT: FORM ─────────────── -->
    <div>
      <div class="card">
        <div class="card-hd"><i class="bi bi-ticket-perforated"></i> New Sale</div>

        <!-- ── EVENT CARDS (replaces dropdown) ── -->
        <div class="evt-section">
          <div class="evt-section-hd">
            <label style="margin:0;">Event <span class="req">*</span></label>
          </div>
          <div class="evt-cards" id="evtCards">
            <% events.forEach(function(ev){ %>
            <div class="evt-card"
                 data-id="<%= ev._id %>"
                 onclick="onEventCard(this, '<%= ev._id %>')">
              <div class="evt-card-icon"><i class="bi bi-calendar-event"></i></div>
              <div class="evt-card-info">
                <div class="evt-card-name"><%= ev.name %></div>
                <div class="evt-card-meta">
                  <span><i class="bi bi-calendar3"></i><%= new Date(ev.date).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %></span>
                  <% if(ev.venue){ %><span><i class="bi bi-geo-alt"></i><%= ev.venue %></span><% } %>
                </div>
              </div>
              <div class="evt-card-sel"></div>
            </div>
            <% }); %>
          </div>
        </div>

        <!-- Ticket types -->
        <div id="secType" style="display:none;">
          <div class="fg">
            <label>Ticket Type <span class="req">*</span></label>
            <div class="ttype-grid" id="typeGrid"></div>
          </div>
        </div>

        <!-- Seat map -->
        <div id="secMap" style="display:none;">
          <div class="fg">
            <label>Zone / Section <span style="font-size:0.65rem;color:var(--muted);font-weight:400;">(tap to select)</span></label>
            <div class="seatmap-outer">
              <div class="seatmap-title" id="mapTitle">VENUE MAP</div>
              <div class="seatmap-canvas-wrap" id="mapWrap">
                <img id="mapImg" class="seatmap-img" src="" alt="Seat Map" style="display:none;"/>
                <svg id="mapSvg" viewBox="0 0 960 760" xmlns="http://www.w3.org/2000/svg">
                  <rect width="100%" height="100%" fill="#0f0f18"/>
                </svg>
                <div class="zone-overlay" id="zoneOverlay"></div>
              </div>
              <div class="seatmap-legend" id="mapLegend"></div>
            </div>
            <div class="zone-selected-bar" id="zoneBar">
              <i class="bi bi-geo-alt-fill"></i>
              <span id="zoneBarText">No zone selected</span>
              <button class="zone-clear" onclick="clearZone()" title="Clear zone">✕ clear</button>
            </div>
          </div>
        </div>

        <!-- Fallback zone select -->
        <div id="secZoneFb" style="display:none;">
          <div class="fg">
            <label>Zone / Section</label>
            <select id="zoneFbSel" onchange="selZone=this.value;">
              <option value="">— General (no zone) —</option>
            </select>
          </div>
        </div>

        <!-- Quantity -->
        <div id="secQty" style="display:none;">
          <div class="fg">
            <label>Number of Tickets <span class="req">*</span></label>
            <div class="qty-row">
              <button type="button" class="qty-btn" onclick="adjQty(-1)">−</button>
              <input type="number" id="qtyInp" value="1" min="1" max="20" oninput="onQty(parseInt(this.value)||1)"/>
              <button type="button" class="qty-btn" onclick="adjQty(1)">+</button>
            </div>
            <div class="hint" id="qtyHint"></div>
          </div>
          <div class="combo-bar" id="comboBar" style="display:none;">
            <i class="bi bi-gift-fill"></i><span id="comboTxt"></span>
          </div>
          <div class="summary-bar" id="sumBar" style="display:none;">
            <div class="sum-item"><div class="sum-val" id="sQty">—</div><div class="sum-lbl">Tickets</div></div>
            <div class="sum-item"><div class="sum-val" id="sPrice">—</div><div class="sum-lbl">Per Ticket</div></div>
            <div class="sum-item"><div class="sum-val" id="sDisc">₹0</div><div class="sum-lbl">Discount</div></div>
            <div class="sum-item"><div class="sum-val" id="sConv">₹0</div><div class="sum-lbl">Conv.</div></div>
            <div class="sum-item"><div class="sum-val big" id="sTotal">—</div><div class="sum-lbl">Total</div></div>
          </div>
        </div>

        <!-- Attendees -->
        <div id="secAtt" style="display:none;">
          <div class="fg">
            <label>Attendee Details</label>
            <div class="att-list" id="attList"></div>
          </div>
        </div>

        <!-- Buyer contact -->
        <div id="secContact" style="display:none;" class="contact-section">
          <div class="card-hd" style="margin-bottom:0.8rem;"><i class="bi bi-person-lines-fill"></i> Buyer Contact</div>
          <div class="fg">
            <label>Buyer Name</label>
            <input type="text" id="bName" placeholder="Full name of buyer" autocomplete="name"/>
          </div>
          <div class="row2">
            <div class="fg">
              <label>WhatsApp / Phone <span class="req">*</span></label>
              <input type="tel" id="bPhone" placeholder="9876543210" maxlength="10" inputmode="numeric" autocomplete="tel"/>
              <div class="hint">QR ticket sent via WhatsApp</div>
            </div>
            <div class="fg">
              <label>Email <span class="req">*</span></label>
              <input type="email" id="bEmail" placeholder="buyer@example.com" inputmode="email" autocomplete="email"/>
              <div class="hint">Confirmation sent here</div>
            </div>
          </div>
          <div id="contactErr" style="color:var(--error);font-size:0.74rem;display:none;margin-top:-0.25rem;margin-bottom:0.45rem;"></div>
        </div>

        <div class="sell-sticky">
          <button class="btn-sell" id="sellBtn" onclick="doSell()" disabled>
            <i class="bi bi-cash-coin"></i> Confirm Cash Sale
          </button>
        </div>
      </div>
    </div>

    <!-- ─────────────── RIGHT: HISTORY ─────────────── -->
    <div>
      <div class="card">
        <div class="card-hd"><i class="bi bi-clock-history"></i> My Sales</div>
        <div class="tab-bar">
          <button class="tb active" onclick="switchTab('all',this)">All</button>
          <button class="tb" onclick="switchTab('today',this)">Today</button>
        </div>
        <div class="sales-wrap">
          <% if(mySales && mySales.length > 0){ %>
          <table class="sales-tbl">
            <thead><tr>
              <th>Ref</th><th>Buyer</th><th>Event</th><th>Type</th><th style="text-align:center">Qty</th><th>Amount</th><th>Time</th>
            </tr></thead>
            <tbody id="salesBody">
            <% mySales.forEach(function(s){ %>
              <% var isToday=(function(){var d=new Date(s.createdAt),n=new Date();return d.getFullYear()===n.getFullYear()&&d.getMonth()===n.getMonth()&&d.getDate()===n.getDate();})(); %>
              <tr class="sale-row" data-today="<%= isToday %>">
                <td>
                  <span class="ref-pill" onclick="cpCopy('<%= s.bookingRef %>')" title="Copy ref"><%= s.bookingRef %></span>
                  <button class="reprint-btn" onclick="reprintBooking('<%= s._id %>', event)">
                    <i class="bi bi-printer"></i> Reprint
                  </button>
                </td>
                <td>
                  <div style="font-weight:600;font-size:0.79rem;"><%= s.contactName||'Walk-in' %></div>
                  <div style="font-size:0.66rem;color:var(--muted2);"><%= s.contactPhone||s.contactEmail||'' %></div>
                </td>
                <td style="font-size:0.78rem;color:#d8b4fe;"><%= s.event?s.event.name:'—' %></td>
                <td style="font-size:0.78rem;text-transform:capitalize;"><%= s.ticketType||'—' %></td>
                <td style="text-align:center;font-family:'Space Mono',monospace;font-size:0.79rem;"><%= s.quantity %></td>
                <td style="font-family:'Space Mono',monospace;font-size:0.79rem;font-weight:700;color:var(--cash);">₹<%= (s.totalAmount||0).toLocaleString('en-IN') %></td>
                <td style="font-size:0.69rem;color:var(--muted2);white-space:nowrap;">
                  <%= new Date(s.createdAt).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %><br>
                  <span style="font-size:0.62rem;"><%= new Date(s.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %></span>
                </td>
              </tr>
            <% }); %>
            </tbody>
          </table>
          <% } else { %>
          <div class="no-sales"><i class="bi bi-ticket-perforated"></i>No sales yet. Make your first sale!</div>
          <% } %>
        </div>
        <%
          var todayCnt=0,todayRev=0,allRev=0;
          if(mySales){ mySales.forEach(function(s){
            allRev+=(s.totalAmount||0);
            var d=new Date(s.createdAt),n=new Date();
            if(d.getFullYear()===n.getFullYear()&&d.getMonth()===n.getMonth()&&d.getDate()===n.getDate()){todayCnt++;todayRev+=(s.totalAmount||0);}
          });}
        %>
        <div class="stats-strip">
          <div class="sstat"><div class="sstat-val" id="dTodayCnt"><%= todayCnt %></div><div class="sstat-lbl">Today's Sales</div></div>
          <div class="sstat"><div class="sstat-val" id="dTodayRev">₹<%= todayRev.toLocaleString('en-IN') %></div><div class="sstat-lbl">Today's Revenue</div></div>
          <div class="sstat"><div class="sstat-val" style="color:var(--accent);" id="dAllRev">₹<%= allRev.toLocaleString('en-IN') %></div><div class="sstat-lbl">Total Revenue</div></div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- ── SUCCESS MODAL ── -->
<div class="modal-bg" id="modalBg" onclick="if(event.target===this)closeModal()">
  <div class="modal" id="modalBox">
    <div class="modal-handle"></div>
    <div class="modal-top">
      <div class="modal-ok" id="modalOkLine"><i class="bi bi-check-circle-fill"></i> Sale Confirmed!</div>
      <div class="modal-ref" id="mRef"></div>
    </div>
    <div class="modal-tickets" id="mTickets"></div>
    <div class="modal-actions">
      <button class="btn-print" id="printBtn" onclick="printTickets()">
        <i class="bi bi-printer"></i> Print Tickets
      </button>
      <button class="btn-close-modal" onclick="closeModal()"><i class="bi bi-plus-circle"></i> New Sale</button>
    </div>
  </div>
</div>

<div id="toast"></div>
<div id="printOverlay" style="display:none;"></div>

<script>
// ── Embedded data ──
const EVENTS = <%- JSON.stringify(events) %>;
const SMAPS  = <%- seatMaps %>;

const CAT_COLORS = {
  platinum:'#9D4EDD', gold:'#E9B84A', silver:'#A8B5C8',
  vip:'#E9B84A', fanfit:'#2ECC94', family:'#FF7A7A',
  standard:'#6B7280', general:'#6A0DAD', bronze:'#CD7F32',
};
const cc = cat => CAT_COLORS[(cat||'').toLowerCase()] || '#9D4EDD';

// ── State ──
let selEvt=null, selType=null, selZone='', selQty=1, selSeatMap=null;
let _currentModalData = null;
let _lockedEvtId = null; // Persists event selection across bookings

// ──────────────────── EVENT CARD SELECT ────────────────────
function onEventCard(cardEl, id) {
  // If already selected and locked, deselect to allow switching
  if (_lockedEvtId === id) {
    // Already active — do nothing, keep selection
    return;
  }
  document.querySelectorAll('.evt-card').forEach(c => c.classList.remove('selected'));
  cardEl.classList.add('selected');
  onEvent(id);
}

async function onEvent(id) {
  selEvt=null; selType=null; selZone=''; selSeatMap=null;
  hide('secType'); hide('secMap'); hide('secZoneFb'); hide('secQty');
  hide('secAtt'); hide('secContact'); hide('sumBar'); hide('comboBar');
  document.getElementById('sellBtn').disabled = true;
  setZoneBar('');
  if (!id) return;

  try {
    const r = await fetch('/staff/api/event/' + id, { credentials: 'include' });
    const d = await r.json();
    if (d.success && d.event) {
      selEvt = d.event;
      const idx = EVENTS.findIndex(e => e._id === id);
      if (idx >= 0) EVENTS[idx] = d.event;
    } else {
      selEvt = EVENTS.find(e => e._id === id);
    }
  } catch(e) {
    selEvt = EVENTS.find(e => e._id === id);
  }
  if (!selEvt) return;

  const grid = document.getElementById('typeGrid');
  grid.innerHTML = '';
  (selEvt.ticketTypes||[]).filter(t => t.isActive).forEach(t => {
    const avail = Math.max(0, t.totalSeats - t.bookedSeats);
    const color = cc(t.category);
    let comboText = '';
    if (Array.isArray(t.discountTiers) && t.discountTiers.length > 0) {
      const best = t.discountTiers.filter(d=>d.minQty>0&&d.discount>0).sort((a,b)=>b.discount-a.discount)[0];
      if (best) comboText = `Buy ${best.minQty}+ → ₹${best.discount} off`;
    } else if (t.comboOfferMinQty > 0 && t.comboOfferDiscount > 0) {
      comboText = `Buy ${t.comboOfferMinQty}+ → ₹${t.comboOfferDiscount} off`;
    }
    const availClass = avail === 0 ? 'none' : avail <= 10 ? 'low' : '';
    const card = document.createElement('div');
    card.className = 'ttype-card' + (avail <= 0 ? ' soldout' : '');
    card.innerHTML = `
      <div class="tt-top">
        <div class="tt-color" style="background:${color}"></div>
        <div class="tt-name">${t.name||t.category}</div>
      </div>
      <div class="tt-avail ${availClass}">${avail > 0 ? avail + ' available' : 'Sold Out'}</div>
      <div class="tt-price">₹${(t.price||0).toLocaleString('en-IN')}</div>
      ${comboText ? `<div class="tt-combo"><i class="bi bi-gift-fill"></i>${comboText}</div>` : ''}`;
    if (avail > 0) card.onclick = () => selectType(t, card);
    grid.appendChild(card);
  });
  show('secType');
  fetchAndShowSeatmap(id);
}

async function fetchAndShowSeatmap(eventId) {
  try {
    const r = await fetch('/staff/api/seatmap/' + eventId, { credentials: 'include' });
    const d = await r.json();
    if (d.success && d.seatMap) {
      SMAPS[eventId] = d.seatMap;
      selSeatMap = d.seatMap;
      buildSeatMap(d.seatMap);
      show('secMap');
      if (selType) renderZones(d.seatMap, selType.category);
      return;
    }
  } catch(e) {}
  const cached = SMAPS[eventId];
  if (cached) {
    selSeatMap = cached;
    buildSeatMap(cached);
    show('secMap');
  }
}

// ──────────────────── TYPE SELECT ────────────────────
function selectType(t, card) {
  selType = t; selZone = '';
  document.querySelectorAll('.ttype-card').forEach(c => c.classList.remove('selected'));
  card.classList.add('selected');
  setZoneBar('');
  if (selSeatMap) { renderZones(selSeatMap, t.category); show('secMap'); hide('secZoneFb'); }
  else { hide('secMap'); hide('secZoneFb'); }
  show('secQty'); show('secContact');
  selQty = 1;
  document.getElementById('qtyInp').value = 1;
  onQty(1);
}

// ──────────────────── SEAT MAP BUILDER ────────────────────
function buildSeatMap(sm) {
  const img = document.getElementById('mapImg');
  const svg = document.getElementById('mapSvg');
  if (sm.previewImage && sm.previewImage.startsWith('data:')) {
    img.src = sm.previewImage; img.style.display = 'block'; svg.style.display = 'none'; return;
  }
  img.style.display = 'none';
  const cw = sm.canvasWidth || 960, ch = sm.canvasHeight || 760;
  svg.setAttribute('viewBox', `0 0 ${cw} ${ch}`);
  const st=sm.stage||{}, stX=(st.x!==undefined)?st.x:Math.round((cw-(st.width||500))/2), stY=(st.y!==undefined)?st.y:30;
  const stW=st.width||500, stH=st.height||100, stC=st.color||'#6A0DAD', stLbl=st.label||'STAGE', stShp=st.shape||'rectangle';
  const scx=stX+stW/2, scy=stY+stH/2;
  let html=`<rect width="${cw}" height="${ch}" fill="#0f0f18"/>`;
  html+=`<pattern id="gdot" width="40" height="40" patternUnits="userSpaceOnUse"><circle cx="20" cy="20" r="0.7" fill="rgba(255,255,255,0.07)"/></pattern><rect width="${cw}" height="${ch}" fill="url(#gdot)"/>`;
  if (stShp==='semicircle'){const r=stW/2,atBottom=scy>=ch/2,sy2=atBottom?stY:stY+stH,sw2=atBottom?0:1;html+=`<path d="M ${stX} ${sy2} A ${r} ${r} 0 0 ${sw2} ${stX+stW} ${sy2}" fill="${stC}33" stroke="${stC}" stroke-width="2"/>`;}
  else if(stShp==='thrust'){html+=`<polygon points="${stX},${stY} ${stX+stW},${stY} ${stX+stW-50},${stY+stH} ${stX+stW/2+35},${stY+stH} ${stX+stW/2+35},${stY+stH+50} ${stX+stW/2-35},${stY+stH+50} ${stX+stW/2-35},${stY+stH} ${stX+50},${stY+stH}" fill="${stC}33" stroke="${stC}" stroke-width="2"/>`;}
  else if(stShp==='intheround'){const r2=Math.min(stW,stH)*0.45;html+=`<circle cx="${scx}" cy="${scy}" r="${r2}" fill="${stC}33" stroke="${stC}" stroke-width="2"/>`;}
  else{html+=`<rect x="${stX}" y="${stY}" width="${stW}" height="${stH}" rx="10" fill="${stC}33" stroke="${stC}" stroke-width="2"/>`;}
  html+=`<text x="${scx}" y="${scy+5}" text-anchor="middle" fill="${stC}" font-size="14" font-family="'Space Mono',monospace" font-weight="700" letter-spacing="3">${stLbl}</text>`;
  (sm.sections||[]).forEach(sec=>{
    const col=sec.color||cc(sec.category),sx=sec.x||0,sy=sec.y||0,sw=sec.zoneW||200,sh=sec.zoneH||100,rot=sec.zoneRot||0;
    const zcx=sx+sw/2,zcy=sy+sh/2,avail=Math.max(0,(sec.totalSeats||0)-(sec.bookedSeats||0)),shape=sec.zoneShape||'rect';
    const tr=rot!==0?` transform="rotate(${rot} ${zcx} ${zcy})"`:''
    const fs=Math.max(9,Math.min(14,sw/Math.max((sec.name||'').length*0.9,1))),avCol=avail>0?'rgba(255,255,255,0.8)':'#FF5555';
    if(shape==='round'){html+=`<ellipse cx="${zcx}" cy="${zcy}" rx="${sw/2}" ry="${sh/2}" fill="${col}28" stroke="${col}" stroke-width="1.5"${tr}/>`;}
    else if(shape==='triangle'){html+=`<polygon points="${zcx},${sy} ${sx+sw},${sy+sh} ${sx},${sy+sh}" fill="${col}28" stroke="${col}" stroke-width="1.5"${tr}/>`;}
    else{html+=`<rect x="${sx}" y="${sy}" width="${sw}" height="${sh}" rx="8" fill="${col}28" stroke="${col}" stroke-width="1.5"${tr}/>`;}
    html+=`<text x="${zcx}" y="${zcy-4}" text-anchor="middle" fill="#fff" font-size="${fs}" font-family="'Outfit',sans-serif" font-weight="700"${tr}>${sec.name}</text>`;
    html+=`<text x="${zcx}" y="${zcy+12}" text-anchor="middle" fill="${avCol}" font-size="10" font-family="'Outfit',sans-serif"${tr}>${avail>0?avail+' left':'FULL'}</text>`;
  });
  svg.innerHTML=html; svg.style.display='block';
  const leg=document.getElementById('mapLegend');
  const cats=[...new Set((sm.sections||[]).map(s=>s.category))];
  leg.innerHTML=cats.map(cat=>`<div class="leg-item"><div class="leg-dot" style="background:${cc(cat)}"></div>${cat}</div>`).join('');
}

function renderZones(sm, filterCat) {
  const overlay=document.getElementById('zoneOverlay'); overlay.innerHTML='';
  const cw=sm.canvasWidth||960, ch=sm.canvasHeight||760;
  (sm.sections||[]).forEach(sec=>{
    if(filterCat&&sec.category!==filterCat) return;
    const avail=Math.max(0,(sec.totalSeats||0)-(sec.bookedSeats||0));
    const color=sec.color||cc(sec.category);
    const el=document.createElement('div');
    el.className='zone-hit'+(avail<=0?' full':'');
    el.style.left=((sec.x||0)/cw*100).toFixed(3)+'%';
    el.style.top=((sec.y||0)/ch*100).toFixed(3)+'%';
    el.style.width=((sec.zoneW||200)/cw*100).toFixed(3)+'%';
    el.style.height=((sec.zoneH||100)/ch*100).toFixed(3)+'%';
    el.style.background=color+'44'; el.style.borderColor=color;
    if(sec.zoneRot) el.style.transform=`rotate(${sec.zoneRot}deg)`;
    el.innerHTML=`<div class="zone-label">${sec.name}</div><div class="zone-cnt">${avail>0?avail+' left':'Full'}</div>`;
    if(avail>0){
      el.addEventListener('click',()=>{
        document.querySelectorAll('.zone-hit').forEach(z=>z.classList.remove('active'));
        el.classList.add('active'); selZone=sec.name; setZoneBar(sec.name);
        const curQty=parseInt(document.getElementById('qtyInp').value)||1;
        document.getElementById('qtyInp').max=avail;
        if(curQty>avail){document.getElementById('qtyInp').value=avail;onQty(avail);}
        else updateHint(avail);
      });
    }
    overlay.appendChild(el);
  });
}

function setZoneBar(zoneName){const bar=document.getElementById('zoneBar'),text=document.getElementById('zoneBarText');if(zoneName){text.textContent='Zone: '+zoneName;bar.classList.add('show');}else{bar.classList.remove('show');}}
function clearZone(){selZone='';setZoneBar('');document.querySelectorAll('.zone-hit').forEach(z=>z.classList.remove('active'));if(selType){const max=selType.totalSeats-selType.bookedSeats;document.getElementById('qtyInp').max=max;updateHint();}}

function adjQty(d){const inp=document.getElementById('qtyInp');const v=Math.max(1,Math.min(parseInt(inp.max)||20,(parseInt(inp.value)||1)+d));inp.value=v;onQty(v);}
function onQty(v){selQty=Math.max(1,v||1);document.getElementById('qtyInp').value=selQty;buildAttRows(selQty);updateSummary();show('secAtt');checkReady();}
function updateHint(maxAvail){const hint=document.getElementById('qtyHint');let max=selType?selType.totalSeats-selType.bookedSeats:20;if(maxAvail!==undefined)max=Math.min(max,maxAvail);document.getElementById('qtyInp').max=max;hint.textContent=`Max ${max} available`+(selZone?` in "${selZone}"`:'');}

function updateSummary(){
  if(!selType)return;
  const conv=selEvt?(selEvt.convenienceFee||0):0;
  let discount=0,comboMsg='';
  if(Array.isArray(selType.discountTiers)&&selType.discountTiers.length>0){
    const tiers=selType.discountTiers.filter(d=>d.minQty>0&&d.discount>0).sort((a,b)=>b.minQty-a.minQty);
    const app=tiers.find(d=>selQty>=d.minQty);
    if(app){const groups=Math.floor(selQty/app.minQty);discount=groups*app.discount;const next=tiers.slice().reverse().find(d=>d.minQty>selQty);comboMsg=`🎉 ₹${discount} discount (${groups} group${groups>1?'s':''} × ₹${app.discount})`;if(next)comboMsg+=` · Add ${next.minQty-selQty} more for ₹${next.discount} off!`;}
    else{const next=tiers.slice().reverse().find(d=>d.minQty>selQty);if(next)comboMsg=`🎁 Add ${next.minQty-selQty} more ticket${next.minQty-selQty>1?'s':''} for ₹${next.discount} off!`;}
  } else if(selType.comboOfferMinQty>0&&selType.comboOfferDiscount>0){
    if(selQty>=selType.comboOfferMinQty){const groups=Math.floor(selQty/selType.comboOfferMinQty);discount=groups*selType.comboOfferDiscount;comboMsg=`🎉 ₹${discount} discount (${groups} group${groups>1?'s':''} × ₹${selType.comboOfferDiscount})`;}
    else{comboMsg=`🎁 Add ${selType.comboOfferMinQty-selQty} more for ₹${selType.comboOfferDiscount} off!`;}
  }
  const total=Math.max(0,selType.price*selQty-discount+conv);
  document.getElementById('sQty').textContent=selQty;
  document.getElementById('sPrice').textContent='₹'+(selType.price).toLocaleString('en-IN');
  document.getElementById('sDisc').textContent=discount>0?'-₹'+discount.toLocaleString('en-IN'):'₹0';
  document.getElementById('sConv').textContent=conv>0?'₹'+conv.toLocaleString('en-IN'):'₹0';
  document.getElementById('sTotal').textContent='₹'+total.toLocaleString('en-IN');
  show('sumBar');
  if(comboMsg){document.getElementById('comboTxt').textContent=comboMsg;document.getElementById('comboBar').style.display='flex';}
  else{document.getElementById('comboBar').style.display='none';}
  updateHint();
}

function buildAttRows(qty){
  const list=document.getElementById('attList'); list.innerHTML='';
  for(let i=0;i<qty;i++){
    const div=document.createElement('div'); div.className='att-row';
    div.innerHTML=`<div class="att-num">Attendee ${i+1}</div>
      <div class="row2">
        <div class="fg" style="margin-bottom:0.4rem;"><label>Name <span class="req">*</span></label><input class="att-name" type="text" placeholder="Full name" autocomplete="off"/></div>
        <div class="fg" style="margin-bottom:0.4rem;"><label>Age <span class="req">*</span></label><input class="att-age" type="number" placeholder="Age" min="1" max="99" inputmode="numeric"/></div>
      </div>
      <div class="fg" style="margin-bottom:0;"><label>Gender</label>
        <select class="att-gender"><option value="">—</option><option value="male">Male</option><option value="female">Female</option><option value="other">Other</option></select>
      </div>`;
    list.appendChild(div);
  }
}

function checkReady(){document.getElementById('sellBtn').disabled=!(selEvt&&selType);}

// ──────────────────── EXECUTE SALE ────────────────────
async function doSell(){
  const phone=document.getElementById('bPhone').value.trim();
  const email=document.getElementById('bEmail').value.trim();
  const errEl=document.getElementById('contactErr'); errEl.style.display='none';
  if(!phone){errEl.textContent='WhatsApp number is required.';errEl.style.display='block';return;}
  if(!email){errEl.textContent='Email address is required.';errEl.style.display='block';return;}
  if(!/^[6-9]\d{9}$/.test(phone)){errEl.textContent='Invalid phone — enter 10-digit Indian mobile.';errEl.style.display='block';return;}
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){errEl.textContent='Invalid email address.';errEl.style.display='block';return;}
  const attendees=[]; let valid=true;
  document.querySelectorAll('.att-row').forEach(row=>{
    const name=row.querySelector('.att-name')?.value?.trim()||'';
    const age=parseInt(row.querySelector('.att-age')?.value)||0;
    const gender=row.querySelector('.att-gender')?.value||'';
    if(!name||!age){valid=false;return;}
    attendees.push({name,age,gender});
  });
  if(!valid){showToast('Fill in all attendee names and ages.',true);return;}
  const btn=document.getElementById('sellBtn');
  btn.disabled=true; btn.innerHTML='<i class="bi bi-hourglass-split"></i> Processing…';

  // Remember which event to stay on after booking
  const currentEvtId = selEvt._id;
  const currentEvtCard = document.querySelector(`.evt-card[data-id="${currentEvtId}"]`);

  try{
    const resp=await fetch('/staff/api/sell',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({eventId:selEvt._id,ticketType:selType.category,quantity:selQty,attendees,buyerPhone:phone,buyerEmail:email,buyerName:document.getElementById('bName').value.trim()||attendees[0]?.name||'',zone:selZone})});
    const data=await resp.json();
    if(!data.success){showToast(data.message||'Sale failed.',true);btn.disabled=false;btn.innerHTML='<i class="bi bi-cash-coin"></i> Confirm Cash Sale';if(selEvt)fetchAndShowSeatmap(selEvt._id);return;}
    showModal(data);
    prependRow(data);
    // Lock this event so closeModal() restores it
    _lockedEvtId = currentEvtId;
    // Refresh seat availability for this event
    if(selEvt) fetchAndShowSeatmap(selEvt._id);
  }catch(e){showToast('Network error. Try again.',true);btn.disabled=false;btn.innerHTML='<i class="bi bi-cash-coin"></i> Confirm Cash Sale';}
}

// ──────────────────── BUILD TICKET HTML ────────────────────
function buildTicketHTML(data) {
  const typeCategory = selType?.category || data.ticketType || '';
  const typeLabel    = (selType?.name || selType?.category || data.ticketType || 'TICKET').toUpperCase();
  const priceEach    = selType?.price
    ? selType.price
    : (data.pricePerTicket ? Number(data.pricePerTicket) : 0);

  const eventDateStr = data.event?.date
    ? new Date(data.event.date).toLocaleDateString('en-IN',{day:'2-digit',month:'long',year:'numeric'}).toUpperCase()
    : '—';
  const doorsOpen = data.event?.doorsOpen || '—';
  const venueName = data.event?.venue || '';
  const venueAddr = data.event?.venueAddress || '';
  const totalTix  = (data.tickets||[]).length;

  const ticketTypesSource = selEvt?.ticketTypes || data.event?.ticketTypes || [];
  const evtTicketType = ticketTypesSource.find(tt => tt.category === typeCategory);
  const isSittingType = evtTicketType?.seatType === 'sitting';
  const gateNumber    = evtTicketType?.gateNumber || data.gateNumber || '';

  let html = '';
  (data.tickets||[]).forEach((t, idx) => {
    const attendee  = t.attendee || 'GUEST';
    const attAge    = t.attendeeAge    || '';
    const attGender = t.attendeeGender
      ? (t.attendeeGender.charAt(0).toUpperCase() + t.attendeeGender.slice(1))
      : '';
    const rawSeat  = (t.seatNumber || '').trim();
    const seatDisp = (isSittingType && rawSeat) ? rawSeat.toUpperCase() : 'N/A';

    html += `
    <div class="ticket">
      <img class="ticket-bg" src="/img/ticket_BG.png" alt="" crossorigin="anonymous"/>
      <div class="t-qr-left">
        ${t.qrCode
          ? `<img src="${t.qrCode}" alt="QR" crossorigin="anonymous"/>`
          : '<div style="width:100%;aspect-ratio:1;background:#fff;border-radius:3px;"></div>'}
      </div>
      <div class="t-ev-info">
        <div class="t-ev-name">${typeLabel}</div>
        <div class="t-ev-price">&#8377; ${priceEach.toLocaleString('en-IN')}</div>
      </div>
      <div class="t-ev-meta">
        <div class="t-em-row">
          <div class="t-em-col">
            <div class="t-em-lbl">DATE</div>
            <div class="t-em-val">${eventDateStr}</div>
          </div>
          <div class="t-em-col">
            <div class="t-em-lbl">TIME</div>
            <div class="t-em-val">${doorsOpen}</div>
          </div>
        </div>
        <div class="t-em-divider"></div>
        <div class="t-em-col">
          <div class="t-em-venue-name">${venueName}</div>
          ${venueAddr ? `<div class="t-em-venue-addr">${venueAddr.toUpperCase()}</div>` : ''}
        </div>
      </div>
      <div class="t-rp">
        <div class="t-rp-qr">
          ${t.qrCode
            ? `<img src="${t.qrCode}" alt="QR" crossorigin="anonymous"/>`
            : '<div class="t-rp-qr-ph">QR CODE</div>'}
        </div>
        <div class="t-bid-lbl">BOOKING ID</div>
        <div class="t-bid-val">${data.bookingRef}</div>
        <div class="t-rp-hr"></div>
        <div class="t-att-name">${attendee.toUpperCase()}</div>
        ${(attAge || attGender)
          ? `<div class="t-att-meta">${attAge ? 'AGE - '+attAge : ''}${attAge && attGender ? ' | ' : ''}${attGender ? 'GENDER - '+attGender : ''}</div>`
          : ''}
        <div class="t-rp-hr"></div>
        <div class="t-grid">
          <div class="t-gc"><div class="t-gl">Ticket ID</div><div class="t-gv mono">${t.ticketId}</div></div>
          <div class="t-gc"><div class="t-gl">Ticket No.</div><div class="t-gv">${idx+1} of ${totalTix}</div></div>
          <div class="t-gc"><div class="t-gl">Category</div><div class="t-gv acc">${typeLabel}</div></div>
          <div class="t-gc"><div class="t-gl">Seat No.</div><div class="t-gv acc">${seatDisp}</div></div>
          <div class="t-gc"><div class="t-gl">Amount</div><div class="t-gv">&#8377; ${priceEach.toLocaleString('en-IN')}/-</div></div>
          ${gateNumber ? `<div class="t-gc"><div class="t-gl">Gate</div><div class="t-gv acc">${gateNumber}</div></div>` : ''}
        </div>
        <div class="t-valid">&#10003;&nbsp; VALID &nbsp;·&nbsp; ONE TIME ENTRY</div>
      </div>
    </div>`;
  });

  return html;
}

// ──────────────────── SUCCESS MODAL ────────────────────
function showModal(data) {
  _currentModalData = data;
  const isReprint = !!data._isReprint;
  document.getElementById('modalOkLine').innerHTML = isReprint
    ? `<i class="bi bi-printer"></i> Reprinting Tickets`
    : `<i class="bi bi-check-circle-fill"></i> Sale Confirmed!`;
  const bookingTotal = data.totalAmount ? Number(data.totalAmount).toLocaleString('en-IN') : '—';
  document.getElementById('mRef').textContent =
    `Ref: ${data.bookingRef}  ·  ${data.event?.name || ''}  ·  ₹${bookingTotal} collected`;
  document.getElementById('mTickets').innerHTML = buildTicketHTML(data);
  document.getElementById('modalBg').classList.add('show');
  document.getElementById('modalBox').scrollTop = 0;
}

// ──────────────────── PRINT ────────────────────
function printTickets() {
  if (!_currentModalData) { showToast('No tickets to print.', true); return; }
  const overlay = document.getElementById('printOverlay');
  overlay.innerHTML = '';
  const source = document.getElementById('mTickets');
  Array.from(source.children).forEach(child => {
    const wrap = document.createElement('div');
    wrap.className = 'ticket-scale-wrap';
    wrap.appendChild(child.cloneNode(true));
    overlay.appendChild(wrap);
  });
  setTimeout(() => {
    window.print();
    setTimeout(() => { overlay.innerHTML = ''; }, 500);
  }, 200);
}

// ──────────────────── REPRINT ────────────────────
async function reprintBooking(bookingId, ev) {
  const btn = ev?.currentTarget || ev?.target;
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i>'; }
  try {
    const r = await fetch('/staff/api/booking/' + bookingId, { credentials: 'include' });
    const d = await r.json();
    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-printer"></i> Reprint'; }
    if (!d.success) { showToast(d.message || 'Could not load booking.', true); return; }
    d._isReprint = true;
    const _prevType = selType;
    const _prevEvt  = selEvt;
    if (!selEvt && d.event) selEvt = d.event;
    if (selEvt && d.ticketType && !selType) {
      selType = selEvt.ticketTypes?.find(tt => tt.category === d.ticketType) || null;
    }
    showModal(d);
    selType = _prevType;
    selEvt  = _prevEvt;
  } catch(e) {
    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-printer"></i> Reprint'; }
    showToast('Network error.', true);
  }
}

// ──────────────────── CLOSE MODAL — Stays on same event ────────────────────
function closeModal(){
  document.getElementById('modalBg').classList.remove('show');
  _currentModalData = null;

  // Reset form fields but KEEP the event selected
  const savedEvtId = _lockedEvtId;

  // Clear contact fields
  ['bPhone','bEmail','bName'].forEach(id=>document.getElementById(id).value='');

  // Reset ticket type selection + downstream sections
  selType = null; selZone = '';
  document.querySelectorAll('.ttype-card').forEach(c => c.classList.remove('selected'));
  hide('secQty'); hide('secAtt'); hide('secContact'); hide('sumBar'); hide('comboBar');
  document.getElementById('sellBtn').disabled = true;
  document.getElementById('sellBtn').innerHTML='<i class="bi bi-cash-coin"></i> Confirm Cash Sale';
  setZoneBar('');

  // Restore event — re-run onEvent to refresh availability
  if (savedEvtId) {
    // Keep card highlighted
    document.querySelectorAll('.evt-card').forEach(c => c.classList.remove('selected'));
    const savedCard = document.querySelector(`.evt-card[data-id="${savedEvtId}"]`);
    if (savedCard) savedCard.classList.add('selected');
    onEvent(savedEvtId);
  }
}

// ──────────────────── LIVE ROW PREPEND ────────────────────
function prependRow(data){
  const tbody=document.getElementById('salesBody'); if(!tbody)return;
  const now=new Date();
  const tr=document.createElement('tr'); tr.className='sale-row'; tr.dataset.today='true';
  tr.innerHTML=`
    <td>
      <span class="ref-pill" onclick="cpCopy('${data.bookingRef}')">${data.bookingRef}</span>
      <button class="reprint-btn" onclick="reprintBooking('${data.bookingId}', event)">
        <i class="bi bi-printer-fill"></i> Reprint Tickets
      </button>
    </td>
    <td><div style="font-weight:600;font-size:0.79rem;">${document.getElementById('bName').value||data.tickets[0]?.attendee||'—'}</div>
        <div style="font-size:0.66rem;color:var(--muted2);">${document.getElementById('bPhone').value}</div></td>
    <td style="font-size:0.78rem;color:#d8b4fe;">${selEvt?.name||'—'}</td>
    <td style="font-size:0.78rem;text-transform:capitalize;">${selType?.name||selType?.category||'—'}</td>
    <td style="text-align:center;font-family:'Space Mono',monospace;">${selQty}</td>
    <td style="font-family:'Space Mono',monospace;font-weight:700;color:var(--cash);">₹${(data.totalAmount||0).toLocaleString('en-IN')}</td>
    <td style="font-size:0.69rem;color:var(--muted2);">${now.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'})}</td>`;
  tbody.insertBefore(tr,tbody.firstChild);
  ['dTodayCnt','dTodayRev','dAllRev'].forEach(id=>{
    const el=document.getElementById(id); if(!el)return;
    if(id==='dTodayCnt'){el.textContent=(parseInt(el.textContent)||0)+1;}
    else{const cur=parseInt(el.textContent.replace(/[^0-9]/g,''))||0;el.textContent='₹'+(cur+(data.totalAmount||0)).toLocaleString('en-IN');}
  });
}

// ──────────────────── UTILS ────────────────────
function show(id){const el=document.getElementById(id);if(el)el.style.display='block';}
function hide(id){const el=document.getElementById(id);if(el)el.style.display='none';}
function switchTab(tab,btn){document.querySelectorAll('.tb').forEach(b=>b.classList.remove('active'));btn.classList.add('active');document.querySelectorAll('.sale-row').forEach(r=>{r.style.display=tab==='today'?(r.dataset.today==='true'?'':'none'):''});}
function cpCopy(t){navigator.clipboard?.writeText(t).then(()=>showToast('Copied: '+t)).catch(()=>showToast(t));}
function showToast(msg,isErr=false){const el=document.getElementById('toast');el.textContent=msg;el.style.borderColor=isErr?'rgba(255,68,68,0.35)':'rgba(0,200,80,0.3)';el.style.color=isErr?'var(--error)':'var(--cash)';el.style.display='block';setTimeout(()=>el.style.display='none',3200);}
</script>
</body>
</html>
