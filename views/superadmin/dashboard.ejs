<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#0B0B0F;--surface:#14141C;--border:rgba(255,255,255,0.08);--accent:#9D4EDD;--text:#fff;--muted:#B3B3B3;--error:#FF4444;--success:#00FF88;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    .layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh;}
    .sidebar{background:var(--surface);border-right:1px solid var(--border);padding:1.5rem 1rem;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:0.3rem;overflow-y:auto;}
    .s-logo{font-family:'Poppins',sans-serif;font-size:1.3rem;letter-spacing:3px;color:#fff;text-decoration:none;display:block;padding:0 0.5rem 0.5rem;border-bottom:1px solid var(--border);margin-bottom:0.4rem;}
    .s-logo span{color:var(--accent);}
    .s-badge{font-family:'Space Mono',monospace;font-size:0.5rem;letter-spacing:2px;color:var(--accent);background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.25);border-radius:10px;padding:0.15rem 0.6rem;margin-bottom:0.8rem;display:inline-block;}
    .s-link{display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--muted);text-decoration:none;border-radius:6px;font-size:0.85rem;transition:all 0.15s;border:1px solid transparent;}
    .s-link:hover,.s-link.active{background:rgba(157,78,221,0.08);border-color:rgba(157,78,221,0.2);color:#fff;}
    .s-link i{color:var(--accent);width:18px;}
    .s-logout{margin-top:auto;display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--error);text-decoration:none;border-radius:6px;font-size:0.85rem;border:1px solid transparent;transition:all 0.15s;}
    .s-logout:hover{background:rgba(255,68,68,0.08);border-color:rgba(255,68,68,0.2);}
    .main{padding:2rem;overflow-x:hidden;}
    .page-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem;flex-wrap:wrap;gap:1rem;}
    .page-title{font-family:'Poppins',sans-serif;font-size:1.8rem;letter-spacing:2px;}
    .page-sub{font-size:0.78rem;color:var(--muted);}
    .stats-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:1rem;margin-bottom:2rem;}
    .stat-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:1.2rem;}
    .stat-icon{font-size:1.2rem;margin-bottom:0.5rem;}
    .stat-val{font-family:'Poppins',sans-serif;font-size:1.8rem;letter-spacing:1px;color:var(--accent);}
    .stat-lbl{font-size:0.72rem;color:var(--muted);margin-top:0.2rem;}
    /* Active event panel */
    .panel{background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-bottom:2rem;}
    .panel-header{padding:1.2rem 1.5rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.8rem;}
    .panel-title{font-family:'Poppins',sans-serif;font-size:1rem;letter-spacing:1px;}
    .table-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;}
    table{width:100%;border-collapse:collapse;}
    th{font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;padding:0.8rem 1.2rem;text-align:left;border-bottom:1px solid var(--border);}
    td{padding:0.9rem 1.2rem;border-bottom:1px solid rgba(255,255,255,0.04);font-size:0.85rem;vertical-align:middle;}
    tr:last-child td{border-bottom:none;}
    tr:hover td{background:rgba(255,255,255,0.02);}
    /* Quick links */
    .quick-links{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem;}
    .ql-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:1.2rem;text-decoration:none;color:var(--text);transition:all 0.18s;display:flex;align-items:center;gap:0.8rem;}
    .ql-card:hover{border-color:rgba(157,78,221,0.3);transform:translateY(-2px);color:#fff;}
    .ql-icon{width:40px;height:40px;border-radius:8px;background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.2);display:flex;align-items:center;justify-content:center;font-size:1.1rem;color:var(--accent);}
    .ql-label{font-weight:600;font-size:0.88rem;}
    .ql-sub{font-size:0.72rem;color:var(--muted);}
    @media(max-width:900px){.layout{grid-template-columns:1fr;}.sidebar{display:none;}.stats-grid{grid-template-columns:repeat(2,1fr);}}
  @keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:0.3;} }
@keyframes spin   { to{transform:rotate(360deg);} }
  
  </style>
</head>
<body>
<div class="layout">
  <%- include('../partials/superadmin-sidebar', { activePage: 'dashboard' }) %>
  <main class="main">
    <div class="page-header">
      <div>
        <div class="page-title">SUPER ADMIN</div>
        <div class="page-sub">Full system access — manage staff, coupons, and all operations.</div>
      </div>
      <!-- <a href="/admin/events/new" style="display:inline-flex;align-items:center;gap:0.5rem;background:var(--accent);color:#fff;padding:0.7rem 1.4rem;border-radius:6px;text-decoration:none;font-weight:700;font-size:0.85rem;letter-spacing:1px;">
        <i class="bi bi-plus-lg"></i> New Event
      </a> -->

<div style="display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap;">
  <!-- Auto-refresh countdown -->
  <div id="refreshCountdown" style="display:inline-flex;align-items:center;gap:0.4rem;font-size:0.72rem;color:var(--muted);padding:0.4rem 0.8rem;border-radius:6px;border:1px solid rgba(255,255,255,0.05);background:rgba(255,255,255,0.02);font-family:'Space Mono',monospace;letter-spacing:1px;">
    <span style="width:6px;height:6px;border-radius:50%;background:#00FF88;animation:pulse 1.5s ease-in-out infinite;display:inline-block;"></span>
    <span id="refreshTimer">5:00</span> auto-refresh
  </div>
  <!-- Manual refresh button -->
  <button onclick="doRefresh()" id="refreshBtn"
    style="display:inline-flex;align-items:center;gap:0.5rem;background:transparent;color:var(--muted);padding:0.65rem 1rem;border-radius:6px;border:1px solid var(--border);font-size:0.82rem;cursor:pointer;font-family:'Outfit',sans-serif;transition:all 0.15s;"
    onmouseover="this.style.borderColor='rgba(157,78,221,0.35)';this.style.color='#fff'"
    onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--muted)'">
    <i class="bi bi-arrow-clockwise" id="refreshIcon"></i> Refresh
  </button>
  <!-- New Event button -->
  <a href="/admin/events/new" style="display:inline-flex;align-items:center;gap:0.5rem;background:var(--accent);color:#fff;padding:0.7rem 1.4rem;border-radius:6px;text-decoration:none;font-weight:700;font-size:0.85rem;letter-spacing:1px;">
    <i class="bi bi-plus-lg"></i> New Event
  </a>
</div>


    </div>

    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card"><div class="stat-icon">👥</div><div class="stat-val"><%= staffCount %></div><div class="stat-lbl">Staff & Admins</div></div>
      <div class="stat-card"><div class="stat-icon">🎟️</div><div class="stat-val"><%= totalBookings %></div><div class="stat-lbl">Paid Bookings</div></div>
      <div class="stat-card"><div class="stat-icon">₹</div><div class="stat-val"><%= (totalRevenue/1000).toFixed(1) %>K</div><div class="stat-lbl">Total Revenue</div></div>
      <div class="stat-card"><div class="stat-icon">🏷️</div><div class="stat-val"><%= coupons %></div><div class="stat-lbl">Coupons</div></div>
      <div class="stat-card"><div class="stat-icon">🧑‍🤝‍🧑</div><div class="stat-val"><%= totalUsers || 0 %></div><div class="stat-lbl">Total Users</div></div>
    </div>

    <!-- ── Active Event Panel ── -->
    <% if (activeEvent) {
      const catColors = {platinum:'#9D4EDD',gold:'#f5c842',silver:'#c0c8d8',vip:'#bf80ff',general:'#a0a0a0',standard:'#a0a0a0',family:'#FF6B6B',fanfit:'#00FF88'};
      const catMap = {};
      activeEvent.ticketTypes.forEach(t => {
        catMap[t.category] = { name: t.name||t.category, total: t.totalSeats, booked: t.bookedSeats, price: t.price, color: t.color || catColors[t.category] || '#6A0DAD', attendees: [] };
      });
      activeEventBookings.forEach(b => {
        if (catMap[b.ticketType]) {
          (b.tickets||[]).forEach(tk => {
            catMap[b.ticketType].attendees.push({ name: tk.attendee?.name||'—', age: tk.attendee?.age||'—', gender: tk.attendee?.gender||'—', phone: b.contactPhone||b.user?.phone||'—', bookingRef: b.bookingRef });
          });
        }
      });
      const catList = Object.entries(catMap);
    %>
    <div class="panel">
      <div class="panel-header">
        <div>
          <div class="panel-title">🎯 ACTIVE EVENT</div>
          <div style="font-size:0.82rem;color:var(--muted);margin-top:0.3rem;">
            <strong style="color:#fff;"><%= activeEvent.name %></strong>
            &nbsp;·&nbsp; <%= new Date(activeEvent.date).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
            &nbsp;·&nbsp; <%= activeEvent.venue %>
          </div>
        </div>
        <div style="display:flex;gap:1.5rem;flex-wrap:wrap;align-items:center;">
          <div style="text-align:center;">
            <div style="font-family:'Poppins',sans-serif;font-size:1.4rem;color:var(--accent);">₹<%= (activeEventRevenue/1000).toFixed(1) %>k</div>
            <div style="font-size:0.65rem;color:var(--muted);letter-spacing:1px;font-family:'Space Mono',monospace;">EVENT REVENUE</div>
          </div>
          <div style="text-align:center;">
            <div style="font-family:'Poppins',sans-serif;font-size:1.4rem;color:#00FF88;"><%= activeEventBookings.reduce((s,b)=>s+b.quantity,0) %></div>
            <div style="font-size:0.65rem;color:var(--muted);letter-spacing:1px;font-family:'Space Mono',monospace;">TICKETS SOLD</div>
          </div>
          <div style="text-align:center;">
            <div style="font-family:'Poppins',sans-serif;font-size:1.4rem;color:#f5c842;"><%= activeEvent.ticketTypes.reduce((s,t)=>s+(t.totalSeats-t.bookedSeats),0) %></div>
            <div style="font-size:0.65rem;color:var(--muted);letter-spacing:1px;font-family:'Space Mono',monospace;">SEATS LEFT</div>
          </div>
          <a href="/admin/events/<%= activeEvent._id %>/edit" style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.5rem 1rem;border:1px solid var(--border);border-radius:6px;color:var(--muted);font-size:0.8rem;text-decoration:none;transition:all 0.15s;" onmouseover="this.style.borderColor='var(--accent)';this.style.color='#fff'" onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--muted)'">
            <i class="bi bi-pencil-fill"></i> Edit Event
          </a>
        </div>
      </div>

      <!-- Seat balance by category -->
      <div style="padding:1.2rem 1.5rem;border-bottom:1px solid var(--border);">
        <div style="font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:var(--muted);margin-bottom:0.8rem;">SEATS BY CATEGORY</div>
        <div style="display:flex;flex-wrap:wrap;gap:0.8rem;">
          <% catList.forEach(([cat, info]) => {
            const pct = info.total > 0 ? Math.round((info.booked/info.total)*100) : 0;
            const remaining = info.total - info.booked;
          %>
          <div style="background:#0B0B0F;border:1px solid rgba(255,255,255,0.06);border-radius:8px;padding:0.8rem 1.2rem;min-width:150px;flex:1;">
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem;">
              <div style="width:8px;height:8px;border-radius:50%;background:<%= info.color %>;box-shadow:0 0 6px <%= info.color %>;"></div>
              <span style="font-size:0.75rem;font-weight:600;color:#fff;text-transform:uppercase;"><%= info.name %></span>
              <span style="font-size:0.68rem;color:var(--muted);margin-left:auto;">₹<%= info.price %></span>
            </div>
            <div style="font-family:'Poppins',sans-serif;font-size:1.5rem;color:<%= info.color %>;line-height:1;"><%= remaining %></div>
            <div style="font-size:0.65rem;color:var(--muted);margin-top:0.2rem;"><%= info.booked %> booked / <%= info.total %> total</div>
            <div style="margin-top:0.6rem;height:3px;background:rgba(255,255,255,0.06);border-radius:2px;overflow:hidden;">
              <div style="height:100%;width:<%= pct %>%;background:<%= info.color %>;border-radius:2px;transition:width 0.3s;"></div>
            </div>
          </div>
          <% }); %>
        </div>
      </div>

      <!-- Attendee list with search/filter -->
      <div style="padding:1.2rem 1.5rem;">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.8rem;margin-bottom:1rem;">
          <div style="font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:var(--muted);">ATTENDEES</div>
          <div style="display:flex;gap:0.6rem;flex-wrap:wrap;">
            <input id="attSearch" type="text" placeholder="Search name / phone..." oninput="filterAtt()"
              style="background:#0B0B0F;border:1px solid var(--border);border-radius:6px;padding:0.4rem 0.8rem;color:#fff;font-size:0.8rem;width:200px;outline:none;"/>
            <select id="attCat" onchange="filterAtt()"
              style="background:#0B0B0F;border:1px solid var(--border);border-radius:6px;padding:0.4rem 0.8rem;color:#fff;font-size:0.8rem;outline:none;">
              <option value="">All Categories</option>
              <% catList.forEach(([cat, info]) => { %><option value="<%= cat %>"><%= info.name %></option><% }); %>
            </select>
            <select id="attGender" onchange="filterAtt()"
              style="background:#0B0B0F;border:1px solid var(--border);border-radius:6px;padding:0.4rem 0.8rem;color:#fff;font-size:0.8rem;outline:none;">
              <option value="">All Genders</option>
              <option value="male">Male</option>
              <option value="female">Female</option>
              <option value="other">Other</option>
            </select>
            <span id="attCount" style="font-family:'Space Mono',monospace;font-size:0.7rem;color:var(--muted);align-self:center;"></span>
          </div>
        </div>
        <div class="table-scroll">
          <table id="attTable">
            <thead>
              <tr>
                <th>#</th><th>Name</th><th>Age</th><th>Gender</th><th>Category</th><th>Phone</th><th>Booking Ref</th>
              </tr>
            </thead>
            <tbody id="attTbody">
              <% let rowIdx = 0; %>
              <% catList.forEach(([cat, info]) => { %>
                <% info.attendees.forEach(att => { rowIdx++; %>
                <tr class="att-row"
                  data-cat="<%= cat %>"
                  data-gender="<%= att.gender.toLowerCase() %>"
                  data-search="<%= (att.name+' '+att.phone).toLowerCase() %>">
                  <td style="color:var(--muted);font-size:0.75rem;"><%= rowIdx %></td>
                  <td style="font-weight:600;"><%= att.name %></td>
                  <td><%= att.age %></td>
                  <td style="text-transform:capitalize;"><%= att.gender %></td>
                  <td>
                    <span style="background:rgba(106,13,173,0.1);border:1px solid rgba(106,13,173,0.2);color:<%= info.color %>;border-radius:10px;padding:0.15rem 0.5rem;font-size:0.7rem;font-family:'Space Mono',monospace;">
                      <%= info.name %>
                    </span>
                  </td>
                  <td style="font-family:'Space Mono',monospace;font-size:0.75rem;color:var(--muted);"><%= att.phone %></td>
                  <td style="font-family:'Space Mono',monospace;font-size:0.72rem;color:var(--muted);"><%= att.bookingRef %></td>
                </tr>
                <% }); %>
              <% }); %>
              <% if (rowIdx === 0) { %>
                <tr><td colspan="7" style="text-align:center;color:var(--muted);padding:2rem;">No attendees yet</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <% } else { %>
    <div class="panel" style="padding:2rem;text-align:center;color:var(--muted);">
      <i class="bi bi-calendar-x" style="font-size:2rem;display:block;margin-bottom:0.8rem;color:#333;"></i>
      No active event right now.
      <a href="/admin/events/new" style="color:var(--accent);margin-left:0.4rem;">Create one →</a>
    </div>
    <% } %>

    <!-- Quick Access -->
    <h2 style="font-family:'Poppins',sans-serif;font-size:1rem;letter-spacing:2px;margin-bottom:1rem;color:var(--muted);">QUICK ACCESS</h2>
    <div class="quick-links">
      <a href="/superadmin/staff" class="ql-card">
        <div class="ql-icon"><i class="bi bi-people-fill"></i></div>
        <div><div class="ql-label">Staff Management</div><div class="ql-sub">Add/block admins & staff</div></div>
      </a>
      <a href="/superadmin/coupons" class="ql-card">
        <div class="ql-icon"><i class="bi bi-tag-fill"></i></div>
        <div><div class="ql-label">Coupons</div><div class="ql-sub">Create & manage codes</div></div>
      </a>
      <a href="/superadmin/referrals" class="ql-card">
        <div class="ql-icon"><i class="bi bi-qr-code"></i></div>
        <div><div class="ql-label">Referral Links</div><div class="ql-sub">QR codes & tracking</div></div>
      </a>
      <a href="/superadmin/users-by-event" class="ql-card">
        <div class="ql-icon"><i class="bi bi-person-lines-fill"></i></div>
        <div><div class="ql-label">Users by Event</div><div class="ql-sub">View attendee lists</div></div>
      </a>
      <a href="/admin/bookings" class="ql-card">
        <div class="ql-icon"><i class="bi bi-ticket-perforated-fill"></i></div>
        <div><div class="ql-label">All Bookings</div><div class="ql-sub">View & manage bookings</div></div>
      </a>
     
    </div>
  </main>
</div>

<script>
function filterAtt() {
  const q      = document.getElementById('attSearch').value.toLowerCase();
  const cat    = document.getElementById('attCat').value;
  const gender = document.getElementById('attGender').value;
  const rows   = document.querySelectorAll('.att-row');
  let visible  = 0;
  rows.forEach((r, i) => {
    const show = (!q || r.dataset.search.includes(q))
              && (!cat    || r.dataset.cat    === cat)
              && (!gender || r.dataset.gender === gender);
    r.style.display = show ? '' : 'none';
    if (show) { visible++; r.querySelector('td').textContent = visible; }
  });
  const el = document.getElementById('attCount');
  if (el) el.textContent = visible + ' shown';
}
filterAtt();

async function repairQR(el) {
  if (!confirm('This will fix all existing bookings that have "PENDING" in their QR codes.\n\nContinue?')) return;
  el.style.opacity = '0.6';
  el.querySelector('.ql-label').textContent = 'Fixing...';
  try {
    const r = await fetch('/superadmin/api/repair-qr', { method: 'POST', credentials: 'include' });
    const d = await r.json();
    if (d.success) {
      el.querySelector('.ql-label').textContent = `✅ Done! Fixed ${d.fixed}`;
      el.querySelector('.ql-sub').textContent = `${d.skipped} were already OK`;
    } else {
      el.querySelector('.ql-label').textContent = '❌ Failed';
      el.querySelector('.ql-sub').textContent = d.message;
    }
  } catch(e) {
    el.querySelector('.ql-label').textContent = '❌ Network error';
  }
  el.style.opacity = '1';
}

// ── Refresh logic ──────────────────────────────────────
let _refreshSecs = 300;
const _timerEl   = document.getElementById('refreshTimer');
const _refreshBtn = document.getElementById('refreshBtn');
const _refreshIcon = document.getElementById('refreshIcon');

function _pad(n){ return String(n).padStart(2,'0'); }
function _tick(){
  const m = Math.floor(_refreshSecs/60), s = _refreshSecs%60;
  _timerEl.textContent = m+':'+_pad(s);
  if(--_refreshSecs < 0) location.reload();
}
setInterval(_tick, 1000);
_tick();

function doRefresh(){
  _refreshIcon.style.animation = 'spin 0.7s linear infinite';
  _refreshBtn.disabled = true;
  setTimeout(() => location.reload(), 300);
}
// ───────────────────────────────────────────────────────
</script>
</body>
</html>
