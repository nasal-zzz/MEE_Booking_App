<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#0B0B0F;--surface:#14141C;--card:#14141C;--border:rgba(255,255,255,0.08);--accent:#6A0DAD;--text:#FFFFFF;--muted:#B3B3B3;--success:#00FF88;--error:#FF4444;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;}
    .admin-layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh;}
    .main{padding:2rem;position:relative;z-index:1;overflow-x:hidden;}
    .page-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem;flex-wrap:wrap;gap:1rem;}
    .page-title{font-family:'Poppins',sans-serif;font-size:1.8rem;letter-spacing:2px;color:#fff;}
    .page-title span{color:var(--accent);}

    /* Filter Bar */
    .filter-bar{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:1.2rem 1.5rem;margin-bottom:1.5rem;display:flex;flex-wrap:wrap;gap:1rem;align-items:flex-end;}
    .fg{display:flex;flex-direction:column;gap:0.3rem;min-width:160px;}
    .fg label{font-size:0.72rem;font-family:'Space Mono',monospace;letter-spacing:1px;color:var(--muted);text-transform:uppercase;}
    .fg select,.fg input{background:#0d0d14;border:1px solid var(--border);border-radius:6px;padding:0.5rem 0.8rem;color:#fff;font-family:'Outfit',sans-serif;font-size:0.85rem;}
    .fg select:focus,.fg input:focus{outline:none;border-color:rgba(157,78,221,0.5);}
    .btn-filter{padding:0.55rem 1.2rem;background:var(--accent);color:#fff;border:none;border-radius:6px;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.85rem;cursor:pointer;letter-spacing:0.5px;transition:all 0.18s;}
    .btn-filter:hover{box-shadow:0 0 20px rgba(106,13,173,0.35);}
    .btn-clear{padding:0.55rem 1rem;background:rgba(255,255,255,0.05);color:var(--muted);border:1px solid var(--border);border-radius:6px;font-family:'Outfit',sans-serif;font-size:0.85rem;cursor:pointer;text-decoration:none;transition:all 0.15s;}
    .btn-clear:hover{color:#fff;border-color:rgba(255,255,255,0.2);}

    /* Summary Cards */
    .summary-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;margin-bottom:1.5rem;}
    .sum-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:1.2rem 1.4rem;}
    .sum-label{font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;margin-bottom:0.5rem;}
    .sum-val{font-family:'Poppins',sans-serif;font-size:1.8rem;font-weight:700;color:#fff;}
    .sum-val.accent{color:var(--accent);}
    .sum-val.green{color:var(--success);}

    /* Seller Cards */
    .sellers-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem;margin-bottom:2rem;}
    .seller-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:1.3rem;cursor:pointer;transition:all 0.18s;border-left:3px solid var(--accent);}
    .seller-card:hover{border-color:#9D4EDD;box-shadow:0 0 20px rgba(106,13,173,0.15);}
    .seller-card.active{border-color:var(--success);box-shadow:0 0 20px rgba(0,255,136,0.1);}
    .sc-name{font-family:'Poppins',sans-serif;font-weight:700;font-size:1rem;color:#fff;margin-bottom:0.6rem;}
    .sc-stats{display:flex;gap:1.2rem;flex-wrap:wrap;}
    .sc-stat{display:flex;flex-direction:column;gap:0.1rem;}
    .sc-stat-val{font-family:'Space Mono',monospace;font-size:0.9rem;font-weight:700;color:#9D4EDD;}
    .sc-stat-lbl{font-size:0.65rem;color:var(--muted);text-transform:uppercase;letter-spacing:1px;}

    /* Attendee Table */
    .section-hd{font-family:'Space Mono',monospace;font-size:0.7rem;letter-spacing:2px;color:var(--muted);text-transform:uppercase;padding:0.5rem 0;border-bottom:1px solid var(--border);margin-bottom:1rem;}
    .table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;}
    table{width:100%;border-collapse:collapse;font-size:0.83rem;}
    th{font-family:'Space Mono',monospace;font-size:0.6rem;letter-spacing:1.5px;color:var(--muted);text-transform:uppercase;padding:0.7rem 1rem;text-align:left;border-bottom:1px solid var(--border);white-space:nowrap;}
    td{padding:0.75rem 1rem;border-bottom:1px solid rgba(255,255,255,0.04);vertical-align:middle;}
    tr:hover td{background:rgba(255,255,255,0.02);}
    .badge{display:inline-flex;align-items:center;padding:0.2rem 0.6rem;border-radius:4px;font-family:'Space Mono',monospace;font-size:0.62rem;font-weight:700;letter-spacing:1px;}
    .badge-cash{background:rgba(0,255,136,0.12);color:var(--success);border:1px solid rgba(0,255,136,0.2);}
    .empty{text-align:center;padding:3rem;color:var(--muted);font-size:0.9rem;}
    .card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:1.5rem;margin-bottom:1.5rem;}

    /* Detail panel */
    #detailPanel{display:none;}
    #detailPanel.show{display:block;}
    .detail-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:0.5rem;}
    .detail-title{font-family:'Poppins',sans-serif;font-size:1.1rem;font-weight:700;color:#9D4EDD;}
    .btn-close-detail{background:rgba(255,255,255,0.06);border:1px solid var(--border);color:var(--muted);padding:0.4rem 0.9rem;border-radius:6px;cursor:pointer;font-size:0.8rem;transition:all 0.15s;}
    .btn-close-detail:hover{color:#fff;}

    @media(max-width:768px){
      .admin-layout{grid-template-columns:1fr;}
      .filter-bar{flex-direction:column;}
      .fg{min-width:100%;}
      .page-title{font-size:1.4rem;}
    }
  </style>
</head>
<body>
<div class="admin-layout">
  <%- include('../partials/superadmin-sidebar', { activePage: 'seller-activity' }) %>

  <main class="main">
    <div class="page-header">
      <h1 class="page-title">Seller <span>Activity</span></h1>
      <a href="/superadmin" class="btn-clear"><i class="bi bi-arrow-left"></i> Back</a>
    </div>

    <!-- Filters -->
    <form method="GET" action="/superadmin/seller-activity" class="filter-bar">
      <div class="fg">
        <label>Staff Member</label>
        <select name="staffId">
          <option value="">All Sellers</option>
          <% allStaff.forEach(function(s){ %>
          <option value="<%= s.username %>" <%= filters.staffId === s.username ? 'selected' : '' %>>
            <%= s.firstName %> <%= s.lastName||'' %> (<%= s.username %>)
          </option>
          <% }); %>
        </select>
      </div>
      <div class="fg">
        <label>Event</label>
        <select name="eventId">
          <option value="">All Events</option>
          <% events.forEach(function(e){ %>
          <option value="<%= e._id %>" <%= filters.eventId === String(e._id) ? 'selected' : '' %>>
            <%= e.name %>
          </option>
          <% }); %>
        </select>
      </div>
      <div class="fg">
        <label>From Date</label>
        <input type="date" name="dateFrom" value="<%= filters.dateFrom || '' %>"/>
      </div>
      <div class="fg">
        <label>To Date</label>
        <input type="date" name="dateTo" value="<%= filters.dateTo || '' %>"/>
      </div>
      <button type="submit" class="btn-filter"><i class="bi bi-funnel-fill"></i> Filter</button>
      <a href="/superadmin/seller-activity" class="btn-clear"><i class="bi bi-x"></i> Clear</a>
    </form>

    <!-- Summary -->
    <div class="summary-grid">
      <div class="sum-card">
        <div class="sum-label">Total Revenue</div>
        <div class="sum-val green">₹<%= totalRevenue.toLocaleString('en-IN') %></div>
      </div>
      <div class="sum-card">
        <div class="sum-label">Total Tickets Sold</div>
        <div class="sum-val accent"><%= totalTickets %></div>
      </div>
      <div class="sum-card">
        <div class="sum-label">Total Bookings</div>
        <div class="sum-val"><%= bookings.length %></div>
      </div>
      <div class="sum-card">
        <div class="sum-label">Active Sellers</div>
        <div class="sum-val"><%= sellerStats.length %></div>
      </div>
    </div>

    <!-- Seller Cards -->
    <% if (sellerStats.length === 0) { %>
    <div class="card">
      <div class="empty"><i class="bi bi-person-x" style="font-size:2.5rem;display:block;margin-bottom:0.7rem;"></i>No cash sales found for the selected filters.</div>
    </div>
    <% } else { %>
    <div class="section-hd">Seller Summary — click a card to view attendees</div>
    <div class="sellers-grid">
      <% sellerStats.forEach(function(s, idx){ %>
      <div class="seller-card" id="sc-<%= idx %>" onclick="showDetail(<%= idx %>)">
        <div class="sc-name"><i class="bi bi-person-badge-fill" style="color:#9D4EDD;margin-right:0.4rem;"></i><%= s.seller %></div>
        <div class="sc-stats">
          <div class="sc-stat">
            <span class="sc-stat-val">₹<%= s.revenue.toLocaleString('en-IN') %></span>
            <span class="sc-stat-lbl">Revenue</span>
          </div>
          <div class="sc-stat">
            <span class="sc-stat-val"><%= s.tickets %></span>
            <span class="sc-stat-lbl">Tickets</span>
          </div>
          <div class="sc-stat">
            <span class="sc-stat-val"><%= s.bookings %></span>
            <span class="sc-stat-lbl">Bookings</span>
          </div>
        </div>
      </div>
      <% }); %>
    </div>

    <!-- Detail Panel -->
    <div id="detailPanel" class="card">
      <div class="detail-header">
        <div class="detail-title" id="detailTitle"></div>
        <button class="btn-close-detail" onclick="closeDetail()"><i class="bi bi-x-lg"></i> Close</button>
      </div>
      <div class="section-hd">Attendee Details</div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Attendee Name</th>
              <th>Ticket ID</th>
              <th>Type</th>
              <th>Event</th>
              <th>Date Sold</th>
            </tr>
          </thead>
          <tbody id="detailTbody"></tbody>
        </table>
      </div>
    </div>

    <!-- All Bookings Table -->
    <div class="section-hd" style="margin-top:1rem;">All Cash Bookings</div>
    <div class="card" style="padding:0;">
      <% if (bookings.length === 0) { %>
      <div class="empty">No bookings found.</div>
      <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Booking Ref</th>
              <th>Seller</th>
              <th>Buyer</th>
              <th>Event</th>
              <th>Tickets</th>
              <th>Amount</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% bookings.forEach(function(b){ %>
            <tr>
              <td style="font-family:'Space Mono',monospace;font-size:0.72rem;color:#9D4EDD;"><%= b.bookingRef %></td>
              <td style="font-weight:600;"><%= b.soldBy || '—' %></td>
              <td style="font-size:0.8rem;color:var(--muted);">
                <%= b.contactName || '—' %><br/>
                <span style="font-size:0.7rem;"><%= b.contactPhone || '' %> <%= b.contactEmail || '' %></span>
              </td>
              <td style="font-size:0.8rem;"><%= b.event?.name || '—' %></td>
              <td style="text-align:center;"><span class="badge badge-cash"><%= b.quantity %></span></td>
              <td style="font-family:'Space Mono',monospace;color:var(--success);">₹<%= (b.totalAmount||0).toLocaleString('en-IN') %></td>
              <td style="font-size:0.75rem;color:var(--muted);">
                <%= b.createdAt ? new Date(b.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '—' %>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
    <% } %>
  </main>
</div>

<script>
const sellerData = <%- JSON.stringify(sellerStats.map(function(s){ return { seller: s.seller, tickets: s.tickets, revenue: s.revenue, bookings: s.bookings, attendees: s.attendees }; })) %>;

function showDetail(idx) {
  const s = sellerData[idx];
  if (!s) return;

  // Highlight card
  document.querySelectorAll('.seller-card').forEach(c => c.classList.remove('active'));
  const card = document.getElementById('sc-' + idx);
  if (card) card.classList.add('active');

  document.getElementById('detailTitle').textContent =
    s.seller + ' — ' + s.tickets + ' ticket' + (s.tickets !== 1 ? 's' : '') + ' · ₹' + s.revenue.toLocaleString('en-IN');

  const tbody = document.getElementById('detailTbody');
  if (s.attendees.length === 0) {
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--muted);padding:2rem;">No attendee details.</td></tr>';
  } else {
    tbody.innerHTML = s.attendees.map(function(a, i) {
      const d = a.date ? new Date(a.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
      return '<tr>' +
        '<td style="color:var(--muted);">' + (i+1) + '</td>' +
        '<td style="font-weight:600;">' + (a.name||'—') + '</td>' +
        '<td style="font-family:\'Space Mono\',monospace;font-size:0.7rem;color:#9D4EDD;">' + (a.ticketId||'—') + '</td>' +
        '<td><span class="badge badge-cash">' + (a.type||'—') + '</span></td>' +
        '<td style="font-size:0.8rem;">' + (a.event||'—') + '</td>' +
        '<td style="font-size:0.75rem;color:var(--muted);">' + d + '</td>' +
      '</tr>';
    }).join('');
  }

  const panel = document.getElementById('detailPanel');
  panel.classList.add('show');
  panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function closeDetail() {
  document.getElementById('detailPanel').classList.remove('show');
  document.querySelectorAll('.seller-card').forEach(c => c.classList.remove('active'));
}
</script>
</body>
</html>
