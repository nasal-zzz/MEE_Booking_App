<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins&family=Outfit:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    :root{--bg:#0B0B0F;--surface:#14141C;--border:rgba(255,255,255,0.08);--accent:#9D4EDD;--text:#fff;--muted:#B3B3B3;--error:#FF4444;--success:#00FF88;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;}
    .layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh;}
    .sidebar{background:var(--surface);border-right:1px solid var(--border);padding:1.5rem 1rem;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:0.3rem;overflow-y:auto;}
    .s-logo{font-family:'Poppins',sans-serif;font-size:1.3rem;letter-spacing:3px;color:#fff;text-decoration:none;display:block;padding:0 0.5rem 0.5rem;border-bottom:1px solid var(--border);margin-bottom:0.4rem;}
    .s-logo span{color:var(--accent);}
    .s-badge{font-family:'Space Mono',monospace;font-size:0.5rem;letter-spacing:2px;color:var(--accent);background:rgba(157,78,221,0.1);border:1px solid rgba(157,78,221,0.25);border-radius:10px;padding:0.15rem 0.6rem;margin-bottom:0.8rem;display:inline-block;}
    .s-link{display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--muted);text-decoration:none;border-radius:6px;font-size:0.85rem;transition:all 0.15s;border:1px solid transparent;}
    .s-link:hover,.s-link.active{background:rgba(157,78,221,0.08);border-color:rgba(157,78,221,0.2);color:#fff;}
    .s-link i{color:var(--accent);width:18px;}
    .s-logout{margin-top:auto;display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0.8rem;color:var(--error);text-decoration:none;border-radius:6px;font-size:0.85rem;border:1px solid transparent;transition:all 0.15s;}
    .s-logout:hover{background:rgba(255,68,68,0.08);}
    .main{padding:2rem;overflow-x:hidden;}
    .page-title{font-family:'Poppins',sans-serif;font-size:1.8rem;letter-spacing:2px;margin-bottom:0.3rem;}
    .page-sub{font-size:0.78rem;color:var(--muted);margin-bottom:2rem;}

    /* Add form */
    .add-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-bottom:2rem;}
    .card-bar{height:3px;background:linear-gradient(90deg,#9D4EDD,#6A0DAD);}
    .card-body{padding:1.5rem;}
    .card-head{font-family:'Poppins',sans-serif;font-size:1rem;letter-spacing:2px;margin-bottom:1.2rem;}
    .f-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;}
    .f-grid.cols3{grid-template-columns:1fr 1fr 1fr;}
    .f-grp{display:flex;flex-direction:column;gap:0.3rem;}
    .f-lbl{font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:1px;color:#555;text-transform:uppercase;}
    .f-inp,.f-sel{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:7px;color:#fff;font-family:'Outfit',sans-serif;font-size:0.88rem;padding:0.62rem 0.85rem;outline:none;transition:border-color 0.18s;width:100%;}
    .f-inp:focus,.f-sel:focus{border-color:rgba(157,78,221,0.45);}
    .f-sel option{background:#1a1a2e;}
    .perms-row{display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:1rem;}
    .perm-check{display:flex;align-items:center;gap:0.4rem;font-size:0.82rem;color:var(--muted);cursor:pointer;}
    .perm-check input{width:15px;height:15px;accent-color:var(--accent);}
    .submit-btn{display:flex;align-items:center;justify-content:center;gap:0.5rem;padding:0.8rem 2rem;background:var(--accent);color:#fff;border:none;border-radius:8px;font-weight:700;font-size:0.88rem;cursor:pointer;transition:all 0.18s;}
    .submit-btn:hover{box-shadow:0 0 20px rgba(157,78,221,0.4);}
    .result-box{display:none;background:rgba(0,255,136,0.06);border:1px solid rgba(0,255,136,0.2);border-radius:8px;padding:1rem;margin-top:1rem;}
    .result-box.show{display:block;}
    .cred-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:0.4rem;font-family:'Space Mono',monospace;font-size:0.78rem;}
    .cred-key{color:#555;}
    .cred-val{color:#fff;font-weight:700;background:rgba(255,255,255,0.06);padding:0.2rem 0.6rem;border-radius:4px;}

    /* Staff table */
    .staff-table{width:100%;border-collapse:collapse;}
    .staff-table th{font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:2px;color:#555;text-transform:uppercase;padding:0.6rem 0.8rem;border-bottom:1px solid var(--border);text-align:left;}
    .staff-table td{padding:0.85rem 0.8rem;border-bottom:1px solid rgba(255,255,255,0.04);font-size:0.85rem;vertical-align:middle;}
    .staff-table tr:hover td{background:rgba(255,255,255,0.02);}
    .role-badge{font-family:'Space Mono',monospace;font-size:0.55rem;letter-spacing:1px;padding:0.2rem 0.55rem;border-radius:10px;}
    .role-admin{background:rgba(157,78,221,0.12);border:1px solid rgba(157,78,221,0.3);color:#9D4EDD;}
    .role-staff{background:rgba(0,255,136,0.08);border:1px solid rgba(0,255,136,0.25);color:#00FF88;}
    .role-superadmin{background:rgba(245,200,66,0.1);border:1px solid rgba(245,200,66,0.3);color:#f5c842;}
    .badge-active{background:rgba(0,255,136,0.08);border:1px solid rgba(0,255,136,0.25);color:#00FF88;font-size:0.55rem;font-family:'Space Mono',monospace;padding:0.15rem 0.5rem;border-radius:10px;}
    .badge-blocked{background:rgba(255,68,68,0.08);border:1px solid rgba(255,68,68,0.25);color:#FF4444;font-size:0.55rem;font-family:'Space Mono',monospace;padding:0.15rem 0.5rem;border-radius:10px;}
    .btn-sm{display:inline-flex;align-items:center;gap:0.3rem;padding:0.32rem 0.65rem;border-radius:4px;font-size:0.72rem;cursor:pointer;border:1px solid var(--border);background:transparent;color:var(--text);transition:all 0.15s;}
    .btn-sm:hover{border-color:var(--accent);color:var(--accent);}
    .btn-block{color:#f5c842;border-color:rgba(245,200,66,0.3);}
    .btn-block:hover{background:rgba(245,200,66,0.1);}
    .btn-del{color:var(--error);border-color:rgba(255,68,68,0.3);}
    .btn-del:hover{background:rgba(255,68,68,0.1);}
    .btn-cred{color:#9D4EDD;border-color:rgba(157,78,221,0.3);}
    .btn-cred:hover{background:rgba(157,78,221,0.1);}
    .empty{text-align:center;padding:3rem;color:#555;}

    /* Password reveal cell */
    .pw-cell{display:flex;align-items:center;gap:0.4rem;}
    .pw-dots{font-family:'Space Mono',monospace;font-size:0.72rem;color:#555;letter-spacing:2px;user-select:none;}
    .pw-text{font-family:'Space Mono',monospace;font-size:0.75rem;color:#fff;display:none;background:rgba(157,78,221,0.08);padding:0.15rem 0.5rem;border-radius:4px;border:1px solid rgba(157,78,221,0.2);}
    .pw-toggle{background:none;border:none;color:#555;cursor:pointer;font-size:0.85rem;padding:0.1rem 0.2rem;transition:color 0.15s;line-height:1;}
    .pw-toggle:hover{color:#9D4EDD;}

    /* Edit credentials modal */
    .modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:200;align-items:center;justify-content:center;}
    .modal-overlay.show{display:flex;}
    .modal{background:#14141C;border:1px solid rgba(157,78,221,0.35);border-radius:14px;padding:1.8rem;width:420px;max-width:95vw;}
    .modal-title{font-family:'Poppins',sans-serif;font-size:1rem;letter-spacing:2px;margin-bottom:0.3rem;}
    .modal-sub{font-size:0.75rem;color:var(--muted);margin-bottom:1.4rem;}
    .modal-field{margin-bottom:1rem;}
    .modal-lbl{font-family:'Space Mono',monospace;font-size:0.52rem;letter-spacing:1px;color:#555;text-transform:uppercase;display:block;margin-bottom:0.3rem;}
    .modal-inp-wrap{position:relative;}
    .modal-inp{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:7px;color:#fff;font-family:'Space Mono',monospace;font-size:0.85rem;padding:0.65rem 2.5rem 0.65rem 0.85rem;outline:none;transition:border-color 0.18s;width:100%;}
    .modal-inp:focus{border-color:rgba(157,78,221,0.5);}
    .modal-eye{position:absolute;right:0.7rem;top:50%;transform:translateY(-50%);background:none;border:none;color:#555;cursor:pointer;font-size:0.95rem;transition:color 0.15s;padding:0;}
    .modal-eye:hover{color:#9D4EDD;}
    .modal-actions{display:flex;gap:0.7rem;justify-content:flex-end;margin-top:1.4rem;}
    .modal-cancel{padding:0.65rem 1.3rem;background:transparent;border:1px solid var(--border);border-radius:7px;color:var(--muted);font-size:0.85rem;cursor:pointer;transition:all 0.15s;}
    .modal-cancel:hover{border-color:rgba(255,255,255,0.2);color:#fff;}
    .modal-save{padding:0.65rem 1.6rem;background:var(--accent);border:none;border-radius:7px;color:#fff;font-size:0.85rem;font-weight:700;cursor:pointer;transition:all 0.18s;}
    .modal-save:hover{box-shadow:0 0 16px rgba(157,78,221,0.4);}
    .modal-err{display:none;color:var(--error);font-size:0.78rem;margin-top:0.5rem;}
    .modal-ok{display:none;color:var(--success);font-size:0.78rem;margin-top:0.5rem;}
    @media(max-width:900px){.layout{grid-template-columns:1fr;}.sidebar{display:none;}.f-grid{grid-template-columns:1fr;}.f-grid.cols3{grid-template-columns:1fr 1fr;}}
  </style>
</head>
<body>
<div class="layout">
  <%- include('../partials/superadmin-sidebar', { activePage: 'staff' }) %>
  <main class="main">
    <h1 class="page-title">STAFF & ADMINS</h1>
    <p class="page-sub">Create accounts for admins and staff. Only superadmin can view or change credentials.</p>

    <!-- Add Staff Form -->
    <div class="add-card">
      <div class="card-bar"></div>
      <div class="card-body">
        <div class="card-head">ADD NEW MEMBER</div>
        <div class="f-grid">
          <div class="f-grp"><label class="f-lbl">First Name *</label><input class="f-inp" id="saFirstName" placeholder="e.g. Rahul"/></div>
          <div class="f-grp"><label class="f-lbl">Last Name</label><input class="f-inp" id="saLastName" placeholder="e.g. Kumar"/></div>
        </div>
        <div class="f-grid cols3">
          <div class="f-grp"><label class="f-lbl">Email *</label><input class="f-inp" type="email" id="saEmail" placeholder="email@example.com"/></div>
          <div class="f-grp"><label class="f-lbl">Phone *</label><input class="f-inp" type="tel" id="saPhone" placeholder="10-digit mobile"/></div>
          <div class="f-grp">
            <label class="f-lbl">Role *</label>
            <select class="f-sel" id="saRole" onchange="togglePerms()">
              <option value="staff">Staff</option>
              <option value="admin">Admin</option>
            </select>
          </div>
        </div>
        <div id="permsWrap" style="margin-bottom:1rem;display:block;">
          <div class="f-lbl" style="margin-bottom:0.5rem;">Permissions</div>
          <div class="perms-row">
            <label class="perm-check"><input type="checkbox" id="pCanScanQR" checked/> Scan QR</label>
            <label class="perm-check"><input type="checkbox" id="pCanViewBookings"/> View Bookings</label>
            <label class="perm-check"><input type="checkbox" id="pCanManageEvents"/> Manage Events</label>
            <label class="perm-check"><input type="checkbox" id="pCanSellTickets"/> Sell Tickets (Offline)</label>
          </div>
        </div>
        <div style="margin-bottom:1rem;">
          <label class="perm-check" style="font-size:0.85rem;">
            <input type="checkbox" id="manualCreds" onchange="toggleManualCreds()"/> Set username &amp; password manually
          </label>
        </div>
        <div id="manualCredsWrap" style="display:none;margin-bottom:1rem;">
          <div class="f-grid">
            <div class="f-grp">
              <label class="f-lbl">Username *</label>
              <input class="f-inp" id="saManualUsername" placeholder="e.g. admin-raju"/>
            </div>
            <div class="f-grp">
              <label class="f-lbl">Password *</label>
              <div style="position:relative;">
                <input class="f-inp" type="password" id="saManualPassword" placeholder="Min 4 characters" style="padding-right:2.5rem;"/>
                <button type="button" onclick="toggleNewPw()" style="position:absolute;right:0.7rem;top:50%;transform:translateY(-50%);background:none;border:none;color:#555;cursor:pointer;font-size:1rem;" id="newPwEye"><i class="bi bi-eye"></i></button>
              </div>
            </div>
          </div>
          <div style="font-size:0.72rem;color:#555;margin-top:0.3rem;">Username will be lowercased. Leave blank to auto-generate.</div>
        </div>
        <button class="submit-btn" onclick="addStaff()"><i class="bi bi-person-plus-fill"></i> Create Account</button>
        <div class="result-box" id="resultBox">
          <div style="font-family:'Space Mono',monospace;font-size:0.65rem;letter-spacing:2px;color:var(--success);margin-bottom:0.7rem;">✓ ACCOUNT CREATED — SAVE THESE CREDENTIALS</div>
          <div class="cred-row"><span class="cred-key">Username</span><span class="cred-val" id="rUser">—</span></div>
          <div class="cred-row"><span class="cred-key">Password</span><span class="cred-val" id="rPass">—</span></div>
          <div style="font-size:0.72rem;color:#555;margin-top:0.5rem;">Auto-generated format: username-last3digitsofphone</div>
        </div>
        <div id="errBox" style="display:none;color:var(--error);font-size:0.82rem;margin-top:0.7rem;"></div>
      </div>
    </div>

    <!-- Staff List -->
    <h2 style="font-family:'Poppins',sans-serif;font-size:1.2rem;letter-spacing:2px;margin-bottom:1rem;">ALL MEMBERS (<%= staff.length %>)</h2>
    <% if(staff.length === 0){ %>
    <div class="empty"><i class="bi bi-people" style="font-size:2.5rem;display:block;margin-bottom:0.8rem;"></i>No staff yet.</div>
    <% } else { %>
    <div style="overflow-x:auto;">
    <table class="staff-table">
      <thead><tr>
        <th>Name</th><th>Username</th><th>Password</th><th>Email / Phone</th><th>Role</th><th>Status</th><th>Actions</th>
      </tr></thead>
      <tbody>
      <% staff.forEach(function(m){ %>
      <tr id="sr-<%= m._id %>">
        <td>
          <div style="font-weight:600;"><%= m.firstName %> <%= m.lastName %></div>
          <div style="font-size:0.7rem;color:var(--muted);margin-top:0.1rem;">
            <% if(m.role==='admin'){ %>
              <%= [m.canScanQR&&'QR',m.canViewBookings&&'Bookings',m.canManageEvents&&'Events',m.canSellTickets&&'Sell'].filter(Boolean).join(' · ')||'No permissions' %>
            <% } else if(m.role==='superadmin'){ %>
              Full access
            <% } else { %>
              QR Scanner
            <% } %>
          </div>
        </td>
        <td>
          <span style="font-family:'Space Mono',monospace;font-size:0.78rem;color:var(--accent);" id="uname-<%= m._id %>"><%= m.username %></span>
        </td>
        <td>
          <div class="pw-cell">
            <% var displayPw = m.plainPassword || (!m.password.startsWith('$2') ? m.password : null); %>
            <span class="pw-dots" id="pw-dots-<%= m._id %>">••••••••</span>
            <% if (displayPw) { %>
              <span class="pw-text" id="pw-text-<%= m._id %>" data-pw="<%= displayPw %>"><%= displayPw %></span>
            <% } else { %>
              <span class="pw-text" id="pw-text-<%= m._id %>" data-pw="" style="font-size:0.68rem;color:#888;font-style:italic;">Reset to reveal</span>
            <% } %>
            <button class="pw-toggle" onclick="togglePw('<%= m._id %>')" id="pw-eye-<%= m._id %>" title="Show/hide password">
              <i class="bi bi-eye" id="pw-icon-<%= m._id %>"></i>
            </button>
          </div>
        </td>
        <td>
          <div style="font-size:0.8rem;color:var(--muted);"><%= m.email %></div>
          <div style="font-size:0.75rem;color:#555;"><%= m.phone||'—' %></div>
        </td>
        <td>
          <span class="role-badge <%= m.role==='superadmin'?'role-superadmin':m.role==='admin'?'role-admin':'role-staff' %>">
            <%= m.role.toUpperCase() %>
          </span>
        </td>
        <td><span class="<%= m.isActive?'badge-active':'badge-blocked' %>" id="sbadge-<%= m._id %>"><%= m.isActive?'ACTIVE':'BLOCKED' %></span></td>
        <td>
          <div style="display:flex;gap:0.4rem;flex-wrap:wrap;">
            <button class="btn-sm btn-cred" onclick="openEditCreds('<%= m._id %>','<%= m.firstName %> <%= m.lastName %>')" title="Edit credentials">
              <i class="bi bi-key-fill"></i> Credentials
            </button>
            <% if(m.role !== 'superadmin') { %>
            <button class="btn-sm btn-block" onclick="toggleStaff('<%= m._id %>')" id="sbtn-<%= m._id %>">
              <i class="bi bi-<%= m.isActive?'lock-fill':'unlock-fill' %>"></i>
              <span id="stxt-<%= m._id %>"><%= m.isActive?'Block':'Unblock' %></span>
            </button>
            <form method="POST" action="/superadmin/staff/<%= m._id %>/delete" onsubmit="return confirm('Delete <%= m.firstName %>? This cannot be undone.')" style="display:inline;">
              <button type="submit" class="btn-sm btn-del"><i class="bi bi-trash3-fill"></i></button>
            </form>
            <% } %>
          </div>
        </td>
      </tr>
      <% }); %>
      </tbody>
    </table>
    </div>
    <% } %>
  </main>
</div>

<!-- Edit Credentials Modal -->
<div class="modal-overlay" id="credModal">
  <div class="modal">
    <div class="modal-title">🔑 EDIT CREDENTIALS</div>
    <div class="modal-sub" id="credModalSub">Updating credentials for —</div>

    <div class="modal-field">
      <label class="modal-lbl">Username</label>
      <input class="modal-inp" id="editUsername" type="text" placeholder="e.g. admin-raju" autocomplete="off"/>
    </div>
    <div class="modal-field">
      <label class="modal-lbl">New Password</label>
      <div class="modal-inp-wrap">
        <input class="modal-inp" id="editPassword" type="password" placeholder="Min 4 characters" autocomplete="new-password"/>
        <button class="modal-eye" type="button" onclick="toggleEditPw()" id="editPwEye"><i class="bi bi-eye"></i></button>
      </div>
    </div>
    <div class="modal-err" id="credErr"></div>
    <div class="modal-ok" id="credOk"></div>
    <div class="modal-actions">
      <button class="modal-cancel" onclick="closeCredModal()">Cancel</button>
      <button class="modal-save" onclick="saveCredentials()"><i class="bi bi-floppy-fill"></i> Save</button>
    </div>
  </div>
</div>

<script>
let _editingId = null;

// ── Password reveal in table ──
function togglePw(id){
  const dots = document.getElementById('pw-dots-'+id);
  const text = document.getElementById('pw-text-'+id);
  const icon = document.getElementById('pw-icon-'+id);
  const showing = text.style.display === 'inline';
  if(showing){
    text.style.display = 'none';
    dots.style.display = 'inline';
    icon.className = 'bi bi-eye';
  } else {
    dots.style.display = 'none';
    text.style.display = 'inline';
    icon.className = 'bi bi-eye-slash';
  }
}

// ── New password eye in add form ──
function toggleNewPw(){
  const inp = document.getElementById('saManualPassword');
  const eye = document.getElementById('newPwEye').querySelector('i');
  if(inp.type==='password'){ inp.type='text'; eye.className='bi bi-eye-slash'; }
  else { inp.type='password'; eye.className='bi bi-eye'; }
}

// ── Edit credentials modal ──
function openEditCreds(id, name){
  _editingId = id;
  document.getElementById('credModalSub').textContent = 'Updating credentials for ' + name;
  document.getElementById('credErr').style.display = 'none';
  document.getElementById('credOk').style.display = 'none';
  // Pre-fill with current values
  const uname = document.getElementById('uname-'+id);
  document.getElementById('editUsername').value = uname ? uname.textContent.trim() : '';
  document.getElementById('editPassword').value = '';
  document.getElementById('editPwEye').querySelector('i').className = 'bi bi-eye';
  document.getElementById('editPassword').type = 'password';
  document.getElementById('credModal').classList.add('show');
  document.getElementById('editUsername').focus();
}

function closeCredModal(){
  document.getElementById('credModal').classList.remove('show');
  _editingId = null;
}

function toggleEditPw(){
  const inp = document.getElementById('editPassword');
  const eye = document.getElementById('editPwEye').querySelector('i');
  if(inp.type==='password'){ inp.type='text'; eye.className='bi bi-eye-slash'; }
  else { inp.type='password'; eye.className='bi bi-eye'; }
}

async function saveCredentials(){
  const newUsername = document.getElementById('editUsername').value.trim();
  const newPassword = document.getElementById('editPassword').value.trim();
  const errEl = document.getElementById('credErr');
  const okEl  = document.getElementById('credOk');
  errEl.style.display='none'; okEl.style.display='none';

  if(!newUsername){ errEl.textContent='Username is required.'; errEl.style.display='block'; return; }
  if(!newPassword){ errEl.textContent='Password is required.'; errEl.style.display='block'; return; }
  if(newPassword.length < 4){ errEl.textContent='Password must be at least 4 characters.'; errEl.style.display='block'; return; }

  try {
    const res = await fetch(`/superadmin/staff/${_editingId}/credentials`, {
      method: 'POST', credentials: 'include',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ newUsername, newPassword }),
    });
    const d = await res.json();
    if(d.success){
      // Update table in place
      const unameEl = document.getElementById('uname-'+_editingId);
      if(unameEl) unameEl.textContent = d.username;
      // Update revealed password text if visible
      const pwText = document.getElementById('pw-text-'+_editingId);
      if(pwText) {
        pwText.textContent = newPassword;
        pwText.dataset.pw = newPassword;
        pwText.style.fontStyle = 'normal';
        pwText.style.color = '';
        pwText.style.fontSize = '';
      }
      okEl.textContent = '✓ Credentials updated successfully.';
      okEl.style.display = 'block';
      setTimeout(closeCredModal, 1400);
    } else {
      errEl.textContent = d.message || 'Failed to update.';
      errEl.style.display = 'block';
    }
  } catch(e){
    errEl.textContent = 'Network error. Try again.';
    errEl.style.display = 'block';
  }
}

// ── Add staff ──
function togglePerms(){
  const role = document.getElementById('saRole').value;
  // Always show permissions panel
  document.getElementById('permsWrap').style.display = 'block';
  // For admin role — check all permissions by default
  if(role === 'admin'){
    document.getElementById('pCanScanQR').checked = true;
    document.getElementById('pCanViewBookings').checked = true;
    document.getElementById('pCanManageEvents').checked = true;
    document.getElementById('pCanSellTickets').checked = false;
  } else {
    // Staff role — only scan QR by default, others off
    document.getElementById('pCanScanQR').checked = true;
    document.getElementById('pCanViewBookings').checked = false;
    document.getElementById('pCanManageEvents').checked = false;
    document.getElementById('pCanSellTickets').checked = false;
  }
}

function toggleManualCreds(){
  const on = document.getElementById('manualCreds').checked;
  document.getElementById('manualCredsWrap').style.display = on ? 'block' : 'none';
  if(!on){ document.getElementById('saManualUsername').value=''; document.getElementById('saManualPassword').value=''; }
}

async function addStaff(){
  const firstName = document.getElementById('saFirstName').value.trim();
  const lastName  = document.getElementById('saLastName').value.trim();
  const email     = document.getElementById('saEmail').value.trim();
  const phone     = document.getElementById('saPhone').value.trim();
  const role      = document.getElementById('saRole').value;
  const manualUsername = document.getElementById('saManualUsername').value.trim();
  const manualPassword = document.getElementById('saManualPassword').value.trim();
  const errBox = document.getElementById('errBox');
  errBox.style.display = 'none';
  if(!firstName||!email||!phone){ errBox.textContent='First name, email and phone are required.'; errBox.style.display='block'; return; }
  if(document.getElementById('manualCreds').checked && !manualUsername){ errBox.textContent='Enter a username or uncheck manual credentials.'; errBox.style.display='block'; return; }
  try {
    const res = await fetch('/superadmin/staff', { method:'POST', credentials:'include', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ firstName, lastName, email, phone, role, manualUsername, manualPassword,
        canScanQR: document.getElementById('pCanScanQR').checked ? 'on' : '',
        canViewBookings: document.getElementById('pCanViewBookings').checked ? 'on' : '',
        canManageEvents: document.getElementById('pCanManageEvents').checked ? 'on' : '',
        canSellTickets: document.getElementById('pCanSellTickets').checked ? 'on' : '' }) });
    const d = await res.json();
    if(d.success){
      document.getElementById('rUser').textContent = d.username;
      document.getElementById('rPass').textContent = d.password;
      document.getElementById('resultBox').classList.add('show');
      setTimeout(() => location.reload(), 3500);
    } else { errBox.textContent = d.message||'Failed'; errBox.style.display='block'; }
  } catch(e){ errBox.textContent='Network error.'; errBox.style.display='block'; }
}

// ── Block/Unblock ──
async function toggleStaff(id){
  const res = await fetch(`/superadmin/staff/${id}/toggle`, { method:'POST', credentials:'include' });
  const d = await res.json();
  if(d.success){
    const badge = document.getElementById('sbadge-'+id);
    const btn   = document.getElementById('sbtn-'+id);
    const txt   = document.getElementById('stxt-'+id);
    if(d.isActive){ badge.className='badge-active'; badge.textContent='ACTIVE'; btn.querySelector('i').className='bi bi-lock-fill'; txt.textContent='Block'; }
    else { badge.className='badge-blocked'; badge.textContent='BLOCKED'; btn.querySelector('i').className='bi bi-unlock-fill'; txt.textContent='Unblock'; }
  }
}

// Close modal on backdrop click
document.getElementById('credModal').addEventListener('click', function(e){ if(e.target===this) closeCredModal(); });

// Enter key in modal fields triggers save
['editUsername','editPassword'].forEach(id => {
  document.getElementById(id).addEventListener('keydown', e => { if(e.key==='Enter') saveCredentials(); });
});
</script>
